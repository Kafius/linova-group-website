---
import Layout from '../../layouts/SourDelusionsLayout.astro';
import Navbar from '../../components/sourdelusions/Navbar.astro';
import Footer from '../../components/sourdelusions/Footer.astro';
import CartSidebar from '../../components/sourdelusions/CartSidebar.astro';
---

<Layout title="All Products | Sour Delusions">
  <Navbar />
  <CartSidebar />

  <section class="pt-32 pb-20 min-h-screen">
    <div class="max-w-300 mx-auto px-6">
      <!-- Header -->
      <div class="text-center mb-12">
        <span class="inline-block text-[0.8rem] font-semibold uppercase tracking-widest text-brand-pink mb-4">Full Collection</span>
        <h1 class="text-[clamp(2.5rem,5vw,3.5rem)] font-extrabold tracking-tight text-brand-dark mb-4">All Products</h1>
        <p class="text-text-muted text-lg max-w-120 mx-auto">Every sour creation we make, all in one place. Filter by category or sort by what matters to you.</p>
      </div>

      <!-- Filters -->
      <div class="flex flex-wrap items-center justify-between gap-4 mb-10 pb-6 border-b border-border-subtle">
        <div class="flex flex-wrap gap-2" id="categoryFilters">
          <button data-category="all" class="filter-btn active px-5 py-2 rounded-full text-sm font-semibold border transition-all duration-300 cursor-pointer font-body">All</button>
          <button data-category="gummies" class="filter-btn px-5 py-2 rounded-full text-sm font-semibold border transition-all duration-300 cursor-pointer font-body">Gummies</button>
          <button data-category="strips" class="filter-btn px-5 py-2 rounded-full text-sm font-semibold border transition-all duration-300 cursor-pointer font-body">Strips</button>
          <button data-category="hard-candy" class="filter-btn px-5 py-2 rounded-full text-sm font-semibold border transition-all duration-300 cursor-pointer font-body">Hard Candy</button>
        </div>
        <div class="flex items-center gap-3">
          <label class="text-xs font-semibold text-text-muted uppercase tracking-wide">Sort by</label>
          <select id="sortSelect" class="px-4 py-2 rounded-xl border border-border-subtle bg-bg-card text-brand-dark text-sm font-body outline-none cursor-pointer">
            <option value="name">Name</option>
            <option value="price-low">Price: Low → High</option>
            <option value="price-high">Price: High → Low</option>
            <option value="sour">Sourness Level</option>
          </select>
        </div>
      </div>

      <!-- Product count -->
      <p class="text-sm text-text-muted mb-6"><span id="productCount">0</span> products</p>

      <!-- Product Grid -->
      <div id="productGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <!-- Populated by JS -->
      </div>

      <!-- Empty state -->
      <div id="emptyState" class="hidden text-center py-20">
        <p class="text-text-muted">No products found in this category.</p>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .filter-btn {
    background: transparent;
    border-color: rgba(0,0,0,0.07);
    color: #666;
  }
  .filter-btn:hover {
    border-color: rgba(255, 45, 138, 0.3);
    color: #FF2D8A;
  }
  .filter-btn.active {
    background: linear-gradient(135deg, #16F00D, #FDFE0A);
    border-color: transparent;
    color: #111;
  }

  .product-card {
    opacity: 0;
    transform: translateY(20px);
    animation: card-in 0.4s ease forwards;
  }
  @keyframes card-in {
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  import { init, getAll } from '../../scripts/sourdelusions/products-db.js';
  import { addItem } from '../../scripts/sourdelusions/cart.js';

  await init();

  const grid = document.getElementById('productGrid')!;
  const emptyState = document.getElementById('emptyState')!;
  const countEl = document.getElementById('productCount')!;
  const sortSelect = document.getElementById('sortSelect') as HTMLSelectElement;
  const filterBtns = document.querySelectorAll('.filter-btn');

  let currentCategory = 'all';
  let currentSort = 'name';

  function getTagBadge(tag: string) {
    const colors: Record<string, string> = {
      'best-seller': 'bg-brand-green/10 text-[#0EBB08]',
      'new': 'bg-brand-pink/10 text-brand-pink',
      'fan-favourite': 'bg-brand-yellow/15 text-[#B8A500]',
      'extreme': 'bg-red-100 text-red-600',
    };
    return colors[tag] || 'bg-bg-card text-text-muted';
  }

  function getCategoryIcon(category: string) {
    switch (category) {
      case 'gummies': return { bg: 'bg-brand-green/10', stroke: '#0EBB08', path: '<path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2z"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>' };
      case 'hard-candy': return { bg: 'bg-brand-pink/[0.08]', stroke: '#FF2D8A', path: '<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>' };
      case 'strips': return { bg: 'bg-brand-yellow/15', stroke: '#B8A500', path: '<rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 7V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v3"/>' };
      default: return { bg: 'bg-bg-card', stroke: '#666', path: '<circle cx="12" cy="12" r="10"/>' };
    }
  }

  function render() {
    let products = getAll();

    // Filter
    if (currentCategory !== 'all') {
      products = products.filter((p: any) => p.category === currentCategory);
    }

    // Sort
    switch (currentSort) {
      case 'price-low': products.sort((a: any, b: any) => a.price - b.price); break;
      case 'price-high': products.sort((a: any, b: any) => b.price - a.price); break;
      case 'sour': products.sort((a: any, b: any) => b.sour - a.sour); break;
      default: products.sort((a: any, b: any) => a.name.localeCompare(b.name));
    }

    countEl.textContent = String(products.length);

    if (products.length === 0) {
      grid.classList.add('hidden');
      emptyState.classList.remove('hidden');
      return;
    }

    grid.classList.remove('hidden');
    emptyState.classList.add('hidden');

    grid.innerHTML = products.map((p: any, i: number) => {
      const icon = getCategoryIcon(p.category);
      const tags = (p.tags || []).map((t: string) =>
        `<span class="text-[0.65rem] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full ${getTagBadge(t)}">${t.replace('-', ' ')}</span>`
      ).join('');

      const imageHtml = p.image
        ? `<div class="w-full aspect-[4/3] rounded-xl mb-4 overflow-hidden bg-bg-card"><img src="${p.image}" alt="${p.name}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"></div>`
        : `<div class="w-full aspect-[4/3] rounded-xl mb-4 overflow-hidden bg-gradient-to-br from-bg-card via-brand-green/[0.03] to-brand-pink/[0.03] border border-dashed border-black/8 flex flex-col items-center justify-center gap-2">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center ${icon.bg}">
              <svg class="w-4.5 h-4.5 stroke-2 [stroke-linecap:round] [stroke-linejoin:round] fill-none" viewBox="0 0 24 24" stroke="${icon.stroke}">${icon.path}</svg>
            </div>
            <span class="text-[0.65rem] text-text-muted">Product Image</span>
          </div>`;

      return `
        <div class="product-card group bg-bg-card border border-border-subtle rounded-[20px] p-6 pt-6 transition-all duration-400 relative overflow-hidden hover:-translate-y-2 hover:border-brand-pink/20 hover:shadow-[0_20px_60px_rgba(0,0,0,0.06)] flex flex-col" style="animation-delay: ${i * 0.05}s">
          <div class="absolute top-0 left-0 right-0 h-0.75 bg-gradient-to-r from-brand-green to-brand-pink scale-x-0 transition-transform duration-400 origin-left group-hover:scale-x-100"></div>

          ${!p.inStock ? '<div class="absolute top-3 right-3 z-1 text-[0.65rem] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-red-100 text-red-600">Out of Stock</div>' : ''}

          ${imageHtml}

          ${tags ? `<div class="flex flex-wrap gap-1.5 mb-3">${tags}</div>` : ''}

          <h3 class="font-heading text-[1.2rem] font-bold mb-1.5 text-brand-dark">${p.name}</h3>
          <p class="text-text-muted text-sm mb-4 leading-relaxed flex-1">${p.description}</p>

          <div class="flex items-center gap-2 mb-1">
            <span class="text-xs uppercase tracking-wide text-text-muted font-semibold">Sour</span>
            <div class="flex-1 h-1 bg-black/6 rounded-full overflow-hidden">
              <div class="h-full rounded-full bg-gradient-to-r from-brand-green to-brand-yellow" style="width: ${p.sour}%"></div>
            </div>
            <span class="text-xs font-bold text-text-muted">${p.sour}%</span>
          </div>

          <div class="text-xs text-text-muted mb-4">${p.weight || ''}</div>

          <div class="flex justify-between items-center mt-auto pt-2">
            <span class="font-heading text-xl font-bold text-brand-dark">$${p.price.toFixed(2)}</span>
            <button
              class="add-btn bg-brand-green/10 border border-brand-green/20 text-[#0EBB08] px-4 py-2 rounded-full text-[0.8rem] font-semibold cursor-pointer transition-all duration-300 font-body hover:bg-brand-green/20 hover:scale-105 ${!p.inStock ? 'opacity-40 pointer-events-none' : ''}"
              data-name="${p.name}"
              data-price="${p.price}"
              ${!p.inStock ? 'disabled' : ''}
            >${p.inStock ? 'Add to Cart' : 'Sold Out'}</button>
          </div>
        </div>
      `;
    }).join('');

    // Bind add-to-cart buttons
    grid.querySelectorAll('.add-btn:not([disabled])').forEach(btn => {
      btn.addEventListener('click', () => {
        const button = btn as HTMLButtonElement;
        addItem({ name: button.dataset.name!, price: parseFloat(button.dataset.price!) });
        window.dispatchEvent(new CustomEvent('cart-item-added'));
        const orig = button.textContent;
        button.textContent = 'Added!';
        button.classList.add('!bg-brand-green/25');
        setTimeout(() => { button.textContent = orig; button.classList.remove('!bg-brand-green/25'); }, 1200);
      });
    });
  }

  // Filter buttons
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentCategory = (btn as HTMLElement).dataset.category!;
      render();
    });
  });

  // Sort
  sortSelect.addEventListener('change', () => {
    currentSort = sortSelect.value;
    render();
  });

  window.addEventListener('products-updated', render);
  render();
</script>
