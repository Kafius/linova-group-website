---
import Layout from '../../layouts/SourDelusionsLayout.astro';
import Navbar from '../../components/sourdelusions/Navbar.astro';
import CartSidebar from '../../components/sourdelusions/CartSidebar.astro';
---

<Layout title="Checkout | Sour Delusions">
  <Navbar />
  <CartSidebar />

  <section class="min-h-screen pt-32 pb-20">
    <div class="max-w-180 mx-auto px-6">
      <a href="/sourdelusions/" class="inline-flex items-center gap-2 text-sm text-text-muted hover:text-brand-pink transition-colors mb-8">
        <svg class="w-4 h-4 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        Back to Shop
      </a>

      <h1 class="font-heading text-[clamp(2rem,4vw,3rem)] font-extrabold tracking-tight text-brand-dark mb-10">Checkout</h1>

      <!-- Empty state -->
      <div id="checkoutEmpty" class="hidden text-center py-20">
        <div class="w-20 h-20 rounded-full bg-bg-card flex items-center justify-center mx-auto mb-5">
          <svg class="w-9 h-9 stroke-text-muted fill-none" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
          </svg>
        </div>
        <h2 class="font-heading text-xl font-bold text-brand-dark mb-2">Your cart is empty</h2>
        <p class="text-text-muted text-sm mb-6">Add some sour treats before checking out!</p>
        <a href="/sourdelusions/products" class="inline-flex items-center gap-2 bg-gradient-to-br from-brand-green to-brand-yellow text-brand-dark px-8 py-3 rounded-full font-bold text-sm transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_0_40px_rgba(22,240,13,0.2)]">Browse Products</a>
      </div>

      <!-- Checkout content -->
      <div id="checkoutContent" class="hidden">
        <!-- Order Summary -->
        <div class="bg-bg-card border border-border-subtle rounded-2xl p-6 mb-8">
          <h3 class="font-heading text-base font-bold text-brand-dark mb-4">Order Summary</h3>
          <div id="orderItems" class="space-y-3 mb-5 pb-5 border-b border-border-subtle">
            <!-- Populated by JS -->
          </div>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-text-muted">Subtotal</span>
              <span id="orderSubtotal" class="font-semibold text-brand-dark">$0.00</span>
            </div>
            <div class="flex justify-between">
              <span class="text-text-muted">Shipping & taxes</span>
              <span class="font-semibold text-text-muted text-xs">Calculated by Stripe</span>
            </div>
          </div>
        </div>

        <!-- Demo notice -->
        <div class="bg-bg-card border border-border-subtle rounded-2xl p-6 mb-8">
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-brand-pink/[0.08] flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 stroke-brand-pink fill-none" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
            </div>
            <div>
              <h3 class="font-heading text-sm font-bold text-brand-dark mb-1">Demo Showcase</h3>
              <p class="text-text-muted text-xs leading-relaxed">This is a portfolio preview of the Sour Delusions site. The live store uses Stripe for secure payments — the button below is disabled in this static demo.</p>
            </div>
          </div>
        </div>

        <!-- Checkout button -->
        <button id="stripeCheckoutBtn" class="w-full bg-gradient-to-br from-brand-green to-brand-yellow text-brand-dark py-4 rounded-full font-bold text-base transition-all duration-300 cursor-not-allowed font-body border-none flex items-center justify-center gap-2 opacity-60" disabled>
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
          Checkout Disabled (Demo)
        </button>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { getItems, getTotal } from '../../scripts/sourdelusions/cart.js';

  const emptyEl = document.getElementById('checkoutEmpty')!;
  const contentEl = document.getElementById('checkoutContent')!;
  const orderItemsEl = document.getElementById('orderItems')!;
  const orderSubtotalEl = document.getElementById('orderSubtotal')!;

  function renderCheckout() {
    const items = getItems();
    const subtotal = getTotal();

    if (items.length === 0) {
      emptyEl.classList.remove('hidden');
      contentEl.classList.add('hidden');
      return;
    }

    emptyEl.classList.add('hidden');
    contentEl.classList.remove('hidden');

    orderItemsEl.innerHTML = items.map((item: any) => `
      <div class="flex justify-between items-center">
        <div class="flex items-center gap-3">
          <span class="w-6 h-6 rounded-full bg-brand-pink/10 text-brand-pink text-[0.65rem] font-bold flex items-center justify-center shrink-0">${item.qty}</span>
          <span class="text-sm text-brand-dark font-medium">${item.name}</span>
        </div>
        <span class="text-sm font-semibold text-brand-dark">$${(item.price * item.qty).toFixed(2)}</span>
      </div>
    `).join('');

    orderSubtotalEl.textContent = `$${subtotal.toFixed(2)}`;
  }

  window.addEventListener('cart-updated', renderCheckout);
  renderCheckout();
</script>
