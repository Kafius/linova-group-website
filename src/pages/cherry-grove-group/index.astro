---
import PitchLayout from '../../layouts/PitchLayout.astro';

const services = [
  { title: 'Interlock', desc: 'Our crew can transform your home by installing high-quality interlocking pavers that enhance both the beauty and functionality of your outdoor spaces. With expert craftsmanship, we create durable and visually appealing pathways, driveways, and patios, giving your property a sophisticated, lasting upgrade.', icon: 'M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z', photo: '/cherry-grove/interlock.avif' },
  { title: 'Fencing', desc: 'A fence provides privacy, security, and enhances the appearance of your property. It also helps define boundaries and protects pets or children. Our crew will build a sturdy, durable fence tailored to your needs, ensuring quality craftsmanship and a perfect fit for your space.', icon: 'M4 4v16M9 4v16M14 4v16M19 4v16M2 9h20M2 15h20', photo: '/cherry-grove/fencing.avif' },
  { title: 'Flagstone', desc: 'Flagstone is a durable, natural stone often used for patios, walkways, and landscaping. It has an aesthetic appeal with strong durability that requires low maintenance.', icon: 'M3 19h18M3 14h18M3 9h18M3 4h18', photo: '/cherry-grove/flagstone.avif' },
  { title: 'Decks', desc: 'A deck provides additional outdoor living space, ideal for relaxing, dining, and entertaining. It enhances your home\'s aesthetic appeal and can increase property value. Decks are customizable to fit various styles and require minimal maintenance, offering a long-lasting, functional area to enjoy the outdoors.', icon: 'M3 21V8l9-5 9 5v13M9 21V12h6v9', photo: '/cherry-grove/decks.avif' },
  { title: 'Mulching & Sodding', desc: 'We use premium mulch to enhance the aesthetic of your garden beds, retain moisture, suppress weeds, and nourish the soil. For lawns, we provide high-quality sod installation using only Kentucky Blue Sod, creating a lush, green lawn that\'s ready to thrive. Our team ensures a precise and efficient process, giving your outdoor space an instant, polished look while promoting long-term health and growth.', icon: 'M12 2v6m0 0l-3-3m3 3l3-3M4 22l4-8 4 4 4-6 4 10z', photo: '/cherry-grove/mulching-sodding.avif' },
];


// Partner marks are shown full-colour on white cards, matching the brand's
// site. `mono` logos ship as white/transparent artwork, so we render them
// as a solid ink silhouette instead (otherwise they vanish on white).
const partners = [
  { name: 'Unilock',        logo: '/cherry-grove/1443440360_logo_unilock.avif' },
  { name: 'Techo-Bloc',     logo: '/cherry-grove/TB2020_header_contact-us_v01_en.avif' },
  { name: 'Permacon',       logo: '/cherry-grove/Permacon-Logo.avif', mono: true },
  { name: 'Oaks',           logo: '/cherry-grove/OAKS_LANDSCAPE_PRODUCTS_LOGO_250.avif' },
  { name: 'Best Way Stone', logo: '/cherry-grove/best-way-stone-logo.avif' },
];

const serviceAreas = ['Markham', 'Toronto', 'Vaughan', 'Richmond Hill', 'Pickering', 'Ajax', 'Whitby', 'Aurora', 'Newmarket', 'Barrie'];

const contacts = [
  { name: 'Dominic Valera', phone: '(647) 818-6451', tel: '+16478186451' },
  { name: 'Jackie Liu', phone: '(647) 868-0388', tel: '+16478680388' },
  { name: 'Hasko Genc', phone: '(647) 835-8127', tel: '+16478358127' },
];
---

<PitchLayout
  title="Cherry Grove Group — Premium Landscaping & Interlocking | GTA"
  description="Cherry Grove Group designs and builds premium outdoor spaces across the Greater Toronto Area — interlocking, patios, retaining walls, and natural stone work built to last."
  fontsHref="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
>
  <style is:global>
    :root {
      /* Palette drawn from the Cherry Grove Group brand: black tree logo,
         slate-navy accent (#20303C) and white, per cherrygrovegroup.wixsite.com */
      --cg-bg: #FAF8F5;
      --cg-cream: #ECEEF0;
      --cg-stone: #C3C8CD;
      --cg-ink: #14202A;
      --cg-forest: #20303C;
      --cg-forest-dark: #101B24;
      --cg-clay: #A65A3B;
      --cg-line: rgba(20, 32, 42, 0.12);
    }
    .cg-body { font-family: 'Inter', system-ui, sans-serif; color: var(--cg-ink); background: var(--cg-bg); }
    .cg-display { font-family: 'Fraunces', Georgia, serif; font-weight: 500; letter-spacing: -0.02em; }
    .cg-eyebrow { font-family: 'Inter', sans-serif; letter-spacing: 0.18em; text-transform: uppercase; font-size: 11px; font-weight: 600; }
    .cg-btn-primary {
      background: var(--cg-forest); color: #fff; padding: 14px 26px; border-radius: 999px;
      font-weight: 600; font-size: 14px; letter-spacing: 0.02em; display: inline-flex; align-items: center; gap: 8px;
      transition: background .2s ease, transform .2s ease;
    }
    .cg-btn-primary:hover { background: var(--cg-forest-dark); }
    .cg-btn-ghost {
      background: transparent; color: var(--cg-ink); padding: 14px 26px; border-radius: 999px;
      font-weight: 600; font-size: 14px; letter-spacing: 0.02em; display: inline-flex; align-items: center; gap: 8px;
      border: 1px solid var(--cg-line);
      transition: background .2s ease, border-color .2s ease;
    }
    .cg-btn-ghost:hover { background: #fff; border-color: var(--cg-ink); }
    .cg-divider { height: 1px; background: var(--cg-line); }
    .cg-card { background: #fff; border: 1px solid var(--cg-line); border-radius: 18px; }
    .cg-card-hover { transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease; }
    .cg-card-hover:hover { transform: translateY(-3px); box-shadow: 0 18px 40px rgba(31,42,34,0.08); border-color: rgba(31,42,34,0.18); }
    .cg-project { position: relative; overflow: hidden; border-radius: 18px; }
    .cg-project img { transition: transform .6s ease; }
    .cg-project:hover img { transform: scale(1.05); }
    .cg-project-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(31,42,34,0) 40%, rgba(31,42,34,0.78) 100%);
    }
    .cg-link-underline { position: relative; }
    .cg-link-underline::after {
      content: ''; position: absolute; left: 0; bottom: -3px; width: 100%;
      height: 1px; background: currentColor; transform: scaleX(0); transform-origin: left;
      transition: transform .3s ease;
    }
    .cg-link-underline:hover::after { transform: scaleX(1); }
    .cg-hero { background: var(--cg-forest-dark); min-height: 100svh; }
    .cg-slide { position: absolute; inset: 0; opacity: 0; transition: opacity 1s ease; }
    .cg-slide.active { opacity: 1; }
    .cg-dot { width: 8px; height: 8px; border-radius: 999px; background: rgba(255,255,255,0.4); transition: background .3s ease, width .3s ease; }
    .cg-dot.active { background: #fff; width: 24px; }
    .cg-marquee { display: flex; gap: 28px; animation: cg-scroll 32s linear infinite; }
    @keyframes cg-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    .cg-stat-num { font-family: 'Fraunces', serif; font-size: 56px; line-height: 1; font-weight: 500; letter-spacing: -0.03em; }
    @media (max-width: 768px) { .cg-stat-num { font-size: 42px; } }

    /* Pitch ribbon */
    .cg-pitch-ribbon {
      position: fixed; bottom: 20px; right: 20px; z-index: 50;
      background: var(--cg-ink); color: #fff; border-radius: 14px;
      padding: 14px 18px; max-width: 320px;
      font-size: 13px; line-height: 1.45;
      box-shadow: 0 20px 50px rgba(0,0,0,0.25);
    }
    .cg-pitch-ribbon a { color: #fff; text-decoration: underline; }
  </style>

  <div class="cg-body">

    <!-- NAV -->
    <header class="sticky top-0 z-40 bg-[color:var(--cg-bg)]/85 backdrop-blur border-b border-[color:var(--cg-line)]">
      <div class="max-w-7xl mx-auto px-6 lg:px-10 h-20 flex items-center justify-between">
        <a href="#top" class="flex items-center" aria-label="Cherry Grove Group — home">
          <img src="/cherry-grove/CherrygroveLogo_BlackPNG.png" alt="Cherry Grove Group" class="h-14 w-auto" />
        </a>
        <nav class="hidden lg:flex items-center gap-9 text-sm font-medium">
          <a href="#services" class="cg-link-underline">Services</a>
          <a href="#about" class="cg-link-underline">About</a>
          <a href="#areas" class="cg-link-underline">Service Areas</a>
          <a href="#contact" class="cg-link-underline">Contact</a>
        </nav>
        <a href="#contact" class="cg-btn-primary text-xs">Get a Free Quote
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </header>

    <!-- HERO CAROUSEL -->
    <section id="top" class="cg-hero relative overflow-hidden flex items-center">

      <!-- ── Slides ───────────────────────────────────────────────────────
           Replace the src on each <img> with your own photo.
           Add or remove <div class="cg-slide"> blocks to change slide count.
      ─────────────────────────────────────────────────────────────────── -->
      <div id="cg-carousel" class="absolute inset-0" aria-hidden="true">

        <div class="cg-slide active">
          <img src="/cherry-grove/hero-1.avif" alt="Cherry Grove Group project" class="w-full h-full object-cover" />
        </div>
        <div class="cg-slide">
          <img src="/cherry-grove/hero-2.avif" alt="Cherry Grove Group project" class="w-full h-full object-cover" />
        </div>
        <div class="cg-slide">
          <img src="/cherry-grove/hero-3.avif" alt="Cherry Grove Group project" class="w-full h-full object-cover" />
        </div>
        <div class="cg-slide">
          <img src="/cherry-grove/hero-4.avif" alt="Cherry Grove Group project" class="w-full h-full object-cover" />
        </div>
        <div class="cg-slide">
          <img src="/cherry-grove/hero-5.avif" alt="Cherry Grove Group project" class="w-full h-full object-cover" />
        </div>
        <div class="cg-slide">
          <img src="/cherry-grove/hero-6.avif" alt="Cherry Grove Group project" class="w-full h-full object-cover" />
        </div>

        <!-- Dark overlay so text stays readable over any photo -->
        <div class="absolute inset-0" style="background: linear-gradient(160deg, rgba(31,42,34,0.72) 0%, rgba(31,42,34,0.45) 100%);"></div>
      </div>

      <!-- Content -->
      <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10 py-36 lg:py-52 text-white w-full">
        <span class="cg-eyebrow opacity-90">Greater Toronto Area · Since 2022</span>
        <h1 class="cg-display text-5xl sm:text-6xl lg:text-7xl leading-[1.05] mt-5 max-w-4xl">
          Outdoor spaces,<br/>built to last.
        </h1>
        <p class="mt-6 max-w-xl text-lg text-white/85 leading-relaxed">
          We design and build premium interlocking, patios, and natural stone work across the GTA — combining precision craftsmanship with materials that age beautifully.
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href="#contact" class="cg-btn-primary" style="background:#fff;color:var(--cg-ink);">
            Request a Consultation
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
          </a>
          <a href="#services" class="cg-btn-ghost" style="color:#fff;border-color:rgba(255,255,255,0.4);">
            Our Services
          </a>
        </div>
      </div>

      <!-- Dot indicators -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex gap-2 items-center" id="cg-dots" aria-hidden="true">
        <div class="cg-dot active"></div>
        <div class="cg-dot"></div>
        <div class="cg-dot"></div>
        <div class="cg-dot"></div>
        <div class="cg-dot"></div>
        <div class="cg-dot"></div>
      </div>

    </section>

    <!-- PARTNERS / MARQUEE -->
    <section class="border-y border-[color:var(--cg-line)] bg-[color:var(--cg-cream)]/40 overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 lg:px-10 py-14 lg:py-20 flex flex-col items-center gap-10">
        <span class="cg-eyebrow text-[color:var(--cg-forest)] text-center" style="font-size:13px;">Authorized installers for</span>
        <div class="overflow-hidden w-full">
          <div class="cg-marquee items-center">
            {[...partners, ...partners, ...partners].map((p) => (
              <div class="flex-shrink-0 rounded-2xl px-10 py-8 flex items-center justify-center h-32 w-64 bg-white border border-[color:var(--cg-line)] shadow-sm">
                <img
                  src={p.logo}
                  alt={`${p.name} — authorized installer`}
                  class="max-h-16 w-auto max-w-full object-contain"
                  style={p.mono ? 'filter: brightness(0);' : undefined}
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section id="services" class="py-24 lg:py-32">
      <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-end mb-14">
          <div class="lg:col-span-7">
            <span class="cg-eyebrow text-[color:var(--cg-forest)]">What we build</span>
            <h2 class="cg-display text-4xl lg:text-5xl mt-3 leading-[1.1]">
              Every element of your outdoor space, considered.
            </h2>
          </div>
          <div class="lg:col-span-5">
            <p class="text-base text-[color:var(--cg-ink)]/70 leading-relaxed">
              From the first cut of stone to the final wash and seal, we handle every stage of the build in-house — so the design, the engineering, and the finish all carry the same standard.
            </p>
          </div>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {services.map((s) => (
            <article class="cg-card cg-card-hover overflow-hidden cursor-pointer group">
              <!-- Photo -->
              <div class="overflow-hidden aspect-[4/3]">
                <img
                  src={s.photo}
                  alt={s.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              <!-- Info -->
              <div class="p-6">
                <div class="flex items-center gap-3 mb-3">
                  <span class="inline-flex items-center justify-center w-9 h-9 rounded-full flex-shrink-0" style="background:var(--cg-cream);">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--cg-forest)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <path d={s.icon} />
                    </svg>
                  </span>
                  <h3 class="cg-display text-xl">{s.title}</h3>
                </div>
                <p class="text-sm text-[color:var(--cg-ink)]/70 leading-relaxed">{s.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- STATS / ABOUT -->
    <section id="about" class="py-24 lg:py-32 bg-[color:var(--cg-cream)]/60 border-y border-[color:var(--cg-line)]">
      <div class="max-w-7xl mx-auto px-6 lg:px-10 grid lg:grid-cols-12 gap-12 lg:gap-20 items-center">
        <div class="lg:col-span-6">
          <span class="cg-eyebrow text-[color:var(--cg-forest)]">About us</span>
          <h2 class="cg-display text-4xl lg:text-5xl mt-3 leading-[1.1]">
            Transforming outdoor spaces since 2022.
          </h2>
          <p class="mt-6 text-[color:var(--cg-ink)]/75 leading-relaxed">
            Cherry Grove Group has been transforming residential and commercial properties with expert interlocking and landscaping services since 2022. Our mission is to create stunning, functional outdoor spaces that enhance your property's beauty and comfort. Whether you're looking to upgrade your driveway, design a backyard oasis, or build a custom walkway, our skilled team is here to bring your vision to life.
          </p>
          <p class="mt-4 text-[color:var(--cg-ink)]/75 leading-relaxed">
            We proudly serve homeowners and businesses across Markham, Toronto, Durham Region, and Simcoe Region, delivering high-quality craftsmanship and tailored landscaping solutions. From concept to completion, we focus on precision, durability, and aesthetics — ensuring your outdoor space is not only visually appealing but also built to last.
          </p>
          <div class="mt-10 grid grid-cols-3 gap-6">
            <div>
              <div class="cg-stat-num text-[color:var(--cg-forest)]">2022</div>
              <p class="text-xs uppercase tracking-wider text-[color:var(--cg-ink)]/60 mt-2">Founded</p>
            </div>
            <div>
              <div class="cg-stat-num text-[color:var(--cg-forest)]">5+</div>
              <p class="text-xs uppercase tracking-wider text-[color:var(--cg-ink)]/60 mt-2">Premium material partners</p>
            </div>
            <div>
              <div class="cg-stat-num text-[color:var(--cg-forest)]">10+</div>
              <p class="text-xs uppercase tracking-wider text-[color:var(--cg-ink)]/60 mt-2">Municipalities served</p>
            </div>
          </div>
        </div>
        <div class="lg:col-span-6 grid grid-cols-2 gap-4">
          <div class="cg-project aspect-[3/4]">
            <img src="/cherry-grove/about-1.avif" alt="Cherry Grove Group project" class="w-full h-full object-cover" />
          </div>
          <div class="cg-project aspect-[3/4] mt-10">
            <img src="/cherry-grove/about-2.avif" alt="Cherry Grove Group project" class="w-full h-full object-cover" />
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS -->
    <section class="py-24 lg:py-32">
      <div class="max-w-7xl mx-auto px-6 lg:px-10">

        <div class="text-center mb-14">
          <span class="cg-eyebrow text-[color:var(--cg-forest)]">What our clients say</span>
          <h2 class="cg-display text-4xl lg:text-5xl mt-3 leading-[1.1]">Trusted across the GTA.</h2>
        </div>

        <div class="grid md:grid-cols-3 gap-6 items-start">

          <!-- Review 1 -->
          <article class="cg-card p-7 flex flex-col gap-4">
            <div class="flex gap-1">
              {[...Array(5)].map(() => (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--cg-forest)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              ))}
            </div>
            <div>
              <p class="font-semibold text-[color:var(--cg-ink)] text-sm">Denis Lan</p>
              <p class="cg-eyebrow text-[color:var(--cg-ink)]/45 mt-0.5">Review left on 20 Jul 2023</p>
            </div>
            <h3 class="cg-display text-lg text-[color:var(--cg-ink)]">Interlocks for Walkway</h3>
            <p class="text-sm text-[color:var(--cg-ink)]/70 leading-relaxed">
              I recently had the pleasure of hiring Cherry Grove Group to install interlocks for my walkway, and I couldn't be happier with the results! Their team of three skilled professionals transformed my walkway into a stunning and functional space. From the moment I contacted Cherry Grove Group, their customer service was outstanding. When it came to the installation process, the team demonstrated exceptional craftsmanship and attention to detail. They also worked efficiently and neatly, leaving my property clean and tidy after completing the project. Their dedication to delivering the project within the agreed timeframe and budget made the entire experience stress-free and transparent. I wholeheartedly recommend Cherry Grove Group — their team of experts will undoubtedly transform your space and leave you with a smile on your face.
            </p>
          </article>

          <!-- Review 2 -->
          <article class="cg-card p-7 flex flex-col gap-4">
            <div class="flex gap-1">
              {[...Array(5)].map(() => (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--cg-forest)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              ))}
            </div>
            <div>
              <p class="font-semibold text-[color:var(--cg-ink)] text-sm">Customer of Cherry Grove Group</p>
              <p class="cg-eyebrow text-[color:var(--cg-ink)]/45 mt-0.5">Review left on 22 Sep 2023</p>
            </div>
            <h3 class="cg-display text-lg text-[color:var(--cg-ink)]">Exceptional Driveway renovation/Extension</h3>
            <p class="text-sm text-[color:var(--cg-ink)]/70 leading-relaxed">
              I recently had the pleasure of experiencing the professional expertise of Cherry Grove Group for a driveway extension project, and the results exceeded all expectations. The communication throughout the project was outstanding — prompt, courteous, and attentive. Their collaborative approach ensured that the final design perfectly complemented my home's aesthetic. The craftsmanship was truly exceptional, with the newly extended portion seamlessly blending with the existing driveway. Not only did they deliver on aesthetics, but they also prioritized functionality — the grading and drainage solutions have proven highly effective. The project was completed within the promised timeframe, and they went above and beyond to exceed my expectations.
            </p>
          </article>

          <!-- Review 3 -->
          <article class="cg-card p-7 flex flex-col gap-4">
            <div class="flex gap-1">
              {[...Array(5)].map(() => (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--cg-forest)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              ))}
            </div>
            <div>
              <p class="font-semibold text-[color:var(--cg-ink)] text-sm">Customer of Cherry Grove Group</p>
              <p class="cg-eyebrow text-[color:var(--cg-ink)]/45 mt-0.5">Review left on 2 Oct 2024</p>
            </div>
            <h3 class="cg-display text-lg text-[color:var(--cg-ink)]">Backyard patio, steps, walkway, and fence replacement</h3>
            <p class="text-sm text-[color:var(--cg-ink)]/70 leading-relaxed">
              My wife and I selected Cherry Grove Group for our first major home project after our initial meeting with Dominic. He stood out after we met with 5 different contractors, based on his communication skills and expertise. He provided competitively priced quotes and digital renderings which helped us visualize the project and finalize our design choices. Dominic and his team were friendly, passionate, accommodating, and showed attention to details. They expertly transformed our 20+ year old decrepit backyard into the modern, functional space we envisioned — it truly exceeded our expectations! We trust and recommend Dominic to deliver high quality work, and look forward to hiring Cherry Grove Group again for our future front yard project.
            </p>
          </article>

        </div>
      </div>
    </section>

    <!-- SERVICE AREAS -->
    <section id="areas" class="py-24 lg:py-32 bg-[color:var(--cg-cream)]/60 border-y border-[color:var(--cg-line)]">
      <div class="max-w-7xl mx-auto px-6 lg:px-10 grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">

        <!-- Left: copy -->
        <div class="lg:col-span-5">
          <span class="cg-eyebrow text-[color:var(--cg-forest)]">Where we work</span>
          <h2 class="cg-display text-4xl lg:text-5xl mt-3 leading-[1.1]">
            Serving the Greater Toronto Area.
          </h2>
          <p class="mt-6 text-[color:var(--cg-ink)]/75 leading-relaxed">
            From Toronto through Markham, Durham Region, and into Simcoe — if you can drive to it from the 401, we can build there. Not sure if you're in range? Just ask.
          </p>

          <!-- Area pills -->
          <div class="mt-8 flex flex-wrap gap-2">
            {serviceAreas.map((a) => (
              <span class="px-4 py-2 rounded-full bg-white border border-[color:var(--cg-line)] text-sm font-medium text-[color:var(--cg-ink)]/80">{a}</span>
            ))}
          </div>

          <a href="#contact" class="cg-btn-primary mt-8 inline-flex">Check Your Address →</a>
        </div>

        <!-- Right: map -->
        <div class="lg:col-span-7">
          <div class="rounded-2xl overflow-hidden border border-[color:var(--cg-line)] bg-white shadow-sm">
            <img
