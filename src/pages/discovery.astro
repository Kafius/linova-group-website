---
import Layout from '../layouts/Layout.astro';

// After booking, redirect to /thank-you-booked:
//   Calendly dashboard → Event Settings → Confirmation Page
//   → "Redirect to an external site" → https://yourdomain.com/thank-you-booked
const CALENDLY_URL = 'https://calendly.com/ddeleon-thelinovagroup/30min';
---

<Layout
  title="Book a Free Discovery Call — Linova Group"
  description="We build premium, high-converting websites for B2B businesses in 1–2 weeks, without the inflated agency price tag. Book a free discovery call."
>

  <!-- ─── Minimal header: logo only, no nav links ─── -->
  <header class="fixed top-4 inset-x-0 z-[1000] px-4 sm:px-6 pointer-events-none">
    <div
      class="max-w-[1140px] mx-auto bg-white/95 backdrop-blur-md rounded-2xl border border-border px-5 flex items-center h-[64px] pointer-events-auto"
      style="box-shadow: 0 4px 24px rgba(0,0,0,0.07);"
    >
      <a href="/" class="flex items-center cursor-pointer">
        <img src="/linova-logo-horizontal.png" alt="Linova Group" width="176" height="44" class="h-11 w-auto" />
      </a>
    </div>
  </header>

  <!-- ─── Hero: headline + subhead + proof ─── -->
  <section
    class="relative pt-32 pb-16 overflow-hidden text-white"
    style="background: radial-gradient(ellipse at 50% 50%, #2a2b6e 0%, #1a1b4b 45%, #16172f 100%);"
  >
    <!-- Dot grid -->
    <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle, #ffffff 1px, transparent 1px); background-size: 30px 30px;"></div>

    <!-- Aurora layers -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[500px] rounded-full pointer-events-none" style="background: radial-gradient(ellipse, rgba(109,40,217,0.22) 0%, transparent 70%); filter: blur(80px);"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[700px] rounded-full pointer-events-none" style="background: radial-gradient(ellipse, transparent 30%, rgba(20,184,166,0.12) 55%, transparent 75%); filter: blur(60px);"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[1200px] h-[900px] rounded-full pointer-events-none" style="background: radial-gradient(ellipse, transparent 40%, rgba(59,130,246,0.1) 65%, transparent 80%); filter: blur(70px);"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[300px] rounded-full pointer-events-none" style="background: radial-gradient(ellipse, rgba(139,92,246,0.18) 0%, transparent 70%); filter: blur(50px);"></div>

    <div class="relative max-w-[760px] mx-auto px-6 w-full text-center">

      <!-- Eyebrow badge -->
      <div class="inline-flex items-center gap-2 bg-white/10 border border-white/15 text-white/75 text-xs font-semibold tracking-[0.15em] uppercase px-4 py-2 rounded-full mb-8 backdrop-blur-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-400 inline-block"></span>
        Free 30-Minute Discovery Call
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-extrabold tracking-tight leading-[1.07] mb-5">
        Your Business Is Polished.<br />
        <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(90deg, #93c5fd, #a5b4fc);">Your Website Should Be Too.</span>
      </h1>

      <p class="text-lg sm:text-xl text-white/60 max-w-[580px] mx-auto mb-10 leading-relaxed font-medium">
        We build premium, high-converting websites for B2B businesses in 1–2 weeks, without the inflated agency price tag.
      </p>

    </div>
  </section>

  <!-- ─── Two-column: Sound Familiar (left) + Calendly sticky (right) ─── -->
  <section class="py-20 text-white border-t border-white/[0.06]" style="background: #16172f;" id="book">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-12 xl:gap-20 items-start">

        <!-- Left: Problems we solve -->
        <div>
          <h2 class="text-3xl lg:text-4xl font-bold text-white mb-3 tracking-tight">
            Sound familiar?
          </h2>
          <p class="text-white/55 text-lg mb-10 leading-relaxed">
            These are the things B2B business owners tell us are holding them back online.
          </p>

          <div class="flex flex-col gap-5">

            <div class="flex gap-5 items-start p-6 rounded-2xl border border-white/10 bg-white/[0.05]">
              <div class="w-10 h-10 min-w-[2.5rem] rounded-xl bg-white/10 text-white/70 flex items-center justify-center">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
              </div>
              <div>
                <p class="font-bold text-white text-base mb-1">Your website is sending prospects elsewhere.</p>
                <p class="text-white/55 text-sm leading-relaxed">An outdated design, slow load times, or a site that hasn't changed in years tells buyers you might not be keeping up in other areas either — before you've said a word.</p>
              </div>
            </div>

            <div class="flex gap-5 items-start p-6 rounded-2xl border border-white/10 bg-white/[0.05]">
              <div class="w-10 h-10 min-w-[2.5rem] rounded-xl bg-white/10 text-white/70 flex items-center justify-center">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
              </div>
              <div>
                <p class="font-bold text-white text-base mb-1">Every agency quote feels like a small mortgage.</p>
                <p class="text-white/55 text-sm leading-relaxed">Five-figure proposals, months of back-and-forth, and a final product that still doesn't feel like yours. There's a better way.</p>
              </div>
            </div>

            <div class="flex gap-5 items-start p-6 rounded-2xl border border-white/10 bg-white/[0.05]">
              <div class="w-10 h-10 min-w-[2.5rem] rounded-xl bg-white/10 text-white/70 flex items-center justify-center">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
              </div>
              <div>
                <p class="font-bold text-white text-base mb-1">Traffic shows up. Clients don't.</p>
                <p class="text-white/55 text-sm leading-relaxed">A site that looks fine but doesn't clearly communicate what you do, who you serve, and what to do next is just an expensive digital brochure.</p>
              </div>
            </div>

          </div>
        </div>

        <!-- Right: Calendly embed (sticky on desktop) -->
        <div class="lg:sticky lg:top-[88px]" id="calendly-wrapper">
          <p class="text-sm font-semibold text-white/70 mb-3">Pick a time that works for you —</p>
          <div class="overflow-x-hidden rounded-2xl border border-white/15">
            <div
              class="calendly-inline-widget"
              data-url={CALENDLY_URL}
              data-resize="true"
            ></div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── Secondary CTA: contact form fallback ─── -->
  <section class="py-24 bg-[#f8fafc]" id="contact">
    <div class="max-w-[640px] mx-auto px-6">

      <h2 class="text-3xl font-bold text-dark text-center mb-3 tracking-tight">
        Not ready to book? Send us a message and we'll follow up.
      </h2>
      <p class="text-center text-muted mb-12">
        Leave your details and we'll reach out within one business day.
      </p>

      <div id="discoveryFormError" class="hidden mb-4 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm font-medium">
        Something went wrong. Please try again or email us directly.
      </div>

      <form id="discoveryContactForm" class="flex flex-col gap-4" novalidate>

        <div class="flex flex-col sm:flex-row gap-4">
          <div class="flex flex-col gap-1.5 w-full">
            <label for="dc-name" class="text-sm font-semibold text-dark">
              Name <span class="text-red-400" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="dc-name"
              name="name"
              placeholder="Jane Smith"
              required
              class="w-full px-4 py-3.5 rounded-lg border border-border bg-white text-dark font-sans text-[0.95rem] placeholder:text-muted/50 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all duration-200"
            />
          </div>
          <div class="flex flex-col gap-1.5 w-full">
            <label for="dc-email" class="text-sm font-semibold text-dark">
              Work Email <span class="text-red-400" aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="dc-email"
              name="email"
              placeholder="jane@company.com"
              required
              class="w-full px-4 py-3.5 rounded-lg border border-border bg-white text-dark font-sans text-[0.95rem] placeholder:text-muted/50 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all duration-200"
            />
          </div>
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="dc-company" class="text-sm font-semibold text-dark">Company Name</label>
          <input
            type="text"
            id="dc-company"
            name="company"
            placeholder="Acme Inc."
            class="w-full px-4 py-3.5 rounded-lg border border-border bg-white text-dark font-sans text-[0.95rem] placeholder:text-muted/50 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all duration-200"
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="dc-message" class="text-sm font-semibold text-dark">
            What's your biggest challenge online?
          </label>
          <textarea
            id="dc-message"
            name="message"
            rows="4"
            placeholder="Tell us what's holding your business back..."
            class="w-full px-4 py-3.5 rounded-lg border border-border bg-white text-dark font-sans text-[0.95rem] placeholder:text-muted/50 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all duration-200 resize-y"
          ></textarea>
        </div>

        <button
          type="submit"
          id="discoverySubmitBtn"
          class="self-center inline-flex items-center justify-center gap-2 px-9 py-4 rounded-xl font-semibold text-[1.05rem] bg-primary text-white hover:bg-primary-hover hover:-translate-y-0.5 hover:shadow-[0_8px_28px_rgba(38,39,94,0.3)] transition-all duration-200 disabled:opacity-60 disabled:cursor-not-allowed disabled:translate-y-0 disabled:shadow-none cursor-pointer min-h-[52px]"
        >
          Send Message
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>

      </form>
    </div>
  </section>

  <!-- ─── Minimal footer ─── -->
  <footer class="py-8 border-t border-border bg-white">
    <div class="max-w-[1140px] mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <a href="/" class="flex items-center">
        <img src="/linova-logo-horizontal.png" alt="Linova Group" width="140" height="35" class="h-9 w-auto opacity-60 hover:opacity-100 transition-opacity duration-200" />
      </a>
      <p class="text-muted text-sm">© {new Date().getFullYear()} Linova Group. All rights reserved.</p>
    </div>
  </footer>

</Layout>

<style>
  /* Calendly embed — data-resize lets the iframe grow to fit content.
     min-height is the fallback before the widget script fires. */
  .calendly-inline-widget {
    min-width: 320px;
    width: 100%;
    min-height: 900px;
  }
  @media (max-width: 640px) {
    .calendly-inline-widget {
      min-height: 750px;
    }
  }
</style>

<!-- Calendly widget script (deferred so it doesn't block initial paint) -->
<script is:inline defer src="https://assets.calendly.com/assets/external/widget.js"></script>

<script>
  // Contact form → Formspree → redirect to /thank-you-contacted on success.
  const FORMSPREE_ID = 'xeepbppp';

  const form = document.getElementById('discoveryContactForm') as HTMLFormElement | null;
  const btn  = document.getElementById('discoverySubmitBtn')  as HTMLButtonElement | null;
  const err  = document.getElementById('discoveryFormError')  as HTMLElement | null;

  const BTN_DEFAULT_HTML = btn?.innerHTML ?? '';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!btn || !err) return;

    btn.disabled    = true;
    btn.textContent = 'Sending…';
    err.classList.add('hidden');

    try {
      const res = await fetch(`https://formspree.io/f/${FORMSPREE_ID}`, {
        method:  'POST',
        body:    new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        window.location.href = '/thank-you-contacted';
      } else {
        throw new Error('non-ok');
      }
    } catch {
      btn.disabled  = false;
      btn.innerHTML = BTN_DEFAULT_HTML;
      err.classList.remove('hidden');
    }
  });
</script>
