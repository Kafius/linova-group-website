---
// /thank-you-booked — where Calendly's confirmation redirect lands after a
// booking (event settings → confirmation page), including bookings made in
// the /book embed. Noindexed and kept out of the sitemap: a confirmation page
// has nothing to offer search.
import BaseLayout from '../layouts/BaseLayout.astro';

const steps: [string, string][] = [
  ['Calendar invite', 'A confirmation email with the meeting link is already on its way.'],
  ['No prep needed', 'Bring your goals and whatever you want to ask about the site you have now.'],
  ['Twenty minutes', 'The business, where the openings are, and a straight read on what we would build.'],
  ['A written answer', 'A short summary and a clear proposal, within one business day of the call.'],
];
---

<BaseLayout
  title="You're booked — The Linova Group"
  description="Your call is confirmed. Here's what happens between now and then."
  noindex
>
  <div class="plot-grid">
    <header class="mx-auto max-w-[1000px] px-6 pb-10 pt-24">
      <p class="label-caps">call confirmed</p>
      <h1 class="mt-4 max-w-[14ch] font-display text-display text-film">
        You're booked<span class="text-redline">.</span>
      </h1>
      <p class="mt-5 max-w-[52ch] text-body text-film-dim">
        Check your inbox for the invite. Here's what happens between now and
        the call.
      </p>
    </header>
  </div>

  <div class="mx-auto max-w-[1000px] px-6 pb-24">
    <ol class="m-0 grid list-none gap-px border border-grid/40 bg-grid/40 p-0 md:grid-cols-2">
      {steps.map(([title, detail], i) => (
        <li class="bg-navy p-6">
          <p class="label-caps m-0">{String(i + 1).padStart(2, '0')}</p>
          <p class="m-0 mt-3 text-body font-medium text-film">{title}</p>
          <p class="m-0 mt-2 text-caption text-film-dim">{detail}</p>
        </li>
      ))}
    </ol>

    <div class="mt-16">
      <p class="label-caps">while you wait</p>
      <a
        href="/work"
        class="mt-3 inline-block font-display text-title text-film no-underline transition-colors hover:text-gold"
      >
        See the work<span class="text-gold">.</span>
      </a>
      <p class="mt-4 max-w-[52ch] text-caption text-film-dim">
        Every study is a live site with real customers on it. Open one on your
        phone before we talk.
      </p>
    </div>
  </div>
</BaseLayout>
