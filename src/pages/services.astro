---
// /services — the five groups, each tagged by the engine that delivers it.
// Marketing and social carry the same weight as web (brief §1).
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
import { emphasize } from '../lib/emphasis';
import PartsList from '../components/features/PartsList.astro';
import ServiceMosaic from '../components/services/ServiceMosaic.astro';
import { breadcrumbs, service as serviceJsonLd } from '../lib/jsonld';

---

<BaseLayout
  title="Services — The Linova Group"
  description="Web design and development, marketing strategy, social media and content, brand design, and ongoing support — machine-fast builds, human-real marketing."
  jsonLd={[
    ...services.map((s) => serviceJsonLd(s.name, s.deck, s.slug)),
    breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Services', path: '/services' }]),
  ]}
>
  <div class="plot-grid">
    <header class="mx-auto max-w-[1200px] px-6 pb-10 pt-24">
      <p class="label-caps">services</p>
      <h1 class="mt-4 max-w-[18 ch] font-display text-display text-film">
        You are good at what you do. Let's keep it that way.
      </h1>
      <p class="mt-5 max-w-[58ch] text-body text-film-dim">
        Your job should be delivering the high quality product or outstanding service to your clients and customers.
        Leave the website, marketing, and content to us.
      </p>
    </header>
  </div>

  <div class="mx-auto max-w-[1200px] px-6 pb-24">
    <ul class="m-0 list-none border-t border-grid/40 p-0">
      {services.map((svc, i) => (
        <li id={svc.slug} class="grid gap-8 border-b border-grid/40 py-12 lg:grid-cols-2 lg:gap-16">
          {/* The mosaic swaps sides down the page. Five stacked rows with the
              pictures all down one edge reads as a column of images next to a
              column of text; alternating makes each group its own spread.
              Order only — in the DOM the words still come first, so the
              reading order and the tab order stay unchanged. */}
          <div class:list={[i % 2 === 1 && 'lg:order-2']}>
            <h2 class="mt-3 font-display text-title text-film">{svc.name}</h2>
            {/* The gold hairline runs under every group. It used to be held
                back from the human-engine ones so a redline marker could sit
                under their names instead — four marked headings on one page,
                against the one-redline-per-viewport law, and it read as noise.
                The engine label above the heading carries that distinction. */}
            <hr class="rule-gold mt-4 max-w-[120px]" />
            <p class="mt-5 max-w-[52ch] text-body text-film-dim" set:html={emphasize(svc.deck, svc.keywords)} />

            <ul class="m-0 mt-8 flex list-none flex-col gap-3 p-0">
              {svc.deliverables.map((item) => (
                <li class="flex items-baseline gap-3 text-caption text-film-dim">
                  <span class="label-caps shrink-0" aria-hidden="true">—</span>
                  <span set:html={emphasize(item, svc.keywords)} />
                </li>
              ))}
            </ul>
          </div>

          <div class:list={['self-center', i % 2 === 1 && 'lg:order-1']}>
            <ServiceMosaic photos={svc.photos} />
          </div>
        </li>
      ))}
    </ul>

    <!-- The full parts list the homepage only previews. Sits after the five
         service groups: by here a reader has decided they want detail. -->
    <div class="border-t border-grid/40 pt-16">
      <PartsList />
    </div>

    <div class="pt-16">
      <p class="label-caps">where to start</p>
      <a href="/book" class="mt-4 inline-block font-display text-display text-film no-underline transition-colors hover:text-gold">
        Book a call<span class="text-redline">.</span>
      </a>
      <p class="mt-4 max-w-[52ch] text-body text-film-dim">
        Not sure which half you need? That's normal — most projects need both.
        Bring the problem; we'll sort the engines.
      </p>
    </div>
  </div>
</BaseLayout>
