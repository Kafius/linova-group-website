---
// /services — the five groups, each tagged by the engine that delivers it.
// Marketing and social carry the same weight as web (brief §1).
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
import { breadcrumbs, service as serviceJsonLd } from '../lib/jsonld';

const engineLabel = {
  machine: 'the build system',
  human: 'the marketing team',
  both: 'both engines',
} as const;
---

<BaseLayout
  title="Services — The Linova Group"
  description="Web design and development, marketing strategy, social media and content, brand design, and ongoing support — machine-fast builds, human-real marketing."
  jsonLd={[
    ...services.map((s) => serviceJsonLd(s.name, s.deck, s.slug)),
    breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Services', path: '/services' }]),
  ]}
>
  <div class="plot-grid">
    <header class="mx-auto max-w-[1200px] px-6 pb-10 pt-24">
      <p class="label-mono">services · two engines</p>
      <h1 class="mt-4 max-w-[18ch] font-display text-display text-film">
        The machine builds. The humans market.
      </h1>
      <p class="mt-5 max-w-[58ch] text-body text-film-dim">
        Every service below is tagged with the engine that delivers it — the
        AI-implemented build system, the marketing team in the Philippines,
        or both working the same project.
      </p>
      <div class="mt-8 flex flex-wrap gap-x-8 gap-y-2" aria-hidden="true">
        <span class="label-mono"><span class="mr-2 inline-block h-px w-6 bg-gold align-middle"></span>machine — the plotter's line</span>
        <span class="label-mono text-redline"><span class="mr-2 inline-block h-[3px] w-6 bg-redline align-middle"></span>human — the marker</span>
      </div>
    </header>
  </div>

  <div class="mx-auto max-w-[1200px] px-6 pb-24">
    <ul class="m-0 list-none border-t border-grid/40 p-0">
      {services.map((svc) => (
        <li id={svc.slug} class="grid gap-6 border-b border-grid/40 py-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-16">
          <div>
            <p class="label-mono" class:list={[svc.engine === 'human' ? 'text-redline' : '']}>
              {engineLabel[svc.engine]}
            </p>
            <h2 class="mt-3 font-display text-title text-film">
              <span
                class:list={[
                  svc.engine === 'human' || svc.engine === 'both' ? 'marker-u' : '',
                ]}
              >{svc.name}</span>
            </h2>
            {svc.engine !== 'human' && <hr class="rule-gold mt-4 max-w-[120px]" />}
            <p class="mt-5 max-w-[52ch] text-body text-film-dim">{svc.deck}</p>
          </div>
          <ul class="m-0 flex list-none flex-col gap-3 self-center p-0">
            {svc.deliverables.map((item) => (
              <li class="flex items-baseline gap-3 text-caption text-film-dim">
                <span class="label-mono shrink-0" aria-hidden="true">—</span>
                {item}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>

    <div class="pt-16">
      <p class="label-mono">where to start</p>
      <a href="/book" class="mt-4 inline-block font-display text-display text-film no-underline transition-colors hover:text-gold">
        Book a call<span class="text-redline">.</span>
      </a>
      <p class="mt-4 max-w-[52ch] text-body text-film-dim">
        Not sure which half you need? That's normal — most projects need both.
        Bring the problem; we'll sort the engines.
      </p>
    </div>
  </div>
</BaseLayout>
