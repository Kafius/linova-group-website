---
// /work — the case-study index, set like a section front: masthead, section
// rail, one lead story, then the rest newest-first. Content is Sanity at
// build time, seeds until the project has documents (see lib/caseStudies).
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionRail from '../../components/shell/SectionRail.astro';
import StoryGrid from '../../components/work/StoryGrid.astro';
import { fetchCaseStudies, workSections } from '../../lib/caseStudies';
import { breadcrumbs, itemList } from '../../lib/jsonld';

const studies = await fetchCaseStudies();
const sections = workSections(studies);

const railItems = [
  { label: 'all', href: '/work', count: studies.length },
  ...sections.map((s) => ({ label: s.name, href: s.href, count: s.count, accent: s.accent })),
];

const latest = studies[0]?.publishedAt;
// UTC to match the datelines on the stories themselves (see StoryGrid).
const latestDate = latest
  ? new Intl.DateTimeFormat('en-CA', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(new Date(latest))
  : '';
---

<BaseLayout
  title="Work — The Linova Group"
  description="Case studies from the Linova build system: live sites for contractors, restaurants, suppliers, schools, and transport companies across Ontario."
  jsonLd={[
    breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Work', path: '/work' }]),
    itemList(
      'Linova case studies',
      studies.map((study) => ({ name: study.title, path: `/work/${study.slug}` })),
    ),
  ]}
>
  <div class="plot-grid">
    <header class="mx-auto max-w-[1200px] px-6 pb-10 pt-24">
      <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
        <p class="label-mono">selected work</p>
        <p class="label-mono" style="color: var(--color-film-dim)">
          {studies.length} filed{latestDate && ` · latest ${latestDate}`}
        </p>
      </div>
      <h1 class="mt-4 max-w-[16ch] font-display text-display text-film">
        The receipts.
      </h1>
      <p class="mt-5 max-w-[52ch] text-body text-film-dim">
        Every study is a live site with real customers on it. Open one on your
        phone — speed is the first thing we'd check.
      </p>
    </header>
  </div>

  <SectionRail label="Case study sections" active="/work" items={railItems} />

  <div class="mx-auto max-w-[1200px] px-6 pb-28 pt-12">
    <StoryGrid studies={studies} />
  </div>
</BaseLayout>
