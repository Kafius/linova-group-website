---
// /lp/[campaign]/thanks — the conversion page. Confirms in the CTA's own
// words, then offers the call as the immediate next step (Calendly inline,
// prefilled). Booking fires Schedule to both pixel and CAPI with a matched
// event_id.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { campaigns, type Campaign } from '../../../data/campaigns';

export function getStaticPaths() {
  return campaigns
    .filter((c) => c.active)
    .map((campaign) => ({ params: { campaign: campaign.slug }, props: { campaign } }));
}

interface Props {
  campaign: Campaign;
}

const { campaign } = Astro.props;
const calendlyEvent =
  (import.meta.env.PUBLIC_CALENDLY_EVENT as string | undefined) ||
  'ddeleon-thelinovagroup/30min';
const calendlyUrl = `https://calendly.com/${calendlyEvent}`;
---

<BaseLayout title={`${campaign.thanksHeadline} — The Linova Group`} description={campaign.thanksBody} noindex chrome={false}>
  <div class="plot-grid min-h-svh">
    <div class="mx-auto flex max-w-[640px] flex-col px-5 pb-16 pt-8">
      <p class="m-0 font-display text-2xl text-film" aria-label="The Linova Group">
        Linova<span class="text-gold">/</span>
      </p>

      <p class="label-mono mt-10">✓ received</p>
      <h1 class="mt-3 font-display text-title text-film">{campaign.thanksHeadline}</h1>
      <p class="mt-4 text-body text-film-dim">{campaign.thanksBody}</p>

      {calendlyUrl ? (
        <div
          class="calendly-host mt-8 border border-grid/40 bg-film"
          data-calendly-url={calendlyUrl}
          style="min-width: 300px; height: 700px;"
        >
          <p class="p-6 text-caption text-navy">Loading the calendar…</p>
        </div>
      ) : (
        <p class="mt-8 border border-grid/40 p-5 text-caption text-film-dim">
          Watch your inbox — the reply comes from a person, within one
          business day.
        </p>
      )}
    </div>
  </div>

  {calendlyUrl && (
    <script is:inline>
      (function () {
        var host = document.querySelector('[data-calendly-url]');
        if (!host) return;
        var params = new URLSearchParams(location.search);
        var prefill = new URLSearchParams();
        if (params.get('name')) prefill.set('name', params.get('name'));
        if (params.get('email')) prefill.set('email', params.get('email'));
        var url = host.getAttribute('data-calendly-url') + (prefill.toString() ? '?' + prefill.toString() : '');

        var s = document.createElement('script');
        s.src = 'https://assets.calendly.com/assets/external/widget.js';
        s.async = true;
        s.onload = function () {
          host.innerHTML = '';
          window.Calendly.initInlineWidget({ url: url, parentElement: host });
        };
        document.head.appendChild(s);

        window.addEventListener('message', function (e) {
          if (e.data && e.data.event === 'calendly.event_scheduled') {
            var eventId = (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : String(Math.random()).slice(2);
            if (window.fbq) window.fbq('track', 'Schedule', {}, { eventID: eventId });
            fetch('/api/capi', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                event_name: 'Schedule', event_id: eventId,
                email: params.get('email') || '', url: location.href,
              }),
            }).catch(function () {});
            if (window.linovaTrack) window.linovaTrack('calendly_scheduled', { source: 'lp' });
          }
        });
      })();
    </script>
  )}
</BaseLayout>
