  <script is:inline>
    const ham = document.getElementById('at-ham');
    const menu = document.getElementById('at-mob-menu');
    const overlay = document.getElementById('at-mob-overlay');
    function openMenu() {
      ham.classList.add('active');
      menu.classList.add('active');
      overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
    function closeMenu() {
      ham.classList.remove('active');
      menu.classList.remove('active');
      overlay.classList.remove('active');
      document.body.style.overflow = '';
    }
    ham.addEventListener('click', () => menu.classList.contains('active') ? closeMenu() : openMenu());
    overlay.addEventListener('click', closeMenu);
    document.querySelectorAll('#at-mob-menu a').forEach(a => a.addEventListener('click', closeMenu));
  </script>

