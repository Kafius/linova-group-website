---

<ATFinancialPitchLayout
  title="A.T. Financial Group — Preview"
  description="Specialized insurance and wealth advisory for physicians, dentists, and the corporations they build."
  fontsHref="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@300;400;500;600;700;800&family=Barlow:wght@300;400;500;600;700&display=swap"
>
  <style is:global>
    /* Cap card */
    .at-cap {
      position: relative; padding: 28px 32px;
      border-right: 1px solid var(--color-soft-deep); border-bottom: 1px solid var(--color-soft-deep);
      background: var(--color-paper); border-top: 3px solid transparent;
      transition: border-top-color 0.25s, background 0.25s; min-height: 220px; overflow: hidden;
    }
    .at-cap:hover { border-top-color: var(--color-accent); background: var(--color-soft); }

    /* Market card */
    .at-market-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(10,10,10,0.95) 0%, rgba(10,10,10,0.4) 50%, rgba(10,10,10,0.1) 100%);
      transition: background 0.3s;
    }
    .at-market:hover .at-market-overlay {
      background: linear-gradient(to top, rgba(174,0,36,0.92) 0%, rgba(174,0,36,0.3) 50%, rgba(10,10,10,0.1) 100%);
    }

    /* Hero animations */
    .at-anim { opacity: 0; animation: fadeUp 0.9s forwards; }
    .at-anim-1 { animation-delay: 0.1s; }
    .at-anim-2 { animation-delay: 0.25s; }
    .at-anim-3 { animation-delay: 0.4s; }
    .at-anim-4 { animation-delay: 0.55s; }

    /* Portrait accent block */
    .at-portrait::after {
      content: ''; position: absolute; bottom: -20px; right: -20px;
      width: 120px; height: 120px; background: var(--color-accent); z-index: -1;
    }

    /* Marquee ticker */
    .at-ticker-track {
      display: flex; gap: 56px; width: max-content;
      animation: marqueeScroll 40s linear infinite;
    }
    .at-ticker-item {
      display: inline-flex; align-items: center; gap: 56px;
      font-family: var(--font-display); font-weight: 600;
      font-size: 22px; letter-spacing: 4px; text-transform: uppercase; white-space: nowrap;
    }
    @media (max-width: 768px) {
      .at-ticker-track { gap: 36px; }
      .at-ticker-item { gap: 36px; font-size: 1rem; letter-spacing: 2px; }
      .at-ticker-item::after { margin-left: 36px; }
    }
    .at-ticker-item::after { content: '◆'; color: var(--color-accent); font-size: 14px; }

    /* Partners marquee */
    .at-pscroll-track {
      display: flex; align-items: center; list-style: none; margin: 0; padding: 0;
      width: max-content; animation: marqueeScroll 10s linear infinite;
    }
    .at-partners-wrap {
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to right, transparent 0, black 80px, black calc(100% - 80px), transparent 100%);
              mask-image: linear-gradient(to right, transparent 0, black 80px, black calc(100% - 80px), transparent 100%);
    }

    @media (prefers-reduced-motion: reduce) { .at-ticker-track, .at-pscroll-track { animation: none; } }

    /* CTA watermark */
    .at-watermark {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
      font-family: var(--font-display); font-weight: 800;
      font-size: clamp(220px, 30vw, 460px); letter-spacing: -8px;
      color: rgba(255,255,255,0.07); pointer-events: none; user-select: none;
      line-height: 1; white-space: nowrap;
    }

    /* Hamburger */
    .at-ham span { display: block; width: 26px; height: 2px; background: var(--color-ink); transition: all 0.3s; }
    .at-ham.active span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .at-ham.active span:nth-child(2) { opacity: 0; }
    .at-ham.active span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* Mobile menu */
    .at-mob-menu { transform: translateX(100%); transition: transform 400ms cubic-bezier(0.7,0,0.3,1); }
    .at-mob-menu.active { transform: translateX(0); }
    .at-mob-overlay { opacity: 0; pointer-events: none; transition: opacity 300ms; }
    .at-mob-overlay.active { opacity: 1; pointer-events: auto; }

    details > summary::-webkit-details-marker { display: none; }
  </style>

  <!-- TOP BAR -->
  <div class="bg-[#0A0A0A] text-[#BCBCBC] text-[13px] tracking-[0.3px] py-[10px] border-b border-[#2A2A2A] max-md:hidden">
    <div class="container-x flex items-center justify-between gap-7 flex-wrap">
      <div class="flex items-center gap-7 flex-wrap">
        <a href="tel:9057071087" class="inline-flex items-center gap-1.5 transition-colors hover:text-[#AE0024]" aria-label="Call">
          <svg class="w-[13px] h-[13px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
