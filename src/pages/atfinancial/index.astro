          </svg>
          905-707-1087
        </a>
        <a href="mailto:clientservices@atfg.ca" class="inline-flex items-center gap-1.5 transition-colors hover:text-[#AE0024]" aria-label="Email">
          <svg class="w-[13px] h-[13px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          clientservices@atfg.ca
        </a>
        <span class="text-[#5A5A5A]">Richmond Hill, ON</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="https://www.linkedin.com/" target="_blank" rel="noopener" class="transition-colors hover:text-[#AE0024]" aria-label="LinkedIn">
          <svg class="w-[14px] h-[14px]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.37V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/>
          </svg>
        </a>
        <a href="https://www.facebook.com/" target="_blank" rel="noopener" class="transition-colors hover:text-[#AE0024]" aria-label="Facebook">
          <svg class="w-[14px] h-[14px]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.69.24 2.69.24v2.97h-1.52c-1.49 0-1.95.93-1.95 1.89v2.26h3.32l-.53 3.49h-2.79V24C19.61 23.1 24 18.1 24 12.07z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- NAV -->
  <nav class="sticky top-0 z-[100] bg-[#FFFFFF] border-b border-[#ECEDEA] shadow-sm">
    <div class="container-x flex items-center justify-between py-[18px]">
      <a href="/" class="flex items-center shrink-0" aria-label="A.T. Financial Group Home">
        <img src="/atfinancial/at-financial-logo.svg" alt="A.T. Financial Group" class="h-12 max-md:h-10 w-auto max-w-none" />
      </a>

      <ul class="hidden lg:flex items-center gap-6 list-none m-0 p-0">
        {navLinks.map((link) => (
          <li class={link.children ? 'relative group' : ''}>
            <a
              href={link.href}
              class="inline-flex items-center gap-1 text-[#0A0A0A] font-display font-medium uppercase text-[13px] tracking-[1px] transition-colors hover:text-[#AE0024] py-2"
            >
              {link.label}
              {link.children && (
                <svg class="w-3 h-3 transition-transform group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              )}
            </a>
            {link.children && (
              <div class="absolute top-full left-0 min-w-[200px] bg-white border border-[#ECEDEA] shadow-lg opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 pt-2 pb-2 z-10">
                {link.children.map((child) => (
                  <a
                    href={child.href}
                    class="block px-5 py-2.5 text-[#0A0A0A] text-sm hover:bg-[#F6F7F5] hover:text-[#AE0024] transition-colors"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            )}
          </li>
        ))}
      </ul>

      <button class="at-ham lg:hidden flex flex-col gap-[5px] p-1.5" id="at-ham" aria-label="Toggle menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>

  <!-- MOBILE OVERLAY -->
  <div id="at-mob-overlay" class="at-mob-overlay fixed inset-0 bg-black/60 z-[150]"></div>

  <!-- MOBILE MENU -->
  <div id="at-mob-menu" class="at-mob-menu fixed top-0 right-0 w-[85%] max-w-[380px] h-screen bg-white z-[200] pt-[80px] px-6 pb-8 overflow-y-auto">
    <ul class="list-none m-0 p-0">
      {navLinks.map((link) => (
        <li class="border-b border-[#ECEDEA]">
          {link.children ? (
            <details class="group">
              <summary class="flex items-center justify-between py-[16px] font-display font-medium text-base uppercase tracking-[1.5px] text-[#0A0A0A] cursor-pointer list-none hover:text-[#AE0024]">
                <span>{link.label}</span>
                <svg class="w-4 h-4 transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
                </svg>
              </summary>
              <div class="pb-3 pl-2">
                {link.children.map((child) => (
                  <a href={child.href} class="block py-2 text-sm text-[#5A5A5A] hover:text-[#AE0024]">{child.label}</a>
                ))}
              </div>
            </details>
          ) : (
            <a href={link.href} class="block py-[16px] font-display font-medium text-base uppercase tracking-[1.5px] text-[#0A0A0A] hover:text-[#AE0024]">
              {link.label}
            </a>
