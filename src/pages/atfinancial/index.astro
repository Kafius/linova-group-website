  { heading: 'Insurance', items: ['Life', 'Critical Illness', 'Disability', 'Car / Home', 'Travel'] },
  { heading: 'Wealth Creation', items: ['Insured Annuity', 'RESP', 'RDSP', 'TFSA', 'RRSP', 'RRIF'] },
