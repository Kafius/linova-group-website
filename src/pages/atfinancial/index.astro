      ))}
    </ul>
    <div class="mt-8 space-y-3 text-sm text-[#5A5A5A]">
      <a href="tel:9057071087" class="block hover:text-[#AE0024]">905-707-1087</a>
      <a href="mailto:clientservices@atfg.ca" class="block hover:text-[#AE0024]">clientservices@atfg.ca</a>
      <div class="flex items-center gap-4 pt-2">
        <a href="https://www.linkedin.com/" target="_blank" rel="noopener" class="hover:text-[#AE0024]" aria-label="LinkedIn">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.37V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/>
          </svg>
        </a>
        <a href="https://www.facebook.com/" target="_blank" rel="noopener" class="hover:text-[#AE0024]" aria-label="Facebook">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.69.24 2.69.24v2.97h-1.52c-1.49 0-1.95.93-1.95 1.89v2.26h3.32l-.53 3.49h-2.79V24C19.61 23.1 24 18.1 24 12.07z"/>
