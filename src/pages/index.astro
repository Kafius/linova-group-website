---
// Homepage v2 — the seven acts (design plan, sheet 01).
import BaseLayout from '../layouts/BaseLayout.astro';
import Opening from '../components/opening/Opening.astro';
import IndustriesRail from '../components/industries/IndustriesRail.astro';
import SystemSection from '../components/system/SystemSection.astro';
import HandoffSection from '../components/handoff/HandoffSection.astro';
import WorkSection from '../components/work/WorkSection.astro';
import ProofSection from '../components/proof/ProofSection.astro';
import CloseSection from '../components/close/CloseSection.astro';
import BuildLog from '../components/shell/BuildLog.astro';
import { site } from '../data/site';

const acts: [string, string][] = [
  ['act-opening', 'the compiler'],
  ['act-industries', 'industries'],
  ['act-system', 'the system'],
  ['act-handoff', 'the handoff'],
  ['act-work', 'selected work'],
  ['act-close', 'book a call'],
];
---

<BaseLayout
  title="The Linova Group — web design & marketing, Thornhill"
  description={site.description}
  withBusinessJsonLd
>
  <Opening />
  <IndustriesRail />
  <SystemSection />
  <HandoffSection />
  <WorkSection />
  <ProofSection />
  <CloseSection />
  <BuildLog acts={acts} />
</BaseLayout>
