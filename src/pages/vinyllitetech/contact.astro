---
import VltLayout from '../../layouts/VltLayout.astro';

const infoCards = [
  {
    label: 'Location',
    value: '13027 Harmon Road',
    sub: 'Fort Worth, Texas 76177',
    icon: `<path d="M8 1C5.24 1 3 3.24 3 6c0 3.75 5 9 5 9s5-5.25 5-9c0-2.76-2.24-5-5-5Zm0 6.5A1.5 1.5 0 1 1 8 4a1.5 1.5 0 0 1 0 3.5Z" fill="#0A82EF"/>`,
    href: null,
  },
  {
    label: 'Phone',
    value: '(800) 259-2937',
    sub: 'Mon–Fri, 8am–5pm CST',
    icon: `<path d="M3 2h3l1.5 3.75L6 7s1 2 3 3l1.25-1.5L14 10v3c0 .55-.45 1-1 1C5.72 14 2 7.28 2 3c0-.55.45-1 1-1Z" fill="#0A82EF"/>`,
    href: 'tel:+18002592937',
  },
  {
    label: 'Email',
    value: 'info@vinyllitetech.com',
    sub: 'We respond within 1 business day',
    icon: `<path d="M2 4h12v8H2V4Zm0 0 6 5 6-5" stroke="#0A82EF" stroke-width="1.25" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
    href: 'mailto:info@vinyllitetech.com',
  },
];

const productOptions = [
  'The Bullet — Entry-Level SDL System',
  'Derringer Punch — Mid-Range SDL System',
  'Magnum Punch — High-Volume SDL System',
  'SDL Bar Profiles',
  'Custom Vinyl Extrusions',
  'General Inquiry',
];
---

<VltLayout
  title="Contact — Vinyl Lite Technology Inc."
  description="Get in touch with Vinyl Lite Technology Inc. Request a quote for SDL fabrication systems or ask about custom vinyl extrusions for your manufacturing operation."
  activeSection="contact"
>



<!-- PAGE HERO -->
<div class="vlt-page-hero" data-bg="SDL">
  <div class="vlt-hero-grid"></div>
  <div class="vlt-inner">
    <div class="vlt-breadcrumb">
      <a href="/vinyllitetech">Home</a>
      <span>/</span>
      Contact
    </div>
    <h1 class="vlt-page-title">Let's Talk<br /><span class="accent">Production</span></h1>
    <p class="vlt-page-sub">
      Whether you're scaling up or just starting out with SDL, we'll help you find the right
      system and get it running fast.
    </p>
  </div>
</div>

<!-- CONTACT SECTION -->
<section class="contact-section">
  <div class="vlt-inner">
    <div class="vlt-label">Get in Touch</div>
    <h2 class="vlt-section-title">Request a<br />Quote</h2>

    <div class="contact-grid">
      <!-- Left: info -->
      <div>
        <div class="info-panel">
          {infoCards.map((c) => (
            <div class="info-row">
              <div class="info-icon">
                <svg width="16" height="16" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" set:html={c.icon} />
              </div>
              <div class="info-text">
                <span class="info-label">{c.label}</span>
                <span class="info-value">
                  {c.href ? <a href={c.href}>{c.value}</a> : c.value}
                </span>
                <span class="info-sub">{c.sub}</span>
              </div>
            </div>
          ))}
        </div>

        <div class="map-embed">
          <iframe
            src="https://maps.google.com/maps?q=13027+Harmon+Rd,+Fort+Worth,+TX+76177&t=&z=15&ie=UTF8&iwloc=&output=embed"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Vinyl Lite Technology office location"
          ></iframe>
        </div>
      </div>

      <!-- Right: form -->
      <form class="contact-form" id="vlt-contact-form">
        <div class="form-row">
          <div class="form-field">
            <label class="form-label" for="vlt-first">First Name</label>
            <input id="vlt-first" name="firstName" class="form-input" type="text" placeholder="First name" required />
          </div>
          <div class="form-field">
            <label class="form-label" for="vlt-last">Last Name</label>
            <input id="vlt-last" name="lastName" class="form-input" type="text" placeholder="Last name" required />
          </div>
        </div>
        <div class="form-field">
          <label class="form-label" for="vlt-email">Email</label>
          <input id="vlt-email" name="email" class="form-input" type="email" placeholder="you@company.com" required />
        </div>
        <div class="form-field">
          <label class="form-label" for="vlt-phone">Phone (Optional)</label>
          <input id="vlt-phone" name="phone" class="form-input" type="tel" placeholder="(555) 000-0000" />
        </div>
        <div class="form-field">
          <label class="form-label" for="vlt-interest">Interested In</label>
          <select id="vlt-interest" name="interest" class="form-input form-select" required>
            <option value="" disabled selected>Select an inquiry…</option>
            {productOptions.map((opt) => <option value={opt}>{opt}</option>)}
          </select>
        </div>
        <div class="form-field">
          <label class="form-label" for="vlt-message">Message</label>
          <textarea id="vlt-message" name="message" class="form-textarea" placeholder="Tell us about your production needs, volume, and any questions…" required></textarea>
        </div>
        <button type="submit" class="form-submit">Send Inquiry →</button>
      </form>
    </div>
  </div>
</section>

<script is:inline>
  var form = document.getElementById('vlt-contact-form');
  form && form.addEventListener('submit', function(e) {
    e.preventDefault();
    alert("Thanks — we'll be in touch within one business day.");
  });
</script>

</VltLayout>
