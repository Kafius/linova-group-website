---
// /thank-you-contacted — the no-JS landing for the Formspree contact form.
// With script running, /contact confirms in place and never comes here; this
// is the fallback that keeps the form honest when it doesn't. Noindexed and
// kept out of the sitemap.
import BaseLayout from '../layouts/BaseLayout.astro';

const steps: [string, string][] = [
  ['A person reads it', 'Not a bot and not a queue — the message arrives as you wrote it.'],
  ['A reply within one business day', 'Usually the same day, by email, with first thoughts and anything we need to ask.'],
  ['A scope and a price', 'If it looks like a fit, you get the work written down and costed. No surprises.'],
];
---

<BaseLayout
  title="Message received — The Linova Group"
  description="Thanks for reaching out. We reply within one business day."
  noindex
>
  <div class="plot-grid">
    <header class="mx-auto max-w-[1000px] px-6 pb-10 pt-24">
      <p class="label-mono">message received</p>
      <h1 class="mt-4 max-w-[14ch] font-display text-display text-film">
        Got it<span class="text-redline">.</span>
      </h1>
      <p class="mt-5 max-w-[52ch] text-body text-film-dim">
        We read every message ourselves. You'll hear back within one business
        day, usually sooner.
      </p>
    </header>
  </div>

  <div class="mx-auto max-w-[1000px] px-6 pb-24">
    <ol class="m-0 grid list-none gap-px border border-grid/40 bg-grid/40 p-0 md:grid-cols-3">
      {steps.map(([title, detail], i) => (
        <li class="bg-navy p-6">
          <p class="label-mono m-0">{String(i + 1).padStart(2, '0')}</p>
          <p class="m-0 mt-3 text-body font-medium text-film">{title}</p>
          <p class="m-0 mt-2 text-caption text-film-dim">{detail}</p>
        </li>
      ))}
    </ol>

    <div class="mt-16">
      <p class="label-mono">rather talk sooner</p>
      <a
        href="/book"
        data-track="book_click"
        data-track-label="thank-you-contacted"
        class="mt-3 inline-block font-display text-title text-film no-underline transition-colors hover:text-gold"
      >
        Book a call<span class="text-gold">.</span>
      </a>
      <p class="mt-4 max-w-[52ch] text-caption text-film-dim">
        Twenty minutes covers what a week of email would. Pick a slot that
        suits you.
      </p>
    </div>
  </div>
</BaseLayout>
