---
// Northline demo — scope of services. Eight lines of work, each with the
// crew size and service window stated, because that is the first thing a
// facility manager checks and the last thing most contractor sites publish.
import DemoLayout from '../../../../../layouts/DemoLayout.astro';
import { chrome, routes } from '../../../../../lib/demos/northlineChrome';
import { demoBreadcrumbs, serviceList } from '../../../../../lib/demos/northlineJsonld';
import {
  business,
  pageMeta,
  services,
  servicesPage,
} from '../../../../../data/demos/b2b-commercial-services';

const meta = pageMeta.services;
---

<DemoLayout
  {...chrome}
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  current={routes.services}
  jsonLd={[
    serviceList(routes.services),
    demoBreadcrumbs([
      { name: business.shortName, path: routes.home },
      { name: meta.breadcrumb, path: routes.services },
    ]),
  ]}
>
  <header class="bay sv-head">
    <div class="wrap">
      <p class="kicker">{servicesPage.kicker}</p>
      <h1 class="sv-title">{servicesPage.heading}</h1>
      <hr class="rule" />
      <p class="lede sv-lede">{servicesPage.intro}</p>

      <nav class="jump" aria-label={servicesPage.jumpLabel}>
        <ol class="jump__list">
          {services.map((service, i) => (
            <li>
              <a class="jump__link" href={`#${service.id}`}>
                <span class="jump__num">{String(i + 1).padStart(2, '0')}</span>
                <span>{service.name}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  </header>

  <section class="bay" aria-label={servicesPage.heading}>
    <div class="wrap">
      {services.map((service, i) => (
        <article class="svc" id={service.id} aria-labelledby={`h-${service.id}`}>
          <div class="svc__head">
            <span class="svc__num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h2 class="svc__name" id={`h-${service.id}`}>{service.name}</h2>
              <p class="svc__summary">{service.summary}</p>
              <ul class="svc__spec">
                {service.spec.map((entry) => (
                  <li class="chip">
                    <span class="chip__k">{entry.label}</span>
                    <span class="chip__v">{entry.value}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <div class="svc__body">
            <h3 class="svc__inc-h">{servicesPage.includesLabel}</h3>
            <ul class="inc">
              {service.includes.map((line) => <li class="inc__item">{line}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="bay on-paper">
    <div class="wrap closer">
      <div>
        <h2 class="section-title">{servicesPage.closerHeading}</h2>
        <p class="section-body section-body--paper">{servicesPage.closerBody}</p>
      </div>
      <a class="btn btn--fill" href={routes.quote} data-analytics-event="quote_cta_services">
        {servicesPage.closerCta}
      </a>
    </div>
  </section>
</DemoLayout>

<style>
  .kicker {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .section-title {
    font-size: var(--fs-title);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .section-body {
    margin-top: 0.9rem;
    max-width: 52ch;
    color: var(--on-ink-dim);
  }
  .section-body--paper {
    color: var(--on-paper-dim);
  }
  .chip {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid var(--ink-line);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1;
  }
  .chip__k {
    padding: 0.4rem 0.5rem;
    background: var(--ink-raised);
    color: var(--on-ink-dim);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .chip__v {
    padding: 0.4rem 0.55rem;
    font-weight: 600;
    color: var(--on-ink);
    border-left: 1px solid var(--ink-line);
  }

  .sv-head {
    padding-bottom: 0;
  }
  .sv-title {
    margin-top: 1rem;
    font-size: var(--fs-display);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .sv-lede {
    margin-top: 1.35rem;
    max-width: 54ch;
  }

  /* ── Jump index. Numbered, ruled, deliberately a contents page. ─────── */
  .jump {
    margin-top: 2.5rem;
    border-top: 1px solid var(--ink-line);
  }
  .jump__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  @media (min-width: 700px) {
    .jump__list {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 3rem;
    }
  }
  .jump__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--ink-line);
    font-size: var(--fs-small);
    text-decoration: none;
  }
  .jump__link:hover {
    color: var(--accent);
  }
  .jump__num {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--accent);
  }

  /* ── One service ───────────────────────────────────────────────────── */
  .svc {
    padding: clamp(2rem, 4vw, 3rem) 0;
    border-bottom: 1px solid var(--ink-line);
    scroll-margin-top: 7rem;
  }
  .svc:first-of-type {
    padding-top: 0;
  }
  @media (min-width: 940px) {
    .svc {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3.5rem;
      align-items: start;
    }
  }
  .svc__head {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0 1rem;
  }
  .svc__num {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--accent);
  }
  .svc__name {
    font-size: clamp(1.35rem, 1.15rem + 0.9vw, 1.8rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .svc__summary {
    margin-top: 0.9rem;
    max-width: 46ch;
    color: var(--on-ink-dim);
  }
  .svc__spec {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .svc__body {
    margin-top: 2rem;
  }
  @media (min-width: 940px) {
    .svc__body {
      margin-top: 0;
      padding-left: 2rem;
      border-left: 1px solid var(--ink-line);
    }
  }
  .svc__inc-h {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-ink-dim);
  }
  .inc {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .inc__item {
    position: relative;
    padding-left: 1.4rem;
    font-size: var(--fs-small);
    line-height: 1.55;
  }
  .inc__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.75rem;
    height: 1px;
    background: var(--accent);
  }

  .closer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
</style>
