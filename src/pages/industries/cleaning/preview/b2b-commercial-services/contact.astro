---
// Northline demo — contact. No second enquiry form: the quote page already
// takes new business with the qualifying fields attached, and a duplicate
// form here would send the same lead in with less information.
import DemoLayout from '../../../../../layouts/DemoLayout.astro';
import { chrome, routes } from '../../../../../lib/demos/northlineChrome';
import { demoBreadcrumbs } from '../../../../../lib/demos/northlineJsonld';
import {
  business,
  contactPage,
  coverage,
  officeHours,
  pageMeta,
  serviceArea,
} from '../../../../../data/demos/b2b-commercial-services';
import { formatTime } from '../../../../../lib/demos/shared';

const meta = pageMeta.contact;
const hourRows = officeHours.map((day) => ({
  day: day.day,
  open: `${formatTime(day.open)} – ${formatTime(day.close)}`,
}));
---

<DemoLayout
  {...chrome}
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  current={routes.contact}
  jsonLd={[
    demoBreadcrumbs([
      { name: business.shortName, path: routes.home },
      { name: meta.breadcrumb, path: routes.contact },
    ]),
  ]}
>
  <header class="bay ct-head">
    <div class="wrap">
      <p class="kicker">{contactPage.kicker}</p>
      <h1 class="ct-title">{contactPage.heading}</h1>
      <hr class="rule" />
    </div>
  </header>

  <section class="wrap ct-grid">
    <div class="details">
      <div class="detail">
        <h2 class="detail__h">{contactPage.addressHeading}</h2>
        <address class="detail__address">
          <span>{business.address.street}</span>
          <span>{business.address.city}, {business.address.region} {business.address.postalCode}</span>
        </address>
      </div>
      <div class="detail">
        <h2 class="detail__h">{contactPage.phoneHeading}</h2>
        <a class="detail__phone" href={business.phoneHref} data-analytics-event="phone_tap_contact">
          {business.phone}
        </a>
      </div>
      <div class="detail">
        <h2 class="detail__h">{contactPage.emailHeading}</h2>
        <a class="detail__link" href={business.emailHref}>{business.email}</a>
      </div>
      <a class="btn btn--fill" href={routes.quote} data-analytics-event="quote_cta_contact">
        {contactPage.quoteCta}
      </a>
    </div>

    <div class="map" role="img" aria-label={contactPage.mapLabel}>
      <span class="map__label">{contactPage.mapLabel}</span>
      <svg class="map__cross" aria-hidden="true" preserveAspectRatio="none">
        <line x1="0" y1="0" x2="100%" y2="100%" stroke="currentColor" stroke-width="1" opacity="0.2" />
        <line x1="100%" y1="0" x2="0" y2="100%" stroke="currentColor" stroke-width="1" opacity="0.2" />
      </svg>
    </div>
  </section>

  <!-- ── Hours: office on the left, crews on the right ───────────────── -->
  <section class="bay" aria-labelledby="hours-h">
    <div class="wrap">
      <h2 id="hours-h" class="section-title">{contactPage.hoursHeading}</h2>
      <hr class="rule" />
      <p class="note">{contactPage.hoursNote}</p>
      <div class="hours-grid">
        <table class="hours">
          <thead>
            <tr>
              <th scope="col">{contactPage.hoursTable.day}</th>
              <th scope="col">{contactPage.hoursTable.open}</th>
            </tr>
          </thead>
          <tbody>
            {hourRows.map((row) => (
              <tr>
                <th scope="row">{row.day}</th>
                <td>{row.open}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <dl class="crews">
          {coverage.map((row) => (
            <div class="crew">
              <dt class="crew__k">{row.label}</dt>
              <dd class="crew__v">{row.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ── Who to ask for ──────────────────────────────────────────────── -->
  <section class="bay on-paper" aria-labelledby="routing-h">
    <div class="wrap">
      <h2 id="routing-h" class="section-title">{contactPage.routingHeading}</h2>
      <hr class="rule" />
      <dl class="routing">
        {contactPage.routing.map((entry) => (
          <div class="route">
            <dt class="route__k">{entry.title}</dt>
            <dd class="route__v">{entry.detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ── Service area ────────────────────────────────────────────────── -->
  <section class="bay" aria-labelledby="area-h">
    <div class="wrap">
      <h2 id="area-h" class="section-title">{contactPage.areaHeading}</h2>
      <hr class="rule" />
      <p class="note">{contactPage.areaNote}</p>
      <ul class="area__list">
        {serviceArea.map((city) => <li class="area__city">{city}</li>)}
      </ul>
    </div>
  </section>
</DemoLayout>

<style>
  .kicker {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .section-title {
    font-size: var(--fs-title);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .note {
    margin-top: 1rem;
    max-width: 56ch;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
  }
  .ct-head {
    padding-bottom: 0;
  }
  .ct-title {
    margin-top: 1rem;
    font-size: var(--fs-display);
    font-weight: 600;
    letter-spacing: -0.03em;
    max-width: 16ch;
  }

  .ct-grid {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .ct-grid {
      grid-template-columns: 1fr 1.1fr;
      gap: 3.5rem;
      align-items: start;
    }
  }
  .details {
    display: grid;
    gap: 2rem;
    justify-items: start;
  }
  .detail__h {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }
  .detail__address {
    font-style: normal;
    display: grid;
    gap: 0.15rem;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.15rem);
  }
  .detail__phone {
    font-family: var(--font-mono);
    font-size: clamp(1.6rem, 1.35rem + 1.1vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--accent);
    text-decoration: none;
  }
  .detail__link {
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.1rem);
    text-underline-offset: 4px;
  }

  .map {
    position: relative;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    text-align: center;
    border: 1px dashed color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 5%, transparent);
    color: var(--accent);
  }
  .map__label {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    max-width: 24ch;
    line-height: 1.6;
  }
  .map__cross {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* ── Hours ────────────────────────────────────────────────────────── */
  .hours-grid {
    margin-top: 1.75rem;
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 800px) {
    .hours-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: start;
    }
  }
  .hours {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .hours th,
  .hours td {
    text-align: left;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--ink-line);
    font-size: var(--fs-small);
  }
  .hours thead th {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
  }
  .hours tbody th {
    font-weight: 400;
  }
  .hours td {
    font-family: var(--font-mono);
    color: var(--on-ink-dim);
    text-align: right;
  }
  .crews {
    margin: 0;
    display: grid;
    gap: 1px;
    background: var(--ink-line);
    border: 1px solid var(--ink-line);
  }
  .crew {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.85rem 1rem;
    background: var(--ink-raised);
  }
  .crew__k {
    font-size: var(--fs-small);
    font-weight: 600;
  }
  .crew__v {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
  }

  /* ── Routing ──────────────────────────────────────────────────────── */
  .routing {
    margin: 2rem 0 0;
    display: grid;
    gap: 1px;
    background: var(--paper-line);
    border: 1px solid var(--paper-line);
  }
  @media (min-width: 720px) {
    .routing {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1080px) {
    .routing {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .route {
    padding: 1.5rem 1.4rem;
    background: var(--paper);
  }
  .route__k {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-paper);
  }
  .route__v {
    margin: 0.75rem 0 0;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--on-paper-dim);
  }

  /* ── Service area ─────────────────────────────────────────────────── */
  .area__list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--ink-line);
    border: 1px solid var(--ink-line);
  }
  @media (min-width: 640px) {
    .area__list {
      grid-template-columns: repeat(6, 1fr);
    }
  }
  .area__city {
    padding: 1.1rem 1rem;
    background: var(--ink-raised);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    font-weight: 600;
  }
</style>
