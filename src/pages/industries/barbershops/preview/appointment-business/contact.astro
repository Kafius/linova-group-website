---
// Ironwood demo — contact and hours. No contact form here: booking is the
// enquiry path on this playbook, so the page points at the booking flow and
// the phone rather than adding a second inbox nobody watches.
import DemoMap from '../../../../../components/demos/DemoMap.astro';
import DemoLayout from '../../../../../layouts/DemoLayout.astro';
import { chrome, routes } from '../../../../../lib/demos/ironwoodChrome';
import { demoBreadcrumbs } from '../../../../../lib/demos/ironwoodJsonld';
import { business, contact, hours, pageMeta } from '../../../../../data/demos/appointment-business';
import { formatTime } from '../../../../../lib/demos/shared';

const meta = pageMeta.contact;
const hourRows = hours.map((day) => ({
  day: day.day,
  open: day.closed ? contact.closedLabel : `${formatTime(day.open)} – ${formatTime(day.close)}`,
  closed: Boolean(day.closed),
}));
---

<DemoLayout
  {...chrome}
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  current={routes.contact}
  jsonLd={[
    demoBreadcrumbs([
      { name: business.shortName, path: routes.home },
      { name: meta.breadcrumb, path: routes.contact },
    ]),
  ]}
>
  <header class="bay contact-head">
    <div class="wrap">
      <p class="eyebrow">{contact.eyebrow}</p>
      <h1 class="contact-title">{contact.heading}</h1>
      <hr class="rule" />
    </div>
  </header>

  <section class="wrap contact-grid">
    <div class="details">
      <div class="detail">
        <h2 class="detail__h">{contact.addressHeading}</h2>
        <address class="detail__address">
          <span>{business.address.street}</span>
          <span>{business.address.neighbourhood}, {business.address.city}</span>
          <span>{business.address.region} {business.address.postalCode}</span>
        </address>
      </div>
      <div class="detail">
        <h2 class="detail__h">{contact.phoneHeading}</h2>
        <a class="detail__phone" href={business.phoneHref} data-analytics-event="phone_tap_contact">
          {business.phone}
        </a>
      </div>
      <div class="detail">
        <h2 class="detail__h">{contact.emailHeading}</h2>
        <a class="detail__link" href={business.emailHref}>{business.email}</a>
      </div>
    </div>

    <DemoMap label={contact.mapLabel} seed="appointment-business" />
  </section>

  <!-- ── Hours ───────────────────────────────────────────────────────── -->
  <section class="bay" aria-labelledby="hours-h">
    <div class="wrap">
      <h2 id="hours-h" class="section-title">{contact.hoursHeading}</h2>
      <hr class="rule" />
      <p class="note">{contact.hoursNote}</p>
      <table class="hours">
        <thead>
          <tr>
            <th scope="col">{contact.hoursTable.day}</th>
            <th scope="col">{contact.hoursTable.open}</th>
          </tr>
        </thead>
        <tbody>
          {hourRows.map((row) => (
            <tr class:list={[row.closed && 'is-closed']}>
              <th scope="row">{row.day}</th>
              <td>{row.open}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── Walk-ins ────────────────────────────────────────────────────── -->
  <section class="bay on-paper" aria-labelledby="walk-h">
    <div class="wrap walk">
      <div>
        <h2 id="walk-h" class="section-title">{contact.walkInHeading}</h2>
        <hr class="rule" />
        <p class="walk__body">{contact.walkInBody}</p>
      </div>
      <a class="btn btn--fill" href={routes.book} data-analytics-event="booking_cta_contact">
        {contact.bookCta}
      </a>
    </div>
  </section>

  <!-- ── Getting here ────────────────────────────────────────────────── -->
  <section class="bay" aria-labelledby="here-h">
    <div class="wrap">
      <h2 id="here-h" class="section-title">{contact.gettingHereHeading}</h2>
      <hr class="rule" />
      <dl class="here">
        {contact.gettingHere.map((entry) => (
          <div>
            <dt class="here__t">{entry.title}</dt>
            <dd class="here__d">{entry.detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</DemoLayout>

<style>
  .section-title {
    font-size: var(--fs-title);
    letter-spacing: -0.015em;
  }
  .contact-head {
    padding-bottom: 0;
  }
  .contact-title {
    font-size: var(--fs-display);
    letter-spacing: -0.025em;
    max-width: 16ch;
  }
  .note {
    margin-top: 1rem;
    max-width: 52ch;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
  }

  .contact-grid {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr 1.1fr;
      gap: 3.5rem;
      align-items: start;
    }
  }
  .details {
    display: grid;
    gap: 2rem;
  }
  .detail__h {
    font-family: var(--font-body);
    font-size: var(--fs-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }
  .detail__address {
    font-style: normal;
    display: grid;
    gap: 0.15rem;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
  }
  .detail__phone {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 1.5rem + 1.4vw, 2.6rem);
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .detail__link {
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    text-underline-offset: 4px;
  }


  .hours {
    margin-top: 1.75rem;
    width: 100%;
    max-width: 32rem;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .hours th,
  .hours td {
    text-align: left;
    padding: 0.7rem 0.75rem 0.7rem 0;
    border-bottom: 1px solid var(--ink-line);
    font-size: var(--fs-small);
  }
  .hours thead th {
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 700;
  }
  .hours tbody th {
    font-weight: 700;
  }
  .hours td {
    color: var(--on-ink-dim);
  }
  .hours .is-closed th,
  .hours .is-closed td {
    color: color-mix(in srgb, var(--on-ink) 55%, transparent);
  }

  .walk {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.75rem;
  }
  .walk__body {
    margin-top: 1.25rem;
    max-width: 46ch;
    color: var(--on-paper-dim);
  }

  .here {
    margin: 2rem 0 0;
    display: grid;
    gap: 1.75rem;
  }
  @media (min-width: 800px) {
    .here {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }
  .here__t {
    font-size: var(--fs-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent);
  }
  .here__d {
    margin: 0.6rem 0 0;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--on-ink-dim);
  }
</style>
