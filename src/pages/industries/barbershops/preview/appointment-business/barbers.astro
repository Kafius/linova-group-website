---
// Ironwood demo — the barbers. Clients follow a person, not a shop, so each
// chair gets its own block with what they book for and what they charge.
import DemoLayout from '../../../../../layouts/DemoLayout.astro';
import DemoImage from '../../../../../components/demos/DemoImage.astro';
import { chrome, routes } from '../../../../../lib/demos/ironwoodChrome';
import { demoBreadcrumbs } from '../../../../../lib/demos/ironwoodJsonld';
import { barbers, barbersPage, business, pageMeta } from '../../../../../data/demos/appointment-business';
import { formatPrice } from '../../../../../lib/demos/shared';

const meta = pageMeta.barbers;
---

<DemoLayout
  {...chrome}
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  current={routes.barbers}
  jsonLd={[
    demoBreadcrumbs([
      { name: business.shortName, path: routes.home },
      { name: meta.breadcrumb, path: routes.barbers },
    ]),
  ]}
>
  <header class="bay chairs-head">
    <div class="wrap">
      <p class="eyebrow">{barbersPage.eyebrow}</p>
      <h1 class="chairs-title">{barbersPage.heading}</h1>
      <hr class="rule" />
      <p class="lede chairs-lede">{barbersPage.intro}</p>
    </div>
  </header>

  <section class="bay" aria-label={barbersPage.heading}>
    <div class="wrap">
      <ul class="people">
        {barbers.map((barber) => (
          <li class="person">
            <DemoImage
              demo="appointment-business"
              file={barber.photo.file}
              subject={barber.photo.subject}
              alt={barber.photo.alt}
              ratio="4 / 5"
              sizes="(min-width: 900px) 40vw, 90vw"
              widths={[420, 640, 900]}
            />
            <div class="person__body">
              <h2 class="person__name">{barber.name}</h2>
              <p class="person__role">{barber.role}</p>
              <p class="person__bio">{barber.bio}</p>

              <dl class="person__facts">
                <div>
                  <dt>{barbersPage.specialtiesLabel}</dt>
                  <dd>{barber.specialties.join(' · ')}</dd>
                </div>
                <div>
                  <dt>{barbersPage.rateLabel}</dt>
                  <dd class="person__rate">
                    {barber.surcharge === 0
                      ? barbersPage.baseRate
                      : `Base + $${formatPrice(barber.surcharge)}`}
                  </dd>
                </div>
              </dl>

              <a class="btn btn--fill person__cta" href={routes.book} data-analytics-event="booking_cta_barber">
                {barbersPage.bookWith} {barber.name.split(' ')[0]}
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</DemoLayout>

<style>
  .chairs-head {
    padding-bottom: 0;
  }
  .chairs-title {
    font-size: var(--fs-display);
    letter-spacing: -0.025em;
    max-width: 16ch;
  }
  .chairs-lede {
    margin-top: 1.25rem;
    max-width: 50ch;
  }

  .people {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
  }
  .person {
    display: grid;
    gap: 1.75rem;
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
    border-bottom: 1px solid var(--ink-line);
  }
  .person:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  @media (min-width: 800px) {
    .person {
      grid-template-columns: 20rem minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
    }
    /* Alternate the photo side so four blocks do not read as a spreadsheet. */
    .person:nth-child(even) :global(.shot) {
      order: 2;
    }
    .person:nth-child(even) {
      grid-template-columns: minmax(0, 1fr) 20rem;
    }
  }

  .person__name {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 1.5rem + 1.8vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .person__role {
    margin-top: 0.3rem;
    font-size: var(--fs-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent);
  }
  .person__bio {
    margin-top: 1.1rem;
    max-width: 50ch;
    color: var(--on-ink-dim);
  }

  .person__facts {
    margin: 1.75rem 0 0;
    display: grid;
    gap: 1rem;
    border-top: 1px solid var(--ink-line);
    padding-top: 1.25rem;
  }
  @media (min-width: 560px) {
    .person__facts {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }
  .person__facts dt {
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--on-ink-dim);
  }
  .person__facts dd {
    margin: 0.4rem 0 0;
    font-size: var(--fs-small);
    font-weight: 700;
  }
  .person__rate {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .person__cta {
    margin-top: 1.75rem;
  }
</style>
