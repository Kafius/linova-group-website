---
// Ironwood demo — book a chair. This page is the Booking line item made
// visible: service, barber, day and time, then contact, with validation at
// every step and a confirmation state at the end.
//
// NO LIVE CALENDAR. The slot grid renders `slots` from the data module and
// marks the taken ones from a stated list, because a sample site has no
// barber's calendar to read. On a live build this page is where the calendar
// handoff goes — see the CALENDAR HANDOFF note in the script below.
//
// Nothing is submitted anywhere. There is no endpoint and no card: booking on
// this playbook feeds the shop's calendar, and payment stays on the Clover
// terminal they already have.
import DemoLayout from '../../../../../layouts/DemoLayout.astro';
import { chrome, routes } from '../../../../../lib/demos/ironwoodChrome';
import { demoBreadcrumbs } from '../../../../../lib/demos/ironwoodJsonld';
import {
  barbers,
  bookPage,
  business,
  pageMeta,
  services,
  slots,
} from '../../../../../data/demos/appointment-business';
import { formatPrice, formatTime } from '../../../../../lib/demos/shared';

const meta = pageMeta.book;
const stepCount = bookPage.steps.length;
---

<DemoLayout
  {...chrome}
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  current={routes.book}
  jsonLd={[
    demoBreadcrumbs([
      { name: business.shortName, path: routes.home },
      { name: meta.breadcrumb, path: routes.book },
    ]),
  ]}
>
  <header class="bay book-head">
    <div class="wrap">
      <p class="eyebrow">{bookPage.eyebrow}</p>
      <h1 class="book-title">{bookPage.heading}</h1>
      <hr class="rule" />
      <p class="lede book-lede">{bookPage.intro}</p>
    </div>
  </header>

  <section class="bay book-bay">
    <div class="wrap">
      <div class="booker" data-booker>
        <!-- Progress -->
        <p class="progress" data-progress aria-live="polite">
          {bookPage.stepLabel} <span data-step-now>{1}</span> {bookPage.ofLabel} {stepCount}
        </p>
        <ol class="ticks" aria-hidden="true">
          {bookPage.steps.map((step, i) => (
            <li class="tick" data-tick={i} data-on={i === 0 ? 'true' : 'false'}></li>
          ))}
        </ol>

        <form class="book-form" data-book-form novalidate>
          <!-- ── Step 1: service ──────────────────────────────────── -->
          <fieldset class="step" data-step="0">
            <legend class="step__legend">{bookPage.steps[0]?.title}</legend>
            <p class="step__hint">{bookPage.steps[0]?.hint}</p>
            <div class="choices">
              {services.map((service) => (
                <label class="choice">
                  <input
                    class="choice__input"
                    type="radio"
                    name="service"
                    value={service.id}
                    data-price={service.price}
                    data-label={service.name}
                  />
                  <span class="choice__body">
                    <span class="choice__name">{service.name}</span>
                    <span class="choice__meta">{service.minutes} min · ${formatPrice(service.price)}</span>
                    <span class="choice__desc">{service.description}</span>
                  </span>
                </label>
              ))}
            </div>
            <p class="step__err" data-err="service" hidden>{bookPage.errors.service}</p>
          </fieldset>

          <!-- ── Step 2: barber ───────────────────────────────────── -->
          <fieldset class="step" data-step="1" hidden>
            <legend class="step__legend">{bookPage.steps[1]?.title}</legend>
            <p class="step__hint">{bookPage.steps[1]?.hint}</p>
            <div class="choices">
              <label class="choice">
                <input
                  class="choice__input"
                  type="radio"
                  name="barber"
                  value={bookPage.anyBarber.id}
                  data-surcharge="0"
                  data-label={bookPage.anyBarber.name}
                />
                <span class="choice__body">
                  <span class="choice__name">{bookPage.anyBarber.name}</span>
                  <span class="choice__meta">{bookPage.anyBarber.role}</span>
                  <span class="choice__desc">{bookPage.anyBarber.detail}</span>
                </span>
              </label>
              {barbers.map((barber) => (
                <label class="choice">
                  <input
                    class="choice__input"
                    type="radio"
                    name="barber"
                    value={barber.id}
                    data-surcharge={barber.surcharge}
                    data-label={barber.name}
                  />
                  <span class="choice__body">
                    <span class="choice__name">{barber.name}</span>
                    <span class="choice__meta">
                      {barber.role}{barber.surcharge > 0 ? ` · +$${formatPrice(barber.surcharge)}` : ''}
                    </span>
                    <span class="choice__desc">{barber.specialties.join(' · ')}</span>
                  </span>
                </label>
              ))}
            </div>
            <p class="step__err" data-err="barber" hidden>{bookPage.errors.barber}</p>
          </fieldset>

          <!-- ── Step 3: day and time ─────────────────────────────── -->
          <fieldset class="step" data-step="2" hidden>
            <legend class="step__legend">{bookPage.steps[2]?.title}</legend>
            <p class="step__hint">{bookPage.steps[2]?.hint}</p>

            <label class="date-field">
              <span class="field__label">{bookPage.dateLabel}</span>
              <input class="date-input" type="date" name="date" data-date />
            </label>
            <p class="step__err" data-err="date" hidden>{bookPage.errors.date}</p>

            <div class="slots" role="group" aria-label={bookPage.timeLabel}>
              {slots.times.map((time) => {
                const taken = slots.taken.includes(time);
                return (
                  <label class:list={['slot', taken && 'slot--taken']}>
                    <input
                      class="slot__input"
                      type="radio"
                      name="time"
                      value={time}
                      disabled={taken}
                      data-label={formatTime(time)}
                    />
                    <span class="slot__label">{formatTime(time)}</span>
                    {taken && <span class="slot__taken">{slots.takenLabel}</span>}
                  </label>
                );
              })}
            </div>
            <p class="step__err" data-err="time" hidden>{bookPage.errors.time}</p>
          </fieldset>

          <!-- ── Step 4: contact ──────────────────────────────────── -->
          <fieldset class="step" data-step="3" hidden>
            <legend class="step__legend">{bookPage.steps[3]?.title}</legend>
            <p class="step__hint">{bookPage.steps[3]?.hint}</p>

            <div class="fields">
              <div class="field">
                <label class="field__label" for="bk-name">{bookPage.form.nameLabel}</label>
                <input class="field__input" id="bk-name" name="name" type="text" required
                  autocomplete="name" placeholder={bookPage.form.namePlaceholder}
                  aria-describedby="bk-name-err" />
                <p class="field__err" id="bk-name-err" hidden>{bookPage.form.nameError}</p>
              </div>
              <div class="field">
                <label class="field__label" for="bk-phone">{bookPage.form.phoneLabel}</label>
                <input class="field__input" id="bk-phone" name="phone" type="tel" required
                  autocomplete="tel" placeholder={bookPage.form.phonePlaceholder}
                  aria-describedby="bk-phone-err" />
                <p class="field__err" id="bk-phone-err" hidden>{bookPage.form.phoneError}</p>
              </div>
              <div class="field">
                <label class="field__label" for="bk-email">{bookPage.form.emailLabel}</label>
                <input class="field__input" id="bk-email" name="email" type="email" required
                  autocomplete="email" placeholder={bookPage.form.emailPlaceholder}
                  aria-describedby="bk-email-err" />
                <p class="field__err" id="bk-email-err" hidden>{bookPage.form.emailError}</p>
              </div>
              <div class="field">
                <label class="field__label" for="bk-notes">{bookPage.form.notesLabel}</label>
                <textarea class="field__input field__input--area" id="bk-notes" name="notes" rows="3"
                  placeholder={bookPage.form.notesPlaceholder}></textarea>
              </div>
            </div>

            <!-- Running summary, filled in by the script -->
            <div class="summary">
              <h2 class="summary__h">{bookPage.summaryHeading}</h2>
              <dl class="summary__list">
                <div><dt>{bookPage.serviceLabel}</dt><dd data-sum="service">—</dd></div>
                <div><dt>{bookPage.barberLabel}</dt><dd data-sum="barber">—</dd></div>
                <div><dt>{bookPage.dateLabel}</dt><dd data-sum="date">—</dd></div>
                <div><dt>{bookPage.timeLabel}</dt><dd data-sum="time">—</dd></div>
                <div class="summary__total"><dt>{bookPage.totalLabel}</dt><dd data-sum="total">—</dd></div>
              </dl>
            </div>
          </fieldset>

          <!-- ── Controls ─────────────────────────────────────────── -->
          <div class="controls">
            <button class="btn btn--line" type="button" data-back hidden>{bookPage.backLabel}</button>
            <button class="btn btn--fill" type="button" data-next>{bookPage.nextLabel}</button>
            <button class="btn btn--fill" type="submit" data-confirm hidden
              data-analytics-event="booking_confirm">{bookPage.confirmLabel}</button>
          </div>
        </form>

        <!-- ── Confirmation ───────────────────────────────────────── -->
        <div class="done" data-done hidden tabindex="-1">
          <h2 class="done__h">{bookPage.successHeading}</h2>
          <dl class="summary__list done__list">
            <div><dt>{bookPage.serviceLabel}</dt><dd data-done-sum="service">—</dd></div>
            <div><dt>{bookPage.barberLabel}</dt><dd data-done-sum="barber">—</dd></div>
            <div><dt>{bookPage.dateLabel}</dt><dd data-done-sum="date">—</dd></div>
            <div><dt>{bookPage.timeLabel}</dt><dd data-done-sum="time">—</dd></div>
            <div class="summary__total"><dt>{bookPage.totalLabel}</dt><dd data-done-sum="total">—</dd></div>
          </dl>
          <p class="done__body">{bookPage.successBody}</p>
          <button class="btn btn--line" type="button" data-again>{bookPage.successAgain}</button>
        </div>
      </div>

      <aside class="walkin">
        <p>{bookPage.walkInNote}</p>
        <a class="walkin__link" href={business.phoneHref} data-analytics-event="phone_tap_book">
          {business.phone}
        </a>
      </aside>
    </div>
  </section>
</DemoLayout>

<script>
  // ── Booking flow ─────────────────────────────────────────────────────
  // Four steps, validated one at a time, with a running summary and a
  // confirmation state. Nothing leaves the browser.
  //
  // CALENDAR HANDOFF: on a live build, the confirm handler below is where the
  // booking POSTs to the shop's calendar (Booksy, Square Appointments, Fresha
  // or Clover Appointments), and the slot grid is populated from that
  // calendar's availability instead of the stated `taken` list. Payment is not
  // touched here — deposits and the final total go through the Clover
  // terminal, which is the whole reason this page has no card fields.
  const root = document.querySelector<HTMLElement>('[data-booker]');
  const form = root?.querySelector<HTMLFormElement>('[data-book-form]');

  if (root && form) {
    const steps = [...form.querySelectorAll<HTMLElement>('[data-step]')];
    const ticks = [...root.querySelectorAll<HTMLElement>('[data-tick]')];
    const stepNow = root.querySelector<HTMLElement>('[data-step-now]');
    const back = form.querySelector<HTMLButtonElement>('[data-back]');
    const next = form.querySelector<HTMLButtonElement>('[data-next]');
    const confirm = form.querySelector<HTMLButtonElement>('[data-confirm]');
    const done = root.querySelector<HTMLElement>('[data-done]');
    const again = root.querySelector<HTMLButtonElement>('[data-again]');
    const dateInput = form.querySelector<HTMLInputElement>('[data-date]');

    let current = 0;

    // A booking cannot be for yesterday.
    if (dateInput) {
      const today = new Date();
      const iso = new Date(today.getTime() - today.getTimezoneOffset() * 60000)
        .toISOString()
        .slice(0, 10);
      dateInput.min = iso;
    }

    const showError = (key: string, on: boolean) => {
      const el = form.querySelector<HTMLElement>(`[data-err="${key}"]`);
      if (el) el.hidden = !on;
    };

    const checked = (name: string) =>
      form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);

    const money = (n: number) => `$${n % 1 === 0 ? n : n.toFixed(2)}`;

    const readableDate = (value: string) => {
      if (!value) return '—';
      // Parsed as parts, not Date(value), which would shift by timezone.
      const [y, m, d] = value.split('-').map(Number);
      if (!y || !m || !d) return '—';
      return new Date(y, m - 1, d).toLocaleDateString('en-CA', {
        weekday: 'long',
        month: 'long',
        day: 'numeric',
      });
    };

    const summarise = () => {
      const service = checked('service');
      const barber = checked('barber');
      const time = checked('time');
      const price = Number(service?.dataset.price ?? 0);
      const surcharge = Number(barber?.dataset.surcharge ?? 0);
      const values: Record<string, string> = {
        service: service?.dataset.label ?? '—',
        barber: barber?.dataset.label ?? '—',
        date: readableDate(dateInput?.value ?? ''),
        time: time?.dataset.label ?? '—',
        total: service ? money(price + surcharge) : '—',
      };
      root.querySelectorAll<HTMLElement>('[data-sum]').forEach((el) => {
        el.textContent = values[el.dataset.sum ?? ''] ?? '—';
      });
      root.querySelectorAll<HTMLElement>('[data-done-sum]').forEach((el) => {
        el.textContent = values[el.dataset.doneSum ?? ''] ?? '—';
      });
    };

    const validateStep = (index: number): boolean => {
      if (index === 0) {
        const ok = !!checked('service');
        showError('service', !ok);
        return ok;
      }
      if (index === 1) {
        const ok = !!checked('barber');
        showError('barber', !ok);
        return ok;
      }
      if (index === 2) {
        const hasDate = !!dateInput?.value;
        const hasTime = !!checked('time');
        showError('date', !hasDate);
        showError('time', hasDate && !hasTime);
        return hasDate && hasTime;
      }
      // Final step: the native constraints on the contact fields.
      const fields = [...steps[3]!.querySelectorAll<HTMLInputElement>('.field__input')];
      let valid = true;
      fields.forEach((field) => {
        const ok = field.checkValidity();
        const errId = field.getAttribute('aria-describedby');
        const err = errId ? document.getElementById(errId) : null;
        if (err) err.hidden = ok;
        field.setAttribute('aria-invalid', String(!ok));
        field.classList.toggle('is-invalid', !ok);
        if (!ok) valid = false;
      });
      if (!valid) fields.find((f) => f.classList.contains('is-invalid'))?.focus();
      return valid;
    };

    const render = () => {
      steps.forEach((step, i) => {
        step.hidden = i !== current;
      });
      ticks.forEach((tick, i) => {
        tick.dataset.on = String(i <= current);
      });
      if (stepNow) stepNow.textContent = String(current + 1);
      if (back) back.hidden = current === 0;
      const last = current === steps.length - 1;
      if (next) next.hidden = last;
      if (confirm) confirm.hidden = !last;
      if (last) summarise();
      // Move focus to the step that just appeared, or a keyboard user is
      // left where the button used to be.
      steps[current]?.querySelector<HTMLElement>('legend')?.scrollIntoView({ block: 'nearest' });
    };

    next?.addEventListener('click', () => {
      if (!validateStep(current)) return;
      current = Math.min(current + 1, steps.length - 1);
      render();
    });

    back?.addEventListener('click', () => {
      current = Math.max(current - 1, 0);
      render();
    });

    // Choosing anything clears that step's error and keeps the total honest.
    form.addEventListener('change', (event) => {
      const target = event.target as HTMLInputElement | null;
      if (target?.name) showError(target.name, false);
      summarise();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!validateStep(current)) return;
      summarise();
      form.hidden = true;
      if (done) {
        done.hidden = false;
        done.focus();
      }
    });

    again?.addEventListener('click', () => {
      form.reset();
      current = 0;
      form.hidden = false;
      if (done) done.hidden = true;
      form.querySelectorAll<HTMLElement>('[data-err]').forEach((el) => (el.hidden = true));
      form.querySelectorAll('.is-invalid').forEach((el) => el.classList.remove('is-invalid'));
      render();
    });

    render();
  }
</script>

<style>
  .book-head {
    padding-bottom: 0;
  }
  .book-title {
    font-size: var(--fs-display);
    letter-spacing: -0.02em;
  }
  .book-lede {
    margin-top: 1.25rem;
    max-width: 44ch;
  }
  .book-bay .wrap {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1000px) {
    .book-bay .wrap {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: 3rem;
      align-items: start;
    }
  }

  .booker {
    border: 1px solid var(--ink-line);
    background: var(--ink-raised);
    padding: clamp(1.25rem, 3vw, 2.25rem);
  }

  .progress {
    font-size: var(--fs-label);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent);
  }
  .ticks {
    list-style: none;
    display: flex;
    gap: 0.4rem;
    margin: 0.75rem 0 2rem;
    padding: 0;
  }
  .tick {
    height: 2px;
    flex: 1;
    background: var(--ink-line);
  }
  .tick[data-on='true'] {
    background: var(--accent);
  }

  .step {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .step__legend {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    padding: 0;
  }
  .step__hint {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
    max-width: 48ch;
  }
  .step__err {
    margin-top: 1rem;
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--accent);
  }

  /* ── Radio cards ──────────────────────────────────────────────────── */
  .choices {
    margin-top: 1.75rem;
    display: grid;
    gap: 0.6rem;
  }
  @media (min-width: 680px) {
    .choices {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .choice {
    position: relative;
    display: block;
    cursor: pointer;
  }
  .choice__input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .choice__body {
    display: grid;
    gap: 0.2rem;
    height: 100%;
    padding: 1rem 1.1rem;
    border: 1px solid var(--ink-line);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .choice:hover .choice__body {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .choice__input:checked + .choice__body {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
  }
  .choice__input:focus-visible + .choice__body {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .choice__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .choice__meta {
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .choice__desc {
    margin-top: 0.35rem;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--on-ink-dim);
  }

  /* ── Date and slots ───────────────────────────────────────────────── */
  .date-field {
    display: grid;
    gap: 0.45rem;
    margin-top: 1.75rem;
    max-width: 16rem;
  }
  .date-input {
    font: inherit;
    font-size: var(--fs-body);
    color: var(--on-ink);
    background: var(--ink);
    border: 1px solid var(--ink-line);
    border-radius: var(--radius);
    padding: 0.75rem 0.9rem;
    color-scheme: dark;
  }
  .date-input:focus {
    border-color: var(--accent);
  }

  .slots {
    margin-top: 1.75rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr));
    gap: 0.5rem;
  }
  .slot {
    position: relative;
    display: block;
    cursor: pointer;
  }
  .slot--taken {
    cursor: not-allowed;
  }
  .slot__input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: inherit;
  }
  .slot__label {
    display: block;
    padding: 0.7rem 0.5rem;
    text-align: center;
    border: 1px solid var(--ink-line);
    font-size: var(--fs-small);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .slot:not(.slot--taken):hover .slot__label {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .slot__input:checked + .slot__label {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }
  .slot__input:focus-visible + .slot__label {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .slot--taken .slot__label {
    /* 55%, not 38%: disabled controls are exempt from WCAG contrast, but the
       word "Taken" is the only thing explaining why the slot is dead. */
    color: color-mix(in srgb, var(--on-ink) 55%, transparent);
    border-style: dashed;
  }
  .slot__taken {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
    color: color-mix(in srgb, var(--on-ink) 55%, transparent);
  }

  /* ── Contact fields ───────────────────────────────────────────────── */
  .fields {
    margin-top: 1.75rem;
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 680px) {
    .fields {
      grid-template-columns: repeat(2, 1fr);
    }
    .fields .field:last-child {
      grid-column: 1 / -1;
    }
  }
  .field {
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }
  .field__label {
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--on-ink-dim);
  }
  .field__input {
    font: inherit;
    font-size: var(--fs-body);
    color: var(--on-ink);
    background: var(--ink);
    border: 1px solid var(--ink-line);
    border-radius: var(--radius);
    padding: 0.75rem 0.9rem;
    width: 100%;
  }
  .field__input::placeholder {
    color: color-mix(in srgb, var(--on-ink) 55%, transparent);
  }
  .field__input:focus {
    border-color: var(--accent);
  }
  .field__input--area {
    resize: vertical;
    min-height: 5rem;
  }
  .field__input.is-invalid {
    border-color: var(--accent);
  }
  .field__err {
    font-size: var(--fs-small);
    color: var(--accent);
  }

  /* ── Summary ──────────────────────────────────────────────────────── */
  .summary {
    margin-top: 2rem;
