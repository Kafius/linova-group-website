---
// Redline demo — services. Split deliberately into what can be priced and
// what cannot: the second list is the honest half, and booking one of those
// books the inspection rather than the repair.
import DemoLayout from '../../../../../layouts/DemoLayout.astro';
import { chrome, routes } from '../../../../../lib/demos/redlineChrome';
import { demoBreadcrumbs } from '../../../../../lib/demos/redlineJsonld';
import {
  business,
  fixedServices,
  pageMeta,
  quotedServices,
  servicesPage,
} from '../../../../../data/demos/automotive-book-a-bay';
import { formatPrice } from '../../../../../lib/demos/shared';

const meta = pageMeta.services;
const fixed = fixedServices();
const quoted = quotedServices();
---

<DemoLayout
  {...chrome}
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  current={routes.services}
  jsonLd={[
    demoBreadcrumbs([
      { name: business.shortName, path: routes.home },
      { name: meta.breadcrumb, path: routes.services },
    ]),
  ]}
>
  <header class="bay svc-head">
    <div class="wrap">
      <p class="eyebrow">{servicesPage.eyebrow}</p>
      <h1 class="svc-title">{servicesPage.heading}</h1>
      <hr class="rule" />
      <p class="lede svc-lede">{servicesPage.intro}</p>
    </div>
  </header>

  <!-- ── Fixed price ─────────────────────────────────────────────────── -->
  <section class="bay" aria-labelledby="fixed-h">
    <div class="wrap">
      <h2 id="fixed-h" class="section-title">{servicesPage.fixedHeading}</h2>
      <hr class="rule" />
      <ul class="list">
        {fixed.map((service) => (
          <li class="row">
            <div>
              <h3 class="row__name">{service.name}</h3>
              <p class="row__desc">{service.description}</p>
            </div>
            <div class="row__meta">
              <span class="row__price">
                {service.from && <span class="row__from">{servicesPage.fromLabel}</span>}
                ${formatPrice(service.price ?? 0)}
              </span>
              <a class="row__book" href={routes.book} data-analytics-event="booking_cta_service">
                {servicesPage.bookCta}
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Quoted after inspection ─────────────────────────────────────── -->
  <section class="bay on-paper" aria-labelledby="quoted-h">
    <div class="wrap">
      <h2 id="quoted-h" class="section-title">{servicesPage.quotedHeading}</h2>
      <hr class="rule" />
      <p class="quoted__note">{servicesPage.quotedNote}</p>
      <ul class="list list--paper">
        {quoted.map((service) => (
          <li class="row">
            <div>
              <h3 class="row__name">{service.name}</h3>
              <p class="row__desc">{service.description}</p>
            </div>
            <div class="row__meta">
              <span class="row__quote">{servicesPage.quoteLabel}</span>
              <a class="row__book" href={routes.book} data-analytics-event="booking_cta_quote">
                {servicesPage.bookCta}
              </a>
            </div>
          </li>
        ))}
      </ul>

      <a class="btn btn--fill list__cta" href={routes.book} data-analytics-event="booking_cta_services">
        {servicesPage.allCta}
      </a>
    </div>
  </section>
</DemoLayout>

<style>
  .section-title {
    font-size: var(--fs-title);
    letter-spacing: -0.02em;
  }
  .svc-head {
    padding-bottom: 0;
  }
  .svc-title {
    font-size: var(--fs-display);
    letter-spacing: -0.03em;
    max-width: 16ch;
  }
  .svc-lede {
    margin-top: 1.25rem;
    max-width: 54ch;
  }

  .list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    border-top: 1px solid var(--ink-line);
  }
  .list--paper {
    border-top-color: var(--paper-line);
  }
  .row {
    display: grid;
    gap: 0.75rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--ink-line);
  }
  .list--paper .row {
    border-bottom-color: var(--paper-line);
  }
  @media (min-width: 760px) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      gap: 2.5rem;
    }
  }
  .row__name {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.6rem);
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .row__desc {
    margin-top: 0.4rem;
    max-width: 58ch;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--on-ink-dim);
  }
  .list--paper .row__desc {
    color: var(--on-paper-dim);
  }
  .row__meta {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
  }
  @media (min-width: 760px) {
    .row__meta {
      justify-content: flex-end;
      min-width: 15rem;
    }
  }
  .row__price {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    text-align: right;
  }
  .row__from {
    display: block;
    font-family: var(--font-body);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-ink-dim);
  }
  .row__quote {
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent-paper);
    text-align: right;
  }
  .row__book {
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent);
    text-underline-offset: 4px;
    white-space: nowrap;
  }
  .list--paper .row__book {
    color: var(--accent-paper);
  }
  .quoted__note {
    margin-top: 1rem;
    max-width: 54ch;
    font-size: var(--fs-small);
    color: var(--on-paper-dim);
  }
  .list__cta {
    margin-top: 2rem;
  }
</style>
