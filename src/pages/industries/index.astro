---
// /industries — the directory of every vertical, grouped so a visitor can
// find their own trade fast: category rail on top, then the playbooks under
// their group heading, each row carrying the specific businesses it covers.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionRail from '../../components/shell/SectionRail.astro';
import IndustrySearch from '../../components/industries/IndustrySearch.astro';
import IndustryCards from '../../components/industries/IndustryCards.astro';
import { industries, categoryMenu, industriesIn } from '../../data/industries';
import { breadcrumbs } from '../../lib/jsonld';

const menu = categoryMenu();
// The symbol id is the category slug; "all" carries its own glyph.
const railItems = [
  { label: 'all', href: '/industries', count: industries.length, symbol: 'all' },
  ...menu.map((category) => ({
    label: category.name,
    href: `/industries/category/${category.slug}`,
    count: category.count,
    symbol: category.slug,
  })),
];
---

<BaseLayout
  title="Industries — The Linova Group"
  description="One build system, a playbook per vertical: trades, restaurants, clinics, auto, retail, schools, suppliers and more — grouped so you can find yours."
  jsonLd={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Industries', path: '/industries' }])]}
>
  <div class="plot-grid">
    <header class="mx-auto max-w-[1200px] px-6 pb-10 pt-24">
      <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
        <p class="label-caps">industries</p>
      </div>
      <h1 class="mt-4 max-w-[18ch] font-display text-display text-film">
        Designed for your Industry
      </h1>
      <p class="mt-5 max-w-[54ch] text-body text-film-dim">
        We've done the work to find what works for your industry. Pick your
        group, then find the line that describes what you actually do.
      </p>
    </header>
  </div>

  {/* Both ways of narrowing the list, in one band. The rail is real pages
      with real URLs; the search is for someone who knows their trade but not
      its group. They were two blocks with a gap between them, which read as
      two unrelated controls. */}
  <SectionRail label="Industry groups" active="/industries" items={railItems}>
    <IndustrySearch total={industries.length} />
  </SectionRail>

  <div class="plot-grid pb-4">
    {menu.map((category, i) => (
      <section
        class:list={['pb-16 pt-14', i > 0 && 'border-t border-gold/40']}
        aria-labelledby={`group-${category.slug}`}
        data-industry-group
      >
        <div class="mx-auto max-w-[1200px] px-6 pb-6">
          <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1">
            <h2 id={`group-${category.slug}`} class="m-0 font-display text-heading text-film">
              <a href={`/industries/category/${category.slug}`} class="no-underline hover:text-gold">
                {category.name}
              </a>
            </h2>

          </div>
          <p class="mt-2 max-w-[64ch] text-caption text-film-dim">{category.blurb}</p>
        </div>
        <IndustryCards items={industriesIn(category.slug)} />
      </section>
    ))}

    <div class="mx-auto max-w-[1200px] px-6 py-20">
      <p class="max-w-[52ch] text-body text-film-dim">
        Not on the list? The system doesn't care what you sell — the playbook
        just hasn't been written yet.{' '}
        <a href="/book" class="text-gold underline decoration-1 underline-offset-4">Book a call</a>{' '}
        and we'll write it on the spot.
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  import { magnetic } from '../../lib/motion';
  document
    .querySelectorAll<HTMLElement>('[data-magnetic-row]')
    .forEach((row) => magnetic(row, 0.02, 4));
</script>
