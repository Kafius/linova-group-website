---
// Lakeshore demo — services and fees.
//
// CMS-DRIVEN: renders the `clinicService` collection modelled in the .cms.ts
// stub. Every description says what happens in the appointment; none says what
// it is for. That rule is enforced in the CMS field description too.
import DemoLayout from '../../../../../layouts/DemoLayout.astro';
import { chrome, routes } from '../../../../../lib/demos/lakeshoreChrome';
import { demoBreadcrumbs } from '../../../../../lib/demos/lakeshoreJsonld';
import {
  business,
  groups,
  pageMeta,
  servicesIn,
  servicesPage,
} from '../../../../../data/demos/clinic-practitioner';

const meta = pageMeta.services;
const sections = groups.map((group) => ({ ...group, items: servicesIn(group.id) }));
---

<DemoLayout
  {...chrome}
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  current={routes.services}
  jsonLd={[
    demoBreadcrumbs([
      { name: business.shortName, path: routes.home },
      { name: meta.breadcrumb, path: routes.services },
    ]),
  ]}
>
  <header class="bay sv-head">
    <div class="wrap">
      <p class="eyebrow">{servicesPage.eyebrow}</p>
      <h1 class="sv-title">{servicesPage.heading}</h1>
      <hr class="rule" />
      <p class="lede sv-lede">{servicesPage.intro}</p>
    </div>
  </header>

  <section class="bay" aria-label={servicesPage.heading}>
    <div class="wrap">
      {sections.map((section) => (
        <section class="group" aria-labelledby={`g-${section.id}`}>
          <h2 class="group__name" id={`g-${section.id}`}>{section.name}</h2>
          <p class="group__blurb">{section.blurb}</p>
          <ul class="list">
            {section.items.map((service) => (
              <li class="row">
                <div>
                  <h3 class="row__name">{service.name}</h3>
                  <p class="row__desc">{service.description}</p>
                  {service.requires && <p class="row__req">{service.requires}</p>}
                </div>
                <div class="row__meta">
                  {service.minutes !== null && (
                    <span class="row__time">{service.minutes} {servicesPage.durationLabel}</span>
                  )}
                  <span class="row__price">
                    {service.from && <span class="row__from">{servicesPage.fromLabel}</span>}
                    ${service.price}
                  </span>
                  <a class="row__book" href={routes.booking} data-analytics-event="booking_cta_service">
                    {servicesPage.bookCta}
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <p class="fee-note">{servicesPage.feeNote}</p>
      <a class="btn btn--fill sv-cta" href={routes.booking} data-analytics-event="booking_cta_services">
        {servicesPage.allCta}
      </a>
    </div>
  </section>
</DemoLayout>

<style>
  .sv-head {
    padding-bottom: 0;
  }
  .sv-title {
    font-size: var(--fs-display);
    max-width: 18ch;
  }
  .sv-lede {
    margin-top: 1.5rem;
    max-width: 56ch;
  }

  .group {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .group__name {
    font-size: var(--fs-title);
  }
  .group__blurb {
    margin-top: 0.85rem;
    max-width: 60ch;
    color: var(--on-ink-dim);
  }
  .list {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    border-top: 2px solid var(--accent);
  }
  .row {
    display: grid;
    gap: 1rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--ink-line);
  }
  @media (min-width: 780px) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      gap: 3rem;
    }
  }
  .row__name {
    font-size: var(--fs-heading);
  }
  .row__desc {
    margin-top: 0.6rem;
    max-width: 60ch;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
  }
  .row__req {
    margin-top: 0.65rem;
    display: inline-block;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--ink-line);
    border-radius: var(--radius);
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--accent);
  }
  .row__meta {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }
  @media (min-width: 780px) {
    .row__meta {
      justify-content: flex-end;
      min-width: 17rem;
    }
  }
  .row__time {
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .row__price {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 600;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    text-align: right;
  }
  .row__from {
    display: block;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--on-ink-dim);
  }
  .row__book {
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--accent);
    text-underline-offset: 5px;
    white-space: nowrap;
  }
  .fee-note {
    margin-top: 1rem;
    max-width: 60ch;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
  }
  .sv-cta {
    margin-top: 2rem;
  }
</style>
