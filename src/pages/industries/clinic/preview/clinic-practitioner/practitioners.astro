---
// Lakeshore demo — practitioners.
//
// CMS-DRIVEN: renders the `practitioner` collection. Credentials are listed as
// degrees and college registrations only — no specialisms that are not a
// protected title, and no claims about what anyone is good at treating.
import DemoLayout from '../../../../../layouts/DemoLayout.astro';
import DemoImage from '../../../../../components/demos/DemoImage.astro';
import { chrome, routes } from '../../../../../lib/demos/lakeshoreChrome';
import { demoBreadcrumbs } from '../../../../../lib/demos/lakeshoreJsonld';
import {
  business,
  groups,
  pageMeta,
  practitioners,
  practitionersPage,
} from '../../../../../data/demos/clinic-practitioner';

const meta = pageMeta.practitioners;
const people = practitioners.map((person) => ({
  ...person,
  groupNames: person.groups
    .map((id) => groups.find((g) => g.id === id)?.name)
    .filter((name): name is string => Boolean(name)),
}));
---

<DemoLayout
  {...chrome}
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  current={routes.practitioners}
  jsonLd={[
    demoBreadcrumbs([
      { name: business.shortName, path: routes.home },
      { name: meta.breadcrumb, path: routes.practitioners },
    ]),
  ]}
>
  <header class="bay pr-head">
    <div class="wrap">
      <p class="eyebrow">{practitionersPage.eyebrow}</p>
      <h1 class="pr-title">{practitionersPage.heading}</h1>
      <hr class="rule" />
      <p class="lede pr-lede">{practitionersPage.intro}</p>
    </div>
  </header>

  <section class="bay" aria-label={practitionersPage.heading}>
    <div class="wrap">
      <ul class="people">
        {people.map((person) => (
          <li class="person">
            <DemoImage
              demo="clinic-practitioner"
              file={person.photo.file}
              subject={person.photo.subject}
              alt={person.photo.alt}
              ratio="4 / 5"
              sizes="(min-width: 900px) 26vw, 90vw"
              widths={[340, 520, 700]}
              class="person__shot"
            />
            <div>
              <h2 class="person__name">{person.name}, {person.designation}</h2>
              <p class="person__role">{person.role}</p>
              <p class="person__bio">{person.bio}</p>

              <h3 class="person__label">{practitionersPage.credentialsLabel}</h3>
              <ul class="creds">
                {person.credentials.map((credential) => <li>{credential}</li>)}
              </ul>

              <p class="person__sees">
                <span class="person__sees-label">{practitionersPage.seesLabel}</span>
                {person.groupNames.join(' · ')}
              </p>
            </div>
          </li>
        ))}
      </ul>

      <p class="register-note">{practitionersPage.registerNote}</p>
      <a class="btn btn--fill pr-cta" href={routes.booking} data-analytics-event="booking_cta_practitioners">
        {practitionersPage.bookCta}
      </a>
    </div>
  </section>
</DemoLayout>

<style>
  .pr-head {
    padding-bottom: 0;
  }
  .pr-title {
    font-size: var(--fs-display);
    max-width: 16ch;
  }
  .pr-lede {
    margin-top: 1.5rem;
    max-width: 54ch;
  }

  .people {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem);
  }
  .person {
    display: grid;
    gap: 1.75rem;
    padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--ink-line);
  }
  .person:last-of-type {
    border-bottom: 0;
  }
  @media (min-width: 800px) {
    .person {
      grid-template-columns: 18rem minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
    }
  }
  .person :global(.person__shot) {
    border-radius: var(--radius);
  }
  .person__name {
    font-size: var(--fs-title);
  }
  .person__role {
    margin-top: 0.4rem;
    font-weight: 700;
    color: var(--accent);
  }
  .person__bio {
    margin-top: 1.1rem;
    max-width: 56ch;
    color: var(--on-ink-dim);
  }
  .person__label {
    margin-top: 1.75rem;
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: 700;
  }
  .creds {
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
    max-width: 52ch;
  }
  .creds li {
    padding-left: 1.6rem;
    position: relative;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
  }
  .creds li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.8rem;
    height: 2px;
    background: var(--accent);
  }
  .person__sees {
    margin-top: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--ink-line);
    font-size: var(--fs-small);
  }
  .person__sees-label {
    display: block;
    font-weight: 700;
    margin-bottom: 0.3rem;
  }
  .register-note {
    margin-top: 2.5rem;
    padding-left: 1.1rem;
    border-left: 2px solid var(--accent);
    max-width: 60ch;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
  }
  .pr-cta {
    margin-top: 2rem;
  }
</style>
