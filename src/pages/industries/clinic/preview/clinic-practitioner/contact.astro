---
// Lakeshore demo — contact, hours and access.
//
// Carries an "if it is urgent" block. A clinic website is not monitored and is
// not an emergency service, and saying so plainly — with 911 and Health
// Connect Ontario's 811 — is the responsible thing for a health site to do.
import DemoMap from '../../../../../components/demos/DemoMap.astro';
import DemoLayout from '../../../../../layouts/DemoLayout.astro';
import { chrome, routes } from '../../../../../lib/demos/lakeshoreChrome';
import { demoBreadcrumbs } from '../../../../../lib/demos/lakeshoreJsonld';
import { business, contact, hours, pageMeta } from '../../../../../data/demos/clinic-practitioner';
import { formatTime } from '../../../../../lib/demos/shared';

const meta = pageMeta.contact;
const hourRows = hours.map((day) => ({
  day: day.day,
  open: day.closed ? contact.closedLabel : `${formatTime(day.open)} – ${formatTime(day.close)}`,
  closed: Boolean(day.closed),
}));
---

<DemoLayout
  {...chrome}
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  current={routes.contact}
  jsonLd={[
    demoBreadcrumbs([
      { name: business.shortName, path: routes.home },
      { name: meta.breadcrumb, path: routes.contact },
    ]),
  ]}
>
  <header class="bay ct-head">
    <div class="wrap">
      <p class="eyebrow">{contact.eyebrow}</p>
      <h1 class="ct-title">{contact.heading}</h1>
      <hr class="rule" />
    </div>
  </header>

  <!-- ── Urgent notice, first because it matters most ────────────────── -->
  <section class="wrap">
    <aside class="urgent" aria-labelledby="urgent-h">
      <h2 id="urgent-h" class="urgent__h">{contact.urgentHeading}</h2>
      <p class="urgent__b">{contact.urgentBody}</p>
    </aside>
  </section>

  <section class="wrap ct-grid">
    <div class="details">
      <div class="detail">
        <h2 class="detail__h">{contact.addressHeading}</h2>
        <address class="detail__address">
          <span>{business.address.street}</span>
          <span>{business.address.neighbourhood}, {business.address.city}</span>
          <span>{business.address.region} {business.address.postalCode}</span>
        </address>
      </div>
      <div class="detail">
        <h2 class="detail__h">{contact.phoneHeading}</h2>
        <a class="detail__phone" href={business.phoneHref} data-analytics-event="phone_tap_contact">
          {business.phone}
        </a>
      </div>
      <div class="detail">
        <h2 class="detail__h">{contact.emailHeading}</h2>
        <a class="detail__link" href={business.emailHref}>{business.email}</a>
      </div>
      <a class="btn btn--fill" href={routes.booking} data-analytics-event="booking_cta_contact">
        {contact.bookCta}
      </a>
    </div>

    <DemoMap label={contact.mapLabel} seed="clinic-practitioner" />
  </section>

  <section class="bay" aria-labelledby="hours-h">
    <div class="wrap">
      <h2 id="hours-h" class="section-title">{contact.hoursHeading}</h2>
      <hr class="rule" />
      <p class="note">{contact.hoursNote}</p>
      <table class="hours">
        <thead>
          <tr>
            <th scope="col">{contact.hoursTable.day}</th>
            <th scope="col">{contact.hoursTable.open}</th>
          </tr>
        </thead>
        <tbody>
          {hourRows.map((row) => (
            <tr class:list={[row.closed && 'is-closed']}>
              <th scope="row">{row.day}</th>
              <td>{row.open}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="bay on-paper" aria-labelledby="here-h">
    <div class="wrap">
      <h2 id="here-h" class="section-title">{contact.gettingHereHeading}</h2>
      <hr class="rule" />
      <dl class="here">
        {contact.gettingHere.map((entry) => (
          <div>
            <dt class="here__t">{entry.title}</dt>
            <dd class="here__d">{entry.detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</DemoLayout>

<style>
  .section-title {
    font-size: var(--fs-title);
  }
  .ct-head {
    padding-bottom: 0;
  }
  .ct-title {
    font-size: var(--fs-display);
    max-width: 16ch;
  }
  .note {
    margin-top: 1.25rem;
    max-width: 54ch;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
  }

  .urgent {
    margin-top: 2.5rem;
    padding: 1.75rem;
    border: 2px solid var(--accent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--accent) 5%, transparent);
    max-width: 60rem;
  }
  .urgent__h {
    font-size: var(--fs-heading);
    color: var(--accent);
  }
  .urgent__b {
    margin-top: 0.75rem;
    max-width: 62ch;
  }

  .ct-grid {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 900px) {
    .ct-grid {
      grid-template-columns: 1fr 1.1fr;
      gap: 4rem;
      align-items: start;
    }
  }
  .details {
    display: grid;
    gap: 2.5rem;
    justify-items: start;
  }
  .detail__h {
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }
  .detail__address {
    font-style: normal;
    display: grid;
    gap: 0.2rem;
    font-size: clamp(1.08rem, 1rem + 0.3vw, 1.22rem);
  }
  .detail__phone {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 1.5rem + 1.5vw, 2.7rem);
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .detail__link {
    font-size: clamp(1.08rem, 1rem + 0.3vw, 1.22rem);
    text-underline-offset: 5px;
  }


  .hours {
    margin-top: 2rem;
    width: 100%;
    max-width: 34rem;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .hours th,
  .hours td {
    text-align: left;
    padding: 0.9rem 0.75rem 0.9rem 0;
    border-bottom: 1px solid var(--ink-line);
  }
  .hours thead th {
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--accent);
    border-bottom: 2px solid var(--accent);
  }
  .hours tbody th {
    font-weight: 700;
  }
  .hours td {
    color: var(--on-ink-dim);
    text-align: right;
  }
  .hours .is-closed th,
  .hours .is-closed td {
    color: color-mix(in srgb, var(--on-ink) 62%, transparent);
  }

  .here {
    margin: 2.25rem 0 0;
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 800px) {
    .here {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }
  .here__t {
    font-family: var(--font-display);
    font-size: var(--fs-heading);
    font-weight: 600;
    color: var(--accent-paper);
  }
  .here__d {
    margin: 0.7rem 0 0;
    font-size: var(--fs-small);
    color: var(--on-paper-dim);
  }
</style>
