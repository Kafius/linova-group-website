---
// Halden demo — Delivery & Financing.
//
// The financing section deliberately quotes no rate. Equal-payment plans run
// through a third-party provider; the rate, the fees and the cost of borrowing
// are the provider's to disclose on the application. A furniture site that
// publishes "0% for 24 months" as a headline is making a regulated claim on
// somebody else's behalf, and this demo will not model that for a client.
import DemoLayout from '../../../../../layouts/DemoLayout.astro';
import { chrome, routes } from '../../../../../lib/demos/haldenChrome';
import { demoBreadcrumbs } from '../../../../../lib/demos/haldenJsonld';
import {
  business,
  deliveryPage,
  formatPrice,
  pageMeta,
} from '../../../../../data/demos/retail-large-catalogue';

const meta = pageMeta.delivery;
---

<DemoLayout
  {...chrome}
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  current={routes.delivery}
  jsonLd={[
    demoBreadcrumbs([
      { name: business.shortName, path: routes.home },
      { name: meta.breadcrumb, path: routes.delivery },
    ]),
  ]}
>
  <header class="bay dl-head">
    <div class="wrap">
      <p class="eyebrow">{deliveryPage.eyebrow}</p>
      <h1 class="dl-title">{deliveryPage.heading}</h1>
      <p class="lede dl-lede">{deliveryPage.intro}</p>
    </div>
  </header>

  <!-- ── Rates ───────────────────────────────────────────────────────── -->
  <section class="bay dl-zones" aria-labelledby="zones-h">
    <div class="wrap">
      <h2 id="zones-h" class="section-title">{deliveryPage.zonesHeading}</h2>
      <p class="section-body">{deliveryPage.zonesNote}</p>
      <table class="zones">
        <tbody>
          {deliveryPage.zones.map((zone) => (
            <tr>
              <th scope="row" class="zones__zone">{zone.zone}</th>
              <td class="zones__days">{zone.days}</td>
              <td class="zones__price">${formatPrice(zone.price)}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <h3 class="sub-h">{deliveryPage.includedHeading}</h3>
      <ul class="included">
        {deliveryPage.included.map((line) => <li class="included__item">{line}</li>)}
      </ul>
    </div>
  </section>

  <!-- ── Appliances, on the wine band ────────────────────────────────── -->
  <section class="bay on-paper" aria-labelledby="app-h">
    <div class="wrap">
      <h2 id="app-h" class="section-title">{deliveryPage.applianceHeading}</h2>
      <p class="section-body section-body--paper">{deliveryPage.applianceBody}</p>
      <dl class="steps">
        {deliveryPage.appliancePoints.map((point) => (
          <div class="step">
            <dt class="step__k">{point.title}</dt>
            <dd class="step__v">{point.detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ── Deposit and financing ───────────────────────────────────────── -->
  <section class="bay" aria-labelledby="dep-h">
    <div class="wrap money">
      <div>
        <h2 id="dep-h" class="section-title">{deliveryPage.depositHeading}</h2>
        <p class="section-body">{deliveryPage.depositBody}</p>
        <dl class="terms">
          {deliveryPage.depositTerms.map((term) => (
            <div class="term">
              <dt class="term__k">{term.label}</dt>
              <dd class="term__v">{term.value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div>
        <h2 class="section-title">{deliveryPage.financeHeading}</h2>
        <p class="section-body">{deliveryPage.financeBody}</p>
        <ul class="fin">
          {deliveryPage.financePoints.map((point) => <li class="fin__item">{point}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="bay closer">
    <div class="wrap closer__in">
      <div>
        <h2 class="section-title">{deliveryPage.ctaHeading}</h2>
        <p class="section-body">{deliveryPage.ctaBody}</p>
      </div>
      <a class="btn btn--fill" href={business.phoneHref} data-analytics-event="phone_tap_delivery">
        {business.phone}
      </a>
    </div>
  </section>
</DemoLayout>

<style>
  .section-title {
    font-size: var(--fs-title);
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .section-body {
    margin-top: 1rem;
    max-width: 54ch;
    color: var(--on-ink-dim);
  }
  .section-body--paper {
    color: var(--on-paper-dim);
  }
  .sub-h {
    margin-top: 2.5rem;
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .dl-head {
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .dl-title {
    margin-top: 1.25rem;
    font-size: var(--fs-display);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.06;
    max-width: 16ch;
  }
  .dl-lede {
    margin-top: 1.5rem;
    max-width: 52ch;
  }
  .dl-zones {
    padding-top: 0;
  }

  .zones {
    margin-top: 1.75rem;
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .zones th,
  .zones td {
    text-align: left;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--ink-line);
    vertical-align: baseline;
  }
  .zones tr:first-child th,
  .zones tr:first-child td {
    border-top: 1px solid var(--ink-line);
  }
  .zones__zone {
    font-weight: 400;
    font-size: var(--fs-small);
    padding-right: 1rem;
  }
  .zones__days {
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
    white-space: nowrap;
    padding-right: 1rem;
  }
  .zones__price {
    text-align: right;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }

  .included {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .included__item {
    position: relative;
    padding-left: 1.5rem;
    font-size: var(--fs-small);
    line-height: 1.55;
    max-width: 62ch;
  }
  .included__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.85rem;
    height: 1px;
    background: var(--accent);
  }

  /* ── Appliance steps ──────────────────────────────────────────────── */
  .steps {
    margin: 2.25rem 0 0;
    display: grid;
    gap: 1px;
    background: var(--paper-line);
    border: 1px solid var(--paper-line);
  }
  @media (min-width: 780px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1180px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .step {
    padding: 1.5rem 1.4rem;
    background: var(--paper);
  }
  .step__k {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--accent-paper);
  }
  .step__v {
    margin: 0.7rem 0 0;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--on-paper-dim);
  }

  /* ── Money ────────────────────────────────────────────────────────── */
  .money {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 940px) {
    .money {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
      align-items: start;
    }
  }
  .terms {
    margin: 1.75rem 0 0;
    border-top: 1px solid var(--ink-line);
  }
  .term {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--ink-line);
  }
  .term__k {
    font-size: var(--fs-small);
  }
  .term__v {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--accent);
  }
  .fin {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    border-top: 1px solid var(--ink-line);
  }
  .fin__item {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--ink-line);
    font-size: var(--fs-small);
    line-height: 1.55;
  }

  .closer {
    background: var(--ink-raised);
    border-top: 1px solid var(--ink-line);
  }
  .closer__in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
</style>
