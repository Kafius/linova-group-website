---
// /industries/[slug] — one page per vertical, fully data-driven. Live
// verticals show real proof; concept verticals show the honest spec piece.
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndustryPhoto from '../../components/industries/IndustryPhoto.astro';
import SiteMockup from '../../components/industries/SiteMockup.astro';
import Covers from '../../components/industries/Covers.astro';
import PlaybookPanel from '../../components/industries/PlaybookPanel.astro';
import SiteEmbed from '../../components/industries/SiteEmbed.astro';
import { industries, getCategory, type Industry } from '../../data/industries';
import { proofShots } from '../../data/proofShots';
import { getMockup } from '../../data/industryMockups';
import { embeddableDemosFor } from '../../data/playbooks';
import { breadcrumbs, service } from '../../lib/jsonld';

export function getStaticPaths() {
  return industries.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry },
  }));
}

interface Props {
  industry: Industry;
}

const { industry } = Astro.props;
const shot = proofShots[industry.slug];
const isConcept = industry.status === 'concept';
const mockup = getMockup(industry.slug);
// Where a vertical has built sample sites, the frame shows the real things.
// The drawn mockup stays the fallback for the verticals that don't yet.
const builtDemos = embeddableDemosFor(industry.slug);
const leadDemo = builtDemos[0];
const category = getCategory(industry.category);
---

<BaseLayout
  title={industry.seo.title}
  description={industry.seo.description}
  jsonLd={[
    service(`Web design & marketing for ${industry.name.toLowerCase()}`, industry.seo.description, industry.slug),
    breadcrumbs([
      { name: 'Home', path: '/' },
      { name: 'Industries', path: '/industries' },
      { name: industry.name, path: `/industries/${industry.slug}` },
    ]),
  ]}
  pageEvent={{ name: 'industry_view', params: { industry: industry.slug } }}
>
  <article style={`--vx: ${industry.accent}`}>
    <!-- Hero -->
    <header class="plot-grid relative overflow-hidden">
      {/* The vertical's own photograph, the same one the directory card uses,
          rather than the plotted motif. It is the real subject beside the
          headline instead of a decoration, so it carries its alt text and is
          not aria-hidden. Still absolute and still hidden below lg: the
          headline owns the fold on a phone. */}
      <div class="pointer-events-none absolute inset-y-0 right-[3vw] hidden w-[34%] max-w-[460px] items-center lg:flex">
        <IndustryPhoto
          slug={industry.slug}
          name={industry.name}
          subject={industry.heroPhoto.subject}
          alt={industry.heroPhoto.alt}
          sizes="(min-width: 1024px) 460px, 34vw"
          widths={[460, 700, 920]}
          eager
          class="aspect-[3/2] w-full"
        />
      </div>
      <div class="relative mx-auto max-w-[1200px] px-6 pb-16 pt-24">
        <nav class="label-caps" aria-label="Breadcrumb">
          <a href="/industries" class="hover:text-film">industries</a>
          {category && (
            <>
              <span aria-hidden="true"> / </span>
              <a href={`/industries/category/${category.slug}`} class="hover:text-film">
                {category.name.toLowerCase()}
              </a>
            </>
          )}
          <span aria-hidden="true"> / </span>
          <span style="color: var(--vx)">{industry.name.toLowerCase()}</span>
        </nav>
        <h1 class="mt-6 max-w-[16ch] font-display text-display text-film">
          {industry.headline}
        </h1>
        <p class="mt-6 max-w-[58ch] text-body text-film-dim">{industry.problem}</p>
        <Covers items={industry.covers} label="built for" class="mt-7 max-w-[62ch]" />
        <a
          href="/book"
          data-hero-cta
          class="mt-10 inline-block rounded-chip border border-gold px-6 py-3 text-body text-film transition-colors hover:border-redline"
        >
          Book a call
        </a>
      </div>
    </header>

    <!-- Approach -->
    <section class="mx-auto max-w-[1200px] px-6 py-20" aria-label="What we do differently">
      <h2 class="font-display text-title text-film">What we do differently</h2>
      <hr class="rule-gold mt-3" />
      <dl class="m-0 grid gap-x-12 gap-y-10 pt-10 md:grid-cols-2">
        {industry.approach.map((item) => (
          <div class="max-w-[52ch]">
            <dt class="text-heading font-medium text-film">{item.title}</dt>
            <dd class="m-0 mt-2 text-body text-film-dim">{item.detail}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Marketing angles -->
    <section class="border-y border-grid/30 bg-ink" aria-label="The marketing plays">
      <div class="mx-auto max-w-[1200px] px-6 py-20">
        <h2 class="font-display text-title text-film">The marketing plays</h2>
        <p class="mt-3 max-w-[58ch] text-body text-film-dim">
          Written for {industry.name.toLowerCase()} — not recycled from another
          industry with the nouns swapped. This is the human half of the shop.
        </p>
        <div class="mt-10 grid gap-px border border-grid/40 bg-grid/40 md:grid-cols-2">
          {industry.marketingAngles.map((angle) => (
            <div class="bg-ink p-6 sm:p-8">
              <p class="label-caps" style="color: var(--vx)">{angle.channel}</p>
              <p class="m-0 mt-3 max-w-[52ch] text-body text-film-dim">{angle.angle}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- What we'd build — the interactive spec build, for every vertical.
         The old industry pages each carried one of these and it was the
         thing people actually played with; it is back, and no longer
         limited to the two verticals without a client. -->
    {(leadDemo || mockup) && (
      <section id="spec-build" class="mx-auto max-w-[1200px] px-6 py-20" aria-label="What we'd build">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="font-display text-title text-film">
            {isConcept && !leadDemo
              ? "No client yet. Here's the spec work."
              : `What we'd build for ${industry.cycleWord}`}
          </h2>
          {/* Only the spec-work case is labelled. A built sample site is the
              expected state and saying "built" over it was noise; the copy
              underneath already says it is the finished one. */}
          {!leadDemo && (
            <span class="label-caps hidden shrink-0 sm:block" style="color: var(--vx)">
              spec build
            </span>
          )}
        </div>
        <hr class="rule-gold mt-3" />
        <p class="mt-6 max-w-[58ch] text-body text-film-dim">
          {leadDemo
            ? builtDemos.length > 1
              ? `Not drawings of a ${industry.railWord} site — the finished ones, ${builtDemos.length} packages built to the specs this page describes. They are sample businesses, not clients, and every page of them says so.`
              : `Not a drawing of a ${industry.railWord} site — the finished one, on the ${leadDemo.packageTier} spec this page describes. It is a sample business, not a client, and it says so on every page of it.`
            : isConcept
              ? industry.conceptPitch
              : `A ${industry.name.toLowerCase().replace(/^b2b & /, '')} site built the way this page describes — click through the pages, flip it to a phone, and hold it against what you have now. It is spec work, not a client; the real one is below.`}
        </p>
        <div class="mt-10">
          {leadDemo ? (
            <SiteEmbed playbooks={builtDemos} slug={industry.slug} accent={industry.accent} />
          ) : (
            mockup && <SiteMockup mockup={mockup} slug={industry.slug} accent={industry.accent} />
          )}
        </div>
      </section>
    )}

    <!-- The package — what a build for this vertical actually includes, and
         the sample site built to that spec. Renders only for verticals that
         have a playbook pointed at them in src/data/playbooks.ts. -->
    <PlaybookPanel industrySlug={industry.slug} accent={industry.accent} />

    <!-- Proof — the live client site, for verticals that have one -->
    {!isConcept && (
      <section class="border-t border-grid/30 bg-ink" aria-label="Proof">
        <div class="mx-auto max-w-[1200px] px-6 py-20">
          <div class="grid items-start gap-10 lg:grid-cols-[1fr_1.1fr]">
            <div>
              <h2 class="font-display text-title text-film">Live for {industry.proof?.client}</h2>
              <p class="mt-4 max-w-[52ch] text-body text-film-dim">
                Not a mockup — a working site with real customers on it. Open it,
                tap around, check the speed on your own phone.
              </p>
              <a
                href={industry.proof?.url}
                target="_blank"
                rel="noopener"
                class="label-caps mt-6 inline-block py-1.5 normal-case tracking-normal underline decoration-1 underline-offset-4 hover:text-film"
              >
                visit {industry.proof?.client} ↗
              </a>
            </div>
            {shot && (
              <a href={industry.proof?.url} target="_blank" rel="noopener" class="group block overflow-hidden border border-grid/40">
                <Image
                  src={shot}
                  alt={`${industry.proof?.client} — live site`}
                  widths={[640, 1024, 1440]}
                  sizes="(min-width: 1024px) 55vw, 100vw"
                  class="block h-auto w-full transition-transform duration-500 group-hover:scale-[1.015]"
                  loading="lazy"
                />
              </a>
            )}
          </div>
        </div>
      </section>
    )}

    <!-- Close -->
    <section class="border-t border-grid/30 bg-ink">
      <div class="mx-auto max-w-[1200px] px-6 py-20">
        <p class="label-caps">next step</p>
        <a href="/book" class="mt-4 inline-block font-display text-display text-film no-underline transition-colors hover:text-gold">
          Book a call<span class="text-redline">.</span>
        </a>
        <p class="mt-4 max-w-[52ch] text-body text-film-dim">
          Twenty minutes, straight answers, and a read on what a
          {' '}{industry.name.toLowerCase()} build would look like for you.
        </p>
      </div>
    </section>
  </article>
</BaseLayout>
