---
// The Foundry demo — Contact and viewings. No enquiry form here: Check a Date
// already takes an enquiry with the dates attached, and a second form on this
// page would arrive with less information and the same amount of work.
import DemoLayout from '../../../../../layouts/DemoLayout.astro';
import { chrome, routes } from '../../../../../lib/demos/foundryChrome';
import { demoBreadcrumbs } from '../../../../../lib/demos/foundryJsonld';
import {
  business,
  contactPage,
  pageMeta,
  viewingHours,
} from '../../../../../data/demos/venue-event-space';
import { formatTime } from '../../../../../lib/demos/shared';

const meta = pageMeta.contact;
const hourRows = viewingHours.map((day) => ({
  day: day.day,
  open: `${formatTime(day.open)} – ${formatTime(day.close)}`,
}));
---

<DemoLayout
  {...chrome}
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  current={routes.contact}
  jsonLd={[
    demoBreadcrumbs([
      { name: business.shortName, path: routes.home },
      { name: meta.breadcrumb, path: routes.contact },
    ]),
  ]}
>
  <header class="bay ct-head">
    <div class="wrap">
      <p class="eyebrow">{contactPage.eyebrow}</p>
      <h1 class="ct-title">{contactPage.heading}</h1>
    </div>
  </header>

  <section class="wrap ct-grid">
    <div class="details">
      <div class="detail">
        <h2 class="detail__h">{contactPage.addressHeading}</h2>
        <address class="detail__address">
          <span>{business.address.street}</span>
          <span>{business.address.neighbourhood}</span>
          <span>{business.address.city}, {business.address.region} {business.address.postalCode}</span>
        </address>
      </div>
      <div class="detail">
        <h2 class="detail__h">{contactPage.phoneHeading}</h2>
        <a class="detail__phone" href={business.phoneHref} data-analytics-event="phone_tap_contact">
          {business.phone}
        </a>
      </div>
      <div class="detail">
        <h2 class="detail__h">{contactPage.emailHeading}</h2>
        <a class="detail__link" href={business.emailHref}>{business.email}</a>
      </div>
    </div>

    <div class="map" role="img" aria-label={contactPage.mapLabel}>
      <span class="map__label">{contactPage.mapLabel}</span>
      <svg class="map__cross" aria-hidden="true" preserveAspectRatio="none">
        <line x1="0" y1="0" x2="100%" y2="100%" stroke="currentColor" stroke-width="1" opacity="0.25" />
        <line x1="100%" y1="0" x2="0" y2="100%" stroke="currentColor" stroke-width="1" opacity="0.25" />
      </svg>
    </div>
  </section>

  <!-- ── Viewings ────────────────────────────────────────────────────── -->
  <section class="bay" aria-labelledby="hours-h">
    <div class="wrap">
      <h2 id="hours-h" class="section-title">{contactPage.hoursHeading}</h2>
      <hr class="rule" />
      <p class="section-body">{contactPage.hoursNote}</p>
      <table class="hours">
        <thead>
          <tr>
            <th scope="col">{contactPage.hoursTable.day}</th>
            <th scope="col">{contactPage.hoursTable.open}</th>
          </tr>
        </thead>
        <tbody>
          {hourRows.map((row) => (
            <tr>
              <th scope="row">{row.day}</th>
              <td>{row.open}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── Getting here, on the brick band ─────────────────────────────── -->
  <section class="bay on-paper" aria-labelledby="here-h">
    <div class="wrap">
      <h2 id="here-h" class="section-title">{contactPage.gettingHereHeading}</h2>
      <hr class="rule" />
      <dl class="here">
        {contactPage.gettingHere.map((entry) => (
          <div class="here__item">
            <dt class="here__k">{entry.title}</dt>
            <dd class="here__v">{entry.detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="bay closer">
    <div class="wrap closer__in">
      <div>
        <h2 class="closer__title">{contactPage.ctaHeading}</h2>
        <p class="section-body">{contactPage.ctaBody}</p>
      </div>
      <a class="btn btn--fill" href={routes.checkADate} data-analytics-event="date_cta_contact">
        {contactPage.cta}
      </a>
    </div>
  </section>
</DemoLayout>

<style>
  .section-title {
    font-size: var(--fs-title);
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .section-body {
    margin-top: 1rem;
    max-width: 56ch;
    color: var(--on-ink-dim);
  }
  .ct-head {
    padding-bottom: 0;
  }
  .ct-title {
    margin-top: 1.25rem;
    font-size: var(--fs-display);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .ct-grid {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .ct-grid {
      grid-template-columns: 1fr 1.1fr;
      gap: 3.5rem;
      align-items: start;
    }
  }
  .details {
    display: grid;
    gap: 2.25rem;
    justify-items: start;
  }
  .detail__h {
    font-size: var(--fs-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 0.75rem;
    font-family: var(--font-body);
  }
  .detail__address {
    font-style: normal;
    display: grid;
    gap: 0.2rem;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.15rem + 0.6vw, 1.6rem);
    letter-spacing: -0.01em;
  }
  .detail__phone {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 1.5rem + 1.6vw, 2.6rem);
    letter-spacing: -0.02em;
    color: var(--accent);
    text-decoration: none;
  }
  .detail__link {
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    text-underline-offset: 5px;
  }

  .map {
    position: relative;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    text-align: center;
    border: 1px dashed color-mix(in srgb, var(--accent) 45%, transparent);
    background: var(--ink-raised);
    color: var(--accent);
  }
  .map__label {
    font-size: var(--fs-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    max-width: 24ch;
    line-height: 1.7;
  }
  .map__cross {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* ── Viewing hours ────────────────────────────────────────────────── */
  .hours {
    margin-top: 2rem;
    width: 100%;
    max-width: 32rem;
    border-collapse: collapse;
  }
  .hours th,
  .hours td {
    text-align: left;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--ink-line);
  }
  .hours thead th {
    font-size: var(--fs-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--accent);
  }
  .hours tbody th {
    font-weight: 400;
    font-size: var(--fs-small);
  }
  .hours td {
    font-family: var(--font-display);
    font-size: 1.15rem;
    text-align: right;
    color: var(--on-ink-dim);
  }

  /* ── Getting here ─────────────────────────────────────────────────── */
  .here {
    margin: 2.5rem 0 0;
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 780px) {
    .here {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.25rem 3rem;
    }
  }
  .here__k {
    font-family: var(--font-display);
    font-size: 1.4rem;
    letter-spacing: -0.01em;
    color: var(--accent-paper);
  }
  .here__v {
    margin: 0.7rem 0 0;
    font-size: var(--fs-small);
    line-height: 1.65;
    color: var(--on-paper-dim);
    max-width: 46ch;
  }

  .closer {
    border-top: 1px solid var(--ink-line);
  }
  .closer__in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .closer__title {
    font-size: var(--fs-title);
    font-weight: 400;
    letter-spacing: -0.01em;
  }
</style>
