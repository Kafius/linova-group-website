---
// The Foundry demo — home. Layout only: every string comes from
// src/data/demos/venue-event-space.ts.
//
// Register: near-black, quiet, mostly pictures. Text never sits on top of an
// image anywhere in this demo — the full-bleed bands carry no type, which
// keeps every contrast ratio on the page deterministic rather than dependent
// on whatever photograph the client uploads next.
import DemoLayout from '../../../../../layouts/DemoLayout.astro';
import DemoImage from '../../../../../components/demos/DemoImage.astro';
import { chrome, routes } from '../../../../../lib/demos/foundryChrome';
import { eventVenue } from '../../../../../lib/demos/foundryJsonld';
import {
  gallery,
  home,
  included,
  pageMeta,
} from '../../../../../data/demos/venue-event-space';

const meta = pageMeta.home;
const featured = gallery.slice(0, 4);
const useRoutes: Record<string, string> = {
  weddings: routes.weddings,
  corporate: routes.corporate,
};
---

<DemoLayout
  {...chrome}
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  current={routes.home}
  jsonLd={[eventVenue(routes.home, meta.ogImage)]}
>
  <!-- ── Hero ────────────────────────────────────────────────────────── -->
  <section class="bay hero">
    <div class="wrap">
      <p class="eyebrow">{home.heroEyebrow}</p>
      <h1 class="hero__title">{home.heroTitle}</h1>
      <div class="hero__foot">
        <p class="hero__body">{home.heroBody}</p>
        <div class="hero__ctas">
          <a class="btn btn--fill" href={routes.checkADate} data-analytics-event="date_cta_hero">
            {home.heroPrimaryCta}
          </a>
          <a class="btn btn--line" href={routes.space} data-analytics-event="space_view_hero">
            {home.heroSecondaryCta}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Full bleed, no type over it. -->
  <div class="bleed">
    <DemoImage
      demo="venue-event-space"
      file={home.heroPhoto.file}
      subject={home.heroPhoto.subject}
      alt={home.heroPhoto.alt}
      ratio="21 / 9"
      sizes="100vw"
      widths={[900, 1400, 1920]}
      eager
    />
  </div>

  <!-- ── The numbers ─────────────────────────────────────────────────── -->
  <section class="bay" aria-labelledby="fig-h">
    <div class="wrap">
      <h2 id="fig-h" class="label">{home.figuresHeading}</h2>
      <dl class="figures">
        {home.figures.map((figure) => (
          <div class="figure">
            <dt class="figure__value">{figure.value}</dt>
            <dd class="figure__label">{figure.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ── What happens here ───────────────────────────────────────────── -->
  <section class="bay" aria-labelledby="uses-h">
    <div class="wrap">
      <h2 id="uses-h" class="section-title">{home.usesHeading}</h2>
      <hr class="rule" />
      <ul class="uses">
        {home.uses.map((use) => (
          <li class="use">
            <h3 class="use__title">{use.title}</h3>
            <p class="use__detail">{use.detail}</p>
            <a class="use__cta" href={useRoutes[use.href]} data-analytics-event="use_view_home">
              {use.cta}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── What comes with the room — the brick band ───────────────────── -->
  <section class="bay on-paper" aria-labelledby="inc-h">
    <div class="wrap">
      <h2 id="inc-h" class="section-title">{home.includedHeading}</h2>
      <hr class="rule" />
      <p class="section-body section-body--paper">{home.includedBody}</p>
      <dl class="inc">
        {included.map((entry) => (
          <div class="inc__item">
            <dt class="inc__title">{entry.title}</dt>
            <dd class="inc__detail">{entry.detail}</dd>
          </div>
        ))}
      </dl>
      <a class="btn btn--line" href={routes.space} data-analytics-event="space_view_included">
        {home.includedCta}
      </a>
    </div>
  </section>

  <!-- ── Gallery preview ─────────────────────────────────────────────── -->
  <section class="bay" aria-labelledby="gal-h">
    <div class="wrap">
      <div class="head">
        <div>
          <h2 id="gal-h" class="section-title">{home.galleryHeading}</h2>
          <p class="section-body">{home.galleryBody}</p>
        </div>
        <a class="btn btn--line" href={routes.gallery} data-analytics-event="gallery_view_home">
          {home.galleryCta}
        </a>
      </div>
    </div>
    <ul class="strip">
      {featured.map((item) => (
        <li class="strip__cell">
          <DemoImage
            demo="venue-event-space"
            file={item.photo.file}
            subject={item.photo.subject}
            alt={item.photo.alt}
            ratio="3 / 4"
            sizes="(min-width: 900px) 25vw, 50vw"
            widths={[380, 560, 760]}
          />
        </li>
      ))}
    </ul>
  </section>

  <!-- ── Closer ──────────────────────────────────────────────────────── -->
  <section class="bay closer">
    <div class="wrap closer__in">
      <div>
        <h2 class="closer__title">{home.closerHeading}</h2>
        <p class="section-body">{home.closerBody}</p>
      </div>
      <a class="btn btn--fill" href={routes.checkADate} data-analytics-event="date_cta_closer">
        {home.closerCta}
      </a>
    </div>
  </section>
</DemoLayout>

<style>
  /* ── Shared furniture ─────────────────────────────────────────────── */
  .label {
    font-size: var(--fs-label);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--on-ink-dim);
    font-family: var(--font-body);
  }
  .section-title {
    font-size: var(--fs-title);
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .section-body {
    margin-top: 1rem;
    max-width: 54ch;
    color: var(--on-ink-dim);
  }
  .section-body--paper {
    color: var(--on-paper-dim);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
  }

  /* ── Hero. The type is the whole design here. ─────────────────────── */
  .hero {
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .hero__title {
    margin-top: 1.5rem;
    font-size: clamp(2.9rem, 1.6rem + 6.2vw, 6.5rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.025em;
    max-width: 16ch;
  }
  .hero__foot {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 860px) {
    .hero__foot {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 3rem;
    }
  }
  .hero__body {
    max-width: 46ch;
    font-size: clamp(1.05rem, 1rem + 0.45vw, 1.3rem);
    color: var(--on-ink-dim);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Escapes the wrap entirely — the brief asks for full-bleed imagery. */
  .bleed {
    width: 100%;
  }
  .bleed :global(img),
  .bleed :global(picture) {
    display: block;
    width: 100%;
  }

  /* ── Figures. Big quiet numerals in the display face. ─────────────── */
  .figures {
    margin: 2rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 1.5rem;
  }
  @media (min-width: 820px) {
    .figures {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .figure__value {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 2rem + 3.4vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .figure__label {
    margin: 0.9rem 0 0;
    font-size: var(--fs-small);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-ink-dim);
  }

  /* ── Uses ─────────────────────────────────────────────────────────── */
  .uses {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 860px) {
    .uses {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }
  .use {
    border-top: 1px solid var(--ink-line);
    padding-top: 1.5rem;
  }
  .use__title {
    font-size: clamp(1.6rem, 1.35rem + 1.1vw, 2.1rem);
    font-weight: 400;
    letter-spacing: -0.015em;
  }
  .use__detail {
    margin-top: 1rem;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
    max-width: 40ch;
  }
  .use__cta {
    display: inline-block;
    margin-top: 1.35rem;
    font-size: var(--fs-small);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.2rem;
  }

  /* ── Included, on the brick band ──────────────────────────────────── */
  .inc {
    margin: 2.5rem 0 2.5rem;
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 720px) {
    .inc {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.25rem 3rem;
    }
  }
  @media (min-width: 1120px) {
    .inc {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .inc__title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    letter-spacing: -0.01em;
    color: var(--accent-paper);
  }
  .inc__detail {
    margin: 0.7rem 0 0;
    font-size: var(--fs-small);
    line-height: 1.65;
    color: var(--on-paper-dim);
  }

  /* ── Gallery strip. Four tall cells, no gaps, edge to edge. ───────── */
  .strip {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 900px) {
    .strip {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .strip__cell :global(img),
  .strip__cell :global(picture) {
    display: block;
    width: 100%;
  }

  /* ── Closer ───────────────────────────────────────────────────────── */
  .closer {
    border-top: 1px solid var(--ink-line);
  }
  .closer__in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .closer__title {
    font-size: var(--fs-title);
    font-weight: 400;
    letter-spacing: -0.01em;
  }
</style>
