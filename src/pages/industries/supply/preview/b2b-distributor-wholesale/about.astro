---
// Grandview demo — About. The cold chain section is the one a chef reads,
// because it is the part that decides whether the frozen line arrives frozen.
//
// The food-safety copy describes practice — logging, a written program, an
// annual outside audit, mock recalls — rather than claiming a specific
// registration or certification number, which is not ours to invent for a
// fictional business.
import DemoLayout from '../../../../../layouts/DemoLayout.astro';
import { chrome, routes } from '../../../../../lib/demos/grandviewChrome';
import { demoBreadcrumbs } from '../../../../../lib/demos/grandviewJsonld';
import { aboutPage, business, pageMeta } from '../../../../../data/demos/b2b-distributor-wholesale';

const meta = pageMeta.about;
---

<DemoLayout
  {...chrome}
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  current={routes.about}
  jsonLd={[
    demoBreadcrumbs([
      { name: business.shortName, path: routes.home },
      { name: meta.breadcrumb, path: routes.about },
    ]),
  ]}
>
  <header class="bay ab-head">
    <div class="wrap">
      <p class="kicker">{aboutPage.eyebrow}</p>
      <h1 class="ab-title">{aboutPage.heading}</h1>
      <p class="lede ab-lede">{aboutPage.intro}</p>
    </div>
  </header>

  <section class="bay ab-facts" aria-labelledby="facts-h">
    <div class="wrap">
      <h2 id="facts-h" class="kicker">{aboutPage.factsHeading}</h2>
      <dl class="facts">
        {aboutPage.facts.map((fact) => (
          <div class="fact">
            <dt class="fact__v">{fact.value}</dt>
            <dd class="fact__k">{fact.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ── The cold chain, on the slate band ───────────────────────────── -->
  <section class="bay on-paper" aria-labelledby="cold-h">
    <div class="wrap cold">
      <div>
        <h2 id="cold-h" class="section-title">{aboutPage.coldHeading}</h2>
        <p class="section-body section-body--paper">{aboutPage.coldBody}</p>
      </div>
      <ul class="points">
        {aboutPage.coldPoints.map((point) => <li class="point">{point}</li>)}
      </ul>
    </div>
  </section>

  <section class="bay" aria-labelledby="buy-h">
    <div class="wrap two">
      <div>
        <h2 id="buy-h" class="section-title">{aboutPage.buyingHeading}</h2>
        <p class="section-body">{aboutPage.buyingBody}</p>
      </div>
      <div>
        <h2 class="section-title">{aboutPage.peopleHeading}</h2>
        <p class="section-body">{aboutPage.peopleBody}</p>
      </div>
    </div>
  </section>

  <section class="bay closer">
    <div class="wrap closer__in">
      <div>
        <h2 class="section-title">{aboutPage.ctaHeading}</h2>
        <p class="section-body">{aboutPage.ctaBody}</p>
      </div>
      <a class="btn btn--fill" href={routes.contact} data-analytics-event="contact_view_about">
        {aboutPage.ctaLabel}
      </a>
    </div>
  </section>
</DemoLayout>

<style>
  .kicker {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .section-title {
    font-size: var(--fs-title);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .section-body {
    margin-top: 0.9rem;
    max-width: 56ch;
    color: var(--on-ink-dim);
  }
  .section-body--paper {
    color: var(--on-paper-dim);
  }
  .ab-head {
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .ab-title {
    margin-top: 1rem;
    font-size: var(--fs-display);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.06;
    max-width: 20ch;
  }
  .ab-lede {
    margin-top: 1.35rem;
    max-width: 54ch;
  }
  .ab-facts {
    padding-top: 0;
  }
  .facts {
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--ink-line);
    border: 1px solid var(--ink-line);
  }
  @media (min-width: 820px) {
    .facts {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .fact {
    padding: 1.4rem 1.25rem;
    background: var(--ink);
  }
  .fact__v {
    font-family: var(--font-mono);
    font-size: clamp(1.8rem, 1.4rem + 1.7vw, 2.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--accent);
  }
  .fact__k {
    margin: 0.7rem 0 0;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
  }

  .cold {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 940px) {
    .cold {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
      align-items: start;
    }
  }
  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--paper-line);
  }
  .point {
    padding: 0.85rem 0 0.85rem 1.5rem;
    border-bottom: 1px solid var(--paper-line);
    position: relative;
    font-size: var(--fs-small);
    line-height: 1.55;
  }
  .point::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.5em;
    width: 0.85rem;
    height: 2px;
    background: var(--accent-paper);
  }

  .two {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 940px) {
    .two {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
      align-items: start;
    }
  }

  .closer {
    background: var(--ink-raised);
    border-top: 1px solid var(--ink-line);
  }
  .closer__in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
</style>
