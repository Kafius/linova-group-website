---
// Grandview demo — Contact. Two desks on two numbers, because "where is my
// delivery" and "what is this invoice" are answered by different people, and
// putting them on one line is how a Tuesday morning goes wrong.
import DemoMap from '../../../../../components/demos/DemoMap.astro';
import DemoLayout from '../../../../../layouts/DemoLayout.astro';
import { chrome, routes } from '../../../../../lib/demos/grandviewChrome';
import { demoBreadcrumbs } from '../../../../../lib/demos/grandviewJsonld';
import {
  business,
  contactPage,
  deliveryAreas,
  ordersDesk,
  pageMeta,
  warehouseHours,
} from '../../../../../data/demos/b2b-distributor-wholesale';
import { formatTime } from '../../../../../lib/demos/shared';

const meta = pageMeta.contact;
const hourRows = warehouseHours.map((day) => ({
  day: day.day,
  open: `${formatTime(day.open)} – ${formatTime(day.close)}`,
}));
---

<DemoLayout
  {...chrome}
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  current={routes.contact}
  jsonLd={[
    demoBreadcrumbs([
      { name: business.shortName, path: routes.home },
      { name: meta.breadcrumb, path: routes.contact },
    ]),
  ]}
>
  <header class="bay ct-head">
    <div class="wrap">
      <p class="kicker">{contactPage.eyebrow}</p>
      <h1 class="ct-title">{contactPage.heading}</h1>
    </div>
  </header>

  <section class="bay ct-main">
    <div class="wrap desks">
      <div class="desk">
        <h2 class="desk__h">{contactPage.ordersHeading}</h2>
        <p class="desk__note">{contactPage.ordersNote}</p>
        <a class="desk__phone" href={ordersDesk.phoneHref} data-analytics-event="phone_tap_orders">
          {ordersDesk.phone}
        </a>
        <a class="desk__mail" href={ordersDesk.emailHref}>{ordersDesk.email}</a>
        <p class="desk__hours">{ordersDesk.hours}</p>
      </div>
      <div class="desk desk--accounts on-paper">
        <h2 class="desk__h">{contactPage.accountsHeading}</h2>
        <p class="desk__note">{contactPage.accountsNote}</p>
        <a class="desk__phone" href={business.phoneHref} data-analytics-event="phone_tap_accounts">
          {business.phone}
        </a>
        <a class="desk__mail" href={business.emailHref}>{business.email}</a>
        <a class="btn btn--line" href={routes.apply} data-analytics-event="apply_cta_contact">
          {contactPage.applyCta}
        </a>
      </div>
    </div>
  </section>

  <section class="bay" aria-labelledby="wh-h">
    <div class="wrap wh-grid">
      <div>
        <h2 id="wh-h" class="section-title">{contactPage.addressHeading}</h2>
        <address class="address">
          <span>{business.address.street}</span>
          <span>{business.address.city}, {business.address.region} {business.address.postalCode}</span>
        </address>
        <h3 class="sub-h">{contactPage.hoursHeading}</h3>
        <p class="note">{contactPage.hoursNote}</p>
        <table class="hours">
          <thead>
            <tr>
              <th scope="col">{contactPage.hoursTable.day}</th>
              <th scope="col">{contactPage.hoursTable.open}</th>
            </tr>
          </thead>
          <tbody>
            {hourRows.map((row) => (
              <tr>
                <th scope="row">{row.day}</th>
                <td>{row.open}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <DemoMap label={contactPage.mapLabel} seed="b2b-distributor-wholesale" />
    </div>
  </section>

  <section class="bay area-bay" aria-labelledby="area-h">
    <div class="wrap">
      <h2 id="area-h" class="section-title">{contactPage.areaHeading}</h2>
      <p class="note">{contactPage.areaNote}</p>
      <ul class="areas">
        {deliveryAreas.map((area) => <li class="area">{area}</li>)}
      </ul>
    </div>
  </section>
</DemoLayout>

<style>
  .kicker {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .section-title {
    font-size: var(--fs-title);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .sub-h {
    margin-top: 2.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .note {
    margin-top: 0.8rem;
    max-width: 54ch;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
  }
  .ct-head {
    padding-bottom: 0;
  }
  .ct-title {
    margin-top: 1rem;
    font-size: var(--fs-display);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.06;
  }
  .ct-main {
    padding-top: clamp(2rem, 5vw, 3rem);
  }

  .desks {
    display: grid;
    gap: 1px;
    background: var(--ink-line);
    border: 1px solid var(--ink-line);
  }
  @media (min-width: 820px) {
    .desks {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .desk {
    padding: 1.75rem 1.6rem;
  }
  /* The page's scoped styles load after the layout's, so a bare .desk
     background would beat .on-paper's. Exclude the paper desk explicitly. */
  .desk:not(.on-paper) {
    background: var(--ink);
  }
  .desk__h {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .desk--accounts .desk__h {
    color: var(--accent-paper);
  }
  .desk__note {
    margin-top: 0.8rem;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--on-ink-dim);
    max-width: 42ch;
  }
  .desk--accounts .desk__note {
    color: var(--on-paper-dim);
  }
  .desk__phone {
    display: block;
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 1.25rem + 1vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--accent);
    text-decoration: none;
  }
  .desk--accounts .desk__phone {
    color: var(--accent-paper);
  }
  .desk__mail {
    /* 24px minimum tap target (WCAG 2.2 AA 2.5.8) */
    display: inline-block;
    padding-block: 0.25rem;
    display: inline-block;
    margin-top: 0.4rem;
    font-size: var(--fs-small);
    text-underline-offset: 4px;
    word-break: break-word;
  }
  .desk__hours {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--on-ink-dim);
  }
  .desk--accounts .btn {
    display: block;
    width: fit-content;
    margin-top: 1.25rem;
  }

  .wh-grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 940px) {
    .wh-grid {
      grid-template-columns: 1fr 0.9fr;
      gap: 3.5rem;
      align-items: start;
    }
  }
  .address {
    font-style: normal;
    display: grid;
    gap: 0.15rem;
    margin-top: 1rem;
    font-size: 1.05rem;
  }
  .hours {
    margin-top: 1.25rem;
    width: 100%;
    max-width: 26rem;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .hours th,
  .hours td {
    text-align: left;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--ink-line);
    font-size: var(--fs-small);
  }
  .hours thead th {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-ink-dim);
    font-weight: 600;
  }
  .hours tbody th {
    font-weight: 400;
  }
  .hours td {
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .area-bay {
    background: var(--ink-raised);
    border-top: 1px solid var(--ink-line);
  }
  .areas {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--ink-line);
    border: 1px solid var(--ink-line);
  }
  @media (min-width: 640px) {
    .areas {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .areas {
      grid-template-columns: repeat(7, 1fr);
    }
  }
  .area {
    padding: 0.9rem 0.85rem;
    background: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
  }
</style>
