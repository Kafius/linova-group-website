---
// Almond & Rye demo — Contact. No form: pre-orders go through the Clover
// slot and cakes go through the enquiry, so a third inbox nobody watches
// would help nobody. The same reasoning as every other contact page here.
import DemoLayout from '../../../../../layouts/DemoLayout.astro';
import { chrome, routes } from '../../../../../lib/demos/almondRyeChrome';
import { demoBreadcrumbs } from '../../../../../lib/demos/almondRyeJsonld';
import {
  business,
  contactPage,
  hours,
  pageMeta,
} from '../../../../../data/demos/fnb-bakery-pre-order';
import { formatTime } from '../../../../../lib/demos/shared';

const meta = pageMeta.contact;
const hourRows = hours.map((day) => ({
  day: day.day,
  open: `${formatTime(day.open)} – ${formatTime(day.close)}`,
}));
---

<DemoLayout
  {...chrome}
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  current={routes.contact}
  jsonLd={[
    demoBreadcrumbs([
      { name: business.shortName, path: routes.home },
      { name: meta.breadcrumb, path: routes.contact },
    ]),
  ]}
>
  <header class="bay ct-head">
    <div class="wrap">
      <p class="eyebrow">{contactPage.eyebrow}</p>
      <h1 class="ct-title">{contactPage.heading}</h1>
    </div>
  </header>

  <section class="wrap ct-grid">
    <div class="details">
      <div class="detail">
        <h2 class="detail__h">{contactPage.addressHeading}</h2>
        <address class="detail__address">
          <span>{business.address.street}</span>
          <span>{business.address.neighbourhood}</span>
          <span>{business.address.city}, {business.address.region} {business.address.postalCode}</span>
        </address>
      </div>
      <div class="detail">
        <h2 class="detail__h">{contactPage.phoneHeading}</h2>
        <a class="detail__phone" href={business.phoneHref} data-analytics-event="phone_tap_contact">
          {business.phone}
        </a>
      </div>
      <div class="detail">
        <h2 class="detail__h">{contactPage.emailHeading}</h2>
        <a class="detail__link" href={business.emailHref}>{business.email}</a>
      </div>
      <a class="btn btn--fill" href={routes.preOrder} data-analytics-event="order_cta_contact">
        {contactPage.preOrderCta}
      </a>
    </div>

    <div class="map" role="img" aria-label={contactPage.mapLabel}>
      <span class="map__label">{contactPage.mapLabel}</span>
      <svg class="map__cross" aria-hidden="true" preserveAspectRatio="none">
        <line x1="0" y1="0" x2="100%" y2="100%" stroke="currentColor" stroke-width="1" opacity="0.22" />
        <line x1="100%" y1="0" x2="0" y2="100%" stroke="currentColor" stroke-width="1" opacity="0.22" />
      </svg>
    </div>
  </section>

  <section class="bay" aria-labelledby="hours-h">
    <div class="wrap">
      <h2 id="hours-h" class="section-title">{contactPage.hoursHeading}</h2>
      <p class="note">{contactPage.hoursNote}</p>
      <div class="hours-card">
        <table class="hours">
          <thead>
            <tr>
              <th scope="col">{contactPage.hoursTable.day}</th>
              <th scope="col">{contactPage.hoursTable.open}</th>
            </tr>
          </thead>
          <tbody>
            {hourRows.map((row) => (
              <tr>
                <th scope="row">{row.day}</th>
                <td>{row.open}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bay on-paper" aria-labelledby="visit-h">
    <div class="wrap">
      <h2 id="visit-h" class="section-title">{contactPage.visitHeading}</h2>
      <dl class="visit">
        {contactPage.visit.map((entry) => (
          <div class="visit__item">
            <dt class="visit__k">{entry.title}</dt>
            <dd class="visit__v">{entry.detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</DemoLayout>

<style>
  .section-title {
    font-family: var(--font-display);
    font-size: var(--fs-title);
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .note {
    margin-top: 1rem;
    max-width: 54ch;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
  }
  .ct-head {
    padding-bottom: 0;
  }
  .ct-title {
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.08;
  }
  .ct-grid {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .ct-grid {
      grid-template-columns: 1fr 1.05fr;
      gap: 3.5rem;
      align-items: start;
    }
  }
  .details {
    display: grid;
    gap: 2rem;
    justify-items: start;
  }
  .detail__h {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }
  .detail__address {
    font-style: normal;
    display: grid;
    gap: 0.15rem;
    font-size: clamp(1.02rem, 0.98rem + 0.3vw, 1.15rem);
  }
  .detail__phone {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 1.5rem + 1.3vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--accent);
    text-decoration: none;
  }
  .detail__link {
    font-size: clamp(1rem, 0.96rem + 0.3vw, 1.1rem);
    text-underline-offset: 5px;
    word-break: break-word;
  }
  .map {
    position: relative;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    text-align: center;
    border: 2px dashed color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--accent) 5%, transparent);
    color: var(--accent);
  }
  .map__label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    max-width: 24ch;
    line-height: 1.6;
  }
  .map__cross {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hours-card {
    margin-top: 1.75rem;
    max-width: 32rem;
    padding: 0.5rem 1.4rem 0.75rem;
    border: 1px solid var(--ink-line);
    border-radius: var(--radius);
    background: var(--ink-raised);
  }
  .hours {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .hours th,
  .hours td {
    text-align: left;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--ink-line);
    font-size: var(--fs-small);
  }
  .hours tbody tr:last-child th,
  .hours tbody tr:last-child td {
    border-bottom: 0;
  }
  .hours thead th {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 700;
  }
  .hours tbody th {
    font-weight: 400;
  }
  .hours td {
    text-align: right;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--on-ink-dim);
  }

  .visit {
    margin: 2rem 0 0;
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 820px) {
    .visit {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }
  }
  .visit__item {
    padding: 1.5rem;
    border: 1px solid var(--paper-line);
    border-radius: var(--radius);
  }
  .visit__k {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--accent-paper);
  }
  .visit__v {
    margin: 0.7rem 0 0;
    font-size: var(--fs-small);
    line-height: 1.65;
    color: var(--on-paper-dim);
  }
</style>
