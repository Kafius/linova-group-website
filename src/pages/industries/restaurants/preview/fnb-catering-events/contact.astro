---
// Saffron Table demo — Contact. Two contact blocks and no form: takeout goes
// through the counter or the Clover slot, and catering goes through the
// consultation booking, which already asks the right four questions.
import DemoLayout from '../../../../../layouts/DemoLayout.astro';
import { chrome, routes } from '../../../../../lib/demos/saffronChrome';
import { demoBreadcrumbs } from '../../../../../lib/demos/saffronJsonld';
import {
  business,
  cateringContact,
  contactPage,
  counterHours,
  pageMeta,
  serviceArea,
} from '../../../../../data/demos/fnb-catering-events';
import { formatTime } from '../../../../../lib/demos/shared';

const meta = pageMeta.contact;
const hourRows = counterHours.map((day) => ({
  day: day.day,
  open: `${formatTime(day.open)} – ${formatTime(day.close)}`,
}));
---

<DemoLayout
  {...chrome}
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  current={routes.contact}
  jsonLd={[
    demoBreadcrumbs([
      { name: business.shortName, path: routes.home },
      { name: meta.breadcrumb, path: routes.contact },
    ]),
  ]}
>
  <header class="bay ct-head">
    <div class="wrap">
      <p class="eyebrow">{contactPage.eyebrow}</p>
      <h1 class="ct-title">{contactPage.heading}</h1>
    </div>
  </header>

  <section class="wrap ct-grid">
    <div class="cards">
      <div class="card">
        <h2 class="card__h">{contactPage.counterHeading}</h2>
        <a class="card__phone" href={business.phoneHref} data-analytics-event="phone_tap_contact">
          {business.phone}
        </a>
        <a class="card__mail" href={business.emailHref}>{business.email}</a>
      </div>
      <div class="card card--catering on-paper">
        <h2 class="card__h">{contactPage.cateringHeading}</h2>
        <a class="card__phone" href={cateringContact.phoneHref} data-analytics-event="phone_tap_catering_contact">
          {cateringContact.phone}
        </a>
        <a class="card__mail" href={cateringContact.emailHref}>{cateringContact.email}</a>
        <a class="btn btn--line" href={routes.consultation} data-analytics-event="consultation_cta_contact">
          {contactPage.consultationCta}
        </a>
      </div>
      <div class="card card--address">
        <h2 class="card__h">{contactPage.addressHeading}</h2>
        <address class="card__address">
          <span>{business.address.street}</span>
          <span>{business.address.city}, {business.address.region} {business.address.postalCode}</span>
        </address>
      </div>
    </div>

    <div class="map" role="img" aria-label={contactPage.mapLabel}>
      <span class="map__label">{contactPage.mapLabel}</span>
      <svg class="map__cross" aria-hidden="true" preserveAspectRatio="none">
        <line x1="0" y1="0" x2="100%" y2="100%" stroke="currentColor" stroke-width="1" opacity="0.25" />
        <line x1="100%" y1="0" x2="0" y2="100%" stroke="currentColor" stroke-width="1" opacity="0.25" />
      </svg>
    </div>
  </section>

  <section class="bay" aria-labelledby="hours-h">
    <div class="wrap hours-grid">
      <div>
        <h2 id="hours-h" class="section-title">{contactPage.hoursHeading}</h2>
        <p class="note">{contactPage.hoursNote}</p>
        <table class="hours">
          <thead>
            <tr>
              <th scope="col">{contactPage.hoursTable.day}</th>
              <th scope="col">{contactPage.hoursTable.open}</th>
            </tr>
          </thead>
          <tbody>
            {hourRows.map((row) => (
              <tr>
                <th scope="row">{row.day}</th>
                <td>{row.open}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div>
        <h2 class="section-title">{contactPage.areaHeading}</h2>
        <p class="note">{contactPage.areaNote}</p>
        <ul class="area">
          {serviceArea.map((city) => <li class="area__city">{city}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="bay on-paper" aria-labelledby="visit-h">
    <div class="wrap">
      <h2 id="visit-h" class="section-title">{contactPage.visitHeading}</h2>
      <dl class="visit">
        {contactPage.visit.map((entry) => (
          <div>
            <dt class="visit__k">{entry.title}</dt>
            <dd class="visit__v">{entry.detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</DemoLayout>

<style>
  .section-title {
    font-size: var(--fs-title);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .note {
    margin-top: 1rem;
    max-width: 52ch;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
  }
  .ct-head {
    padding-bottom: 0;
  }
  .ct-title {
    margin-top: 1.25rem;
    font-size: var(--fs-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.08;
  }
  .ct-grid {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 940px) {
    .ct-grid {
      grid-template-columns: 1fr 0.9fr;
      gap: 3.5rem;
      align-items: start;
    }
  }
  .cards {
    display: grid;
    gap: 1px;
    background: var(--ink-line);
    border: 1px solid var(--ink-line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .card {
    padding: 1.6rem 1.5rem;
  }
  /* The page's scoped styles load after the layout's, so a bare .card
     background would beat .on-paper's. Exclude the paper card explicitly. */
  .card:not(.on-paper) {
    background: var(--ink);
  }
  .card--address {
    background: var(--ink-raised);
  }
  .card__h {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .card--catering .card__h {
    color: var(--accent-paper);
  }
  .card__phone {
    display: block;
    margin-top: 0.9rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.35rem + 1vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--accent);
    text-decoration: none;
  }
  .card--catering .card__phone {
    color: var(--accent-paper);
  }
  .card__mail {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    text-underline-offset: 4px;
    word-break: break-word;
  }
  .card--catering .btn {
    display: block;
    width: fit-content;
    margin-top: 1.35rem;
  }
  .card__address {
    font-style: normal;
    display: grid;
    gap: 0.15rem;
    margin-top: 0.9rem;
    font-size: 1.05rem;
  }

  .map {
    position: relative;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    text-align: center;
    border: 1px dashed color-mix(in srgb, var(--accent) 55%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--accent) 7%, transparent);
    color: var(--accent);
  }
  .map__label {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    max-width: 24ch;
    line-height: 1.6;
  }
  .map__cross {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hours-grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .hours-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
      align-items: start;
    }
  }
  .hours {
    margin-top: 1.5rem;
    width: 100%;
    max-width: 28rem;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .hours th,
  .hours td {
    text-align: left;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--ink-line);
    font-size: var(--fs-small);
  }
  .hours thead th {
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 700;
  }
  .hours tbody th {
    font-weight: 400;
  }
  .hours td {
    text-align: right;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--on-ink-dim);
  }
  .area {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--ink-line);
    border: 1px solid var(--ink-line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  @media (min-width: 560px) {
    .area {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .area__city {
    padding: 0.9rem 1rem;
    background: var(--ink-raised);
    font-size: var(--fs-small);
    font-weight: 700;
  }

  .visit {
    margin: 2rem 0 0;
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 820px) {
    .visit {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }
  .visit__k {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--accent-paper);
  }
  .visit__v {
    margin: 0.7rem 0 0;
    font-size: var(--fs-small);
    line-height: 1.65;
    color: var(--on-paper-dim);
  }
</style>
