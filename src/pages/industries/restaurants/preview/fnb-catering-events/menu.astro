---
// Saffron Table demo — Takeout Menu. The transactional half of the fork:
// per-item prices, a Clover ordering slot, and no catering numbers anywhere
// except the one aside that sends a bigger order to the right page.
import DemoLayout from '../../../../../layouts/DemoLayout.astro';
import { chrome, routes } from '../../../../../lib/demos/saffronChrome';
import { counterMenu, demoBreadcrumbs } from '../../../../../lib/demos/saffronJsonld';
import {
  business,
  dietaryLegend,
  formatPrice,
  itemsIn,
  menuLines,
  menuPage,
  pageMeta,
} from '../../../../../data/demos/fnb-catering-events';

const meta = pageMeta.menu;
const sections = menuLines.map((line) => ({ ...line, items: itemsIn(line.id) }));
---

<DemoLayout
  {...chrome}
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  current={routes.menu}
  ogType="restaurant.restaurant"
  jsonLd={[
    counterMenu(routes.menu),
    demoBreadcrumbs([
      { name: business.shortName, path: routes.home },
      { name: meta.breadcrumb, path: routes.menu },
    ]),
  ]}
>
  <header class="bay mn-head">
    <div class="wrap">
      <p class="eyebrow">{menuPage.eyebrow}</p>
      <h1 class="mn-title">{menuPage.heading}</h1>
      <p class="lede mn-lede">{menuPage.intro}</p>
    </div>
  </header>

  <!-- ── The Clover slot ─────────────────────────────────────────────── -->
  <section class="bay mn-store" aria-labelledby="store-h">
    <div class="wrap store">
      <div>
        <h2 id="store-h" class="section-title">{menuPage.embedHeading}</h2>
        <p class="section-body">{menuPage.embedBody}</p>
        <ol class="steps">
          {menuPage.collection.map((step) => (
            <li class="step">
              <h3 class="step__title">{step.title}</h3>
              <p class="step__detail">{step.detail}</p>
            </li>
          ))}
        </ol>
      </div>
      <div class="embed">
        <span class="embed__corner" aria-hidden="true"></span>
        <div class="embed__center">
          <p class="embed__label">{menuPage.embedLabel}</p>
          <p class="embed__note">{menuPage.embedNote}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── The menu ────────────────────────────────────────────────────── -->
  <section class="bay mn-list" aria-label={menuPage.heading}>
    <div class="wrap">
      <dl class="legend" aria-label={menuPage.legendLabel}>
        {dietaryLegend.map((entry) => (
          <div class="legend__pair">
            <dt class="marker">{entry.marker}</dt>
            <dd>{entry.label}</dd>
          </div>
        ))}
      </dl>

      {sections.map((section) => (
        <section class="line" aria-labelledby={`h-${section.id}`}>
          <h2 class="line__name" id={`h-${section.id}`}>{section.name}</h2>
          <p class="line__blurb">{section.blurb}</p>
          <ul class="items">
            {section.items.map((item) => (
              <li class="item">
                <div class="item__line">
                  <h3 class="item__name">
                    {item.name}
                    {item.dietary?.length ? (
                      <span class="item__markers">
                        {item.dietary.map((marker) => (
                          <abbr class="marker" title={dietaryLegend.find((e) => e.marker === marker)?.label}>
                            {marker}
                          </abbr>
                        ))}
                      </span>
                    ) : null}
                  </h3>
                  <span class="item__price">${formatPrice(item.price)}</span>
                </div>
                <p class="item__desc">{item.description}</p>
                <p class="item__portion">
                  <span class="item__k">{menuPage.portionLabel}</span> {item.portion}
                </p>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>

  <!-- ── Send a bigger order to the other path ───────────────────────── -->
  <section class="bay on-paper">
    <div class="wrap aside">
      <div>
        <h2 class="section-title">{menuPage.cateringAsideHeading}</h2>
        <p class="section-body section-body--paper">{menuPage.cateringAsideBody}</p>
      </div>
      <a class="btn btn--line" href={routes.catering} data-analytics-event="catering_view_menu">
        {menuPage.cateringAsideCta}
      </a>
    </div>
  </section>
</DemoLayout>

<style>
  .section-title {
    font-size: var(--fs-title);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .section-body {
    margin-top: 1rem;
    max-width: 52ch;
    color: var(--on-ink-dim);
  }
  .section-body--paper {
    color: var(--on-paper-dim);
  }
  .mn-head {
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .mn-title {
    margin-top: 1.25rem;
    font-size: var(--fs-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.08;
  }
  .mn-lede {
    margin-top: 1.5rem;
    max-width: 50ch;
  }

  /* ── Store slot ───────────────────────────────────────────────────── */
  .mn-store {
    padding-top: 0;
  }
  .store {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 960px) {
    .store {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
    }
  }
  .steps {
    list-style: none;
    counter-reset: step;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  .step {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.2rem 1rem;
  }
  .step::before {
    content: counter(step, decimal-leading-zero);
    grid-row: 1 / span 2;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--accent);
  }
  .step__title {
    font-size: var(--fs-body);
    font-weight: 700;
  }
  .step__detail {
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--on-ink-dim);
    max-width: 40ch;
  }
  .embed {
    position: relative;
    min-height: 24rem;
    height: clamp(24rem, 48vh, 32rem);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
    border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent);
    border-radius: var(--radius);
    background:
      repeating-linear-gradient(
        135deg,
        transparent 0 14px,
        color-mix(in srgb, var(--accent) 8%, transparent) 14px 15px
      ),
      var(--ink-raised);
  }
  .embed__corner {
    position: absolute;
    top: 1rem;
    left: 1rem;
    width: 1.75rem;
    height: 1.75rem;
    border-top: 2px solid var(--accent);
    border-left: 2px solid var(--accent);
  }
  .embed__center {
    max-width: 30ch;
  }
  .embed__label {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.3rem);
    font-weight: 700;
    color: var(--accent);
    line-height: 1.4;
  }
  .embed__note {
    margin-top: 0.7rem;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
  }

  /* ── Menu ─────────────────────────────────────────────────────────── */
  .mn-list {
    border-top: 1px solid var(--ink-line);
  }
  .legend {
    margin: 0 0 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--ink-line);
  }
  .legend__pair {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
  }
  .legend__pair dd {
    margin: 0;
  }
  .marker {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
    padding: 0.3em 0.45em;
    border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent);
    border-radius: 4px;
    color: var(--accent);
    text-decoration: none;
    vertical-align: 0.12em;
  }
  .line {
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }
  .line__name {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.35rem + 1.2vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--accent);
    display: inline-block;
  }
  .line__blurb {
    margin-top: 0.9rem;
    max-width: 56ch;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
  }
  .items {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 760px) {
    .items {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem 3rem;
    }
  }
  .item__line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .item__name {
    font-size: 1.08rem;
    font-weight: 700;
  }
  .item__markers {
    display: inline-flex;
    gap: 0.25rem;
    margin-left: 0.45rem;
  }
  .item__price {
    flex: none;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
  .item__desc {
    margin-top: 0.4rem;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--on-ink-dim);
    max-width: 44ch;
  }
  .item__portion {
    margin-top: 0.5rem;
    font-size: 0.78rem;
  }
  .item__k {
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-ink-dim);
    margin-right: 0.35rem;
  }

  .aside {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
</style>
