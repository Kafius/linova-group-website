---
// Fernrock demo — menu. Four lines, with the customisation choices stated once
// at the top rather than repeated on twenty drinks.
//
// The bubble tea section carries the second accent throughout, which is the
// same colour the boba cards use on the home page and the same one the online
// order uses. One rule, applied everywhere.
import DemoLayout from '../../../../../layouts/DemoLayout.astro';
import { chrome, routes } from '../../../../../lib/demos/fernrockChrome';
import { cafeMenu, demoBreadcrumbs } from '../../../../../lib/demos/fernrockJsonld';
import {
  business,
  customisation,
  dietaryLegend,
  formatPrice,
  itemsIn,
  lines,
  menuPage,
  pageMeta,
} from '../../../../../data/demos/fnb-cafe-order-ahead';

const meta = pageMeta.menu;
const sections = lines.map((line) => ({ ...line, items: itemsIn(line.id) }));
---

<DemoLayout
  {...chrome}
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  current={routes.menu}
  ogType="restaurant.restaurant"
  jsonLd={[
    cafeMenu(routes.menu),
    demoBreadcrumbs([
      { name: business.shortName, path: routes.home },
      { name: meta.breadcrumb, path: routes.menu },
    ]),
  ]}
>
  <header class="bay mn-head">
    <div class="wrap">
      <p class="eyebrow">{menuPage.eyebrow}</p>
      <h1 class="mn-title">{menuPage.heading}</h1>
      <hr class="rule" />
      <p class="lede mn-lede">{menuPage.intro}</p>

      <nav class="jump" aria-label={menuPage.jumpLabel}>
        <ul class="jump__list">
          {sections.map((section) => (
            <li>
              <a class:list={['jump__link', section.alt && 'jump__link--alt']} href={`#${section.id}`}>
                {section.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </header>

  <!-- ── Customisation, stated once ──────────────────────────────────── -->
  <section class="bay on-paper" aria-labelledby="cust-h">
    <div class="wrap">
      <h2 id="cust-h" class="section-title">{customisation.heading}</h2>
      <hr class="rule" />
      <p class="cust__note">{customisation.note}</p>
      <dl class="cust">
        {customisation.groups.map((group) => (
          <div class="cust__group">
            <dt class="cust__label">{group.label}</dt>
            <dd class="cust__options">
              <ul>
                {group.options.map((option) => <li class="chip">{option}</li>)}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ── The menu ────────────────────────────────────────────────────── -->
  <section class="bay" aria-label={menuPage.heading}>
    <div class="wrap">
      <dl class="legend" aria-label={menuPage.legendLabel}>
        {dietaryLegend.map((entry) => (
          <div class="legend__pair">
            <dt class="marker">{entry.marker}</dt>
            <dd>{entry.label}</dd>
          </div>
        ))}
      </dl>

      {sections.map((section) => (
        <section class:list={['line', section.alt && 'line--alt']} id={section.id} aria-labelledby={`h-${section.id}`}>
          <h2 class="line__name" id={`h-${section.id}`}>{section.name}</h2>
          <p class="line__blurb">{section.blurb}</p>
          <ul class="items">
            {section.items.map((item) => (
              <li class="item">
                <div class="item__line">
                  <h3 class="item__name">
                    {item.name}
                    {item.dietary?.length ? (
                      <span class="item__markers">
                        {item.dietary.map((marker) => (
                          <abbr class="marker" title={dietaryLegend.find((e) => e.marker === marker)?.label}>
                            {marker}
                          </abbr>
                        ))}
                      </span>
                    ) : null}
                  </h3>
                  <span class="item__price">${formatPrice(item.price)}</span>
                </div>
                <p class="item__desc">{item.description}</p>
                {item.customisable && <p class="item__cust">{customisation.drinkTag}</p>}
              </li>
            ))}
          </ul>
        </section>
      ))}

      <p class="boba-note">{menuPage.bobaNote}</p>
      <a class="btn btn--fill mn-cta" href={routes.order} data-analytics-event="order_cta_menu">
        {menuPage.orderCta}
      </a>
    </div>
  </section>
</DemoLayout>

<style>
  .section-title {
    font-size: var(--fs-title);
    letter-spacing: -0.015em;
  }
  .mn-head {
    padding-bottom: 0;
  }
  .mn-title {
    font-size: var(--fs-display);
    letter-spacing: -0.03em;
  }
  .mn-lede {
    margin-top: 1.35rem;
    max-width: 48ch;
  }

  .jump {
    margin-top: 2rem;
  }
  .jump__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .jump__link {
    display: inline-block;
    padding: 0.55rem 1.1rem;
    border: 2px solid var(--accent);
    border-radius: 999px;
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
    transition: background-color 0.18s ease, color 0.18s ease;
  }
  .jump__link:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
  .jump__link--alt {
    border-color: var(--accent-alt);
    color: var(--accent-alt);
  }
  .jump__link--alt:hover {
    background: var(--accent-alt);
    color: var(--on-accent-alt);
  }

  /* ── Customisation ────────────────────────────────────────────────── */
  .cust__note {
    margin-top: 1.1rem;
    max-width: 56ch;
    font-size: var(--fs-small);
    color: var(--on-paper-dim);
  }
  .cust {
    margin: 2.25rem 0 0;
    display: grid;
    gap: 1.75rem;
  }
  @media (min-width: 760px) {
    .cust {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }
  .cust__label {
    font-family: var(--font-display);
    font-size: var(--fs-heading);
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--accent-paper);
  }
  .cust__options {
    margin: 0.9rem 0 0;
  }
  .cust__options ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chip {
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--paper-line);
    border-radius: 999px;
    font-size: var(--fs-small);
    color: var(--on-paper);
  }

  /* ── Legend ───────────────────────────────────────────────────────── */
  .legend {
    margin: 0 0 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--ink-line);
  }
  .legend__pair {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
  }
  .legend__pair dd {
    margin: 0;
  }
  .marker {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
    padding: 0.28em 0.45em;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 6px;
    color: var(--accent);
    text-decoration: none;
    vertical-align: 0.12em;
  }

  /* ── Lines ────────────────────────────────────────────────────────── */
  .line {
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
    scroll-margin-top: 7rem;
  }
  .line__name {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 1.4rem + 1.5vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    padding-bottom: 0.5rem;
    border-bottom: 3px solid var(--accent);
    display: inline-block;
  }
  .line--alt .line__name {
    border-bottom-color: var(--accent-alt);
    color: var(--accent-alt);
  }
  .line__blurb {
    margin-top: 0.9rem;
    max-width: 56ch;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
  }
  .items {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 720px) {
    .items {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem 3rem;
    }
  }
  .item__line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .item__name {
    font-size: 1.08rem;
    font-weight: 700;
  }
  .item__markers {
    display: inline-flex;
    gap: 0.25rem;
    margin-left: 0.45rem;
  }
  .item__price {
    flex: none;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
  .line--alt .item__price {
    color: var(--accent-alt);
  }
  .item__desc {
    margin-top: 0.35rem;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--on-ink-dim);
    max-width: 44ch;
  }
  .item__cust {
    margin-top: 0.5rem;
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .line--alt .item__cust {
    background: color-mix(in srgb, var(--accent-alt) 12%, transparent);
    color: var(--accent-alt);
  }

  .boba-note {
    margin-top: 1rem;
    max-width: 58ch;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
  }
  .mn-cta {
    margin-top: 2rem;
  }
</style>
