---
// Vernon Street demo — Retail Shop. The retail half of the fork.
//
// ── CMS-DRIVEN ───────────────────────────────────────────────────────────
// The catalogue below is the `shelfItem` collection and the filter row is the
// `shelf` collection — see retail-catalogue-wholesale.cms.ts. On a live build
// the counter edits both: a loaf comes off in February, a price moves in
// March, "Baked Friday to Sunday" gets filled in and the Wednesday phone call
// stops. `shelf` in the data module is the seed for the first import.
// ─────────────────────────────────────────────────────────────────────────
//
// Nothing on this page is a wholesale number. No case sizes, no delivery
// days, no minimums — those live one page over and are written for somebody
// else. The only nod to the other audience is one aside at the bottom.
//
// The shelf filter is pure CSS: radio inputs plus :has() on the wrapper.
import DemoLayout from '../../../../../layouts/DemoLayout.astro';
import { chrome, routes } from '../../../../../lib/demos/vernonChrome';
import { counterMenu, demoBreadcrumbs } from '../../../../../lib/demos/vernonJsonld';
import {
  business,
  dietaryLegend,
  formatPrice,
  pageMeta,
  shelf,
  shelfCategories,
  shopPage,
} from '../../../../../data/demos/retail-catalogue-wholesale';

const meta = pageMeta.shop;
const filters = [{ id: 'all', name: shopPage.filterAll }, ...shelfCategories];
---

<DemoLayout
  {...chrome}
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  current={routes.shop}
  jsonLd={[
    counterMenu(routes.shop),
    demoBreadcrumbs([
      { name: business.shortName, path: routes.home },
      { name: meta.breadcrumb, path: routes.shop },
    ]),
  ]}
>
  <header class="bay sh-head">
    <div class="wrap">
      <p class="eyebrow">{shopPage.eyebrow}</p>
      <h1 class="sh-title">{shopPage.heading}</h1>
      <p class="lede sh-lede">{shopPage.intro}</p>
    </div>
  </header>

  <!-- ── The Clover slot ─────────────────────────────────────────────── -->
  <section class="bay sh-store" aria-labelledby="store-h">
    <div class="wrap store">
      <div>
        <h2 id="store-h" class="section-title">{shopPage.embedHeading}</h2>
        <p class="section-body">{shopPage.embedBody}</p>
        <ol class="steps">
          {shopPage.collection.map((step) => (
            <li class="step">
              <h3 class="step__title">{step.title}</h3>
              <p class="step__detail">{step.detail}</p>
            </li>
          ))}
        </ol>
      </div>
      <div class="embed">
        <span class="embed__corner" aria-hidden="true"></span>
        <div class="embed__center">
          <p class="embed__label">{shopPage.embedLabel}</p>
          <p class="embed__note">{shopPage.embedNote}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── The catalogue ───────────────────────────────────────────────── -->
  <section class="bay sh-cat" aria-label={shopPage.heading}>
    <div class="wrap">
      <div class="cat">
        <fieldset class="filters">
          <legend class="filters__legend">{shopPage.filterLabel}</legend>
          {filters.map((filter, i) => (
            <>
              <input
                class="filters__input"
                type="radio"
                name="shelf"
                id={`filter-${filter.id}`}
                value={filter.id}
                checked={i === 0}
              />
              <label class="filters__label" for={`filter-${filter.id}`}>{filter.name}</label>
            </>
          ))}
        </fieldset>

        <dl class="legend" aria-label={shopPage.legendLabel}>
          {dietaryLegend.map((entry) => (
            <div class="legend__pair">
              <dt class="marker">{entry.marker}</dt>
              <dd>{entry.label}</dd>
            </div>
          ))}
        </dl>

        <ul class="items">
          {shelf.map((item) => (
            <li class="item" data-shelf={item.category} id={item.id}>
              <div class="item__line">
                <h3 class="item__name">
                  {item.name}
                  {item.dietary?.length ? (
                    <span class="item__markers">
                      {item.dietary.map((marker) => (
                        <abbr class="marker" title={dietaryLegend.find((e) => e.marker === marker)?.label}>
                          {marker}
                        </abbr>
                      ))}
                    </span>
                  ) : null}
                </h3>
                <span class="item__dots" aria-hidden="true"></span>
                <span class="item__price">${formatPrice(item.price)}</span>
              </div>
              <p class="item__desc">{item.description}</p>
              <p class="item__meta">
                <span class="item__unit">
                  <span class="item__k">{shopPage.unitLabel}</span> {item.unit}
                </span>
                {item.bakedOn && (
                  <span class="item__baked">
                    <span class="item__k">{shopPage.bakedLabel}</span> {item.bakedOn}
                  </span>
                )}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ── The one nod to the other audience ───────────────────────────── -->
  <section class="bay on-paper">
    <div class="wrap aside">
      <div>
        <h2 class="section-title">{shopPage.wholesaleAsideHeading}</h2>
        <p class="section-body section-body--paper">{shopPage.wholesaleAsideBody}</p>
      </div>
      <a class="btn btn--line" href={routes.wholesale} data-analytics-event="wholesale_view_shop">
        {shopPage.wholesaleAsideCta}
      </a>
    </div>
  </section>
</DemoLayout>

<style>
  .section-title {
    font-size: var(--fs-title);
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .section-body {
    margin-top: 1rem;
    max-width: 52ch;
    color: var(--on-ink-dim);
  }
  .section-body--paper {
    color: var(--on-paper-dim);
  }
  .sh-head {
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .sh-title {
    margin-top: 1.25rem;
    font-size: var(--fs-display);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.06;
  }
  .sh-lede {
    margin-top: 1.5rem;
    max-width: 50ch;
  }

  /* ── Store slot ───────────────────────────────────────────────────── */
  .sh-store {
    padding-top: 0;
  }
  .store {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 960px) {
    .store {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
    }
  }
  .steps {
    list-style: none;
    counter-reset: step;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  .step {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.2rem 1rem;
  }
  .step::before {
    content: counter(step, decimal-leading-zero);
    grid-row: 1 / span 2;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--accent);
  }
  .step__title {
    font-size: var(--fs-body);
    font-weight: 700;
  }
  .step__detail {
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--on-ink-dim);
    max-width: 40ch;
  }
  .embed {
    position: relative;
    min-height: 24rem;
    height: clamp(24rem, 48vh, 32rem);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    background:
      repeating-linear-gradient(
        135deg,
        transparent 0 14px,
        color-mix(in srgb, var(--accent) 5%, transparent) 14px 15px
      ),
      var(--ink-raised);
  }
  .embed__corner {
    position: absolute;
    top: 1rem;
    left: 1rem;
    width: 1.75rem;
    height: 1.75rem;
    border-top: 2px solid var(--accent);
    border-left: 2px solid var(--accent);
  }
  .embed__center {
    max-width: 30ch;
  }
  .embed__label {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.3rem);
    font-weight: 600;
    color: var(--accent);
    line-height: 1.4;
  }
  .embed__note {
    margin-top: 0.7rem;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
  }

  /* ── Filter row ───────────────────────────────────────────────────── */
  .sh-cat {
    border-top: 1px solid var(--ink-line);
  }
  .filters {
    border: 0;
    padding: 0 0 1.1rem;
    margin: 0 0 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    align-items: baseline;
    border-bottom: 1px solid var(--ink-line);
  }
  .filters__legend {
    padding: 0;
    width: 100%;
    margin-bottom: 0.9rem;
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .filters__input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .filters__label {
    cursor: pointer;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
    padding-bottom: 0.3rem;
    border-bottom: 2px solid transparent;
  }
  .filters__label:hover {
    color: var(--on-ink);
  }
  .filters__input:checked + .filters__label {
    color: var(--accent);
    border-bottom-color: var(--accent);
    font-weight: 700;
  }
  /* The input is visually hidden, so the ring has to land on the label. */
  .filters__input:focus-visible + .filters__label {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .legend {
    margin: 0 0 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .legend__pair {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
  }
  .legend__pair dd {
    margin: 0;
  }
  .marker {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
    padding: 0.3em 0.45em;
    border: 1px solid color-mix(in srgb, var(--accent) 50%, transparent);
    color: var(--accent);
    text-decoration: none;
    vertical-align: 0.12em;
  }

  /* ── Items. A printed price list: name, leader dots, price. ───────── */
  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 800px) {
    .items {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem 3.5rem;
    }
  }
  .item__line {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .item__name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    flex: none;
    max-width: 78%;
  }
  .item__markers {
    display: inline-flex;
    gap: 0.25rem;
    margin-left: 0.4rem;
  }
  .item__dots {
    flex: 1;
    height: 1px;
    align-self: flex-end;
    margin-bottom: 0.35em;
    background-image: radial-gradient(circle, var(--ink-line) 1px, transparent 1px);
    background-size: 5px 1px;
    background-repeat: repeat-x;
  }
  .item__price {
    flex: none;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
  .item__desc {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--on-ink-dim);
    max-width: 46ch;
  }
  .item__meta {
    margin-top: 0.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.25rem;
    font-size: 0.78rem;
  }
  .item__k {
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-ink-dim);
    margin-right: 0.3rem;
  }
  .item__baked {
    color: var(--accent);
    font-weight: 700;
  }

  /* ── The filter itself: no JavaScript, just :has() on the wrapper ──── */
  .cat:has(#filter-sourdough:checked) .item:not([data-shelf='sourdough']),
  .cat:has(#filter-viennoiserie:checked) .item:not([data-shelf='viennoiserie']),
  .cat:has(#filter-pastry:checked) .item:not([data-shelf='pastry']),
  .cat:has(#filter-pantry:checked) .item:not([data-shelf='pantry']) {
    display: none;
  }

  .aside {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
</style>
