  <!-- ── SCRIPTS ────────────────────────────────────────────────── -->
  <script>
    // Mobile menu toggle
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    menuBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });

    // Close mobile menu on link click
    mobileMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
    });

    // ── Product Fan (desktop) ────────────────────────────────────
    const fanCards = Array.from(document.querySelectorAll<HTMLElement>('.fan-card'));
    const textBoxes = Array.from(document.querySelectorAll<HTMLElement>('.text-box'));
    const baseRotations = fanCards.map((_, i) => -70 + i * 20);

    let leaveTimer: ReturnType<typeof setTimeout> | null = null;

    function activateFan(idx: number) {
      if (leaveTimer) { clearTimeout(leaveTimer); leaveTimer = null; }
      fanCards.forEach((card, i) => {
        const rot = baseRotations[i];
        if (i === idx) {
          card.style.transform = `rotate(${rot}deg) translateY(-28px)`;
          card.style.zIndex = '20';
        } else {
          card.style.transform = `rotate(${rot}deg)`;
          card.style.zIndex = String(i + 1);
        }
      });
      textBoxes.forEach((box, i) => {
        if (i === idx) {
          box.classList.add('border-navy-400', 'bg-navy-50', 'shadow-md');
          box.classList.remove('border-slate-200', 'bg-white');
        } else {
          box.classList.remove('border-navy-400', 'bg-navy-50', 'shadow-md');
          box.classList.add('border-slate-200', 'bg-white');
        }
      });
    }

    function scheduleFanReset() {
      leaveTimer = setTimeout(() => {
        fanCards.forEach((card, i) => {
          card.style.transform = `rotate(${baseRotations[i]}deg)`;
          card.style.zIndex = String(i + 1);
        });
        textBoxes.forEach(box => {
          box.classList.remove('border-navy-400', 'bg-navy-50', 'shadow-md');
          box.classList.add('border-slate-200', 'bg-white');
        });
      }, 120);
    }

    fanCards.forEach((card, i) => {
      card.addEventListener('mouseenter', () => activateFan(i));
      card.addEventListener('mouseleave', scheduleFanReset);
    });
    textBoxes.forEach((box, i) => {
      box.addEventListener('mouseenter', () => activateFan(i));
      box.addEventListener('mouseleave', scheduleFanReset);
    });

    // ── Mobile product selector ──────────────────────────────────
    const productsData = JSON.parse(
      document.getElementById('products-json')?.textContent ?? '[]'
    ) as Array<{ name: string; description: string; tag: string; tagColor: string }>;

    const mobileBtns = Array.from(document.querySelectorAll<HTMLElement>('.mobile-btn'));
    const mobileTag  = document.getElementById('mobile-tag');
    const mobileName = document.getElementById('mobile-name');
    const mobileDesc = document.getElementById('mobile-desc');

    function setMobileProduct(idx: number) {
      const p = productsData[idx];
      if (!p || !mobileTag || !mobileName || !mobileDesc) return;
      mobileTag.textContent  = p.tag;
      mobileTag.className    = `inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold mb-3 ${p.tagColor}`;
      mobileName.textContent = p.name;
      mobileDesc.textContent = p.description;
      mobileBtns.forEach((btn, i) => {
        if (i === idx) {
          btn.classList.add('border-navy-400', 'bg-navy-50');
          btn.classList.remove('border-transparent');
        } else {
          btn.classList.remove('border-navy-400', 'bg-navy-50');
          btn.classList.add('border-transparent');
        }
      });
    }

    mobileBtns.forEach((btn, i) => btn.addEventListener('click', () => setMobileProduct(i)));
    if (productsData.length) setMobileProduct(0);
  </script>
