<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Scroll reveal.
  const els = document.querySelectorAll('.re .reveal');
  if (reduce || !('IntersectionObserver' in window)) {
    els.forEach((el) => el.classList.add('in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12 }
    );
    els.forEach((el) => io.observe(el));
  }

  // Count-up — GTA stats and house numbers (handles commas + suffixes).
  function countUp(el: HTMLElement) {
    const raw = el.dataset.count || '';
    const target = parseFloat(raw.replace(/[^0-9.]/g, ''));
    const suffix = el.dataset.suffix || raw.replace(/[0-9.,]/g, '');
    const hasComma = raw.indexOf(',') > -1;
    if (!isFinite(target)) return;
    if (reduce || !('IntersectionObserver' in window)) {
      el.textContent = (hasComma ? target.toLocaleString() : String(target)) + suffix;
      return;
    }
    let done = false;
    const so = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting || done) return;
          done = true;
          const dur = 1500;
          let start: number | null = null;
          const step = (ts: number) => {
            if (start === null) start = ts;
            const p = Math.min((ts - start) / dur, 1);
            const val = Math.round((0.5 - Math.cos(p * Math.PI) / 2) * target);
            el.textContent = (hasComma ? val.toLocaleString() : String(val)) + suffix;
            if (p < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
          so.unobserve(e.target);
        });
      },
      { threshold: 0.5 }
    );
    so.observe(el);
  }
  document
    .querySelectorAll<HTMLElement>('.re .stat-num[data-count], .re .num-v[data-count]')
    .forEach(countUp);

  // Act 1 — auto-playing house tour (cross-fade through rooms).
  const device = document.querySelector('.re .tour-device');
  if (device) {
    const scenes = Array.from(device.querySelectorAll<HTMLElement>('.td-scene'));
    const dots = Array.from(device.querySelectorAll<HTMLElement>('.td-dot'));
    const countEl = device.querySelector<HTMLElement>('.td-count');
    const fill = device.querySelector<HTMLElement>('.td-bar-fill');
    const DWELL = 3800;
    let idx = 0;
    let timer = 0;
    let paused = false;

    function fillReset() {
      if (!fill) return;
      fill.style.transition = 'none';
      fill.style.width = '0%';
      requestAnimationFrame(() => {
        if (!paused && !reduce) {
          fill.style.transition = `width ${DWELL}ms linear`;
          fill.style.width = '100%';
        }
      });
    }
    function show(i: number) {
      idx = (i + scenes.length) % scenes.length;
      scenes.forEach((s, j) => s.classList.toggle('active', j === idx));
      dots.forEach((d, j) => d.classList.toggle('on', j === idx));
      if (countEl) countEl.textContent = ('0' + (idx + 1)).slice(-2);
      fillReset();
    }
    function start() {
      if (reduce) return;
      stop();
      timer = window.setInterval(() => {
        if (!paused) show(idx + 1);
      }, DWELL);
    }
    function stop() {
      if (timer) window.clearInterval(timer);
    }

    dots.forEach((d) =>
      d.addEventListener('click', () => {
        show(Number(d.dataset.i));
        start();
      })
    );
    device.addEventListener('mouseenter', () => {
      paused = true;
      if (fill) fill.style.transition = 'none';
    });
    device.addEventListener('mouseleave', () => {
      paused = false;
      fillReset();
    });

    show(0);
    start();
  }
</script>
