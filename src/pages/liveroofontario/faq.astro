---
import Layout from '../../layouts/LiveRoofOntarioLayout.astro';
import TopBar from '../../components/liveroofontario/TopBar.astro';
import Header from '../../components/liveroofontario/Header.astro';
import PageHero from '../../components/liveroofontario/PageHero.astro';
import CtaBanner from '../../components/liveroofontario/CtaBanner.astro';
import Footer from '../../components/liveroofontario/Footer.astro';
import PhoneReveal from '../../components/liveroofontario/PhoneReveal.astro';

const categories = [
  {
    id: 'benefits',
    label: 'Benefits',
    faqs: [
      { q: 'Is there any research on the effectiveness of the RoofBlue RETAIN™ system?', a: 'Yes. World-renowned researcher Dr. Brad Rowe published a 2022 study comparing stormwater retention effectiveness of various vegetated roof and blue roof systems. Dr. Anna Droz conducted additional research testing RoofBlue RETAIN\'s effects on plant growth and irrigation needs, showing significant water savings and increased plant growth in RETAIN modules.' },
      { q: 'What is the biggest financial advantage of a vegetated roof?', a: 'The primary financial benefit is extension of the lifetime of the roof — typical estimates are that a vegetated roof potentially extends the lifetime of a roof between 200 and 300 percent, by protecting the rooftop from ultraviolet radiation, large temperature fluctuations, drying winds, and punctures. Additionally, reduced membrane maintenance brings significant cost savings over time. Stormwater incentives may provide substantial monetary benefits in some communities.' },
      { q: 'What incentives are available for vegetated roofs?', a: 'Many municipalities offer financial incentives for vegetated roofs to reduce stormwater runoff and encourage energy conservation. Check with your state and local governments for programs in your area.' },
      { q: 'How do vegetated roofs save energy?', a: 'Vegetated Roofs have been proven to bring about significant energy savings, particularly during the summer cooling season in which single story buildings can experience a reduction of greater than 25% energy use for air conditioning.' },
      { q: 'How does the LiveRoof system reduce stormwater runoff?', a: 'In urban areas, impermeable surfaces — streets, sidewalks, rooftops — prevent rainwater from following a natural cycle of absorption. LiveRoof vegetated roof surfaces absorb substantial rainfall, reduce runoff, lessen combined sewer overflow risks, and filter water percolating through soil.' },
      { q: 'How do vegetated roofs reduce noise?', a: 'Plants, soil, and trapped air and moisture in the soil are great acoustic insulators. Studies have shown that vegetated roofs can reduce indoor sound by as much as 40 decibels.' },
    ],
  },
  {
    id: 'design',
    label: 'Design',
    faqs: [
      { q: 'What waterproofing systems can LiveRoof work with?', a: 'LiveRoof systems are compatible with nearly all waterproofing types: EPDM, TPO, PVC, bituminous, polyurethane, rubberized asphalt, inverted or conventional.' },
      { q: 'Why does LiveRoof recommend overhead spray irrigation?', a: 'Spray rotor systems are the least expensive to install, easiest to maintain, and apply water most efficiently.' },
      { q: 'What is the difference between rooftop detention and rooftop retention?', a: 'Retention means a specific volume of water is held on the roof indefinitely. Detention means temporarily delaying stormwater before discharging it as runoff.' },
      { q: 'How much does the LiveRoof system weigh?', a: 'The LiveRoof system weighs approximately 27–29 lbs/sq ft (with a media depth of 4") when fully vegetated and saturated.' },
      { q: 'Can I retrofit my existing building with a vegetated roof?', a: 'Retrofitting depends on structural weight-bearing capacity. A qualified structural engineer must always be consulted before installation.' },
    ],
  },
  {
    id: 'installation',
    label: 'Installation',
    faqs: [
      { q: 'How do I go about having a LiveRoof system installed?', a: 'For Ontario and Atlantic Canada, contact Kees Govers via our Contact page or email kees@liveroofontario.ca.' },
      { q: 'How can a contractor become a LiveRoof Certified Installer?', a: 'Landscape and roofing contractors interested in offering LiveRoof installation services should contact their local representative.' },
      { q: 'Can LiveRoof modules be cut to fit odd dimensions and angles?', a: 'Yes, LiveRoof modules can be cut to size and shape using a masonry saw or reciprocating saw.' },
    ],
  },
  {
    id: 'maintenance',
    label: 'Maintenance',
    faqs: [
      { q: 'Why are frequent, brief maintenance activities critical to success?', a: 'The life cycle of most weeds is about four weeks. Therefore, by weeding every 2 weeks, for just a few minutes, the few weeds that come from birds and the wind are not allowed to reproduce.' },
      { q: 'Is it okay to walk on vegetated roof plantings?', a: 'Minimal, sparse walking is acceptable. Avoid creating single paths, standing in one place, or trampling plants.' },
      { q: 'Will I need to fertilize my vegetated roof?', a: 'Yes, but likely not annually. Send soil samples to a lab qualified for vegetated roof soils each spring before growth begins.' },
      { q: 'Can I use de-icing chemicals on my LiveRoof plants during the winter?', a: 'No, LiveRoof plants are damaged by de-icing chemicals. Use sand or cat litter instead.' },
    ],
  },
  {
    id: 'plants-soil',
    label: 'Plants & Soil',
    faqs: [
      { q: 'What are the best plants to use on vegetated roofs?', a: 'In the Lite and Standard systems, we recommend plants with extreme drought resistance — succulent, water-holding plants like Sedums, Alliums, Sempervivums, and Delospermas.' },
      { q: 'What is so special about LiveRoof soil?', a: 'LiveRoof Engineered Vegetated Roof Soil is composed of approximately 94% high quality inorganic aggregates by dry weight.' },
    ],
  },
];
---

<Layout title="FAQ – LiveRoof Vegetated Roof Systems">
  <TopBar />
  <Header />

  <PageHero
    eyebrow="FAQ"
    title="Frequently Asked"
    highlight="Questions"
    subtitle="Find answers to the most common questions about LiveRoof vegetated roof systems, design, installation, maintenance, and more."
    breadcrumbs={[
      { label: 'Home', href: '/liveroofontario/' },
      { label: 'FAQ' },
    ]}
  />

  <section class="py-14 md:py-24 bg-white">
    <div class="container">
      <div class="faq-tabs flex flex-wrap gap-2 mb-12 border-b border-border pb-4" role="tablist">
        {categories.map((cat, i) => (
          <button
            class={`faq-tab px-5 py-2.5 rounded-lg text-[0.85rem] font-semibold tracking-wide transition-all cursor-pointer ${i === 0 ? 'bg-green text-white' : 'bg-mid text-text-muted hover:bg-border'}`}
            data-tab={cat.id}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {cat.label}
          </button>
        ))}
      </div>

      {categories.map((cat, i) => (
        <div class={`faq-panel ${i === 0 ? '' : 'hidden'}`} data-panel={cat.id} role="tabpanel">
          <div class="grid gap-6">
            {cat.faqs.map((faq) => (
              <details class="group bg-mid rounded-xl overflow-hidden">
                <summary class="flex items-center justify-between cursor-pointer px-4 sm:px-7 py-5 text-dark font-semibold text-[1rem] leading-snug select-none list-none [&::-webkit-details-marker]:hidden">
                  <span class="pr-4">{faq.q}</span>
                  <svg class="flex-shrink-0 w-5 h-5 text-text-muted transition-transform group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                </summary>
                <div class="px-4 sm:px-7 pb-6 pt-0">
                  <p class="text-text-muted leading-relaxed">{faq.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="py-10 md:py-16 bg-mid">
    <div class="container text-center">
      <h2 class="font-serif text-[2rem] text-dark mb-4">Still Have Questions?</h2>
      <p class="text-text-muted max-w-[480px] mx-auto mb-8 leading-relaxed">Our team is here to help. Reach out to your local LiveRoof Ontario representative or contact global headquarters.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/liveroofontario/contact" class="btn btn-primary">Contact Us</a>
        <PhoneReveal number="5196715777" class="btn btn-outline-dark" />
      </div>
    </div>
  </section>

  <CtaBanner />
  <Footer />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.faq-tab');
    const panels = document.querySelectorAll('.faq-panel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-tab');

        tabs.forEach((t) => {
          t.classList.remove('bg-green', 'text-white');
          t.classList.add('bg-mid', 'text-text-muted');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.remove('bg-mid', 'text-text-muted');
        tab.classList.add('bg-green', 'text-white');
        tab.setAttribute('aria-selected', 'true');

        panels.forEach((panel) => {
          if (panel.getAttribute('data-panel') === target) {
            panel.classList.remove('hidden');
          } else {
            panel.classList.add('hidden');
          }
        });
      });
    });
  });
</script>
