---
import Layout from '../../layouts/LiveRoofOntarioLayout.astro';
import TopBar from '../../components/liveroofontario/TopBar.astro';
import Header from '../../components/liveroofontario/Header.astro';
import PageHero from '../../components/liveroofontario/PageHero.astro';
import CtaBanner from '../../components/liveroofontario/CtaBanner.astro';
import Footer from '../../components/liveroofontario/Footer.astro';
---

<Layout title="Portfolio – LiveRoof Ontario">
  <TopBar />
  <Header />

  <PageHero
    eyebrow="Portfolio"
    title="Project"
    highlight="Portfolio"
    subtitle="Vegetated Roof projects across Ontario — from university campuses to corporate headquarters."
    breadcrumbs={[
      { label: 'Home', href: '/liveroofontario/' },
      { label: 'Portfolio' },
    ]}
  />

  <section class="py-14 md:py-24 bg-white">
    <div class="container">
      <div class="max-w-[500px] mx-auto text-center py-16">
        <div class="w-16 h-16 rounded-2xl bg-green-light flex items-center justify-center mx-auto mb-6">
          <svg width="32" height="32" fill="none" stroke="#17b060" stroke-width="1.5" viewBox="0 0 24 24">
            <rect x="3" y="3" width="18" height="18" rx="3" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <path d="m6 21 5.5-7 3.5 4 2.5-3L21 21" />
          </svg>
        </div>
        <h2 class="font-serif text-[1.8rem] text-dark mb-3">Projects Coming Soon</h2>
        <p class="text-text-muted leading-relaxed">Check back soon — we're adding our project portfolio. In the live site, projects are managed via Sanity CMS with filtering by province, type, module system, LEED certification, and more.</p>
      </div>
    </div>
  </section>

  <CtaBanner />
  <Footer />
</Layout>
