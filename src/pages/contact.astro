---
// /contact — the form fallback for people who don't want a call yet.
// Posts to the existing Formspree form (xeepbppp) without loading their
// script; fires form_submit on success. States give direction, not apology.
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbs } from '../lib/jsonld';

const FORMSPREE = 'https://formspree.io/f/xeepbppp';
---

<BaseLayout
  title="Contact — The Linova Group"
  description="Send a message to The Linova Group — web design, development, and marketing from Thornhill, Ontario. Replies within one business day."
  jsonLd={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact' }])]}
>
  <div class="plot-grid">
    <header class="mx-auto max-w-[1100px] px-6 pb-10 pt-24">
      <p class="label-mono">contact</p>
      <h1 class="mt-4 font-display text-display text-film">Send a message</h1>
      <p class="mt-5 max-w-[54ch] text-body text-film-dim">
        Prefer talking? <a href="/book" data-track="book_click" data-track-label="contact" class="text-gold underline decoration-1 underline-offset-4">Book a call</a> instead —
        it's usually faster. Either way you get a reply within one business day.
      </p>
    </header>
  </div>

  <div class="mx-auto max-w-[720px] px-6 pb-24">
    <form data-contact-form action={FORMSPREE} method="POST" class="flex flex-col gap-6" novalidate>
      <div class="grid gap-6 sm:grid-cols-2">
        <label class="flex flex-col gap-2">
          <span class="label-mono">your name</span>
          <input type="text" name="name" required autocomplete="name" class="field" />
        </label>
        <label class="flex flex-col gap-2">
          <span class="label-mono">business</span>
          <input type="text" name="business" autocomplete="organization" class="field" />
        </label>
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        <label class="flex flex-col gap-2">
          <span class="label-mono">email</span>
          <input type="email" name="email" required autocomplete="email" class="field" />
        </label>
        <label class="flex flex-col gap-2">
          <span class="label-mono">phone <span class="normal-case tracking-normal">(optional)</span></span>
          <input type="tel" name="phone" autocomplete="tel" class="field" />
        </label>
      </div>
      <label class="flex flex-col gap-2">
        <span class="label-mono">what do you need</span>
        <select name="need" class="field">
          <option value="new-site">A new website</option>
          <option value="rebuild">A rebuild of an existing site</option>
          <option value="marketing">Marketing & social media</option>
          <option value="both">Site + marketing</option>
          <option value="other">Something else</option>
        </select>
      </label>
      <label class="flex flex-col gap-2">
        <span class="label-mono">the message</span>
        <textarea name="message" rows="5" required class="field"></textarea>
      </label>
      <!-- honeypot -->
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

      <div>
        <button type="submit" class="rounded-chip border border-gold px-7 py-3.5 text-body text-film transition-colors hover:border-redline">
          Send the message
        </button>
      </div>

      <p data-form-ok hidden class="m-0 border border-gold/60 p-4 text-caption text-film">
        Message sent. You'll hear back within one business day — check the
        email you gave us.
      </p>
      <p data-form-err hidden class="m-0 border border-redline/60 p-4 text-caption text-film">
        The message didn't go through. Try again, or email us from your own
        mail app — the form isn't the only door.
      </p>
    </form>
  </div>
</BaseLayout>

<style>
  .field {
    background: color-mix(in srgb, var(--color-ink) 60%, var(--color-navy));
    border: 1px solid color-mix(in srgb, var(--color-grid) 50%, transparent);
    border-radius: var(--radius-chip);
    color: var(--color-film);
    padding: 0.75rem 1rem;
    font-size: 1rem;
    line-height: 1.4;
  }
  .field:focus {
    outline: 2px solid var(--color-film);
    outline-offset: 1px;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const ok = form.querySelector<HTMLElement>('[data-form-ok]');
    const err = form.querySelector<HTMLElement>('[data-form-err]');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      ok!.hidden = true;
      err!.hidden = true;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        ok!.hidden = false;
        (window as unknown as { linovaTrack?: (n: string, p?: object) => void }).linovaTrack?.('form_submit', { form: 'contact' });
      } catch {
        err!.hidden = false;
      }
    });
  }
</script>
