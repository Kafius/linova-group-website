---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Set New Password — Lenny"
  description="Reset your Lenny password."
>

  <header class="fixed top-4 inset-x-0 z-[1000] px-4 sm:px-6 pointer-events-none">
    <div
      class="max-w-[1140px] mx-auto backdrop-blur-md rounded-2xl border px-5 flex items-center h-[64px] pointer-events-auto"
      style="background: rgba(35,44,99,0.85); border-color: rgba(205,168,79,0.2); box-shadow: 0 4px 24px rgba(0,0,0,0.25);"
    >
      <a href="/" class="flex items-center gap-2.5 cursor-pointer">
        <svg width="32" height="32" viewBox="0 0 48 48" aria-label="Lenny">
          <rect width="48" height="48" rx="10" fill="#1a224d" />
          <rect x="18" y="11" width="7" height="26" rx="1.5" fill="#ffffff" />
          <rect x="18" y="30" width="15" height="7" rx="1.5" fill="#cda84f" />
        </svg>
        <span class="text-white font-bold text-lg tracking-tight">Lenny</span>
      </a>
    </div>
  </header>

  <main
    class="relative min-h-[100svh] flex items-center justify-center pt-28 pb-24 overflow-hidden text-white"
    style="background: radial-gradient(ellipse at 50% 40%, #2c3878 0%, #232c63 40%, #161c44 100%);"
  >
    <div class="absolute inset-0 opacity-[0.06]" style="background-image: radial-gradient(circle, #ffffff 1px, transparent 1px); background-size: 30px 30px;"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] rounded-full pointer-events-none" style="background: radial-gradient(ellipse, rgba(205,168,79,0.12) 0%, transparent 65%); filter: blur(80px);"></div>

    <div class="relative max-w-[480px] mx-auto px-6 text-center w-full">

      <!-- Loading state -->
      <div id="state-loading">
        <div class="w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-8 border" style="background: rgba(205,168,79,0.1); border-color: rgba(205,168,79,0.25);">
          <svg class="animate-spin" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#cda84f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
          </svg>
        </div>
        <p class="text-lg" style="color: rgba(255,255,255,0.5);">Validating reset link…</p>
      </div>

      <!-- Form state -->
      <div id="state-form" style="display:none;">
        <div class="w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-8 border" style="background: rgba(205,168,79,0.15); border-color: rgba(205,168,79,0.35);">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#cda84f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </div>

        <div class="inline-flex items-center gap-2 border text-xs font-semibold tracking-[0.15em] uppercase px-4 py-2 rounded-full mb-6" style="background: rgba(205,168,79,0.1); border-color: rgba(205,168,79,0.25); color: rgba(205,168,79,0.9);">
          <span class="w-1.5 h-1.5 rounded-full inline-block" style="background:#cda84f;"></span>
          Reset Password
        </div>

        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-[1.1] mb-4">
          Set a new password.
        </h1>
        <p class="text-base leading-relaxed mb-8" style="color: rgba(255,255,255,0.55);">
          Choose a strong password for your Lenny account.
        </p>

        <form id="reset-form" class="text-left flex flex-col gap-4">
          <div>
            <label for="password" class="block text-sm font-semibold mb-1.5" style="color: rgba(255,255,255,0.7);">New password</label>
            <input
              id="password"
              type="password"
              placeholder="At least 8 characters"
              autocomplete="new-password"
              class="w-full rounded-xl px-4 py-3 text-sm outline-none border transition-all duration-150"
              style="background: rgba(255,255,255,0.07); border-color: rgba(255,255,255,0.12); color: #fff;"
              onfocus="this.style.borderColor='rgba(205,168,79,0.5)'; this.style.background='rgba(255,255,255,0.1)';"
              onblur="this.style.borderColor='rgba(255,255,255,0.12)'; this.style.background='rgba(255,255,255,0.07)';"
            />
          </div>
          <div>
            <label for="confirm-password" class="block text-sm font-semibold mb-1.5" style="color: rgba(255,255,255,0.7);">Confirm password</label>
            <input
              id="confirm-password"
              type="password"
              placeholder="Repeat your new password"
              autocomplete="new-password"
              class="w-full rounded-xl px-4 py-3 text-sm outline-none border transition-all duration-150"
              style="background: rgba(255,255,255,0.07); border-color: rgba(255,255,255,0.12); color: #fff;"
              onfocus="this.style.borderColor='rgba(205,168,79,0.5)'; this.style.background='rgba(255,255,255,0.1)';"
              onblur="this.style.borderColor='rgba(255,255,255,0.12)'; this.style.background='rgba(255,255,255,0.07)';"
            />
          </div>

          <p id="form-error" class="text-sm rounded-xl px-4 py-3 border" style="display:none; background: rgba(239,68,68,0.1); border-color: rgba(239,68,68,0.25); color: #fca5a5;"></p>

          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3.5 rounded-xl font-semibold text-sm text-white transition-all duration-200 mt-2"
            style="background: linear-gradient(135deg, #232c63, #2f3a82);"
          >
            Update password
          </button>
        </form>
      </div>

      <!-- Success state -->
      <div id="state-success" style="display:none;">
        <div class="w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-8 border" style="background: rgba(205,168,79,0.15); border-color: rgba(205,168,79,0.35);">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#cda84f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>

        <div class="inline-flex items-center gap-2 border text-xs font-semibold tracking-[0.15em] uppercase px-4 py-2 rounded-full mb-6" style="background: rgba(205,168,79,0.1); border-color: rgba(205,168,79,0.25); color: rgba(205,168,79,0.9);">
          <span class="w-1.5 h-1.5 rounded-full inline-block" style="background:#cda84f;"></span>
          Password Updated
        </div>

        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-[1.1] mb-5">
          All done.<br />
          <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(90deg, #cda84f, #e8c97a);">You're back in.</span>
        </h1>

        <p class="text-lg leading-relaxed mb-10" style="color: rgba(255,255,255,0.6);">
          Your password has been updated. Open Lenny and sign in with your new password.
        </p>

        <a
          href="/#lenny"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-sm border transition-all duration-200"
          style="border-color: rgba(205,168,79,0.3); color: rgba(205,168,79,0.8);"
        >
          ← Back to Lenny's page
        </a>
      </div>

      <!-- Invalid link error state -->
      <div id="state-error" style="display:none;">
        <div class="w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-8 border" style="background: rgba(239,68,68,0.15); border-color: rgba(239,68,68,0.35);">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#f87171" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </div>

        <div class="inline-flex items-center gap-2 border text-xs font-semibold tracking-[0.15em] uppercase px-4 py-2 rounded-full mb-6" style="background: rgba(239,68,68,0.1); border-color: rgba(239,68,68,0.25); color: rgba(248,113,113,0.9);">
          <span class="w-1.5 h-1.5 rounded-full inline-block" style="background:#f87171;"></span>
          Link Expired
        </div>

        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-[1.1] mb-5">
          This link<br />has expired.
        </h1>

        <p class="text-lg leading-relaxed mb-10" style="color: rgba(255,255,255,0.6);">
          Password reset links expire after 1 hour. Please request a new one from the Lenny app.
        </p>

        <a
          href="/#lenny"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-sm border transition-all duration-200"
          style="border-color: rgba(205,168,79,0.3); color: rgba(205,168,79,0.8);"
        >
          ← Back to Lenny's page
        </a>
      </div>

    </div>
  </main>

  <footer class="py-8 border-t" style="background: #161c44; border-color: rgba(255,255,255,0.07);">
    <div class="max-w-[1140px] mx-auto px-6 text-center">
      <p class="text-sm" style="color: rgba(255,255,255,0.25);">© {new Date().getFullYear()} Linova Group. All rights reserved.</p>
    </div>
  </footer>

</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  const states = ['state-loading', 'state-form', 'state-success', 'state-error'];

  function show(id: string) {
    states.forEach(s => {
      const el = document.getElementById(s);
      if (el) el.style.display = s === id ? '' : 'none';
    });
  }

  async function init() {
    const params = new URLSearchParams(window.location.search);
    const tokenHash = params.get('token_hash');
    const type = params.get('type');

    if (tokenHash && type === 'recovery') {
      // PKCE flow — exchange token for session so updateUser works
      const { error } = await supabase.auth.verifyOtp({ token_hash: tokenHash, type: 'recovery' });
      if (error) { show('state-error'); return; }
      show('state-form');
      return;
    }

    // Implicit flow — recovery token is in the URL hash; getSession processes it
    const { data, error } = await supabase.auth.getSession();
    if (error || !data.session) { show('state-error'); return; }
    show('state-form');
  }

  document.getElementById('reset-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const password = (document.getElementById('password') as HTMLInputElement).value;
    const confirm = (document.getElementById('confirm-password') as HTMLInputElement).value;
    const formError = document.getElementById('form-error')!;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;

    formError.style.display = 'none';

    if (password.length < 8) {
      formError.textContent = 'Password must be at least 8 characters.';
      formError.style.display = '';
      return;
    }
    if (password !== confirm) {
      formError.textContent = 'Passwords do not match.';
      formError.style.display = '';
      return;
    }

    btn.textContent = 'Updating…';
    btn.disabled = true;

    const { error } = await supabase.auth.updateUser({ password });

    if (error) {
      formError.textContent = error.message;
      formError.style.display = '';
      btn.textContent = 'Update password';
      btn.disabled = false;
    } else {
      show('state-success');
    }
  });

  init();
</script>
