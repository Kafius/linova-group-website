---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/navbar/Navbar.astro';
import Footer from '../components/footer/Footer.astro';
import LogoMarquee from '../components/section-showcase/LogoMarquee.astro';
---

<Layout
  title="Section Showcase — Linova Group"
  description="Explore section ideas that transform a website — cinematic heroes, interactive showcases, conversion-focused layouts and more."
>
  <Navbar />

  <!-- Hero -->
  <section class="relative pt-36 pb-24 overflow-hidden text-white" style="background: radial-gradient(ellipse at 50% 50%, #3a1242 0%, #1f0b2a 45%, #120818 100%);">
    <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle, #ffffff 1px, transparent 1px); background-size: 30px 30px;"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] rounded-full pointer-events-none" style="background: radial-gradient(ellipse, rgba(217,70,239,0.22) 0%, transparent 70%); filter: blur(80px);"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[1100px] h-[800px] rounded-full pointer-events-none" style="background: radial-gradient(ellipse, transparent 40%, rgba(244,114,182,0.10) 65%, transparent 80%); filter: blur(70px);"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[450px] h-[320px] rounded-full pointer-events-none" style="background: radial-gradient(ellipse, rgba(251,146,60,0.14) 0%, transparent 70%); filter: blur(50px);"></div>

    <div class="relative max-w-[1140px] mx-auto px-6 text-center">
      <div class="inline-flex items-center gap-2 bg-white/10 border border-white/15 text-white/75 text-xs font-semibold tracking-[0.15em] uppercase px-4 py-2 rounded-full mb-8 backdrop-blur-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-fuchsia-400 inline-block"></span>
        Section Showcase
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-[3.75rem] font-extrabold tracking-tight leading-[1.07] mb-5">
        Sections That<br class="hidden sm:block" />
        <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(90deg, #f0abfc, #fda4af);">Transform a Website</span>
      </h1>
      <p class="text-white/55 text-lg max-w-[560px] mx-auto leading-relaxed font-medium mb-10">
        Real, interactive section ideas you can drop into your site. Hover, click, and explore — then pick the ones that fit your story.
      </p>
      <div aria-hidden="true" class="h-[52px]"></div>
    </div>
  </section>

  <!-- Sections grid -->
  <section class="py-20 bg-[#07080f]">
    <div class="max-w-[1400px] mx-auto px-6">

      <!-- Section label -->
      <div class="flex items-center justify-between mb-12">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-fuchsia-400/60 mb-1">Section Library</p>
          <h2 class="text-white text-2xl font-bold">Ideas, Live and Interactive</h2>
        </div>
        <p class="text-white/30 text-sm hidden md:block">More added regularly</p>
      </div>

      <!-- Section examples — added one at a time -->
      <div class="space-y-24" id="section-list">
        <LogoMarquee />
      </div>

    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="relative py-24 overflow-hidden text-white text-center" style="background: linear-gradient(135deg, #1f0b2a 0%, #3a1242 60%, #2a0f3a 100%);">
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, #ffffff 1px, transparent 1px); background-size: 30px 30px;"></div>
    <div class="relative max-w-[640px] mx-auto px-6">
      <span class="inline-block text-xs font-bold uppercase tracking-[0.2em] text-fuchsia-300/70 mb-4">Want Something Custom?</span>
      <h2 class="text-3xl lg:text-4xl font-extrabold mb-4 tracking-tight">Have a Section in Mind?</h2>
      <p class="text-white/55 text-lg mb-8 leading-relaxed">Tell us what you'd like to showcase. We'll design a section built around your business and your customers.</p>
      <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 rounded-xl font-semibold bg-white text-primary hover:bg-white/90 hover:-translate-y-0.5 hover:shadow-[0_8px_32px_rgba(255,255,255,0.15)] transition-all duration-200 cursor-pointer">
        Get a Free Quote
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <Footer />
</Layout>
