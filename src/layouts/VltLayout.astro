---
import '../styles/global.css';
import '../styles/vlt-global.css';

interface Props {
  title?: string;
  description?: string;
  activeSection?: string;
}

const {
  title = 'Vinyl Lite Technology Inc. — Precision SDL Manufacturing',
  description = 'Vinyl Lite Technology Inc. delivers precision SDL manufacturing systems for vinyl and wood window manufacturers. Fort Worth, TX.',
  activeSection = '',
} = Astro.props;

const productLinks = [
  { href: '/vinyllitetech/products/sdl',                    label: 'Simulated Divided Lites' },
  { href: '/vinyllitetech/products/sdl-bar-profiles',       label: 'SDL Bar Profiles' },
  { href: '/vinyllitetech/products/fabrication-equipment',  label: 'Fabrication Equipment' },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex,nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Barlow:wght@300;400;500;600&family=Share+Tech+Mono&display=swap" rel="stylesheet" />
  
</head>
<body>

  <!-- NAV -->
  <header class="vlt-nav">
    <div class="vlt-nav-inner">
      <a href="/vinyllitetech" class="vlt-nav-logo" aria-label="Vinyl Lite Technology — home">
        <img src="/vinyllitetech-logo.png" alt="Vinyl Lite Technology" />
      </a>

      <div class="vlt-nav-links" role="navigation" aria-label="Primary navigation">
        <a href="/vinyllitetech" class={`vlt-nav-link${activeSection === 'home' ? ' active' : ''}`}>Home</a>
        <a href="/vinyllitetech/about" class={`vlt-nav-link${activeSection === 'about' ? ' active' : ''}`}>About</a>

        <div class="vlt-drop" id="vltDrop">
          <button class="vlt-drop-btn" aria-expanded="false" aria-haspopup="true" id="vltDropBtn">
            Products
            <svg class="vlt-drop-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
              <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ul class="vlt-dropdown" role="menu">
            {productLinks.map((p) => (
              <li role="none">
                <a href={p.href} class="vlt-dropdown-item" role="menuitem">{p.label}</a>
              </li>
            ))}
          </ul>
        </div>

        <a href="/vinyllitetech/contact" class={`vlt-nav-link${activeSection === 'contact' ? ' active' : ''}`}>Contact</a>
      </div>

      <a href="/vinyllitetech/contact" class="vlt-nav-cta">Get a Quote</a>

      <button class="vlt-burger" id="vltBurger" aria-label="Toggle menu" aria-expanded="false" aria-controls="vltMobileMenu">
        <span></span><span></span><span></span>
      </button>
    </div>

    <div class="vlt-mobile-menu" id="vltMobileMenu" aria-hidden="true">
      <a href="/vinyllitetech" class="vlt-mobile-link">Home</a>
      <a href="/vinyllitetech/about" class="vlt-mobile-link">About</a>
      <div style="border-bottom: 1px solid var(--vlt-border);">
        <button class="vlt-mobile-link" id="vltMobDropBtn" aria-expanded="false" style="width:100%;">
          Products
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true" id="vltMobChevron">
            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="vlt-mobile-sub" id="vltMobSub">
          {productLinks.map((p) => (
            <a href={p.href} class="vlt-mobile-sub-link">{p.label}</a>
          ))}
        </div>
      </div>
      <a href="/vinyllitetech/contact" class="vlt-mobile-link">Contact</a>
      <a href="/vinyllitetech/contact" class="vlt-mobile-cta">Get a Quote</a>
    </div>
  </header>

  <!-- PAGE CONTENT -->
  <slot />

  <!-- CTA BANNER -->
  <div class="vlt-cta-banner">
    <div class="vlt-inner">
      <div class="vlt-cta-inner">
        <div>
          <h2 class="vlt-cta-title">Ready to Start Your SDL Program?</h2>
          <p class="vlt-cta-sub">Whether you're scaling up or just starting out, we'll help you find the right system and get it running fast.</p>
        </div>
        <a href="/vinyllitetech/contact" class="vlt-btn vlt-btn-white">Talk to an Expert</a>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="vlt-footer">
    <div class="vlt-inner">
      <div class="vlt-footer-top">
        <div>
          <a href="/vinyllitetech" class="vlt-footer-logo" aria-label="Vinyl Lite Technology — home">
            <img src="/vinyllitetech-logo.png" alt="Vinyl Lite Technology" />
          </a>
          <p class="vlt-footer-tagline">Precision SDL Manufacturing Systems — Fort Worth, TX<br />Serving vinyl and wood window manufacturers across North America.</p>
        </div>
        <div class="vlt-footer-cols">
          <div>
            <div class="vlt-footer-col-head">Company</div>
            <ul class="vlt-footer-col-links">
              <li><a href="/vinyllitetech/about">About</a></li>
              <li><a href="/vinyllitetech/contact">Contact</a></li>
            </ul>
          </div>
          <div>
            <div class="vlt-footer-col-head">Products</div>
            <ul class="vlt-footer-col-links">
              {productLinks.map((p) => (
                <li><a href={p.href}>{p.label}</a></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
      <div class="vlt-footer-bottom">
        <span class="vlt-footer-copy">© {new Date().getFullYear()} Vinyl Lite Technology Inc. · All Rights Reserved · Fort Worth, TX</span>
        <span class="vlt-footer-tag">Precision SDL Systems</span>
      </div>
    </div>
  </footer>

  <!-- PITCH RIBBON -->
  <aside class="vlt-ribbon">
    <strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:15px;letter-spacing:0.5px;text-transform:uppercase;">Preview by Linova Group</strong>
    <p style="margin-top:6px;opacity:.8;font-size:12px;">A redesign concept built for Vinyl Lite Technology. Like what you see? <a href="https://thelinovagroup.com">thelinovagroup.com</a></p>
  </aside>

  <script is:inline>
    // Desktop dropdown
    var vltDrop    = document.getElementById('vltDrop');
    var vltDropBtn = document.getElementById('vltDropBtn');
    function vltOpen()  { vltDrop && vltDrop.setAttribute('data-open', ''); vltDropBtn && vltDropBtn.setAttribute('aria-expanded', 'true'); }
    function vltClose() { vltDrop && vltDrop.removeAttribute('data-open'); vltDropBtn && vltDropBtn.setAttribute('aria-expanded', 'false'); }
    vltDropBtn && vltDropBtn.addEventListener('click', function() { vltDrop && vltDrop.hasAttribute('data-open') ? vltClose() : vltOpen(); });
    document.addEventListener('click', function(e) { if (vltDrop && !vltDrop.contains(e.target)) vltClose(); });
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') vltClose(); });

    // Mobile hamburger
    var vltBurger = document.getElementById('vltBurger');
    var vltMenu   = document.getElementById('vltMobileMenu');
    vltBurger && vltBurger.addEventListener('click', function() {
      var open = vltMenu && vltMenu.classList.toggle('open');
      vltBurger.setAttribute('aria-expanded', String(open));
      vltMenu && vltMenu.setAttribute('aria-hidden', String(!open));
    });
    vltMenu && vltMenu.querySelectorAll('a').forEach(function(a) {
      a.addEventListener('click', function() {
        vltMenu.classList.remove('open');
        vltBurger && vltBurger.setAttribute('aria-expanded', 'false');
        vltMenu.setAttribute('aria-hidden', 'true');
      });
    });

    // Mobile sub-menu
    var vltMobDropBtn = document.getElementById('vltMobDropBtn');
    var vltMobSub     = document.getElementById('vltMobSub');
    var vltMobChevron = document.getElementById('vltMobChevron');
    vltMobDropBtn && vltMobDropBtn.addEventListener('click', function() {
      var open = vltMobSub && vltMobSub.classList.toggle('open');
      vltMobDropBtn.setAttribute('aria-expanded', String(open));
      if (vltMobChevron) vltMobChevron.style.transform = open ? 'rotate(180deg)' : '';
    });
  </script>
</body>
</html>
