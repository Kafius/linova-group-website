---
// Type-to-filter across the industry grid.
//
// The section rail beside this is deliberately not a client-side filter —
// every group is a real page with a real URL. This is the other half of that:
// a visitor who knows their trade but not which group it files under should
// not have to guess. It matches the vertical's name and, more usefully, every
// business type in its covers list — "plumber", "dojo", "boba", "detailing".
//
// Progressive enhancement, honestly done: the markup ships hidden and the
// script reveals it. Without JS there is no dead control on the page, and the
// full grid is visible, which is the correct fallback for a filter.
//
// Lives in SectionRail's slot, so it draws no container of its own — the band
// supplies the measure and the gutter. The band is sticky, which is why this
// is kept to a single row: every line here is a line of the page that stays
// pinned while the cards scroll under it.
interface Props {
  /** how many cards the page is showing, for the initial count */
  total: number;
}

const { total } = Astro.props;
---

<div class="search" data-industry-search hidden>
  {/* Screen-reader only. Under the rail's own links, a visible "search by
      trade" caption is a third mono register competing with them; the icon
      and the placeholder carry it for everyone else. */}
  <label class="sr-only" for="industry-search">Search by trade</label>
  <div class="search__field">
    <svg class="search__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.4" />
      <path d="M10.4 10.4 L14 14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    </svg>
    <input
      id="industry-search"
      type="search"
      class="search__input"
      placeholder="plumber, dojo, bubble tea, detailing…"
      autocomplete="off"
      data-search-input
    />
    <button type="button" class="search__clear label-caps" data-search-clear hidden>
      clear
    </button>
  </div>
  {/* One line, not three. This is inside the sticky band, so a paragraph
      would shove the whole grid down the moment someone mistypes. */}
  <p class="search__empty" data-search-empty hidden>
    Nothing matches. Try the trade rather than the group — or{' '}
    <a href="/book">book a call</a>.
  </p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-industry-search]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const count = document.querySelector<HTMLElement>('[data-search-count]');
  const empty = document.querySelector<HTMLElement>('[data-search-empty]');
  const clear = document.querySelector<HTMLButtonElement>('[data-search-clear]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-industry]'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-industry-group]'));

  if (root && input && cards.length) {
    // Only now does the control exist for anyone: no JS, no dead input.
    root.hidden = false;

    const label = (n: number) => `${n} ${n === 1 ? 'industry' : 'industries'}`;

    const apply = () => {
      const q = input.value.trim().toLowerCase();
      // Every word has to appear somewhere in the card's text, so "bubble
      // tea" narrows rather than widening the way an OR would.
      const terms = q.split(/\s+/).filter(Boolean);
      let shown = 0;

      for (const card of cards) {
        const hay = card.dataset.search ?? '';
        const hit = terms.every((t) => hay.includes(t));
        card.hidden = !hit;
        if (hit) shown += 1;
      }

      // A group whose cards are all filtered out would otherwise leave its
      // heading, blurb and divider stranded above nothing.
      for (const group of groups) {
        group.hidden = !group.querySelector<HTMLElement>('[data-industry]:not([hidden])');
      }

      if (count) count.textContent = q ? `${label(shown)} matching “${q}”` : label(cards.length);
      if (empty) empty.hidden = shown > 0;
      if (clear) clear.hidden = q.length === 0;
    };

    input.addEventListener('input', apply);
    input.addEventListener('search', apply);

    clear?.addEventListener('click', () => {
      input.value = '';
      apply();
      input.focus();
    });

    // Escape clears rather than only blurring, which is what a filter should
    // do when someone wants the whole list back.
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && input.value) {
        event.preventDefault();
        input.value = '';
        apply();
      }
    });

    apply();
  }
</script>

<style>
  /* Symmetrical padding, and modest: this is a row of a pinned band, not a
     block on the page. It used to carry 1.5rem of bottom padding to hold
     itself off the grid below, which the band now handles. */
  .search {
    padding-block: 0.6rem;
  }

  /* No border of its own — the band is the frame. A bordered box inside a
     bordered band reads as two controls again, which is the thing being
     fixed. The field is marked by its rule underneath and the gold icon. */
  .search__field {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    max-width: 34rem;
    padding: 0.35rem 0 0.35rem 0.1rem;
    border-bottom: 1px solid rgba(77, 77, 143, 0.55);
    transition: border-color 0.2s var(--ease-plot);
  }
  .search__field:focus-within {
    border-color: var(--color-gold);
  }

  .search__icon {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--color-gold);
  }

  .search__input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--color-film);
    font-family: var(--font-sans);
    font-size: var(--text-body);
  }
  .search__input::placeholder {
    /* 0.62 alpha on the navy ground clears AA for placeholder text, which is
       still text somebody has to read. */
    color: rgba(239, 241, 248, 0.62);
  }
  .search__input:focus {
    outline: none;
  }
  /* The browser's own clear affordance duplicates the button and is unstyled. */
  .search__input::-webkit-search-cancel-button {
    display: none;
  }

  .search__clear {
    flex: none;
    padding: 0.25rem 0.5rem;
    border: 1px solid rgba(77, 77, 143, 0.55);
    border-radius: 2px;
    background: transparent;
    color: var(--color-film-dim);
    cursor: pointer;
  }
  .search__clear:hover {
    color: var(--color-film);
    border-color: var(--color-gold);
  }

  /* Caption rather than body, and tight to the field: it appears inside the
     pinned band, so its whole cost is height the grid loses while it shows. */
  .search__empty {
    margin: 0.5rem 0 0;
    max-width: 60ch;
    color: var(--color-film-dim);
    font-size: var(--text-caption);
  }
  .search__empty a {
    color: var(--color-gold);
  }

  @media (prefers-reduced-motion: reduce) {
    .search__field {
      transition: none;
    }
  }
</style>
