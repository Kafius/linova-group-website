---
// Speculative concept pieces for the two verticals with no client yet
// (brief §8: never fake a client — design the thing and label it honestly).
// Each is a compact, fully-designed mockup inside a browser frame, stamped
// CONCEPT. Doubles as the sales asset for the first salon or retail client.

interface Props {
  variant: 'barbershops' | 'retail';
}

const { variant } = Astro.props;
---

<div class="concept relative overflow-hidden border border-grid/40" data-concept={variant}>
  <!-- browser chrome -->
  <div class="flex items-center gap-3 border-b border-grid/40 bg-ink px-4 py-2.5">
    <span class="flex gap-1.5" aria-hidden="true">
      <i class="h-2.5 w-2.5 rounded-full bg-grid/60"></i>
      <i class="h-2.5 w-2.5 rounded-full bg-grid/60"></i>
      <i class="h-2.5 w-2.5 rounded-full bg-grid/60"></i>
    </span>
    <span class="label-mono normal-case tracking-normal">concept — no client yet · built on spec by Linova</span>
  </div>

  {variant === 'barbershops' ? (
    <div class="mock-barber relative p-0" aria-label="Speculative barbershop site concept">
      <div class="flex items-center justify-between px-6 py-4" style="background:#101014">
        <span class="font-sans text-[1.05rem] font-semibold tracking-[0.14em]" style="color:#f5f6f8">NORTH<span style="color:#3EC1E8">FADE</span></span>
        <span class="rounded-chip px-3.5 py-1.5 text-[0.75rem] font-semibold" style="background:#3EC1E8; color:#101014">Book a chair</span>
      </div>
      <div class="px-6 pb-7 pt-8" style="background:linear-gradient(160deg,#101014 55%,#16202a)">
        <p class="m-0 font-sans text-[0.7rem] font-medium uppercase tracking-[0.18em]" style="color:#3EC1E8">walk-ins till 8 · king st n</p>
        <p class="m-0 mt-2 font-sans text-[clamp(1.8rem,4vw,2.6rem)] font-bold leading-[1.02]" style="color:#f5f6f8">
          Walk in scruffy.<br />Walk out sharp.
        </p>
        <div class="mt-6 grid grid-cols-3 gap-3">
          {['MJ', 'Rico', 'Dee'].map((barber) => (
            <div class="rounded-[6px] p-3" style="background:rgba(245,246,248,0.06); border:1px solid rgba(62,193,232,0.25)">
              <div class="flex h-9 w-9 items-center justify-center rounded-full font-sans text-[0.7rem] font-bold" style="background:#3EC1E8; color:#101014">{barber.slice(0, 2).toUpperCase()}</div>
              <p class="m-0 mt-2 font-sans text-[0.8rem] font-semibold" style="color:#f5f6f8">{barber}</p>
              <p class="m-0 font-sans text-[0.7rem]" style="color:rgba(245,246,248,0.55)">next slot · today</p>
            </div>
          ))}
        </div>
        <p class="m-0 mt-5 font-sans text-[0.75rem]" style="color:rgba(245,246,248,0.6)">
          ★★★★★ 4.9 on Google · deposits on · no-shows charged
        </p>
      </div>
    </div>
  ) : (
    <div class="mock-retail relative" aria-label="Speculative retail site concept">
      <p class="m-0 py-1.5 text-center font-sans text-[0.7rem] font-medium uppercase tracking-[0.16em]" style="background:#F45FAD; color:#1c0f16">
        open till 8 tonight · queen st e
      </p>
      <div class="flex items-center justify-between px-6 py-4" style="background:#faf6f2">
        <span class="font-display text-[1.3rem]" style="color:#221a1e">Kept<span style="color:#F45FAD">.</span></span>
        <span class="font-sans text-[0.72rem] font-medium" style="color:#221a1e">shop · visit · @keptgoods</span>
      </div>
      <div class="px-6 pb-7" style="background:#faf6f2">
        <div class="grid grid-cols-3 gap-3">
          {[
            { name: 'Stoneware mug', price: '$28', tone: '#e7d8c9' },
            { name: 'Field notebook', price: '$14', tone: '#f0c9dc' },
            { name: 'Beeswax candle', price: '$22', tone: '#d9e3d0' },
          ].map((product) => (
            <div class="overflow-hidden rounded-[6px]" style="background:#ffffff; border:1px solid rgba(34,26,30,0.1)">
              <div class="h-16" style={`background:${product.tone}`}></div>
              <div class="p-2.5">
                <p class="m-0 font-sans text-[0.75rem] font-semibold" style="color:#221a1e">{product.name}</p>
                <p class="m-0 font-sans text-[0.72rem]" style="color:#F45FAD">{product.price} · in stock</p>
              </div>
            </div>
          ))}
        </div>
        <p class="m-0 mt-4 font-sans text-[0.75rem]" style="color:rgba(34,26,30,0.6)">
          stock synced nightly · what you see is on the shelf
        </p>
      </div>
    </div>
  )}

  <!-- the honest stamp -->
  <span
    class="pointer-events-none absolute right-4 top-12 rotate-6 border-2 px-2 py-0.5 font-mono text-[0.7rem] font-medium uppercase tracking-[0.12em]"
    style="border-color: var(--color-redline); color: var(--color-redline)"
    aria-hidden="true"
  >concept</span>
</div>
