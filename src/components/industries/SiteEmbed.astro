---
// The sample sites on an industry page: a screenshot of the landing page in
// the plotted browser frame, and one large invitation to go and open the real
// thing.
//
// It used to embed the live site in an iframe with page tabs and a device
// toggle. That demoed well on a laptop and badly everywhere else — a site
// inside a 900px frame inside a page is nobody's idea of what the site looks
// like, and the tabs invited fiddling rather than looking. A still of the
// landing page reads instantly, and the button sends anyone who wants more to
// the site at the size a customer would actually see it.
//
// Laid out in two columns from 900px up: what the build is and the way into
// it on the left, the still on the right. Below that the three stack in
// reading order — premise, then the shot, then the button that follows it.
//
// A vertical can carry several packages — restaurants alone has seven — so
// when more than one demo is built the frame gains a package switcher, and
// every playbook's shot, address bar, premise and button swap with it.
//
// Plotter & Marker stops at the frame, exactly as it does for the mockup.
// Everything inside the screenshot is that demo's own brand world.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { LivePlaybook } from '../../data/playbooks';

interface Props {
  /** every built demo for this vertical, in pipeline order */
  playbooks: LivePlaybook[];
  /** scopes the instance's ids so a page could carry more than one */
  slug: string;
  /** the vertical's accent — the frame's own colour, as with the mockup */
  accent: string;
}

const { playbooks, slug, accent } = Astro.props;
const lead = playbooks[0];
const many = playbooks.length > 1;

// Landing-page stills, captured from the built demos at 1440x900. Missing one
// is not a build error: the frame falls back to a labelled placeholder so a
// new playbook can go live before its screenshot is taken.
const shots = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/demos/screenshots/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);

const framed = await Promise.all(
  playbooks.map(async (playbook) => {
    const match = Object.entries(shots).find(
      ([path]) => path.replace(/\.[^.]+$/, '').endsWith(`/${playbook.slug}`)
    );
    const shot = match?.[1].default;
    return {
      playbook,
      image: shot
        ? await getImage({
            src: shot,
            widths: [640, 960, 1344, 1600],
            // The container caps at 1152 of content, and the still takes the
            // 60% column of it — so 672 CSS px, and no wider however big the
            // window gets.
            sizes:
              '(min-width: 1200px) 672px, (min-width: 900px) 58vw, calc(100vw - 3rem)',
            format: 'webp',
          })
        : null,
    };
  })
);
---

{lead && (
  <div class="embed-root" data-site-embed={slug} style={`--mk-accent:${accent}`}>
    {/* ── Package switcher, only once a vertical has more than one ──── */}
    {many && (
      <div class="mb-4 flex flex-wrap items-center gap-2" role="group" aria-label="Sample site">
        <span class="label-mono mr-1 shrink-0">package</span>
        {playbooks.map((playbook, i) => (
          <button
            type="button"
            data-pb={playbook.slug}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="pb-btn label-mono rounded-chip border border-grid/50 px-3 py-1.5 normal-case tracking-normal"
          >{playbook.name}</button>
        ))}
      </div>
    )}

    <div class="embed-body">
      <!-- ── Left, top: what this build is for ─────────────────────────── -->
      <div class="embed-copy">
        {playbooks.map((playbook, i) => (
          <p class="m-0 text-body text-film-dim" data-pb-premise={playbook.slug} hidden={i !== 0}>
            {playbook.demo.premise}
          </p>
        ))}
      </div>

      <!-- ── Right: the frame ──────────────────────────────────────────── -->
      <div class="embed-frame mockup-frame relative border border-grid/40">
        <!-- chrome -->
        <div class="flex items-center gap-3 bg-ink px-4 py-2.5">
          <span class="flex shrink-0 gap-1.5" aria-hidden="true">
            <i class="h-2.5 w-2.5 rounded-full bg-grid/60"></i>
            <i class="h-2.5 w-2.5 rounded-full bg-grid/60"></i>
            <i class="h-2.5 w-2.5 rounded-full bg-grid/60"></i>
          </span>
          {playbooks.map((playbook, i) => (
            <span
              class="label-mono truncate normal-case tracking-normal"
              data-pb-url={playbook.slug}
              hidden={i !== 0}
            >{playbook.demo.displayUrl}</span>
          ))}
          <span class="label-mono ml-auto hidden shrink-0 rounded-chip border border-grid/50 px-2 py-0.5 sm:block">
            sample site
          </span>
        </div>
        <hr class="rule-gold m-0" />

        <!-- the still -->
        {framed.map(({ playbook, image }, i) => (
          <div data-pb-shot={playbook.slug} hidden={i !== 0}>
            {image ? (
              <img
                src={image.src}
                srcset={image.srcSet.attribute}
                sizes={image.attributes.sizes}
                width={image.attributes.width}
                height={image.attributes.height}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                alt={`The ${playbook.demo.displayUrl} sample site, landing page`}
                class="embed-shot"
              />
            ) : (
              <div class="embed-shot-missing label-mono">
                screenshot pending — {playbook.demo.displayUrl}
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- ── Left, under the copy: the invitation ──────────────────────── -->
      <div class="embed-invite">
        {playbooks.map((playbook, i) => (
          <div data-pb-open={playbook.slug} hidden={i !== 0}>
            <a
              href={playbook.demoUrl}
              target="_blank"
              rel="noopener"
              data-track="demo_view"
              data-track-label={playbook.slug}
              class="embed-cta"
            >
              <span class="embed-cta__main">Open the live sample site</span>
              <span class="embed-cta__sub">
                {playbook.demo.displayUrl} — the real build, at the size a customer sees it
              </span>
              <span class="embed-cta__arrow" aria-hidden="true">→</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
)}

<script>
  // The package switcher swaps which playbook's screenshot, address bar,
  // premise and button are showing. That is the whole script now — the tabs
  // and the device toggle went with the iframe.
  document.querySelectorAll<HTMLElement>('[data-site-embed]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-pb]')];
    if (!buttons.length) return;

    const swap = (slug: string): void => {
      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.pb === slug));
      });
      (['data-pb-shot', 'data-pb-url', 'data-pb-premise', 'data-pb-open'] as const).forEach((attr) => {
        root.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((el) => {
          el.hidden = el.getAttribute(attr) !== slug;
        });
      });
    };

    root.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-pb]');
      if (button?.dataset.pb) swap(button.dataset.pb);
    });
  });
</script>

<style>
  .embed-root {
    --mk-accent: var(--color-gold);
  }

  /* ── Two columns from 900px: the copy and the way in on the left, the
     still on the right. Under that they stack in DOM order, which is also
     the reading order — what it is, what it looks like, how to open it.
     The areas are what let the button sit under the copy on wide screens
     without having to leave the markup in that order. */
  .embed-body {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 900px) {
    .embed-body {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      /* Copy and button both sit at the top, level with the frame. Centring
         the pair against the still's midline balances the block but opens a
         hole above the first line of copy, which reads as a mistake rather
         than as space. */
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'copy shot'
        'cta shot';
      align-items: start;
      column-gap: 2rem;
      row-gap: 1.25rem;
    }
    .embed-copy {
      grid-area: copy;
    }
    .embed-frame {
      grid-area: shot;
    }
    .embed-invite {
      grid-area: cta;
    }
  }

  /* The frame keeps the mockup's chrome; only what sits under it changed. */
  .mockup-frame {
    overflow: hidden;
    border-radius: 2px;
    background: var(--color-ink);
  }

  .embed-shot {
    display: block;
    width: 100%;
    height: auto;
    /* The still is a photograph of a document, so it gets a hairline rather
       than sitting flush against the chrome. */
    border-top: 1px solid color-mix(in srgb, var(--color-grid) 40%, transparent);
  }

  .embed-shot-missing {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 10;
    padding: 2rem;
    text-align: center;
    color: var(--color-film-dim);
    border-top: 1px dashed color-mix(in srgb, var(--color-grid) 60%, transparent);
  }

  /* ── The invitation ─────────────────────────────────────────────────
     Deliberately large. It is the only thing to do on this block now, and
     it replaces a row of small tab buttons that invited fiddling. */
  .embed-cta {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.35rem 1.5rem;
    width: 100%;
    padding: 1.35rem 1.6rem;
    border: 1px solid var(--color-gold);
    border-radius: 2px;
    background: color-mix(in srgb, var(--mk-accent) 7%, transparent);
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .embed-cta:hover,
  .embed-cta:focus-visible {
    border-color: var(--color-redline);
    background: color-mix(in srgb, var(--mk-accent) 12%, transparent);
  }
  .embed-cta__main {
    grid-column: 1;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.75rem);
    line-height: 1.15;
    color: var(--color-film);
  }
  .embed-cta__sub {
    grid-column: 1;
    font-size: var(--text-caption);
    color: var(--color-film-dim);
  }
  .embed-cta__arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    line-height: 1;
    color: var(--color-gold);
    transition: transform 0.2s ease;
  }
  .embed-cta:hover .embed-cta__arrow {
    transform: translateX(4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .embed-cta__arrow {
      transition: none;
    }
    .embed-cta:hover .embed-cta__arrow {
      transform: none;
    }
  }

  /* ── Package switcher ───────────────────────────────────────────── */
  .pb-btn {
    color: var(--color-film-dim);
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .pb-btn:hover {
    color: var(--color-film);
  }
  .pb-btn[aria-pressed='true'] {
    border-color: var(--mk-accent);
    color: var(--color-film);
  }
</style>
