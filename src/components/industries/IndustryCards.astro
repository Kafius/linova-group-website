---
// The playbooks as a card grid, three up: photograph, the vertical in its own
// accent, the pain line, and the trades it covers. Cards
// stretch to a common height per row, so a long headline never leaves its
// neighbours short.
import Covers from './Covers.astro';
import IndustryPhoto from './IndustryPhoto.astro';
import { type Industry } from '../../data/industries';
import { embeddableDemosFor } from '../../data/playbooks';

interface Props {
  items: Industry[];
}

// The cards used to carry a running index — 01/19, 02/19 — which meant this
// component had to be told how many cards the page had already printed and how
// long the whole roster was. With the numbering gone, so are `start` and
// `total`; the grid only needs the items it is drawing.
const { items } = Astro.props;
---

<ul class="industry-grid m-0 mx-auto grid max-w-[1200px] list-none gap-x-6 gap-y-8 px-6 p-0">
  {items.map((industry) => (
    <li class="flex">
      <a
        href={`/industries/${industry.slug}`}
        class="industry-card group flex w-full flex-col"
        style={`--vx: ${industry.accent}`}
        data-magnetic-row
      >
        <span class="block overflow-hidden" style="color: var(--vx)">
          <IndustryPhoto
            slug={industry.slug}
            name={industry.name}
            subject={industry.heroPhoto.subject}
            alt={industry.heroPhoto.alt}
            sizes="(min-width: 1024px) 370px, (min-width: 640px) 46vw, 90vw"
            widths={[400, 560, 740]}
            class="aspect-[3/2] w-full opacity-85 transition-opacity duration-300 group-hover:opacity-100"
          />
        </span>

        <span class="flex flex-1 flex-col p-5">
          {/* Only a caveat or a credential earns a line here. A vertical with
              a paying client says so; one with neither client nor sample site
              is marked concept so the spec work is never mistaken for a job.
              A vertical whose sample site is built says nothing — that is the
              expected state, and labelling it was noise. */}
          {/* The row is always present, even when it holds nothing. Only some
              cards carry a badge, and letting it collapse dropped the heading
              of every unbadged card ~20px above its neighbours in the row. */}
          <span class="card-badge flex items-baseline justify-end">
            {industry.status === 'live' && industry.proof ? (
              <span class="label-mono normal-case tracking-normal">proof: {industry.proof.client}</span>
            ) : embeddableDemosFor(industry.slug).length === 0 ? (
              <span class="label-mono rounded-chip border border-grid/50 px-2 py-0.5">concept</span>
            ) : null}
          </span>

          <span
            class="mt-3 block font-display text-heading font-semibold leading-tight"
            style="color: var(--vx)"
          >
            {industry.name}
          </span>
          <span class="mt-2 block text-caption text-film-dim">{industry.headline}</span>

          <Covers items={industry.covers} class="mt-4" />

          <span class="label-mono mt-auto block pt-5 text-gold" aria-hidden="true">
            open the playbook →
          </span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .industry-grid {
    /* minmax(0, 1fr), not 1fr. A bare fr track takes its minimum from the
       content, so one long cover string — "private event catering truck" —
       widens the column past the viewport at 320px and the whole page scrolls
       sideways. The two wider breakpoints already guard against this. */
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 640px) {
    .industry-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .industry-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Matches the chip's own height — label line-height plus its vertical
     padding — so a badged and an unbadged card start their heading on the
     same line. */
  .card-badge {
    min-height: 1.5rem;
  }

  .industry-card {
    border: 1px solid rgba(77, 77, 143, 0.4);
    text-decoration: none;
    transition:
      border-color 0.3s var(--ease-plot),
      background-color 0.3s var(--ease-plot);
  }
  .industry-card:hover {
    border-color: color-mix(in srgb, var(--vx) 55%, transparent);
    background: color-mix(in srgb, var(--vx) 6%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .industry-card {
      transition: none;
    }
  }
</style>
