---
// One hero photograph per vertical, with a working placeholder until the
// real picture exists. Drop a file at src/assets/industries/<slug>.jpg
// (or .png/.webp/.avif) and this swaps from the placeholder frame to the
// Astro-optimized image on the next build — no code change needed.
//
// The placeholder prints the art direction from industries.ts, so the page
// itself tells you which picture is missing and what it should be.
//
// `defer` exists because the hero stacks every vertical's slide in the
// viewport at once. Browsers ignore opacity when deciding what to lazy-load,
// so without this every industry's photo downloads on first paint — at 14
// verticals that is most of a megabyte for a decoration behind the headline.
// Deferred slides ship their URLs in data-attributes and the cycle script
// promotes them just before a slide is shown.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  /** vertical name — printed on the placeholder */
  name: string;
  /** art direction, from industry.heroPhoto.subject */
  subject: string;
  alt: string;
  /** LCP candidate? Only the first slide should be eager. */
  eager?: boolean;
  /** hold the image back until the cycle asks for it (every slide but the first) */
  defer?: boolean;
  /** override for callers that aren't the full-bleed hero — a directory
   *  thumbnail asking for a 42vw image downloads three times what it shows. */
  sizes?: string;
  widths?: number[];
  class?: string;
}

const {
  slug,
  name,
  subject,
  alt,
  eager = false,
  defer = false,
  sizes = '(min-width: 1024px) 42vw, 88vw',
  widths = [420, 640, 900],
  class: className,
} = Astro.props;

// Eager glob = resolved at build time, so `found` is known while rendering.
const photos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/industries/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const match = Object.entries(photos).find(
  ([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === slug
);
const photo = match?.[1].default;

const rendered = photo
  ? await getImage({ src: photo, widths, sizes, format: 'webp' })
  : null;
---

<figure class:list={['industry-photo relative m-0 overflow-hidden rounded-[3px]', className]}>
  {rendered ? (
    <img
      src={defer ? undefined : rendered.src}
      srcset={defer ? undefined : rendered.srcSet.attribute}
      data-src={defer ? rendered.src : undefined}
      data-srcset={defer ? rendered.srcSet.attribute : undefined}
      sizes={sizes}
      width={rendered.attributes.width}
      height={rendered.attributes.height}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'low'}
      decoding={eager ? 'auto' : 'async'}
      class="h-full w-full object-cover"
    />
  ) : (
    <div class="photo-slot flex h-full w-full flex-col justify-between p-5" data-photo-slot={slug}>
      <div class="flex items-start justify-between gap-3">
        <span class="label-caps">{name}</span>
        <span class="label-caps opacity-70">photo</span>
      </div>

      <p class="m-0 max-w-[34ch] text-caption normal-case leading-relaxed text-film-dim">
        {subject}
      </p>

      <span class="label-caps opacity-70">src/assets/industries/{slug}.jpg</span>

      <!-- plotter crosshair: marks the frame without pretending to be art -->
      <svg class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true" preserveAspectRatio="none">
        <line x1="0" y1="0" x2="100%" y2="100%" stroke="currentColor" stroke-width="1" opacity="0.18" />
        <line x1="100%" y1="0" x2="0" y2="100%" stroke="currentColor" stroke-width="1" opacity="0.18" />
      </svg>
    </div>
  )}
</figure>

<style>
  .photo-slot {
    /* accent comes from the parent's `color`, same contract the motifs used */
    border: 1px dashed color-mix(in srgb, currentColor 55%, transparent);
    background: color-mix(in srgb, currentColor 7%, transparent);
  }
</style>
