---
// The package playbooks attached to one vertical: what is in the box, what is
// deliberately not, how it fits Clover, and the way into the sample site.
//
// Every line renders from src/data/playbooks.ts. The "left out" copy is
// generated from the same feature flags as the "included" copy, so a playbook
// that turns booking on stops arguing against booking automatically — nobody
// has to remember to edit the prose in two places.
import { playbooksForIndustry, type LivePlaybook, type PackagePlaybook } from '../../data/playbooks';

interface Props {
  industrySlug: string;
  /** the vertical's accent, for the section's own colour */
  accent: string;
}

const { industrySlug, accent } = Astro.props;

// ── Pricing switch ───────────────────────────────────────────────────────
// Flip to true to show real numbers on every playbook. False renders the
// quote CTA in the same slot; nothing else needs to change.
const SHOW_PRICING = false;
const CALENDLY = 'https://calendly.com/ddeleon-thelinovagroup';

const playbooks = playbooksForIndustry(industrySlug);
const live = playbooks.filter((p): p is LivePlaybook => p.status === 'live');
const upcoming = playbooks.filter((p) => p.status === 'coming-soon');

type FeatureKey = keyof LivePlaybook['features'];

const FEATURES: { key: FeatureKey; label: string; included: string; excluded: string }[] = [
  {
    key: 'seoSetup',
    label: 'SEO setup',
    included: 'Title, description, schema and canonical set per page, with a sitemap and clean URLs from day one.',
    excluded: 'No SEO setup. The site is built to be found by the people already searching your name, and nothing more is promised.',
  },
  {
    key: 'ecommerce',
    label: 'E-commerce',
    included: 'Clover Online Ordering embedded into the site, running on the merchant account you already signed.',
    excluded: 'No online store. Nothing here takes money, which means no gateway to configure and no cart to maintain.',
  },
  {
    key: 'analytics',
    label: 'Analytics',
    included: 'GA4 wired up, with a conversion event on every order button, phone tap and form on the site.',
    excluded: 'No analytics build. The site ships without tracking rather than with a dashboard nobody opens.',
  },
  {
    key: 'domainHosting',
    label: 'Domain & hosting',
    included: 'Domain registered or transferred, DNS configured, hosting and SSL included and monitored.',
    excluded: 'No domain or hosting. You keep your own, and we deploy into it.',
  },
  {
    key: 'cms',
    label: 'CMS',
    included: 'A content editor for the pages that actually change, so you are not waiting on us for a price.',
    excluded: 'No CMS. A menu changes a few times a year, not a few times a week, and a system you would log into twice is a subscription rather than a feature. Edits come through us.',
  },
  {
    key: 'crm',
    label: 'CRM',
    included: 'Enquiries land in a CRM with the source attached, so you can see which channel is actually paying.',
    excluded: 'No CRM. There is no pipeline to manage when the customer decides in ninety seconds and either orders or does not.',
  },
  {
    key: 'booking',
    label: 'Booking',
    included: 'A booking flow wired into the calendar that already holds your schedule.',
    excluded: 'No booking engine. Tables come by phone and by the door, and a reservation system nobody staffs is worse than a number that gets answered.',
  },
];

const included = (playbook: LivePlaybook) =>
  FEATURES.filter((feature) => playbook.features[feature.key]);
const excluded = (playbook: LivePlaybook) =>
  FEATURES.filter((feature) => !playbook.features[feature.key]);

const money = (value: number) => `$${value.toLocaleString('en-CA')}`;
---

{playbooks.length > 0 && (
  <section
    id="packages"
    class="border-t border-grid/30"
    style={`--vx: ${accent}`}
    aria-labelledby="packages-h"
  >
    <div class="mx-auto max-w-[1200px] px-6 py-20">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="packages-h" class="font-display text-title text-film">The package</h2>
        <span class="label-mono hidden shrink-0 sm:block" style="color: var(--vx)">
          {playbooks.length} {playbooks.length === 1 ? 'playbook' : 'playbooks'}
        </span>
      </div>
      <hr class="rule-gold mt-3" />

      {live.map((playbook) => (
        <article class="mt-12">
          {/* ── Header ─────────────────────────────────────────────── */}
          <header>
            <p class="label-mono" style="color: var(--vx)">{playbook.packageTier}</p>
            <h3 class="mt-3 font-display text-heading text-film">{playbook.name}</h3>
            <ul class="m-0 mt-4 flex list-none flex-wrap gap-2 p-0">
              {playbook.businessTypes.map((type) => (
                <li class="rounded-chip border border-grid/50 px-2.5 py-1 text-caption text-film-dim">
                  {type}
                </li>
              ))}
            </ul>
          </header>

          <div class="mt-10 grid gap-10 md:grid-cols-2 md:gap-12">
            {/* ── What's included ─────────────────────────────────── */}
            <div>
              <h4 class="label-mono">what's included</h4>
              <p class="mt-3 text-caption text-film-dim">
                {playbook.pageCount} pages, on the {playbook.pricing.maintenancePlan} plan.
              </p>
              <ul class="m-0 mt-5 grid list-none gap-4 p-0">
                {included(playbook).map((feature) => (
                  <li class="grid grid-cols-[1.25rem_1fr] gap-x-3">
                    <span class="text-body leading-tight" style="color: var(--vx)" aria-hidden="true">+</span>
                    <div>
                      <p class="m-0 text-body font-medium text-film">{feature.label}</p>
                      <p class="m-0 mt-1 max-w-[46ch] text-caption text-film-dim">{feature.included}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>

            {/* ── What's deliberately left out ────────────────────── */}
            <div>
              <h4 class="label-mono">what's deliberately left out</h4>
              <p class="mt-3 max-w-[46ch] text-caption text-film-dim">
                Each of these was priced and left out on purpose. The money saved
                goes into the photography and the copy, which is what actually
                moves covers.
              </p>
              <ul class="m-0 mt-5 grid list-none gap-4 p-0">
                {excluded(playbook).map((feature) => (
                  <li class="border-l border-grid/50 pl-4">
                    <p class="m-0 max-w-[46ch] text-caption text-film-dim">{feature.excluded}</p>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          {/* ── Clover fit — verbatim from the spreadsheet ─────────── */}
          <figure class="mt-12 border-y border-gold/40 py-8">
            <p class="label-mono">clover fit</p>
            <blockquote class="m-0 mt-4">
              <p class="m-0 max-w-[58ch] font-display text-heading leading-snug text-film">
                {playbook.cloverFit}
              </p>
            </blockquote>
          </figure>

          {/* ── Pricing, behind the flag ───────────────────────────── */}
          <div class="mt-12">
            <h4 class="label-mono">pricing</h4>
            {SHOW_PRICING ? (
              <div class="mt-5">
                <dl class="m-0 grid gap-px border border-grid/40 bg-grid/40 sm:grid-cols-2 lg:grid-cols-4">
                  <div class="bg-navy p-5">
                    <dt class="m-0 text-caption text-film-dim">Build</dt>
                    <dd class="m-0 mt-1 font-display text-heading text-film">{money(playbook.pricing.build)}</dd>
                  </div>
                  <div class="bg-navy p-5">
                    <dt class="m-0 text-caption text-film-dim">{playbook.pricing.maintenancePlan}</dt>
                    <dd class="m-0 mt-1 font-display text-heading text-film">{money(playbook.pricing.maintenanceMonthly)}<span class="text-caption text-film-dim">/mo</span></dd>
                  </div>
                  <div class="bg-navy p-5">
                    <dt class="m-0 text-caption text-film-dim">Social</dt>
                    <dd class="m-0 mt-1 font-display text-heading text-film">{money(playbook.pricing.socialMonthly)}<span class="text-caption text-film-dim">/mo</span></dd>
                  </div>
                  <div class="bg-navy p-5">
                    <dt class="m-0 text-caption text-film-dim">SEO</dt>
                    <dd class="m-0 mt-1 font-display text-heading text-film">{money(playbook.pricing.seoMonthly)}<span class="text-caption text-film-dim">/mo</span></dd>
                  </div>
                </dl>
                <p class="mt-5 text-body text-film-dim">
                  <span class="text-film">{money(playbook.pricing.totalMonthly)}/month</span> all in, and
                  <span class="text-film"> {money(playbook.pricing.yearOneValue)}</span> across the first year.
                </p>
              </div>
            ) : (
              <div class="mt-5">
                <p class="max-w-[52ch] text-body text-film-dim">
                  Priced per build, because the page count moves with the menu.
                  Twenty minutes on a call and you get the number.
                </p>
                <a
                  href={CALENDLY}
                  target="_blank"
                  rel="noopener"
                  data-track="quote_request"
                  data-track-label={playbook.slug}
                  class="mt-6 inline-block rounded-chip border border-gold px-6 py-3 text-body text-film transition-colors hover:border-redline"
                >
                  Request a quote
                </a>
              </div>
            )}
          </div>

          {/* ── Into the sample site ───────────────────────────────── */}
          <div class="mt-12 border-t border-grid/30 pt-10">
            <p class="label-mono">sample site</p>
            <a
              href={playbook.demoUrl}
              data-track="demo_view"
              data-track-label={playbook.slug}
              class="mt-4 inline-block font-display text-display text-film no-underline transition-colors hover:text-gold"
            >
              View sample site<span class="text-redline">.</span>
            </a>
            <p class="mt-4 max-w-[52ch] text-body text-film-dim">
              A complete site built to exactly this spec — every page, the real
              menu, the ordering slot. Open it on your phone and hold it against
              what you have now.
            </p>
          </div>
        </article>
      ))}

      {/* ── Playbooks whose sample site is not built yet ───────────── */}
      {upcoming.length > 0 && (
        <div class="mt-16 border-t border-grid/30 pt-10">
          <p class="label-mono">also written for this trade</p>
          {/* Bordered per item rather than a gap-filled grid: an odd count
              would otherwise leave a filled phantom cell in the last row. */}
          <ul class="m-0 mt-6 grid list-none gap-4 p-0 sm:grid-cols-2">
            {upcoming.map((playbook: PackagePlaybook) => (
              <li class="border border-grid/40 p-6">
                <p class="label-mono opacity-70">{playbook.packageTier}</p>
                <p class="m-0 mt-2 text-heading text-film-dim">{playbook.name}</p>
                <p class="m-0 mt-2 max-w-[40ch] text-caption text-film-dim opacity-80">
                  {playbook.businessTypes.join(', ')}
                </p>
                <p class="m-0 mt-3 text-caption opacity-60">Sample site in progress</p>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
)}
