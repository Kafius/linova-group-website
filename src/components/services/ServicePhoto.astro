---
// One photograph in a service group's mosaic, with a working placeholder
// until the real picture exists. Drop a file at src/assets/services/<id>.jpg
// (or .png/.webp/.avif) and this swaps from the placeholder frame to the
// Astro-optimized image on the next build — no code change needed.
//
// Same contract as FeaturePhoto and IndustryPhoto, with one difference: the
// ratio is a prop rather than a fixed rule. The mosaic runs a wide lead over
// a pair of squarer frames, so the aspect cannot live in this component's own
// stylesheet the way it does for a uniform card grid.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  /** art direction, from the service's photos[] — printed on the placeholder */
  subject: string;
  alt: string;
  /** CSS aspect-ratio for the frame, e.g. '16 / 9' */
  ratio: string;
  /** the `sizes` attribute — the lead is twice the width of the pair */
  sizes: string;
  class?: string;
}

const { id, subject, alt, ratio, sizes, class: className } = Astro.props;

// Eager glob = resolved at build time, so `photo` is known while rendering.
const photos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/services/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const match = Object.entries(photos).find(
  ([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === id
);
const photo = match?.[1].default;

const rendered = photo
  ? await getImage({ src: photo, widths: [320, 480, 700, 940], sizes, format: 'webp' })
  : null;
---

<figure
  class:list={['service-photo relative m-0 overflow-hidden', className]}
  style={`aspect-ratio: ${ratio}`}
>
  {rendered ? (
    <img
      src={rendered.src}
      srcset={rendered.srcSet.attribute}
      sizes={sizes}
      width={rendered.attributes.width}
      height={rendered.attributes.height}
      alt={alt}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover"
    />
  ) : (
    <div class="photo-slot absolute inset-0 flex flex-col justify-between gap-2 overflow-hidden p-3">
      <span class="label-caps opacity-70">photo</span>
      <p class="photo-slot__subject m-0 text-caption normal-case leading-snug">{subject}</p>
      <span class="label-caps opacity-70">{id}.jpg</span>

      <!-- plotter crosshair: marks the frame without pretending to be art -->
      <svg
        class="pointer-events-none absolute inset-0 h-full w-full"
        aria-hidden="true"
        preserveAspectRatio="none"
      >
        <line x1="0" y1="0" x2="100%" y2="100%" stroke="currentColor" stroke-width="1" opacity="0.16" />
        <line x1="100%" y1="0" x2="0" y2="100%" stroke="currentColor" stroke-width="1" opacity="0.16" />
      </svg>
    </div>
  )}
</figure>

<style>
  /* The frame reserves its space before the image decodes, so the mosaic does
     not reflow as photos load (CLS). `aspect-ratio` itself is set inline —
     a scoped rule here could not be overridden by the parent, since Astro
     scopes styles per component and the parent's selector never matches. */
  .service-photo {
    width: 100%;
    background: color-mix(in srgb, var(--color-grid) 18%, transparent);
  }

  .photo-slot {
    border: 1px dashed color-mix(in srgb, var(--color-gold) 45%, transparent);
    background: color-mix(in srgb, var(--color-gold) 5%, transparent);
    color: var(--color-gold);
  }
  /* Three lines on the lead, two on the smaller pair — clamping to a fixed
     count would overflow the shorter frames. */
  .photo-slot__subject {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
</style>
