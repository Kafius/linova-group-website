---
// Act 5 — selected work at magazine scale: oversized alternating spreads that
// park (CSS sticky) as the next slides over. Not a card grid. Reads the same
// case-study source as /work (Sanity once provisioned, seeds until then).
import { Image } from 'astro:assets';
import { fetchCaseStudies } from '../../lib/caseStudies';
import { getIndustry } from '../../data/industries';

const studies = (await fetchCaseStudies()).filter((s) => s.featured).slice(0, 3);
---

<section id="act-work" class="work-section" aria-label="Selected work">
  <div class="mx-auto max-w-[1240px] px-6 pt-28 lg:pt-36">
    <p class="label-mono">selected work</p>
    <h2 class="mt-4 font-display text-title text-film">Live sites, not mockups.</h2>
  </div>

  <div class="mt-14 flex flex-col gap-14 pb-24 lg:gap-[16vh]">
    {studies.map((study, i) => {
      const industry = study.industrySlug ? getIndustry(study.industrySlug) : undefined;
      return (
        <article
          class="work-spread lg:sticky lg:border-t lg:border-gold/40 lg:pt-5"
          style={`top: calc(8vh + ${i * 22}px); --vx: ${industry?.accent ?? 'var(--color-gold)'}`}
        >
          <div class="mx-auto max-w-[1240px] px-6">
            <div class="grid items-end gap-6 lg:grid-cols-12">
              <a
                href={`/work/${study.slug}`}
                class:list={[
                  'group block overflow-hidden border border-grid/40 lg:col-span-9',
                  i % 2 === 1 ? 'lg:order-2 lg:col-start-4' : '',
                ]}
              >
                {study.image ? (
                  <Image
                    src={study.image}
                    alt={`${study.client} — homepage`}
                    widths={[640, 1024, 1440]}
                    sizes="(min-width: 1024px) 75vw, 100vw"
                    class="block h-auto w-full transition-transform duration-500 group-hover:scale-[1.015]"
                    loading="lazy"
                  />
                ) : study.imageUrl ? (
                  <img
                    src={study.imageUrl}
                    alt={`${study.client} — homepage`}
                    class="block h-auto w-full transition-transform duration-500 group-hover:scale-[1.015]"
                    loading="lazy"
                    width="1440"
                    height="900"
                  />
                ) : null}
              </a>
              <div class:list={['lg:col-span-3 lg:pb-6', i % 2 === 1 ? 'lg:order-1 lg:col-start-1' : '']}>
                <p class="label-mono" style="color: var(--vx)">{industry?.name ?? 'case study'}</p>
                <h3 class="mt-2 font-display text-heading text-film">
                  <a href={`/work/${study.slug}`} class="no-underline hover:text-gold">{study.client}</a>
                </h3>
                <p class="mt-3 text-caption text-film-dim">{study.summary}</p>
                <a href={`/work/${study.slug}`} class="label-mono mt-3 inline-block py-1.5 normal-case tracking-normal underline decoration-1 underline-offset-4 hover:text-film">
                  read the case study →
                </a>
              </div>
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <p class="mx-auto max-w-[1240px] px-6 pb-24 text-caption text-film-dim">
    All of it, with the build stories:{' '}
    <a href="/work" class="text-gold underline decoration-1 underline-offset-4">see the work</a>.
  </p>
</section>

<style>
  .work-section {
    background: linear-gradient(to bottom, var(--color-film) 0, var(--color-navy) 220px);
  }

  /* Each spread is a sheet on a stack. It MUST be opaque: the spreads are
     sticky, so an incoming one slides over the parked one below it, and a
     transparent box drops its text column straight onto the previous
     screenshot. Navy is safe here — the first spread starts ~770px in, well
     past the 220px film→navy gradient above. */
  .work-spread {
    background: var(--color-navy);
  }
  @media (prefers-reduced-motion: reduce) {
    .work-spread {
      position: static !important;
    }
  }
</style>
