---
// Act 3 — the AI-implemented pipeline, shown not told. A sticky stage rail
// on the left; artifact cards stacking on the right (CSS sticky — the §5 pin
// budget is spent on the industries rail). Ground deepens navy → ink.
// Artifacts are real: the actual data module, the actual build output.
import { processStages } from '../../data/process';
---

<section id="act-system" class="system-section relative" aria-label="How the system works">
  <div class="mx-auto max-w-[1200px] px-6 py-28 lg:py-36">
    <div class="max-w-[720px]">
      <p class="label-mono">the build system</p>
      <h2 class="mt-4 font-display text-title text-film">
        Not vibe coding. A pipeline with a paper trail.
      </h2>
      <p class="register-cold mt-5 max-w-[60ch] text-body text-film-dim">
        Every site runs the same four stages. AI accelerates the work inside an
        engineering discipline — typed data, fixed component patterns,
        deterministic builds — which is why the output holds up in production.
      </p>
    </div>

    <div class="mt-16 grid gap-10 lg:grid-cols-[240px_1fr] lg:gap-16">
      <!-- Stage rail -->
      <ol class="stage-rail hidden list-none flex-col gap-6 self-start p-0 lg:sticky lg:top-[16vh] lg:flex">
        {processStages.map((stage, i) => (
          <li>
            <a href={`#stage-${stage.stage}`} class="stage-link group flex items-baseline gap-3 no-underline" data-stage-link={stage.stage}>
              <span class="label-mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-caption text-film-dim transition-colors group-hover:text-film">{stage.name}</span>
            </a>
          </li>
        ))}
      </ol>

      <!-- Artifact cards — min-w-0 stops the <pre>'s intrinsic width from
           blowing out the grid on narrow viewports -->
      <div class="flex min-w-0 flex-col gap-10 lg:gap-[18vh]">
        {processStages.map((stage, i) => (
          <article
            id={`stage-${stage.stage}`}
            class="artifact-card min-w-0 border border-grid/40 p-6 sm:p-8 lg:sticky"
            style={`top: calc(10vh + ${i * 28}px)`}
            data-stage-card={stage.stage}
          >
            <p class="label-mono">
              {String(i + 1).padStart(2, '0')} / {stage.name}
            </p>
            <p class="mt-3 max-w-[58ch] text-body text-film-dim">{stage.description}</p>

            <div class="artifact mt-6 overflow-x-auto border border-grid/40 bg-ink p-5">
              {stage.stage === 'intake' && (
                <div class="register-cold font-mono text-[0.8125rem] leading-relaxed">
                  <p class="m-0 text-gold">content map · restaurant intake</p>
                  <p class="m-0 mt-2 text-film-dim">pages: <span class="text-film">home · menu · hours + location · order · contact</span></p>
                  <p class="m-0 text-film-dim">fields: <span class="text-film">dishes[] · prices · rush hours · covers · delivery links</span></p>
                  <p class="m-0 text-film-dim">integrations: <span class="text-film">reservations · maps profile · direct order</span></p>
                  <p class="m-0 mt-2 text-film-dim/70">captured in one structured call — no loose notes</p>
                </div>
              )}

              {stage.stage === 'data' && (
                <pre class="m-0 bg-transparent font-mono text-[0.8125rem] leading-relaxed"><code><span class="text-film-dim">// src/data/industries.ts — live on this site</span>
<span class="text-redline">export interface</span> <span class="text-film">Industry</span> <span class="text-film-dim">&#123;</span>
  <span class="text-film">slug</span><span class="text-film-dim">:</span> <span class="text-film">string</span><span class="text-film-dim">;</span>
  <span class="text-film">headline</span><span class="text-film-dim">:</span> <span class="text-film">string</span><span class="text-film-dim">;</span>  <span class="text-film-dim">// the pain, in their language</span>
  <span class="text-film">accent</span><span class="text-film-dim">:</span> <span class="text-film">string</span><span class="text-film-dim">;</span>    <span class="text-film-dim">// verified ≥4.5:1 on navy</span>
<span class="text-film-dim">&#125;</span>

<span class="text-film-dim">&#123;</span> <span class="text-film">slug</span><span class="text-film-dim">:</span> <span class="text-gold">'restaurants'</span><span class="text-film-dim">,</span>
  <span class="text-film">headline</span><span class="text-film-dim">:</span> <span class="text-gold">'Your menu is a PDF and Google is your homepage'</span><span class="text-film-dim">,</span>
  <span class="text-film">accent</span><span class="text-film-dim">:</span> <span class="text-gold">'#FF5A4E'</span> <span class="text-film-dim">&#125;</span></code></pre>
              )}

              {stage.stage === 'build' && (
                <div class="register-cold font-mono text-[0.8125rem] leading-relaxed">
                  <p class="m-0 text-film-dim">$ astro build</p>
                  <p class="m-0 mt-2 text-film">42 page(s) built in <span class="text-gold">10.30s</span></p>
                  <p class="m-0 text-film">homepage JS <span class="text-gold">&lt; 150KB</span> gzipped, GSAP included</p>
                  <p class="m-0 text-film-dim">images → avif/webp · fonts subset + preloaded</p>
                  <p class="m-0 mt-2 text-film-dim/70" data-lighthouse-slot>lighthouse scores land here at the audit — measured, not promised</p>
                </div>
              )}

              {stage.stage === 'deploy' && (
                <div class="register-cold font-mono text-[0.8125rem] leading-relaxed">
                  <p class="m-0 text-film-dim">vercel · production</p>
                  <p class="m-0 mt-2 text-film">▲ build completed · static output</p>
                  <p class="m-0 text-film">● ready — served from the edge, no servers to babysit</p>
                  <p class="m-0 mt-2 text-film-dim">cms publish → webhook → rebuild · content edits redeploy the site</p>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .system-section {
    background: linear-gradient(to bottom, var(--color-navy), var(--color-ink) 26%);
  }
  .artifact-card {
    /* opaque: stacked cards must fully cover the one parked beneath */
    background: color-mix(in srgb, var(--color-ink) 82%, var(--color-navy));
  }
  .stage-link.is-active span:last-child {
    color: var(--color-film);
  }
  .stage-link.is-active span:first-child {
    color: var(--color-redline);
  }
  @media (prefers-reduced-motion: reduce) {
    .artifact-card {
      position: static !important;
    }
  }
</style>

<script>
  // Highlight the active stage in the rail as cards stack past.
  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-stage-link]').forEach((link) => {
    links.set(link.dataset.stageLink ?? '', link);
  });
  const cards = document.querySelectorAll<HTMLElement>('[data-stage-card]');
  if (cards.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            links.forEach((link) => link.classList.remove('is-active'));
            links.get((entry.target as HTMLElement).dataset.stageCard ?? '')?.classList.add('is-active');
          }
        }
      },
      { rootMargin: '-30% 0px -50% 0px' }
    );
    cards.forEach((card) => observer.observe(card));
  }
</script>
