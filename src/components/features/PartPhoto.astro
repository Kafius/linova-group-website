---
// One photograph per parts-list group, as a banner strip above the rows.
//
// Same photo-or-placeholder contract as FeaturePhoto, and it reads the same
// directory — the parts-list groups and the homepage systems are two cuts of
// the same categories, and four of them point at the same file. What differs
// is the crop: this sits at the head of a column in a two-up bill of
// materials, so it is a wide strip rather than FeaturePhoto's 16/10 card.
// A ratio prop on FeaturePhoto would have done the same job, but that
// component is shared with the homepage, so this stays separate.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** file base name under src/assets/features/ — the group's photoFile */
  file: string;
  /** group name — printed on the placeholder */
  name: string;
  /** art direction, from group.photo.subject */
  subject: string;
  alt: string;
}

const { file, name, subject, alt } = Astro.props;

// Eager glob = resolved at build time, so `photo` is known while rendering.
const photos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/features/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const match = Object.entries(photos).find(
  ([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === file
);
const photo = match?.[1].default;

// Two columns inside the 1152px measure, less the 3.5rem gutter.
const sizes = '(min-width: 640px) 548px, 92vw';
const rendered = photo
  ? await getImage({ src: photo, widths: [400, 560, 760, 1100], sizes, format: 'webp' })
  : null;
---

<figure class="part-photo relative m-0 overflow-hidden">
  {rendered ? (
    <img
      src={rendered.src}
      srcset={rendered.srcSet.attribute}
      sizes={sizes}
      width={rendered.attributes.width}
      height={rendered.attributes.height}
      alt={alt}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover"
    />
  ) : (
    <div class="photo-slot absolute inset-0 flex flex-col justify-between gap-1 overflow-hidden p-3">
      <span class="label-caps">{name}</span>
      <p class="photo-slot__subject m-0 text-caption normal-case leading-snug">{subject}</p>
      <span class="label-caps opacity-70">{file}.jpg</span>
    </div>
  )}
</figure>

<style>
  /* A strip, not a card. The parts list is a bill of materials two columns
     wide; a 16/10 frame on each of seven groups would turn it into a photo
     gallery with captions. The ratio also reserves the space before the image
     decodes, so the columns do not re-balance as photos load. */
  .part-photo {
    aspect-ratio: 16 / 6;
    width: 100%;
    background: color-mix(in srgb, var(--color-grid) 18%, transparent);
  }

  /* Held back a little so the rows stay the loudest thing in the column —
     the list is the content, the photo is the label. */
  .part-photo img {
    opacity: 0.9;
  }

  .photo-slot {
    border: 1px dashed color-mix(in srgb, var(--color-gold) 45%, transparent);
    background: color-mix(in srgb, var(--color-gold) 5%, transparent);
    color: var(--color-gold);
  }
  .photo-slot__subject {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
</style>
