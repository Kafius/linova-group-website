---
// One photograph per feature category, with a working placeholder until the
// real picture exists. Drop a file at src/assets/features/<id>.jpg (or
// .png/.webp/.avif) and this swaps from the placeholder frame to the
// Astro-optimized image on the next build — no code change needed.
//
// Same contract as IndustryPhoto: the placeholder prints the art direction
// from siteFeatures.ts, so the page itself says which picture is missing and
// what it should be. No `defer` here — these sit well below the fold and
// native lazy loading is enough.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  /** category name — printed on the placeholder */
  name: string;
  /** art direction, from group.photo.subject */
  subject: string;
  alt: string;
  class?: string;
}

const { id, name, subject, alt, class: className } = Astro.props;

// Eager glob = resolved at build time, so `photo` is known while rendering.
const photos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/features/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const match = Object.entries(photos).find(
  ([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === id
);
const photo = match?.[1].default;

const sizes = '(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw';
const rendered = photo
  ? await getImage({ src: photo, widths: [400, 560, 720, 900], sizes, format: 'webp' })
  : null;
---

<figure class:list={['feature-photo relative m-0 overflow-hidden', className]}>
  {rendered ? (
    <img
      src={rendered.src}
      srcset={rendered.srcSet.attribute}
      sizes={sizes}
      width={rendered.attributes.width}
      height={rendered.attributes.height}
      alt={alt}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover"
    />
  ) : (
    <div class="photo-slot absolute inset-0 flex flex-col justify-between gap-2 overflow-hidden p-4">
      <div class="flex items-start justify-between gap-3">
        <span class="label-mono">{name}</span>
        <span class="label-mono opacity-70">photo</span>
      </div>
      <p class="photo-slot__subject m-0 text-caption normal-case leading-snug text-film-dim">{subject}</p>
      <span class="label-mono opacity-70">src/assets/features/{id}.jpg</span>

      <!-- plotter crosshair: marks the frame without pretending to be art -->
      <svg class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true" preserveAspectRatio="none">
        <line x1="0" y1="0" x2="100%" y2="100%" stroke="currentColor" stroke-width="1" opacity="0.16" />
        <line x1="100%" y1="0" x2="0" y2="100%" stroke="currentColor" stroke-width="1" opacity="0.16" />
      </svg>
    </div>
  )}
</figure>

<style>
  /* The frame owns its own ratio. A parent's scoped rule cannot size this
     element — Astro scopes styles per component, so `class="..."` passed in
     from FeaturesSection lands on the figure but the parent's selector never
     matches it. Sizing here also reserves the space before the image decodes,
     so the grid does not shift as photos load (CLS). */
  .feature-photo {
    aspect-ratio: 16 / 10;
    width: 100%;
    flex: none;
  }

  /* Absolutely positioned so the frame's aspect-ratio governs its size —
     as a flow child, long art-direction text stretched the box and broke
     the row's card heights. */
  .photo-slot {
    border: 1px dashed color-mix(in srgb, var(--color-gold) 45%, transparent);
    background: color-mix(in srgb, var(--color-gold) 5%, transparent);
    color: var(--color-gold);
  }
  .photo-slot__subject {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
</style>
