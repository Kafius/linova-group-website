---
// Act 3 — features. Title, then eight systems in two rows of four; each card
// is a picture, a subtitle, and one short line about it. Nothing else.
//
// These eight came out of the build act's "systems" panel when that act was
// removed — they were being rendered twice on one page. The 42-part
// catalogue they summarise still lives on /services (PartsList.astro), which
// is what the one CTA at the foot points to.
import { siteSystems } from '../../data/siteFeatures';
import FeaturePhoto from './FeaturePhoto.astro';
---

<section id="act-features" class="features-section" aria-labelledby="features-heading">
  <div class="mx-auto max-w-[1200px] px-6 py-24 lg:py-32">
    <div class="max-w-[640px]">
      <h2 id="features-heading" class="m-0 font-display text-title text-film">
        Everything that can go in it.
      </h2>
      <p class="mt-4 max-w-[52ch] text-body text-film-dim">
        Your playbook decides which parts earn their place.
      </p>
    </div>

    <ul class="feature-grid m-0 mt-14 list-none p-0">
      {siteSystems.map((system) => (
        <li class="feature-card" data-feature-card>
          <FeaturePhoto
            id={system.id}
            name={system.name}
            subject={system.photo.subject}
            alt={system.photo.alt}
            class="feature-card__media"
          />
          <div class="feature-card__body">
            <h3 class="feature-card__title m-0">{system.name}</h3>
            <p class="feature-card__text m-0">{system.detail}</p>
          </div>
        </li>
      ))}
    </ul>

    <a href="/services#parts-list" class="feature-cta mt-12">See the full parts list</a>
  </div>
</section>

<style>
  .features-section {
    background: var(--color-navy);
  }

  /* Eight cards, two rows of four on desktop. Steps 1 → 2 → 4 so every
     breakpoint divides evenly and no row is ever left part-full. */
  .feature-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .feature-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .feature-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-grid) 38%, transparent);
    border-radius: var(--radius-chip);
    background: color-mix(in srgb, var(--color-ink) 55%, var(--color-navy));
    transition: border-color 0.2s var(--ease-plot), transform 0.2s var(--ease-plot);
  }
  @media (hover: hover) {
    .feature-card:hover {
      border-color: color-mix(in srgb, var(--color-gold) 55%, transparent);
      transform: translateY(-2px);
    }
  }

  .feature-card__body {
    padding: 1.1rem 1.2rem 1.35rem;
  }
  .feature-card__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-film);
  }
  .feature-card__text {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-film) 76%, transparent);
  }
  @media (max-width: 639px) {
    /* 16px minimum for body text on phones */
    .feature-card__text { font-size: 1rem; }
  }

  .feature-cta {
    display: inline-block;
    border: 1px solid var(--color-gold);
    border-radius: var(--radius-chip);
    /* 44px minimum touch target */
    padding: 0.8rem 1.6rem;
    font-size: var(--text-caption);
    color: var(--color-film);
    text-decoration: none;
    transition: border-color 0.2s var(--ease-plot), color 0.2s var(--ease-plot);
  }
  .feature-cta:hover {
    border-color: var(--color-redline);
    color: var(--color-gold);
  }
</style>

<script>
  import { prefersReducedMotion, afterLoad } from '../../lib/motion';

  // Cards are visible in CSS; the script only ever animates FROM a hidden
  // state it sets itself, so reduced motion or a blocked bundle still leaves
  // the grid readable.
  const cards = [...document.querySelectorAll<HTMLElement>('[data-feature-card]')];

  if (cards.length && !prefersReducedMotion()) afterLoad(async () => {
    const { gsap, ScrollTrigger } = await import('../../lib/motion/scroll');

    ScrollTrigger.batch(cards, {
      start: 'top 92%',
      once: true,
      onEnter: (batch) => {
        gsap.fromTo(
          batch,
          { opacity: 0, y: 12 },
          // 300ms and a 40ms stagger — micro-interaction range, transform and
          // opacity only so nothing reflows.
          { opacity: 1, y: 0, duration: 0.3, ease: 'power2.out', stagger: 0.04, overwrite: true }
        );
      },
    });
    cards.forEach((card) => {
      if (card.getBoundingClientRect().top > window.innerHeight * 0.92) {
        gsap.set(card, { opacity: 0, y: 12 });
      }
    });
    ScrollTrigger.refresh();
  });
</script>
