---
// Act 3 — the parts. Eight systems, each a hairline, a name, the claim, and
// one line of what is in it. Nothing else: no numbers, no boxes, no photos.
//
// The form is HandoffSection's, deliberately — that act is the page's other
// "here is a set of things we make" list, and the two now read as the same
// register on opposite grounds: a hairline above each item, a display-face
// name, then body. Act 3 stays quiet on purpose: it sits between two of
// the heaviest picture acts on the page (the act-2 pile and the work cards),
// so it earns its place with type and space rather than a fourth photo grid.
//
// Steps 1 → 2 → 4 so eight items never leave a row part-full.
//
// The 42-part catalogue these summarise lives on /services (PartsList.astro),
// which is what the one CTA at the foot points to.
import { siteSystems } from '../../data/siteFeatures';
import FeaturePhoto from './FeaturePhoto.astro';

// One picture for the whole act, drawn from the same set the parts do. cms is
// the pick on two counts: the source is 1600px (build.jpg, the other candidate
// by subject, is only 1096 and would upscale across a 1200px band), and an
// owner working on their own site is the act in one frame.
const band = siteSystems.find((s) => s.id === 'cms')!;
---

<section id="act-features" class="features-section" aria-labelledby="features-heading">
  <div class="mx-auto max-w-[1200px] px-6 py-24 lg:py-32">
    <div class="max-w-[640px]">
      <h2 id="features-heading" class="m-0 font-display text-title text-film">
        Everything that can go in it.
      </h2>
      <p class="mt-4 max-w-[52ch] text-body text-film-dim">
        Nobody gets all of it. Your trade decides which parts earn their place.
      </p>
    </div>

    {/* The ratio is set here, not in FeaturePhoto: custom properties inherit,
        so the band can be shallower on a phone without the component growing
        a breakpoint of its own. */}
    <div class="parts-band mt-12">
      <FeaturePhoto
        id={band.id}
        name={band.name}
        subject={band.photo.subject}
        alt={band.photo.alt}
        sizes="(min-width: 1272px) 1200px, 92vw"
        widths={[720, 1000, 1200, 1600]}
      />
    </div>

    <ul class="m-0 mt-14 grid list-none gap-10 p-0 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {siteSystems.map((system) => (
        <li class="part" data-feature-item>
          <h3 class="part__name m-0">{system.name}</h3>
          {/* Claim in the brighter ink on its own line, parts under it in
              the dim: the item gets its hierarchy from weight and space, not
              from a rule, a number or a box. */}
          <p class="part__claim m-0 mt-2">{system.claim}</p>
          <p class="part__detail m-0 mt-1">{system.detail}</p>
        </li>
      ))}
    </ul>

    <a href="/services#parts-list" class="feature-cta mt-14">See the full parts list</a>
  </div>
</section>

<style>
  .features-section {
    background: var(--color-navy);
  }

  /* Shallow on a phone, a band once there is width for it — a 3:1 crop of a
     3:2 source on a 390px screen is a letterbox sliver. */
  .parts-band {
    --photo-ratio: 16 / 9;
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-grid) 42%, transparent);
    border-radius: 2px;
  }
  @media (min-width: 900px) {
    .parts-band {
      --photo-ratio: 3 / 1;
      /* the laptop sits below centre in the source; a centred 3:1 window
         clips its lid */
      --photo-position: 50% 42%;
    }
  }
  /* A navy scrim, the same move the hero makes on its motif: raw, the screen
     in this photograph is the brightest thing in the act and the eye goes to
     a stock laptop instead of the sentence. Enough to seat it in the palette,
     not enough to make it a texture. */
  .parts-band::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-navy) 26%, transparent);
    pointer-events: none;
  }

  /* A hairline above each item, so the eight read as one set — the same
     device HandoffSection uses for its three, in the grid register rather
     than the navy one. */
  .part {
    border-top: 1px solid color-mix(in srgb, var(--color-grid) 42%, transparent);
    padding-top: 1.4rem;
  }

  .part__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-film);
  }

  .part__claim,
  .part__detail {
    max-width: 34ch;
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .part__claim {
    color: var(--color-film);
  }
  .part__detail {
    color: color-mix(in srgb, var(--color-film) 62%, transparent);
  }
  @media (max-width: 639px) {
    /* 16px minimum for body text on phones */
    .part__claim, .part__detail { font-size: 1rem; }
  }

  .feature-cta {
    display: inline-block;
    border: 1px solid var(--color-gold);
    border-radius: var(--radius-chip);
    /* 44px minimum touch target */
    padding: 0.8rem 1.6rem;
    font-size: var(--text-caption);
    color: var(--color-film);
    text-decoration: none;
    transition: border-color 0.2s var(--ease-plot), color 0.2s var(--ease-plot);
  }
  .feature-cta:hover {
    border-color: var(--color-redline);
    color: var(--color-gold);
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>

<script>
  import { prefersReducedMotion, afterLoad } from '../../lib/motion';

  // Items are visible in CSS; the script only ever animates FROM a hidden
  // state it sets itself, so reduced motion or a blocked bundle still leaves
  // the list readable.
  const items = [...document.querySelectorAll<HTMLElement>('[data-feature-item]')];

  if (items.length && !prefersReducedMotion()) afterLoad(async () => {
    const { gsap, ScrollTrigger } = await import('../../lib/motion/scroll');

    ScrollTrigger.batch(items, {
      start: 'top 92%',
      once: true,
      onEnter: (batch) => {
        // 300ms and a 40ms stagger — micro-interaction range, transform and
        // opacity only so nothing reflows.
        gsap.fromTo(
          batch,
          { opacity: 0, y: 12 },
          { opacity: 1, y: 0, duration: 0.3, ease: 'power2.out', stagger: 0.04, overwrite: true }
        );
      },
    });
    items.forEach((item) => {
      if (item.getBoundingClientRect().top > window.innerHeight * 0.92) {
        gsap.set(item, { opacity: 0, y: 12 });
      }
    });
    ScrollTrigger.refresh();
  });
</script>
