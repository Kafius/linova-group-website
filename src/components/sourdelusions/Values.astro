---
---

<section class="py-24 bg-linear-to-b from-white via-brand-pink/3 to-white">
  <div class="max-w-300 mx-auto px-6">
    <div class="text-center mb-16 reveal">
      <span class="inline-block text-[0.8rem] font-semibold uppercase tracking-widest text-brand-pink mb-4">What We Stand For</span>
      <h2 class="text-[clamp(1.8rem,3.5vw,2.6rem)] font-extrabold tracking-tight text-brand-dark">Our Values</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-bg-card border border-border-subtle rounded-[20px] p-8 text-center transition-all duration-300 hover:-translate-y-1 hover:border-brand-green/15 reveal">
        <div class="w-13 h-13 rounded-[14px] bg-brand-green/10 flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 stroke-2 [stroke-linecap:round] [stroke-linejoin:round] fill-none" viewBox="0 0 24 24" stroke="#16F00D">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </div>
        <h3 class="text-[1.05rem] font-bold mb-2 text-brand-dark">Maximum Sourness</h3>
        <p class="text-text-muted text-[0.85rem] leading-relaxed">We push the boundaries of sour. No watered-down, barely-there tang — just full-on, face-contorting intensity.</p>
      </div>
      <div class="bg-bg-card border border-border-subtle rounded-[20px] p-8 text-center transition-all duration-300 hover:-translate-y-1 hover:border-brand-pink/15 reveal">
        <div class="w-13 h-13 rounded-[14px] bg-brand-pink/8 flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 stroke-2 [stroke-linecap:round] [stroke-linejoin:round] fill-none" viewBox="0 0 24 24" stroke="#FF2D8A">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <h3 class="text-[1.05rem] font-bold mb-2 text-brand-dark">Quality Ingredients</h3>
        <p class="text-text-muted text-[0.85rem] leading-relaxed">We use the best ingredients and make each product with care for an unforgettable, feel-good taste.</p>
      </div>
      <div class="bg-bg-card border border-border-subtle rounded-[20px] p-8 text-center transition-all duration-300 hover:-translate-y-1 hover:border-brand-green/15 reveal">
        <div class="w-13 h-13 rounded-[14px] bg-brand-green/10 flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 stroke-2 [stroke-linecap:round] [stroke-linejoin:round] fill-none" viewBox="0 0 24 24" stroke="#16F00D">
            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
        </div>
        <h3 class="text-[1.05rem] font-bold mb-2 text-brand-dark">Proudly Canadian</h3>
        <p class="text-text-muted text-[0.85rem] leading-relaxed">Handcrafted in small batches right here in Canada. Fresh, local, and homegrown from day one.</p>
      </div>
    </div>
  </div>
</section>
