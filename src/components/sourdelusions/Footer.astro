---
const shopLinks = [
  { label: 'All Products', href: '/sourdelusions/products' },
  { label: 'Best Sellers', href: '/sourdelusions/products' },
  { label: 'New Drops', href: '/sourdelusions/products' },
  { label: 'Gift Packs', href: '/sourdelusions/products' },
];
const companyLinks = ['Our Story', 'Wholesale', 'Stockists', 'Contact'];
const supportLinks = [
  { label: 'FAQ', href: '#' },
  { label: 'Shipping', href: '/sourdelusions/shipping' },
  { label: 'Returns', href: '#' },
  { label: 'Privacy Policy', href: '#' },
];
---

<footer class="border-t border-border-subtle pt-15 pb-10">
  <div class="max-w-300 mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr] gap-8 lg:gap-12 mb-12">
      <div>
        <div class="font-heading font-black text-xl tracking-tight bg-linear-to-br from-brand-green to-brand-yellow bg-clip-text text-transparent mb-3">SOUR DELUSIONS</div>
        <p class="text-text-muted text-sm leading-relaxed max-w-70">Dangerously sour candy, proudly made in Canada. Your taste buds will never be the same.</p>
      </div>

      <div>
        <h4 class="text-xs uppercase tracking-widest text-brand-dark mb-4 font-semibold">Shop</h4>
        <ul class="list-none">
          {shopLinks.map(link => <li class="mb-2.5"><a href={link.href} class="text-text-muted text-sm transition-colors duration-300 hover:text-brand-pink">{link.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h4 class="text-xs uppercase tracking-widest text-brand-dark mb-4 font-semibold">Company</h4>
        <ul class="list-none">
          {companyLinks.map(link => <li class="mb-2.5"><a href="#" class="text-text-muted text-sm transition-colors duration-300 hover:text-brand-pink">{link}</a></li>)}
        </ul>
      </div>

      <div>
        <h4 class="text-xs uppercase tracking-widest text-brand-dark mb-4 font-semibold">Support</h4>
        <ul class="list-none">
          {supportLinks.map(link => <li class="mb-2.5"><a href={link.href} class="text-text-muted text-sm transition-colors duration-300 hover:text-brand-pink">{link.label}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="flex flex-col md:flex-row justify-between items-center gap-4 pt-8 border-t border-border-subtle text-center md:text-left">
      <p class="text-text-muted text-xs">&copy; 2026 Sour Delusions. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="https://www.instagram.com/sourdelusions/" target="_blank" rel="noopener" aria-label="Instagram"
          class="w-10 h-10 rounded-full border border-border-subtle flex items-center justify-center transition-all duration-300 hover:border-brand-pink hover:bg-brand-pink/6 group">
          <svg class="w-4.5 h-4.5 fill-text-muted transition-colors duration-300 group-hover:fill-brand-pink" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
        <a href="https://www.tiktok.com/@sourdelusions" target="_blank" rel="noopener" aria-label="TikTok"
          class="w-10 h-10 rounded-full border border-border-subtle flex items-center justify-center transition-all duration-300 hover:border-brand-pink hover:bg-brand-pink/6 group">
          <svg class="w-4.5 h-4.5 fill-text-muted transition-colors duration-300 group-hover:fill-brand-pink" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 0010.86 4.48V13a8.28 8.28 0 005.58 2.15V11.7a4.79 4.79 0 01-3.58-1.59V6.69h3.58z"/></svg>
        </a>
        <a href="https://www.sourdelusions.ca" target="_blank" rel="noopener" aria-label="Website"
          class="w-10 h-10 rounded-full border border-border-subtle flex items-center justify-center transition-all duration-300 hover:border-brand-pink hover:bg-brand-pink/6 group">
          <svg class="w-4.5 h-4.5 fill-text-muted transition-colors duration-300 group-hover:fill-brand-pink" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
