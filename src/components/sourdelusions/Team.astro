---
const team = [
  {
    name: 'Dennis',
    role: 'Founder & CEO',
    bio: 'The one who started it all. Obsessed with pushing sour to the absolute limit.',
    accent: 'brand-green',
    initials: 'D',
  },
  {
    name: 'Jasmine',
    role: 'Head of Product',
    bio: 'Flavour architect. If it doesn\'t make your face scrunch, it doesn\'t ship.',
    accent: 'brand-pink',
    initials: 'J',
  },
  {
    name: 'Marcus',
    role: 'Operations Lead',
    bio: 'Keeps every batch on time and on point. The engine behind the sour machine.',
    accent: 'brand-green',
    initials: 'M',
  },
  {
    name: 'Priya',
    role: 'Brand & Marketing',
    bio: 'Tells the sour story. Turns first-timers into lifelong fans.',
    accent: 'brand-pink',
    initials: 'P',
  },
];
---

<section class="py-24 border-t border-border-subtle" id="team">
  <div class="max-w-300 mx-auto px-6">
    <div class="text-center mb-16 reveal">
      <span class="inline-block text-[0.8rem] font-semibold uppercase tracking-widest text-brand-green mb-4">The Crew</span>
      <h2 class="text-[clamp(2rem,4vw,3.2rem)] font-extrabold tracking-tight text-brand-dark">Meet the Team</h2>
      <p class="text-text-muted text-[1.05rem] mt-4 max-w-140 mx-auto">The people behind every pucker, every batch, and every bold flavour.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {team.map((member) => (
        <div class="bg-bg-card border border-border-subtle rounded-[20px] p-7 text-center transition-all duration-300 hover:-translate-y-2 hover:border-brand-pink/20 hover:shadow-[0_20px_60px_rgba(0,0,0,0.06)] group reveal">
          <div class={`w-20 h-20 rounded-full bg-${member.accent}/10 flex items-center justify-center mx-auto mb-5 transition-transform duration-300 group-hover:scale-110`}>
            <span class={`text-${member.accent} text-2xl font-black font-heading`}>{member.initials}</span>
          </div>
          <h3 class="text-[1.1rem] font-bold text-brand-dark mb-1">{member.name}</h3>
          <span class={`inline-block text-[0.75rem] font-semibold uppercase tracking-widest text-${member.accent} mb-3`}>{member.role}</span>
          <p class="text-text-muted text-[0.85rem] leading-relaxed">{member.bio}</p>
        </div>
      ))}
    </div>
  </div>
</section>
