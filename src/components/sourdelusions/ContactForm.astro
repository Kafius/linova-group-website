---
---

<section class="pb-30">
  <div class="max-w-300 mx-auto px-6">
    <div class="contact-grid reveal">
      <!-- Left: Contact Info -->
      <div class="contact-info">
        <div class="bg-bg-card border border-border-subtle rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 hover:border-brand-green/15">
          <div class="w-10 h-10 rounded-[10px] bg-brand-green/10 flex items-center justify-center mb-3">
            <svg class="w-5 h-5 stroke-2 [stroke-linecap:round] [stroke-linejoin:round] fill-none" viewBox="0 0 24 24" stroke="#16F00D">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <h3 class="text-[0.9rem] font-bold text-brand-dark mb-1">Email</h3>
          <p class="text-text-muted text-[0.8rem]">hello@sourdelusions.ca</p>
        </div>

        <div class="bg-bg-card border border-border-subtle rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 hover:border-brand-pink/15">
          <div class="w-10 h-10 rounded-[10px] bg-brand-pink/8 flex items-center justify-center mb-3">
            <svg class="w-5 h-5 stroke-2 [stroke-linecap:round] [stroke-linejoin:round] fill-none" viewBox="0 0 24 24" stroke="#FF2D8A">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <h3 class="text-[0.9rem] font-bold text-brand-dark mb-1">Location</h3>
          <p class="text-text-muted text-[0.8rem]">Made in Canada</p>
        </div>

        <div class="bg-bg-card border border-border-subtle rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 hover:border-brand-green/15">
          <div class="w-10 h-10 rounded-[10px] bg-brand-green/10 flex items-center justify-center mb-3">
            <svg class="w-5 h-5 stroke-2 [stroke-linecap:round] [stroke-linejoin:round] fill-none" viewBox="0 0 24 24" stroke="#16F00D">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <h3 class="text-[0.9rem] font-bold text-brand-dark mb-1">Response Time</h3>
          <p class="text-text-muted text-[0.8rem]">We reply within 24 hours</p>
        </div>
      </div>

      <!-- Right: Form -->
      <div class="contact-form-wrap bg-bg-card border border-border-subtle rounded-3xl p-8">
        <h2 class="text-[1.4rem] font-extrabold text-brand-dark mb-6">Send Us a Message</h2>
        <form id="contactForm" class="space-y-5">
          <div class="form-row">
            <div>
              <label for="name" class="block text-[0.8rem] font-semibold uppercase tracking-widest text-text-muted mb-2">Name</label>
              <input type="text" id="name" name="name" required
                class="w-full px-4 py-3 rounded-xl border border-border-subtle bg-white text-brand-dark text-[0.95rem] font-body outline-none transition-all duration-300 focus:border-brand-green/40 focus:shadow-[0_0_0_3px_rgba(22,240,13,0.08)]"
                placeholder="Your name">
            </div>
            <div>
              <label for="email" class="block text-[0.8rem] font-semibold uppercase tracking-widest text-text-muted mb-2">Email</label>
              <input type="email" id="email" name="email" required
                class="w-full px-4 py-3 rounded-xl border border-border-subtle bg-white text-brand-dark text-[0.95rem] font-body outline-none transition-all duration-300 focus:border-brand-green/40 focus:shadow-[0_0_0_3px_rgba(22,240,13,0.08)]"
                placeholder="you@example.com">
            </div>
          </div>

          <div>
            <label for="subject" class="block text-[0.8rem] font-semibold uppercase tracking-widest text-text-muted mb-2">Subject</label>
            <select id="subject" name="subject"
              class="w-full px-4 py-3 rounded-xl border border-border-subtle bg-white text-brand-dark text-[0.95rem] font-body outline-none cursor-pointer transition-all duration-300 focus:border-brand-green/40 focus:shadow-[0_0_0_3px_rgba(22,240,13,0.08)]">
              <option value="general">General Inquiry</option>
              <option value="wholesale">Wholesale</option>
              <option value="order">Order Support</option>
              <option value="feedback">Feedback</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-[0.8rem] font-semibold uppercase tracking-widest text-text-muted mb-2">Message</label>
            <textarea id="message" name="message" rows="4" required
              class="w-full px-4 py-3 rounded-xl border border-border-subtle bg-white text-brand-dark text-[0.95rem] font-body outline-none resize-y transition-all duration-300 focus:border-brand-green/40 focus:shadow-[0_0_0_3px_rgba(22,240,13,0.08)]"
              placeholder="Tell us what's on your mind..."></textarea>
          </div>

          <button type="submit" id="submitBtn"
            class="inline-flex items-center gap-2 bg-linear-to-br from-brand-green to-brand-yellow text-brand-dark px-8 py-3.5 rounded-full font-bold text-[0.9rem] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_0_40px_rgba(22,240,13,0.2)] cursor-pointer border-none font-body">
            Send Message
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>
          </button>
        </form>

        <!-- Success State -->
        <div id="successMessage" class="hidden text-center py-10">
          <div class="w-16 h-16 rounded-full bg-brand-green/10 flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 stroke-2 [stroke-linecap:round] [stroke-linejoin:round] fill-none" viewBox="0 0 24 24" stroke="#16F00D">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <h3 class="text-[1.2rem] font-bold text-brand-dark mb-2">Message Sent!</h3>
          <p class="text-text-muted text-[0.95rem]">Thanks for reaching out. We'll get back to you soon.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 640px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const successMessage = document.getElementById('successMessage')!;

  form.addEventListener('submit', (e) => {
    e.preventDefault();

    submitBtn.textContent = 'Sending...';
    submitBtn.disabled = true;

    setTimeout(() => {
      form.classList.add('hidden');
      successMessage.classList.remove('hidden');
    }, 1000);
  });
</script>
