---
---

<section class="min-h-screen flex items-center relative pt-20 overflow-hidden">
  <!-- Background glows -->
  <div class="absolute w-[600px] h-[600px] rounded-full blur-[150px] opacity-12 pointer-events-none bg-brand-green -top-[100px] -right-[100px]"></div>
  <div class="absolute w-[600px] h-[600px] rounded-full blur-[150px] opacity-12 pointer-events-none bg-brand-pink -bottom-[100px] -left-[100px]"></div>

  <div class="max-w-[1200px] mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-15 items-center relative z-1">
    <div class="max-w-full md:max-w-[600px] text-center md:text-left">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 border border-brand-green/30 rounded-full text-[0.8rem] font-medium text-brand-green mb-6 bg-brand-green/5 animate-fade-in-up">
        <span class="w-1.5 h-1.5 bg-brand-green rounded-full animate-pulse-dot"></span>
        Made in Canada
      </div>

      <h1 class="text-[clamp(3rem,7vw,5.5rem)] font-black leading-[0.95] tracking-tighter mb-6 text-brand-dark animate-fade-in-up [animation-delay:0.1s]">
        Your Taste Buds Are <span class="bg-gradient-to-br from-brand-green to-brand-yellow bg-clip-text text-transparent">Delusional</span>
      </h1>

      <p class="text-lg text-text-muted max-w-[440px] mb-10 animate-fade-in-up [animation-delay:0.2s] mx-auto md:mx-0">
        Face-puckering, eye-watering, unapologetically sour candy. Crafted in Canada for those who crave the extreme.
      </p>

      <div class="flex gap-4 flex-wrap animate-fade-in-up [animation-delay:0.3s] justify-center md:justify-start">
        <a href="#products" class="inline-flex items-center gap-2 bg-gradient-to-br from-brand-green to-brand-yellow text-brand-dark px-9 py-4 rounded-full font-bold text-base transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_0_40px_rgba(22,240,13,0.2)] cursor-pointer font-body border-none">Explore Flavours</a>
        <a href="#about" class="inline-flex items-center gap-2 bg-transparent text-brand-dark px-9 py-4 rounded-full font-semibold text-base border border-border-subtle transition-all duration-300 hover:border-brand-pink hover:-translate-y-0.5 cursor-pointer font-body">Our Story</a>
      </div>
    </div>

    <div class="relative flex justify-center items-center animate-fade-in [animation-delay:0.4s] order-first md:order-last">
      <div class="w-full aspect-square max-w-[480px] max-md:max-w-[320px] max-md:mx-auto rounded-3xl border-2 border-dashed border-black/10 flex flex-col justify-center items-center gap-4 relative overflow-hidden bg-gradient-to-br from-bg-card via-brand-green/[0.04] to-brand-pink/[0.04]">
        <div class="absolute inset-0 rounded-3xl bg-[radial-gradient(circle_at_20%_80%,rgba(255,45,138,0.06)_0%,transparent_50%),radial-gradient(circle_at_80%_20%,rgba(22,240,13,0.06)_0%,transparent_50%)]"></div>
        <div class="w-16 h-16 rounded-2xl bg-black/[0.04] flex items-center justify-center relative z-1">
          <svg class="w-7 h-7 stroke-text-muted fill-none [stroke-width:1.5] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
        </div>
        <span class="text-sm text-text-muted font-medium relative z-1">Hero Image</span>
        <span class="text-xs text-[#aaa] relative z-1">Replace with your product photo</span>
      </div>
    </div>
  </div>
</section>
