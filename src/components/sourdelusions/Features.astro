---
const features = [
  {
    title: 'Extreme Sour',
    desc: 'Our proprietary sour coating is up to 3x more intense than leading brands.',
    colorClass: 'bg-brand-pink/[0.08]',
    stroke: '#FF2D8A',
    iconPath: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>',
  },
  {
    title: 'Natural Flavours',
    desc: 'Real fruit flavours, no artificial colours. Bold taste you can feel good about.',
    colorClass: 'bg-brand-green/10',
    stroke: '#0EBB08',
    iconPath: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>',
  },
  {
    title: 'Canadian Crafted',
    desc: 'Made in small batches right here in Canada. Fresh, local, and proudly homegrown.',
    colorClass: 'bg-brand-pink/[0.08]',
    stroke: '#FF2D8A',
    iconPath: '<path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline>',
  },
  {
    title: 'Vegan Friendly',
    desc: 'Plant-based ingredients, gelatine-free. Everyone deserves to pucker up.',
    colorClass: 'bg-brand-green/10',
    stroke: '#0EBB08',
    iconPath: '<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 00-3-3.87"></path><path d="M16 3.13a4 4 0 010 7.75"></path>',
  },
];
---

<section class="py-30 border-t border-border-subtle" id="features">
  <div class="max-w-300 mx-auto px-6">
    <div class="text-center mb-16 reveal">
      <span class="inline-block text-[0.8rem] font-semibold uppercase tracking-widest text-brand-pink mb-4">Why Sour Delusions</span>
      <h2 class="text-[clamp(2rem,4vw,3.2rem)] font-extrabold tracking-tight text-brand-dark">What Makes Us Different</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map(feature => (
        <div class="bg-bg-card border border-border-subtle rounded-[20px] py-8 px-6 text-center transition-all duration-300 hover:-translate-y-1 hover:border-brand-pink/15 reveal">
          <div class={`w-13 h-13 rounded-[14px] flex items-center justify-center mx-auto mb-4 ${feature.colorClass}`}>
            <svg class="w-6 h-6 stroke-2 [stroke-linecap:round] [stroke-linejoin:round] fill-none" viewBox="0 0 24 24" stroke={feature.stroke}>
              <Fragment set:html={feature.iconPath} />
            </svg>
          </div>
          <h3 class="text-[1.05rem] font-bold mb-2 text-brand-dark">{feature.title}</h3>
          <p class="text-text-muted text-[0.85rem] leading-relaxed">{feature.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
