---
---

<!-- Cart Overlay -->
<div id="cartOverlay" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-[1999] opacity-0 pointer-events-none transition-opacity duration-300"></div>

<!-- Cart Sidebar -->
<aside id="cartSidebar" class="fixed top-0 right-0 bottom-0 w-full max-w-[420px] bg-white z-[2000] translate-x-full transition-transform duration-300 ease-out flex flex-col shadow-[-8px_0_30px_rgba(0,0,0,0.08)]">
  <!-- Header -->
  <div class="flex items-center justify-between px-6 py-5 border-b border-border-subtle">
    <div class="flex items-center gap-3">
      <h2 class="font-heading text-lg font-bold text-brand-dark">Your Cart</h2>
      <span id="cartSidebarCount" class="text-xs font-bold bg-brand-green/10 text-[#0EBB08] px-2.5 py-0.5 rounded-full">0</span>
    </div>
    <button id="cartClose" class="w-9 h-9 rounded-full border border-border-subtle flex items-center justify-center hover:border-brand-pink hover:bg-brand-pink/5 transition-all duration-300 cursor-pointer bg-transparent" aria-label="Close cart">
      <svg class="w-4 h-4 stroke-brand-dark" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <!-- Items -->
  <div id="cartItems" class="flex-1 overflow-y-auto px-6 py-4">
    <!-- Populated by JS -->
  </div>

  <!-- Empty state -->
  <div id="cartEmpty" class="flex-1 flex-col items-center justify-center px-6 text-center hidden">
    <div class="w-16 h-16 rounded-full bg-bg-card flex items-center justify-center mx-auto mb-4">
      <svg class="w-7 h-7 stroke-text-muted fill-none" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
        <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
      </svg>
    </div>
    <p class="text-text-muted text-sm mb-1">Your cart is empty</p>
    <p class="text-[#aaa] text-xs">Add some sour goodness!</p>
  </div>

  <!-- Footer -->
  <div id="cartFooter" class="border-t border-border-subtle px-6 py-5">
    <div class="flex justify-between items-center mb-4">
      <span class="text-sm text-text-muted">Subtotal</span>
      <span id="cartSubtotal" class="font-heading text-xl font-bold text-brand-dark">$0.00</span>
    </div>
    <p class="text-xs text-[#aaa] mb-4">Shipping & taxes calculated at checkout</p>
    <a href="/sourdelusions/checkout" id="checkoutBtn" class="block w-full text-center bg-gradient-to-br from-brand-green to-brand-yellow text-brand-dark py-3.5 rounded-full font-bold text-[0.95rem] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_0_40px_rgba(22,240,13,0.2)] font-body">
      Checkout
    </a>
    <button id="clearCartBtn" class="block w-full text-center text-text-muted text-xs mt-3 py-2 hover:text-brand-pink transition-colors duration-300 bg-transparent border-none cursor-pointer font-body">
      Clear Cart
    </button>
  </div>
</aside>

<script>
  import { getItems, removeItem, updateQty, clearCart, getTotal, getCount } from '../../scripts/sourdelusions/cart.js';

  const overlay = document.getElementById('cartOverlay')!;
  const sidebar = document.getElementById('cartSidebar')!;
  const closeBtn = document.getElementById('cartClose')!;
  const itemsContainer = document.getElementById('cartItems')!;
  const emptyState = document.getElementById('cartEmpty')!;
  const footer = document.getElementById('cartFooter')!;
  const subtotalEl = document.getElementById('cartSubtotal')!;
  const countEl = document.getElementById('cartSidebarCount')!;
  const clearBtn = document.getElementById('clearCartBtn')!;

  function openCart() {
    sidebar.classList.remove('translate-x-full');
    overlay.classList.remove('opacity-0', 'pointer-events-none');
    document.body.style.overflow = 'hidden';
  }

  function closeCart() {
    sidebar.classList.add('translate-x-full');
    overlay.classList.add('opacity-0', 'pointer-events-none');
    document.body.style.overflow = '';
  }

  function renderCart() {
    const items = getItems();
    const count = getCount();
    const total = getTotal();

    countEl.textContent = String(count);
    subtotalEl.textContent = `$${total.toFixed(2)}`;

    if (items.length === 0) {
      itemsContainer.classList.add('hidden');
      emptyState.classList.remove('hidden');
      emptyState.classList.add('flex');
      footer.classList.add('hidden');
    } else {
      itemsContainer.classList.remove('hidden');
      emptyState.classList.add('hidden');
      emptyState.classList.remove('flex');
      footer.classList.remove('hidden');

      itemsContainer.innerHTML = items.map(item => `
        <div class="flex gap-4 py-4 border-b border-border-subtle last:border-none">
          <div class="w-16 h-16 rounded-xl bg-bg-card border border-border-subtle flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 stroke-text-muted fill-none" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <h4 class="font-heading text-sm font-bold text-brand-dark truncate">${item.name}</h4>
            <p class="text-xs text-text-muted mt-0.5">$${item.price.toFixed(2)} each</p>
            <div class="flex items-center gap-2 mt-2">
              <button data-action="decrease" data-name="${item.name}" class="w-7 h-7 rounded-full border border-border-subtle flex items-center justify-center hover:border-brand-pink transition-colors cursor-pointer bg-transparent text-sm font-bold text-brand-dark">−</button>
              <span class="text-sm font-semibold w-6 text-center">${item.qty}</span>
              <button data-action="increase" data-name="${item.name}" class="w-7 h-7 rounded-full border border-border-subtle flex items-center justify-center hover:border-brand-green transition-colors cursor-pointer bg-transparent text-sm font-bold text-brand-dark">+</button>
              <button data-action="remove" data-name="${item.name}" class="ml-auto text-xs text-text-muted hover:text-brand-pink transition-colors cursor-pointer bg-transparent border-none font-body">Remove</button>
            </div>
          </div>
          <div class="text-right shrink-0">
            <span class="font-heading font-bold text-brand-dark">$${(item.price * item.qty).toFixed(2)}</span>
          </div>
        </div>
      `).join('');
    }
  }

  // Event delegation for cart item buttons
  itemsContainer.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;
    const action = btn.dataset.action;
    const name = btn.dataset.name!;
    const items = getItems();
    const item = items.find(i => i.name === name);
    if (!item) return;

    if (action === 'increase') updateQty(name, item.qty + 1);
    else if (action === 'decrease') updateQty(name, item.qty - 1);
    else if (action === 'remove') removeItem(name);
  });

  closeBtn.addEventListener('click', closeCart);
  overlay.addEventListener('click', closeCart);
  clearBtn.addEventListener('click', () => { clearCart(); });

  // Listen for cart open event (from navbar icon)
  window.addEventListener('open-cart', () => openCart());
  // Re-render on cart updates
  window.addEventListener('cart-updated', () => renderCart());

  // Also open cart when item is added
  window.addEventListener('cart-item-added', () => {
    renderCart();
    openCart();
  });

  // Initial render
  renderCart();
</script>
