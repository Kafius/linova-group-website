---
---

<section class="py-30 bg-linear-to-b from-white via-brand-pink/3 to-white relative" id="about">
  <div class="max-w-300 mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20 items-center">
    <!-- Visual -->
    <div class="relative reveal">
      <div class="bg-bg-card border border-border-subtle rounded-3xl p-15 relative overflow-hidden">
        <div class="absolute -top-1/2 -left-1/2 w-[200%] h-[200%] bg-[conic-gradient(from_180deg,transparent_60%,rgba(255,45,138,0.03)_80%,transparent_100%)] animate-spin-slow"></div>
        <div class="relative z-1 text-center">
          <div class="w-18 h-18 rounded-full bg-brand-pink/8 flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 fill-brand-pink" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
          </div>
          <div class="font-heading text-5xl font-black bg-linear-to-br from-brand-green to-brand-yellow bg-clip-text text-transparent">100%</div>
          <div class="text-text-muted text-sm mt-1">Canadian Made & Owned</div>
        </div>
      </div>
    </div>

    <!-- Content -->
    <div class="text-center md:text-left reveal">
      <span class="inline-block text-[0.8rem] font-semibold uppercase tracking-widest text-brand-pink mb-4">Our Story</span>
      <h2 class="text-[clamp(2rem,3.5vw,2.8rem)] font-extrabold tracking-tight mb-5 text-brand-dark">Born Sour. <br>Raised Canadian.</h2>
      <p class="text-text-muted text-[1.05rem] mb-4 leading-[1.7]">Sour Delusions started with a simple belief: sour candy should actually be sour. Not the watered-down, barely-tingle stuff. We're talking full-on, face-contorting, tear-inducing sour.</p>
      <p class="text-text-muted text-[1.05rem] mb-4 leading-[1.7]">We handcraft every batch right here in Canada using bold, natural flavours. No shortcuts, no compromise &mdash; just pure sour chaos.</p>

      <div class="grid grid-cols-3 gap-6 mt-10">
        <div class="text-center">
          <div class="font-heading text-3xl font-extrabold bg-linear-to-br from-brand-green to-brand-pink bg-clip-text text-transparent">10+</div>
          <div class="text-xs text-text-muted uppercase tracking-wide mt-1">Flavours</div>
        </div>
        <div class="text-center">
          <div class="font-heading text-3xl font-extrabold bg-linear-to-br from-brand-green to-brand-pink bg-clip-text text-transparent">50K+</div>
          <div class="text-xs text-text-muted uppercase tracking-wide mt-1">Happy Fans</div>
        </div>
        <div class="text-center">
          <div class="font-heading text-3xl font-extrabold bg-linear-to-br from-brand-green to-brand-pink bg-clip-text text-transparent">0</div>
          <div class="text-xs text-text-muted uppercase tracking-wide mt-1">Regrets</div>
        </div>
      </div>
    </div>
  </div>
</section>
