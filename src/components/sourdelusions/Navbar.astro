---
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-1000 py-5 transition-all duration-300">
  <div class="max-w-300 mx-auto px-6 flex justify-between items-center">
    <a href="/sourdelusions/" class="font-heading font-black text-2xl tracking-tight bg-linear-to-br from-brand-green to-brand-yellow bg-clip-text text-transparent">SOUR DELUSIONS</a>
    <ul class="hidden md:flex gap-8 list-none items-center" id="navLinks">
      <li><a href="/sourdelusions/about" class="text-sm font-medium text-text-muted hover:text-brand-green transition-colors duration-300 tracking-wide uppercase">Our Story</a></li>
      <li><a href="/sourdelusions/contact" class="text-sm font-medium text-text-muted hover:text-brand-green transition-colors duration-300 tracking-wide uppercase">Contact</a></li>
      <li><a href="/sourdelusions/products" class="bg-linear-to-br from-brand-green to-brand-yellow text-brand-dark! px-6 py-2.5 rounded-full font-bold text-[0.85rem] hover:scale-105 hover:shadow-[0_0_40px_rgba(22,240,13,0.2)] transition-all duration-300">Shop Now</a></li>
      <li>
        <button id="cartToggle" class="relative w-10 h-10 rounded-full border border-border-subtle flex items-center justify-center hover:border-brand-pink hover:bg-brand-pink/5 transition-all duration-300 cursor-pointer bg-transparent" aria-label="Open cart">
          <svg class="w-5 h-5 stroke-brand-dark fill-none" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
          </svg>
          <span id="cartBadge" class="absolute -top-1 -right-1 w-5 h-5 bg-brand-pink text-white text-[0.65rem] font-bold rounded-full flex items-center justify-center transition-all duration-300 scale-0">0</span>
        </button>
      </li>
    </ul>
    <div class="flex md:hidden items-center gap-3">
      <button id="cartToggleMobile" class="relative w-10 h-10 rounded-full border border-border-subtle flex items-center justify-center hover:border-brand-pink transition-all duration-300 cursor-pointer bg-transparent" aria-label="Open cart">
        <svg class="w-5 h-5 stroke-brand-dark fill-none" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
        </svg>
        <span id="cartBadgeMobile" class="absolute -top-1 -right-1 w-5 h-5 bg-brand-pink text-white text-[0.65rem] font-bold rounded-full flex items-center justify-center transition-all duration-300 scale-0">0</span>
      </button>
      <button class="flex flex-col gap-1.25 bg-none border-none cursor-pointer" id="menuToggle" aria-label="Toggle menu">
        <span class="w-6 h-0.5 bg-brand-dark rounded-sm transition-all duration-300"></span>
        <span class="w-6 h-0.5 bg-brand-dark rounded-sm transition-all duration-300"></span>
        <span class="w-6 h-0.5 bg-brand-dark rounded-sm transition-all duration-300"></span>
      </button>
    </div>
  </div>
</nav>

<script>
  import { getCount } from '../../scripts/sourdelusions/cart.js';

  const navbar = document.getElementById('navbar')!;
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar.classList.add('bg-white/90', 'backdrop-blur-[20px]', 'shadow-[0_1px_0_rgba(0,0,0,0.07)]');
    } else {
      navbar.classList.remove('bg-white/90', 'backdrop-blur-[20px]', 'shadow-[0_1px_0_rgba(0,0,0,0.07)]');
    }
  });

  const menuToggle = document.getElementById('menuToggle')!;
  const navLinks = document.getElementById('navLinks')!;
  menuToggle.addEventListener('click', () => {
    navLinks.classList.toggle('hidden');
    navLinks.classList.toggle('md:flex');
    navLinks.classList.toggle('mobile-menu-open');
  });

  navLinks.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      navLinks.classList.add('hidden');
      navLinks.classList.add('md:flex');
      navLinks.classList.remove('mobile-menu-open');
    });
  });

  // Cart icon
  function updateBadge() {
    const count = getCount();
    const badges = [document.getElementById('cartBadge'), document.getElementById('cartBadgeMobile')];
    badges.forEach(badge => {
      if (!badge) return;
      badge.textContent = String(count);
      if (count > 0) {
        badge.classList.remove('scale-0');
        badge.classList.add('scale-100');
      } else {
        badge.classList.add('scale-0');
        badge.classList.remove('scale-100');
      }
    });
  }

  document.getElementById('cartToggle')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-cart'));
  });
  document.getElementById('cartToggleMobile')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-cart'));
  });

  window.addEventListener('cart-updated', updateBadge);
  updateBadge();
</script>

<style>
  .mobile-menu-open {
    display: flex !important;
    flex-direction: column;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(20px);
    padding: 24px;
    gap: 16px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.07);
  }
</style>
