---
// The section menu shared by /work and /industries — a newspaper's section
// rail. Every entry is a real static page, not a client-side filter: deep
// links work, the active state is server-rendered, and the menu needs no JS
// to do its job. Counts are live, derived from whatever the page fetched.
//
// A page can add a second row to the band through the default slot —
// /industries puts its trade search there, so the two ways of narrowing the
// list are one control rather than two blocks with a gap between them. The
// slot is optional and renders nothing when empty, so /work and the category
// pages are unchanged.
import RailSymbol from './RailSymbol.astro';

export interface RailItem {
  label: string;
  href: string;
  count: number;
  /** vertical accent, used only for this item's active underline */
  accent?: string;
  /** a RailSymbol id. Optional: /work passes none and reads as before. */
  symbol?: string;
}

interface Props {
  items: RailItem[];
  /** the current page's path — the matching item is marked current */
  active: string;
  /** what this rail navigates, for screen readers */
  label: string;
}

const { items, active, label } = Astro.props;

// The band is one section, so the <nav> can only wrap the links — anything in
// the slot is a control, not navigation, and would be announced as part of
// this menu if it sat inside.
const hasExtra = Astro.slots.has('default');
---

<div class="rail">
  <nav class="rail__inner" aria-label={label}>
    <ul class="rail__list">
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            class="rail__link"
            style={item.accent ? `--vx: ${item.accent}` : undefined}
            aria-current={item.href === active ? 'page' : undefined}
          >
            {item.symbol && <RailSymbol id={item.symbol} />}
            {item.label}<span class="rail__count">{item.count}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  {hasExtra && (
    <div class="rail__extra">
      <slot />
    </div>
  )}
</div>

<style>
  /* Parks under the sticky Nav — 44px logo + 2 × 16px of padding. */
  .rail {
    position: sticky;
    top: 76px;
    z-index: 30;
    /* Opaque: the page scrolls underneath it. */
    background: var(--color-navy);
    border-block: 1px solid rgba(200, 160, 90, 0.4);
  }

  .rail__inner {
    margin-inline: auto;
    max-width: 1200px;
    padding-inline: 1.5rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .rail__inner::-webkit-scrollbar {
    display: none;
  }

  .rail__list {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    white-space: nowrap;
  }

  /* The slot's row. Same measure and gutter as .rail__inner so the control
     lines up with the links above it, but no overflow-x — the links scroll
     sideways on a phone and a text field inside a scroller is miserable. */
  .rail__extra {
    margin-inline: auto;
    max-width: 1200px;
    padding-inline: 1.5rem;
    /* Hairline between the two rows, in the grid blue rather than the band's
       gold, so the band still reads as one section rather than two stacked. */
    border-top: 1px solid rgba(77, 77, 143, 0.4);
  }

  .rail__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6ch;
    /* 0.7rem rather than the old 0.85. The seven category symbols cost the
       rail the single line that padding used to buy: measured at 1200, the
       links run 1246px and scroll, which is the documented fallback.
       Squeezing further only made the entries look cramped.
       Moving the register off IBM Plex Mono bought 11px of that back — worth
       having, but nowhere near a line, so the rail still scrolls. */
    padding: 0.9rem 0.7rem;
    border-bottom: 2px solid transparent;
    color: var(--color-film-dim);
    font-family: var(--font-label);
    font-size: var(--text-label);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s var(--ease-plot);
  }
  .rail__list li:first-child .rail__link {
    padding-left: 0;
  }
  .rail__link:hover {
    color: var(--color-film);
  }
  /* The active entry is the only place a vertical accent touches the rail. */
  .rail__link[aria-current='page'] {
    color: var(--color-film);
    border-bottom-color: var(--vx, var(--color-gold));
  }

  .rail__count {
    color: var(--color-gold);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .rail__link {
      transition: none;
    }
  }
</style>

<script>
  // On a phone the rail scrolls sideways, and the active entry can start
  // off-screen. Centre it without touching the page's vertical scroll
  // (scrollIntoView would).
  const active = document.querySelector<HTMLElement>('.rail__link[aria-current="page"]');
  const track = active?.closest<HTMLElement>('.rail__inner');
  if (active && track && track.scrollWidth > track.clientWidth) {
    track.scrollLeft = active.offsetLeft - (track.clientWidth - active.offsetWidth) / 2;
  }
</script>
