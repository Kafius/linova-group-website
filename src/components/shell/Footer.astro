---
// Footer — laid out to the format of the live v1 site: a three-equal-column
// top band (brand / links / CTA block), a hairline divider, then a two-sided
// baseline row. Plotter & Marker styling throughout; only the shape is v1's.
import { Image } from 'astro:assets';
import wordmark from '../../assets/linova-logo-horizontal-white.png';
import { nav, site, contact, social } from '../../data/site';

const year = new Date().getFullYear();

// Brand glyphs for whatever profiles exist. Nothing renders until `social`
// in src/data/site.ts is populated, so there are never icons that go nowhere.
const socialIcons: Record<string, string> = {
  instagram: `<rect x="3" y="3" width="18" height="18" rx="5" stroke-width="1.6"/><circle cx="12" cy="12" r="4" stroke-width="1.6"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/>`,
  facebook: `<path d="M14.5 8.5h2.2V5.6h-2.4c-2.3 0-3.6 1.4-3.6 3.7v1.8H8.4v2.9h2.3V21h3v-7h2.3l.4-2.9h-2.7V9.6c0-.8.3-1.1.8-1.1z" stroke-width="1.6" stroke-linejoin="round"/>`,
  linkedin: `<rect x="3" y="3" width="18" height="18" rx="3" stroke-width="1.6"/><path d="M7.5 10.5V17M7.5 7.5v.01M11.5 17v-3.6c0-1.3.9-2.2 2-2.2s2 .9 2 2.2V17" stroke-width="1.6" stroke-linecap="round"/>`,
  tiktok: `<path d="M14 4v10.2a3.2 3.2 0 1 1-2.6-3.15" stroke-width="1.6" stroke-linecap="round"/><path d="M14 4c.4 2.2 1.9 3.6 4 3.8" stroke-width="1.6" stroke-linecap="round"/>`,
};
---

<footer class="border-t border-gold/30 bg-ink pt-16 pb-8">
  <!-- 1200px, not v1's 1140 — the nav and every section use 1200, so a
       narrower footer would sit 30px inboard of everything above it. -->
  <div class="mx-auto max-w-[1200px] px-6">

    <!-- Top: three equal columns -->
    <div class="mb-12 grid grid-cols-1 gap-10 sm:grid-cols-3">

      <!-- Brand -->
      <div>
        <a href="/" class="mb-4 inline-block" aria-label={`${site.name} — home`}>
          <Image
            src={wordmark}
            alt={site.name}
            width={150}
            densities={[1, 2]}
            class="h-[35px] w-auto"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="max-w-[34ch] text-caption text-film-dim">
          Websites, marketing, and content for small and mid-sized businesses.
          Working remotely across the GTA, Canada, and the US.
        </p>
      </div>

      <!-- Pages -->
      <div>
        <p class="label-mono mb-5">Pages</p>
        <ul class="flex flex-col gap-3">
          {nav.links.map((link) => (
            <li><a href={link.href} class="text-caption text-film-dim transition-colors hover:text-film">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Get started -->
      <div>
        <p class="label-mono mb-5">Get started</p>
        <p class="mb-5 max-w-[32ch] text-caption text-film-dim">
          Tell us what you're building. We reply within one business day.
        </p>

        <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
          <a
            href={nav.cta.href}
            data-track="book_click"
            data-track-label="footer"
            class="inline-flex items-center gap-2 rounded-chip border border-gold px-5 py-2.5 text-caption text-film transition-colors hover:border-redline"
          >
            {nav.cta.label}
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
            </svg>
          </a>
          <a href="/contact" class="inline-block py-1.5 text-caption text-film-dim transition-colors hover:text-film">Send a message</a>
        </div>

        {(contact.email || contact.phone) && (
          <ul class="mt-5 flex flex-col gap-2">
            {contact.email && (
              <li><a href={`mailto:${contact.email}`} class="text-caption text-film-dim transition-colors hover:text-film">{contact.email}</a></li>
            )}
            {contact.phone && (
              <li><a href={`tel:${contact.phone.replace(/[^+\d]/g, '')}`} class="text-caption text-film-dim transition-colors hover:text-film">{contact.phone}</a></li>
            )}
          </ul>
        )}

        {social.length > 0 && (
          <ul class="-ml-[11px] mt-6 flex flex-wrap">
            {social.map((profile) => (
              <li>
                <a
                  href={profile.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={profile.label}
                  class="social-link"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" set:html={socialIcons[profile.icon]} />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

    </div>

    <!-- Divider + baseline row -->
    <div class="flex flex-col items-start justify-between gap-3 border-t border-film/12 pt-8 sm:flex-row sm:items-center">
      <p class="text-[0.75rem] text-film-dim/70">
        © {year} Linova Group. All rights reserved.
      </p>
      <!-- -my-1.5 keeps the row's height where it was while py-1.5 lifts the
           tap targets to 24px+ (WCAG 2.2 2.5.8). -->
      <p class="-my-1.5 flex gap-5 text-[0.75rem]">
        <a href="/privacy" class="inline-block py-1.5 text-film-dim/70 transition-colors hover:text-film">Privacy</a>
        <a href="/terms" class="inline-block py-1.5 text-film-dim/70 transition-colors hover:text-film">Terms</a>
        {/* The Unsplash API Guidelines require the photographer credited
            wherever a photo is shown. The demo sites carry theirs on their own
            footer; this is where the marketing site's own pictures — the
            industry heroes and the service mosaics — carry it. */}
        <a href="/credits" class="inline-block py-1.5 text-film-dim/70 transition-colors hover:text-film">Photo credits</a>
      </p>
    </div>

  </div>
</footer>

<style>
  /* 44px target on a 22px glyph — the padding is the hit area, so the row
     carries no gap (targets would overlap) and pulls its own height back in. */
  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-block: -11px;
    color: var(--color-film-dim);
    transition: color 0.25s var(--ease-plot);
  }
  .social-link svg {
    width: 22px;
    height: 22px;
  }
  .social-link:hover {
    color: var(--color-gold);
  }
</style>
