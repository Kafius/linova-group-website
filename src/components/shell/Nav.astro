---
// Site chrome: navy + gold + film only — vertical accents never touch this.
// The nav's Book link is always on at sm+ (phones reach it through the menu
// below). It used to hide itself while a page's [data-hero-cta] was on screen
// — the one-CTA-per-viewport law — but a booking link you have to scroll to
// find is worse than two of them on one screen.
import { Image } from 'astro:assets';
import wordmark from '../../assets/linova-logo-horizontal-white.png';
import { nav } from '../../data/site';
---

<header class="sticky top-0 z-40 bg-navy/90 backdrop-blur-sm">
  <div class="mx-auto flex max-w-[1200px] items-center justify-between gap-6 px-6 py-4">
    <a href="/" class="flex items-center cursor-pointer">
      {/* Through the image pipeline, not public/: the source is 2370px wide
          and was shipping 191KB to every page for a 176px box. */}
      <Image
        src={wordmark}
        alt="Linova Group"
        width={188}
        densities={[1, 2]}
        loading="eager"
        class="h-11 w-auto"
      />
    </a>

    <nav aria-label="Main">
      <ul class="hidden items-center gap-8 md:flex">
        {nav.links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-caption text-film-dim transition-colors hover:text-film"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={nav.cta.href}
        data-track="book_click"
        data-track-label="nav"
        class="hidden rounded-chip border border-gold px-4 py-2 text-caption text-film transition-colors hover:border-redline sm:inline-block"
      >
        {nav.cta.label}
      </a>
      <button
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="flex h-10 w-10 items-center justify-center md:hidden"
        aria-label="Menu"
      >
        <svg width="20" height="14" viewBox="0 0 20 14" fill="none" aria-hidden="true">
          <path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" hidden class="border-t border-grid/40 bg-navy px-6 py-6 md:hidden">
    <ul class="flex flex-col gap-5">
      {nav.links.map((link) => (
        <li>
          <a href={link.href} class="font-display text-heading text-film">{link.label}</a>
        </li>
      ))}
      <li>
        <a
          href={nav.cta.href}
          class="mt-2 inline-block rounded-chip border border-gold px-4 py-2 text-caption text-film"
        >
          {nav.cta.label}
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  // Mobile menu toggle
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
</script>
