---
const clients = [
  { name: "Dataverse", logo: "/clients/dataverse-logo.jpg", url: "https://www.dataverse.ph", height: "h-16" },
  { name: "EasyCare", logo: "/clients/easycare-logo.png", url: "https://www.ecaretransinc.com", height: "h-24" },
  { name: "GMS", logo: "/clients/gms-logo.svg", url: "https://www.globalmusicsolutions.ca", height: "h-16" },
  { name: "MTA", logo: "/clients/mta-logo.jpg", url: "https://www.markhamtaekwondo.com", height: "h-16" },
  { name: "Macao Imperial Tea", logo: "/clients/macao-imperial-tea-logo.jpg", url: "https://www.macaoimperialtealondon.com", height: "h-16" },
  { name: "LiveRoof Ontario", logo: "/clients/liveroof-ontario-logo.svg", url: "https://www.liveroofontario.ca", height: "h-16" },
  { name: "Cherry Grove Group", logo: "/clients/cherrygrovegroup-logo.png", url: "https://www.cherrygrovegroup.com", height: "h-20" },
  { name: "GT Payments", logo: "/clients/gtpayments-logo.png", url: "https://gtpayments.ca", height: "h-16" },
  // Stacked crest-over-wordmark logo — needs the taller slot to read at the same weight as the wordmarks
  { name: "GT Legacy", logo: "/clients/gtlegacy-logo.png", url: "https://gtlegacy.com", height: "h-24" },
];

// The set is rendered 4× so the row always overflows the viewport; the
// animation shifts by exactly one set (-25%) for a seamless loop.
const track = [...clients, ...clients, ...clients, ...clients];
---

<section class="py-8 bg-[#f8fafc]" id="clients">
  <div class="max-w-[1140px] mx-auto px-6">
    <h2 class="text-center text-[0.65rem] font-semibold uppercase tracking-[0.22em] text-muted/70 mb-5">Trusted by growing businesses</h2>

    <!-- Semantic list for assistive tech; the visual row below is decorative -->
    <ul class="sr-only">
      {clients.map((client) => (
        <li><a href={client.url} target="_blank" rel="noopener noreferrer">{client.name}</a></li>
      ))}
    </ul>

    <div class="clients-marquee" aria-hidden="true">
      <div class="clients-track">
        {track.map((client, i) => (
          <a
            href={client.url}
            target="_blank"
            rel="noopener noreferrer"
            tabindex={i < clients.length ? 0 : -1}
            aria-label={`Visit ${client.name}`}
            class:list={[
              "shrink-0 w-[180px] flex items-center justify-center px-4 grayscale opacity-40 hover:grayscale-0 hover:opacity-80 transition-all duration-400 cursor-pointer",
              client.height
            ]}
          >
            <img src={client.logo} alt={i < clients.length ? client.name : ''} loading="lazy" decoding="async" class="max-h-full max-w-full object-contain mix-blend-multiply" />
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .clients-marquee {
    overflow: hidden;
    /* logos fade in and out at the edges instead of hard-clipping */
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
            mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
  }

  .clients-track {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    width: max-content;
    will-change: transform;
    animation: clients-scroll 40s linear infinite;
  }

  .clients-marquee:hover .clients-track { animation-play-state: paused; }

  @keyframes clients-scroll {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-25%, 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .clients-track { animation: none; }
  }

  @media (max-width: 640px) {
    .clients-track { gap: 1.5rem; animation-duration: 28s; }
  }
</style>
