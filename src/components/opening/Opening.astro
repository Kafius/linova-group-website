---
// Act 1 — "The compiler". The anchor sentence is the LCP and never animates;
// the cycling word, motif layer, and chrome animate around it (design plan law 7).
// Reduced motion: no cycle — the slot freezes and a plain list of all seven
// verticals is shown instead.
import { industries } from '../../data/industries';
import Motif from '../motifs/Motif.astro';

const first = industries[0];
const cycleData = industries.map((i) => ({
  slug: i.slug,
  word: i.cycleWord,
  accent: i.accent,
}));
---

<section
  id="act-opening"
  class="opening plot-grid relative flex min-h-[100svh] flex-col justify-center overflow-hidden"
  style={`--vx: ${first.accent}`}
>
  <!-- Motif layer — one plotted signature at a time, behind the sentence -->
  <div class="motif-stage pointer-events-none absolute inset-y-0 right-[4vw] w-[42%] max-w-[560px]" aria-hidden="true">
    {industries.map((industry, i) => (
      <div
        class:list={['motif-slide absolute inset-0 flex items-center justify-center', { 'is-active': i === 0 }]}
        data-motif-slide={industry.slug}
        style={`color: ${industry.accent}`}
      >
        <Motif id={industry.motif} class="max-h-[52svh] w-full opacity-30" />
      </div>
    ))}
  </div>

  <div class="relative mx-auto w-full max-w-[1200px] px-6 pb-24 pt-28 lg:pb-52">
    <h1 class="m-0">
      <!-- Screen readers get the whole claim; the kinetic slot is theatre -->
      <span class="sr-only">
        Machine-built for barbershops, restaurants, contractors, dojos, roofing
        suppliers, retail, and transport. Human-marketed for people.
      </span>
      <span aria-hidden="true" class="block">
        <span class="block font-sans text-title font-medium text-film-dim">machine-built for</span>
        <span
          class="cycle-slot block font-display text-display-xl"
          data-cycle-slot
          style="color: var(--vx)"
        >{first.cycleWord}</span>
        <span class="mt-3 block font-display text-title text-film">
          human-marketed for <span class="marker-u">people.</span>
        </span>
      </span>
    </h1>

    <!-- Reduced motion / no-JS: the seven, spelled out -->
    <p class="cycle-static label-mono mt-6 hidden max-w-[60ch] normal-case tracking-normal" aria-hidden="true">
      {industries.map((i) => i.cycleWord).join(' · ')}
    </p>

    <a
      href="/book"
      data-hero-cta
      data-track="book_click"
      data-track-label="hero"
      class="intro-chrome mt-12 inline-block rounded-chip border border-gold px-7 py-3.5 text-body text-film transition-[border-color,background-color] duration-300 hover:border-redline"
    >
      Book a call
    </a>
  </div>

  <script type="application/json" data-cycle-data set:html={JSON.stringify(cycleData)} />
</section>

<style>
  /* Motif crossfade — opacity/transform only, compositor-safe */
  .motif-slide {
    opacity: 0;
    transform: translateY(12px) scale(0.985);
    transition: opacity 0.55s var(--ease-plot), transform 0.55s var(--ease-plot);
  }
  .motif-slide.is-active {
    opacity: 1;
    transform: none;
  }

  /* The cycling word stays on one line — long words scale down via
     --slot-scale (set per word by the cycle script) instead of wrapping. */
  .cycle-slot {
    font-size: calc(var(--text-display-xl) * var(--slot-scale, 1));
    line-height: 1.05;
    min-height: 1.05em;
    overflow: hidden;
    white-space: nowrap;
  }
  .cycle-slot :global(.char) {
    display: inline-block;
    will-change: transform, opacity;
  }
  /* keep spaces between words of multi-word slots (e.g. "roofing suppliers") */
  .cycle-slot :global(.char.space) {
    white-space: pre;
  }

  /* Intro: chrome fades in AROUND the sentence; the sentence itself paints
     immediately and never animates (LCP law). */
  html.is-intro .intro-chrome,
  html.is-intro .motif-stage {
    opacity: 0;
    transition: opacity 0.5s ease 0.9s;
  }
  html.is-intro.intro-done .intro-chrome,
  html.is-intro.intro-done .motif-stage {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .motif-slide,
    html.is-intro .intro-chrome,
    html.is-intro .motif-stage {
      transition: none;
      opacity: 1;
    }
    .motif-slide:not(.is-active) {
      opacity: 0;
    }
    .cycle-static {
      display: block;
    }
  }

  @media (max-width: 767px) {
    .motif-stage {
      inset-inline: 0;
      width: auto;
      max-width: none;
      opacity: 0.5;
    }
  }
</style>

<script>
  import { prefersReducedMotion, hasPlayedIntro, markIntroPlayed, magnetic, afterLoad } from '../../lib/motion';

  const root = document.documentElement;
  const section = document.querySelector<HTMLElement>('#act-opening');
  const slot = document.querySelector<HTMLElement>('[data-cycle-slot]');
  const dataEl = document.querySelector<HTMLScriptElement>('[data-cycle-data]');
  const cta = document.querySelector<HTMLElement>('[data-hero-cta]');

  if (cta) magnetic(cta);

  // ── The load sequence — 1.2s, once per session, skippable ──────────
  const reduced = prefersReducedMotion();
  const bootLines = document.querySelectorAll<HTMLElement>('[data-boot-line]');

  function finishIntro() {
    root.classList.add('intro-done');
    bootLines.forEach((line) => line.classList.add('is-printed'));
    markIntroPlayed();
  }

  if (!reduced && !hasPlayedIntro()) {
    root.classList.add('is-intro');
    const timers: ReturnType<typeof setTimeout>[] = [];
    bootLines.forEach((line, i) => {
      timers.push(setTimeout(() => line.classList.add('is-printed'), i * 400));
    });
    timers.push(setTimeout(() => finishIntro(), 1300));
    const skip = () => {
      timers.forEach(clearTimeout);
      finishIntro();
      window.removeEventListener('scroll', skip);
      window.removeEventListener('pointerdown', skip);
      window.removeEventListener('keydown', skip);
    };
    window.addEventListener('scroll', skip, { once: true, passive: true });
    window.addEventListener('pointerdown', skip, { once: true });
    window.addEventListener('keydown', skip, { once: true });
  } else {
    root.classList.add('is-intro', 'intro-done');
    bootLines.forEach((line) => line.classList.add('is-printed'));
  }

  // ── The cycle — word + accent + motif swap in sync ─────────────────
  // Boots after first paint; gsap is dynamic-imported so the animation
  // bundle never sits on the LCP critical path.
  interface CycleEntry { slug: string; word: string; accent: string }

  if (section && slot && dataEl && !reduced) afterLoad(async () => {
    const { gsap } = await import('gsap');
    const entries: CycleEntry[] = JSON.parse(dataEl.textContent ?? '[]');
    const slides = new Map<string, HTMLElement>();
    document.querySelectorAll<HTMLElement>('[data-motif-slide]').forEach((el) => {
      slides.set(el.dataset.motifSlide ?? '', el);
    });

    let index = 0;

    const splitToChars = (word: string): HTMLElement[] => {
      slot.textContent = '';
      return [...word].map((ch) => {
        const span = document.createElement('span');
        span.className = ch === ' ' ? 'char space' : 'char';
        span.textContent = ch;
        slot.appendChild(span);
        return span;
      });
    };

    const showEntry = (next: number) => {
      const entry = entries[next];
      const prev = entries[index];
      index = next;

      // motif + accent swap in sync with the word
      slides.get(prev.slug)?.classList.remove('is-active');
      slides.get(entry.slug)?.classList.add('is-active');
      section.style.setProperty('--vx', entry.accent);
      // long words shrink instead of wrapping ("roofing suppliers")
      slot.style.setProperty('--slot-scale', String(Math.min(1, 12 / entry.word.length)));

      const chars = splitToChars(entry.word);
      gsap.fromTo(
        chars,
        { yPercent: 60, opacity: 0 },
        { yPercent: 0, opacity: 1, duration: 0.45, ease: 'power3.out', stagger: 0.022 }
      );
    };

    const cycleOut = () => {
      const chars = slot.querySelectorAll('.char');
      if (chars.length === 0) {
        showEntry((index + 1) % entries.length);
        return;
      }
      gsap.to(chars, {
        yPercent: -60,
        opacity: 0,
        duration: 0.3,
        ease: 'power2.in',
        stagger: 0.014,
        onComplete: () => showEntry((index + 1) % entries.length),
      });
    };

    // Autoplay arms on the first human signal (pointer, scroll, key, touch).
    // Until then the server-rendered word is the LCP and never repaints —
    // law 7: nothing animates the LCP. Real visitors move within a second;
    // lab traces without input simply see the static hero.
    let interval: ReturnType<typeof setInterval> | null = null;
    let scrubbing = false;
    let armed = false;
    const start = () => {
      if (armed && !interval && !scrubbing) interval = setInterval(cycleOut, 2600);
    };
    const arm = () => {
      armed = true;
      start();
    };
    (['pointermove', 'pointerdown', 'scroll', 'keydown', 'touchstart'] as const).forEach(
      (evt) => window.addEventListener(evt, arm, { once: true, passive: true })
    );
    const stop = () => {
      if (interval) {
        clearInterval(interval);
        interval = null;
      }
    };
    document.addEventListener('visibilitychange', () =>
      document.hidden ? stop() : start()
    );
    new IntersectionObserver(([entry]) =>
      entry.isIntersecting ? start() : stop()
    ).observe(section);

    // Scroll makes the system spin up: as the hero exits, the cycle
    // accelerates through a fixed sequence and resolves onto the first
    // rail panel — deterministic, so the pin length never varies.
    const SEEK = [1, 3, 5, 0];
    document.addEventListener('linova:cycle-progress', (event) => {
      const p: number = (event as CustomEvent).detail?.p ?? 0;
      if (p < 0.04) {
        scrubbing = false;
        start();
        return;
      }
      scrubbing = true;
      stop();
      const target =
        p < 0.3 ? SEEK[0] : p < 0.55 ? SEEK[1] : p < 0.8 ? SEEK[2] : SEEK[3];
      if (target !== index) showEntry(target);
    });
  });
  if (slot && reduced) {
    // Reduced motion: freeze the slot on the first word; the static list shows.
    slot.textContent = entries0();
  }

  function entries0(): string {
    try {
      const parsed = JSON.parse(dataEl?.textContent ?? '[]');
      return parsed[0]?.word ?? '';
    } catch {
      return '';
    }
  }
</script>
