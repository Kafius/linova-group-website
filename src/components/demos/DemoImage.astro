---
// A photo slot for a demo site, following the same contract as
// src/components/industries/IndustryPhoto.astro: an eager glob resolved at
// build time, the optimized image when the file exists, and a labelled
// placeholder at the identical aspect ratio when it does not.
//
// The placeholder prints its own art direction and the path it wants, so the
// page tells you which picture is missing and what it should be. The build
// never breaks on a missing photo and the layout never shifts when one lands.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** demo folder under src/assets/demos, e.g. 'fnb-full-service' */
  demo: string;
  /** file basename without extension */
  file: string;
  /** art direction, printed on the placeholder */
  subject: string;
  alt: string;
  /** CSS aspect-ratio, e.g. '16 / 9' — placeholder and photo share it */
  ratio?: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  /** recede the placeholder — for full-bleed slots that sit behind headline
   *  type, where the art-direction note would otherwise fight the words */
  quiet?: boolean;
  class?: string;
}

const {
  demo,
  file,
  subject,
  alt,
  ratio = '3 / 2',
  sizes = '(min-width: 1024px) 50vw, 100vw',
  widths = [640, 1024, 1600],
  eager = false,
  quiet = false,
  class: className,
} = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/demos/**/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);

const wanted = `/src/assets/demos/${demo}/${file}`;
const match = Object.entries(photos).find(
  ([path]) => path.replace(/\.[^.]+$/, '') === wanted
);
const photo = match?.[1].default;

const rendered = photo
  ? await getImage({ src: photo, widths, sizes, format: 'webp' })
  : null;
---

<figure class:list={['shot', className]} style={`aspect-ratio:${ratio}`}>
  {rendered ? (
    <img
      src={rendered.src}
      srcset={rendered.srcSet.attribute}
      sizes={sizes}
      width={rendered.attributes.width}
      height={rendered.attributes.height}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding={eager ? 'auto' : 'async'}
    />
  ) : (
    <div class:list={['shot__slot', quiet && 'shot__slot--quiet']}>
      <span class="shot__tag">Photo</span>
      <p class="shot__subject">{subject}</p>
      <span class="shot__path">src/assets/demos/{demo}/{file}.jpg</span>
    </div>
  )}
</figure>

<style>
  .shot {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--ink-raised);
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .shot__slot {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(0.9rem, 2vw, 1.4rem);
    border: 1px dashed color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }
  .shot__slot--quiet {
    opacity: 0.32;
  }
  .shot__tag,
  .shot__path {
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent);
  }
  .shot__path {
    text-transform: none;
    letter-spacing: 0.02em;
    font-weight: 400;
    opacity: 0.75;
    word-break: break-all;
  }
  .shot__subject {
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--on-ink-dim);
    max-width: 38ch;
  }
</style>
