---
// The category page body for Halden Home Furnishings, shared by all four.
//
// ── CMS-DRIVEN ───────────────────────────────────────────────────────────
// The grid renders the `product` collection, and the two filter rows render
// the `category` and `productType` taxonomy behind it — see
// retail-large-catalogue.cms.ts. On a live build the floor manager adds a
// piece, retires one, or moves a price band during a sale, and this page and
// its filters follow without a deploy.
// ─────────────────────────────────────────────────────────────────────────
//
// ── THE FILTER ───────────────────────────────────────────────────────────
// Two facets, no JavaScript. Each facet is a radio group; each option emits
// one rule that hides every card not matching it. Because the two rules are
// independent, choosing a type AND a price band intersects on its own — the
// selector count is types + bands, not types × bands.
//
// The rules are generated here from the catalogue rather than written by
// hand, which also lets us compute the pairs that have no products at all and
// emit an empty state for exactly those. Add a sofa under $500 to the data
// module and that combination stops being empty by itself.
//
// The CSS is emitted inline and scoped by the wrapper's id, because Astro's
// scoped <style> cannot take a computed string.
// ─────────────────────────────────────────────────────────────────────────
import {
  catalogue,
  deposit,
  formatPrice,
  priceBands,
  productsIn,
  slug,
  stockLabels,
  type Category,
} from '../../data/demos/retail-large-catalogue';

interface Props {
  category: Category;
}

const { category } = Astro.props;
const items = productsIn(category.id);
const root = `cat-${category.id}`;
const typeId = (type: string) => `t-${category.id}-${slug(type)}`;
const bandId = (band: string) => `p-${category.id}-${band}`;

/** Which combinations have nothing in them. Computed, not maintained.
 *
 *  `null` is the "All" option on either facet, and it has to be in here: a
 *  category with nothing at all under $500 shows no results for All types x
 *  Under $500, and the first version of this missed exactly that case on the
 *  appliances page. */
const typeOptions: (string | null)[] = [null, ...category.types];
const bandOptions: (string | null)[] = [null, ...priceBands.map((band) => band.id)];
const idFor = (type: string | null, band: string | null) => ({
  type: type === null ? `t-${category.id}-all` : typeId(type),
  band: band === null ? `p-${category.id}-all` : bandId(band),
});
const emptyPairs = typeOptions.flatMap((type) =>
  bandOptions
    .filter(
      (band) =>
        !items.some((item) => (type === null || item.type === type) && (band === null || item.band === band))
    )
    .map((band) => idFor(type, band))
);

const filterCss = [
  ...category.types.map(
    (type) =>
      `#${root}:has(#${typeId(type)}:checked) .hc-item:not([data-type="${slug(type)}"]){display:none}`
  ),
  ...priceBands.map(
    (band) => `#${root}:has(#${bandId(band.id)}:checked) .hc-item:not([data-band="${band.id}"]){display:none}`
  ),
  `#${root} .hc-empty{display:none}`,
  ...emptyPairs.map(
    (pair) => `#${root}:has(#${pair.type}:checked):has(#${pair.band}:checked) .hc-empty{display:block}`
  ),
].join('');
---

<section class="hc" id={root} aria-label={category.heading}>
  <div class="wrap">
    <!-- ── Filters ─────────────────────────────────────────────────── -->
    <h2 class="hc-filter-h">{catalogue.filterHeading}</h2>
    <div class="hc-filters">
      <fieldset class="facet">
        <legend class="facet__legend">{catalogue.typeLabel}</legend>
        <input class="facet__input" type="radio" name={`type-${category.id}`} id={`t-${category.id}-all`} checked />
        <label class="facet__label" for={`t-${category.id}-all`}>{catalogue.allLabel}</label>
        {category.types.map((type) => (
          <>
            <input class="facet__input" type="radio" name={`type-${category.id}`} id={typeId(type)} value={type} />
            <label class="facet__label" for={typeId(type)}>{type}</label>
          </>
        ))}
      </fieldset>

      <fieldset class="facet">
        <legend class="facet__legend">{catalogue.priceLabel}</legend>
        <input class="facet__input" type="radio" name={`band-${category.id}`} id={`p-${category.id}-all`} checked />
        <label class="facet__label" for={`p-${category.id}-all`}>{catalogue.allLabel}</label>
        {priceBands.map((band) => (
          <>
            <input class="facet__input" type="radio" name={`band-${category.id}`} id={bandId(band.id)} value={band.id} />
            <label class="facet__label" for={bandId(band.id)}>{band.label}</label>
          </>
        ))}
      </fieldset>
    </div>
    <p class="hc-note">{catalogue.resultsNote}</p>

    <!-- ── Grid ────────────────────────────────────────────────────── -->
    <ul class="hc-grid">
      {items.map((item) => (
        <li class="hc-item" data-type={slug(item.type)} data-band={item.band} id={item.id}>
          <div class="hc-shot" aria-hidden="true">
            <span class="hc-shot__label">{item.type}</span>
          </div>
          <div class="hc-body">
            <div class="hc-line">
              <h3 class="hc-name">{item.name}</h3>
              <span class="hc-price">${formatPrice(item.price)}</span>
            </div>
            <p class="hc-desc">{item.description}</p>
            <dl class="hc-spec">
              <div>
                <dt class="hc-k">{catalogue.finishLabel}</dt>
                <dd class="hc-v">{item.finish}</dd>
              </div>
              <div>
                <dt class="hc-k">{catalogue.specLabel}</dt>
                <dd class="hc-v">{item.spec}</dd>
              </div>
              <div>
                <dt class="hc-k">{catalogue.depositLineLabel}</dt>
                <dd class="hc-v hc-v--deposit">
                  ${formatPrice(Math.max(deposit.minimum, Math.round((item.price * deposit.percent) / 100)))}
                </dd>
              </div>
            </dl>
            <p class="hc-stock">{stockLabels[item.stock]}</p>
          </div>
        </li>
      ))}
    </ul>

    <p class="hc-empty">
      <span class="hc-empty__h">{catalogue.emptyHeading}</span>
      <span class="hc-empty__b">{catalogue.emptyBody}</span>
    </p>

    {category.id === 'appliances' && <p class="hc-appliance">{catalogue.applianceNote}</p>}
  </div>
</section>

<!-- ── The deposit slot ──────────────────────────────────────────────── -->
<section class="hc-store on-paper bay" aria-labelledby={`store-${category.id}`}>
  <div class="wrap hc-store__in">
    <div>
      <h2 class="hc-store__h" id={`store-${category.id}`}>{catalogue.embedHeading}</h2>
      <p class="hc-store__b">
        {catalogue.embedBodyPrefix} {deposit.percent}% {catalogue.embedBodySuffix}
      </p>
      <p class="hc-store__fees">{catalogue.embedNoFees}</p>
    </div>
    <div class="hc-embed">
      <span class="hc-embed__corner" aria-hidden="true"></span>
      <div>
        <p class="hc-embed__label">{catalogue.embedLabel}</p>
        <p class="hc-embed__note">{catalogue.embedNote}</p>
      </div>
    </div>
  </div>
</section>

<style is:inline set:html={filterCss}></style>

<style>
  .hc {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--ink-line);
  }
  .hc-filter-h {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .hc-filters {
    margin-top: 1.25rem;
    display: grid;
    gap: 1.25rem;
    padding-bottom: 1.35rem;
    border-bottom: 1px solid var(--ink-line);
  }
  @media (min-width: 780px) {
    .hc-filters {
      grid-template-columns: 1.3fr 1fr;
      gap: 2.5rem;
    }
  }
  .facet {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem 1.25rem;
  }
  .facet__legend {
    padding: 0;
    width: 100%;
    margin-bottom: 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-ink-dim);
  }
  .facet__input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .facet__label {
    cursor: pointer;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
    padding-bottom: 0.25rem;
    border-bottom: 2px solid transparent;
    /* The radio behind this is 1x1 and clipped, so the label IS the target
       and has to carry the 24px minimum itself (WCAG 2.2 AA 2.5.8). "All"
       is short enough to fall under it on width without the min-width. */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    min-height: 24px;
  }
  .facet__label:hover {
    color: var(--on-ink);
  }
  .facet__input:checked + .facet__label {
    color: var(--accent);
    font-weight: 700;
    border-bottom-color: var(--accent);
  }
  /* The input is visually hidden, so the focus ring lands on the label. */
  .facet__input:focus-visible + .facet__label {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .hc-note {
    margin-top: 1rem;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
    max-width: 56ch;
  }

  /* ── Grid. Wide, image-led, minimal text. ─────────────────────────── */
  .hc-grid {
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 2.25rem 1.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
  .hc-item {
    display: grid;
    align-content: start;
  }
  .hc-shot {
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: flex-end;
    padding: 0.85rem;
    background: var(--ink-raised);
    border: 1px solid var(--ink-line);
  }
  .hc-shot__label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-ink-dim);
  }
  .hc-body {
    padding-top: 0.9rem;
  }
  .hc-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .hc-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .hc-price {
    flex: none;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
  .hc-desc {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--on-ink-dim);
  }
  .hc-spec {
    margin: 0.9rem 0 0;
    display: grid;
    gap: 0.3rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--ink-line);
  }
  .hc-spec > div {
    display: flex;
    gap: 0.75rem;
    justify-content: space-between;
    font-size: 0.78rem;
  }
  .hc-k {
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-ink-dim);
  }
  .hc-v {
    margin: 0;
    text-align: right;
  }
  .hc-v--deposit {
    color: var(--accent);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .hc-stock {
    margin-top: 0.8rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-ink-dim);
  }

  .hc-empty {
    margin-top: 2.5rem;
    padding: 1.5rem;
    border: 1px dashed color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 4%, transparent);
    display: grid;
    gap: 0.5rem;
    max-width: 46rem;
  }
  .hc-empty__h {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--accent);
  }
  .hc-empty__b {
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
  }
  .hc-appliance {
    margin-top: 2rem;
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--accent);
  }

  /* ── Deposit slot ─────────────────────────────────────────────────── */
  .hc-store__in {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 960px) {
    .hc-store__in {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
    }
  }
  .hc-store__h {
    font-size: var(--fs-title);
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .hc-store__b {
    margin-top: 1rem;
    max-width: 50ch;
    color: var(--on-paper-dim);
  }
  .hc-store__fees {
    margin-top: 1rem;
    max-width: 50ch;
    font-size: var(--fs-small);
    color: var(--accent-paper);
  }
  .hc-embed {
    position: relative;
    min-height: 20rem;
    height: clamp(20rem, 40vh, 26rem);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
    border: 1px solid color-mix(in srgb, var(--accent-paper) 50%, transparent);
    background:
      repeating-linear-gradient(
        135deg,
        transparent 0 14px,
        color-mix(in srgb, var(--accent-paper) 8%, transparent) 14px 15px
      ),
      var(--paper-raised);
  }
  .hc-embed__corner {
    position: absolute;
    top: 1rem;
    left: 1rem;
    width: 1.75rem;
    height: 1.75rem;
    border-top: 2px solid var(--accent-paper);
    border-left: 2px solid var(--accent-paper);
  }
  .hc-embed__label {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.25rem);
    font-weight: 600;
    color: var(--accent-paper);
    line-height: 1.4;
    max-width: 26ch;
  }
  .hc-embed__note {
    margin-top: 0.7rem;
    font-size: var(--fs-small);
    color: var(--on-paper-dim);
  }
</style>
