---
// The body of a Stillwater room page. Hair, Nails & Esthetics and Spa &
// Massage are the same shape with different contents, so the three pages stay
// their own files — individually editable — while the layout lives here once.
//
// CMS-DRIVEN: the service list renders the `service` collection modelled in
// multi-service-spa-salon.cms.ts. On a live build this loop is fed from Sanity
// and a seasonal reprice needs no developer.
import DemoImage from './DemoImage.astro';
import {
  categoryPage,
  findCategory,
  practitionersIn,
  servicesIn,
  type CategoryId,
} from '../../data/demos/multi-service-spa-salon';

interface Props {
  category: CategoryId;
  /** where the Book CTAs point */
  bookHref: string;
  teamHref: string;
}

const { category, bookHref, teamHref } = Astro.props;
const meta = findCategory(category);
const list = servicesIn(category);
const people = practitionersIn(category);
---

{meta && (
  <>
    <header class="bay cat-head">
      <div class="wrap cat-head__in">
        <div>
          <p class="eyebrow">{meta.name}</p>
          <h1 class="cat-title">{meta.name}</h1>
          <hr class="rule" />
          <p class="lede cat-lede">{meta.blurb}</p>
        </div>
        <DemoImage
          demo="multi-service-spa-salon"
          file={meta.photo.file}
          subject={meta.photo.subject}
          alt={meta.photo.alt}
          ratio="4 / 3"
          sizes="(min-width: 900px) 46vw, 100vw"
          widths={[560, 900, 1200]}
          eager
          class="cat-shot"
        />
      </div>
    </header>

    <section class="bay" aria-label={meta.name}>
      <div class="wrap">
        <ul class="menu">
          {list.map((service) => (
            <li class="entry">
              <div class="entry__main">
                <h2 class="entry__name">{service.name}</h2>
                <p class="entry__desc">{service.description}</p>
              </div>
              <div class="entry__meta">
                <span class="entry__time">{service.minutes} {categoryPage.durationLabel}</span>
                <span class="entry__price">
                  {service.from && <span class="entry__from">{categoryPage.fromLabel}</span>}
                  ${service.price}
                </span>
                <a class="entry__book" href={bookHref} data-analytics-event="booking_cta_service">
                  {categoryPage.bookCta}
                </a>
              </div>
            </li>
          ))}
        </ul>
        <p class="price-note">{categoryPage.priceNote}</p>
      </div>
    </section>

    <section class="bay on-paper" aria-labelledby="who-h">
      <div class="wrap">
        <h2 id="who-h" class="section-title">{categoryPage.practitionersLabel}</h2>
        <hr class="rule" />
        <ul class="people">
          {people.map((person) => (
            <li class="person">
              <DemoImage
                demo="multi-service-spa-salon"
                file={person.photo.file}
                subject={person.photo.subject}
                alt={person.photo.alt}
                ratio="1 / 1"
                sizes="(min-width: 800px) 22vw, 45vw"
                widths={[280, 420, 560]}
                class="person__shot"
              />
              <h3 class="person__name">{person.name}</h3>
              <p class="person__role">{person.role}</p>
            </li>
          ))}
        </ul>
        <div class="who-cta">
          <a class="btn btn--line" href={teamHref} data-analytics-event="team_view_category">
            {categoryPage.practitionersLabel}
          </a>
          <a class="btn btn--fill" href={bookHref} data-analytics-event="booking_cta_category">
            {categoryPage.allCta}
          </a>
        </div>
      </div>
    </section>
  </>
)}

<style>
  .section-title {
    font-size: var(--fs-title);
    letter-spacing: 0.01em;
  }
  .cat-head__in {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .cat-head__in {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }
  .cat-title {
    font-size: var(--fs-display);
    letter-spacing: 0.01em;
  }
  .cat-lede {
    margin-top: 1.5rem;
    max-width: 42ch;
  }
  .cat-head__in :global(.cat-shot) {
    border-radius: var(--radius);
  }

  /* ── The menu: hairlines and a lot of air ─────────────────────────── */
  .menu {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--accent);
  }
  .entry {
    display: grid;
    gap: 0.9rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--ink-line);
  }
  @media (min-width: 760px) {
    .entry {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      gap: 3rem;
    }
  }
  .entry__name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.25rem + 1.1vw, 2.1rem);
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .entry__desc {
    margin-top: 0.6rem;
    max-width: 54ch;
    font-size: var(--fs-small);
    line-height: 1.7;
    color: var(--on-ink-dim);
  }
  .entry__meta {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }
  @media (min-width: 760px) {
    .entry__meta {
      justify-content: flex-end;
      min-width: 17rem;
    }
  }
  .entry__time {
    font-size: var(--fs-label);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--on-ink-dim);
    font-variant-numeric: tabular-nums;
  }
  .entry__price {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 600;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    text-align: right;
  }
  .entry__from {
    display: block;
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--on-ink-dim);
  }
  .entry__book {
    /* inline-block + block padding to clear the 24px target minimum */
    display: inline-block;
    padding-block: 0.2rem;
    font-size: var(--fs-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    text-underline-offset: 5px;
    white-space: nowrap;
  }
  .price-note {
    margin-top: 2rem;
    font-size: var(--fs-small);
    color: var(--on-ink-dim);
  }

  /* ── Who takes these ──────────────────────────────────────────────── */
  .people {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 800px) {
    .people {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .person :global(.person__shot) {
    border-radius: var(--radius);
  }
  .person__name {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .person__role {
    margin-top: 0.25rem;
    font-size: var(--fs-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-paper);
  }
  .who-cta {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
