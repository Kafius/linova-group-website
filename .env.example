# ── thelinovagroup.com v2 — environment ──────────────────────────────
# Copy to .env for local dev; set the same in Vercel → Project → Settings.
# Blanks marked <<>> come from the rebuild brief §0 — the site builds
# without them (features stay stubbed) and lights up when they're set.

# Sanity (case studies CMS) — project "The Linova Group", public dataset.
# Both are public values: they ship in the bundle and belong in Vercel.
# Unset, /work renders from the seeded local module and /studio isn't mounted.
PUBLIC_LINOVA_SANITY_PROJECT_ID=99tmdxsd
PUBLIC_LINOVA_SANITY_DATASET=production

# Local seeding only (npm run sanity:seed) — a write token. Never in Vercel,
# never PUBLIC_. Mint one at sanity.io/manage -> API -> Tokens.
SANITY_WRITE_TOKEN=

# Only needed if the dataset is ever flipped to private: a read token for
# build-time GROQ. A private dataset answers anonymous queries with an empty
# result rather than an error, so /work would quietly fall back to the seeds.
SANITY_READ_TOKEN=

# Calendly — org/event slug for /book (e.g. "linova-group/intro-call")
PUBLIC_CALENDLY_EVENT=

# Google Analytics 4 — the live property already on the old site
PUBLIC_GA4_MEASUREMENT_ID=G-V6RVGVM23G

# Meta paid-social pipeline — /lp/* routes only
PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Google reviews (component ships dark behind siteSettings.features.googleReviews)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
